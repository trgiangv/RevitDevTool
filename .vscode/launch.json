{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Attach Host: Python",
      "type": "debugpy",
      "request": "attach",
      "connect": {
        "host": "localhost",
        "port": 5678
      }
    },
    {
      "name": "Attach Host: IronPython",
      "type": "pydevd",
      "request": "attach",
      "host": "127.0.0.1",
      "port": 5680,
      "mode": "client",
      "console": "integratedTerminal",
      "cwd": "${workspaceFolder}",
      "pythonExecutable": "C:/Program Files/Python314/python.exe"
    },
    {
      "name": "Attach Host: NetFramework",
      "type": "clr",
      "request": "attach",
      "processId": "${command:pickProcess}",
      "justMyCode": true,
      "requireExactSource": false
    },
    {
      "name": "Attach Host: NetCore",
      "type": "coreclr",
      "request": "attach",
      "processId": "${command:pickProcess}",
      "justMyCode": true,
      "requireExactSource": false
    }
  ]
}
