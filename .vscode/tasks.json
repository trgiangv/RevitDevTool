{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "build: Revit 2022 (Debug)",
      "detail": "Stop Revit 2022, build Debug.Autodesk.2022, deploy the add-in",
      "type": "process",
      "command": "pwsh",
      "args": [
        "-NoProfile",
        "-File",
        "${workspaceFolder}/scripts/build-host.ps1",
        "-HostApp",
        "Revit",
        "-Year",
        "2022",
        "-Mode",
        "Debug"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "group": "build",
      "problemMatcher": "$msCompile",
      "presentation": {
        "reveal": "always",
        "panel": "shared",
        "clear": true
      }
    },
