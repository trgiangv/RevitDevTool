<?xml version="1.0" encoding="UTF-8"?>
<Project xmlns="http://schemas.microsoft.com/developer/msbuild/2003">

    <!-- Common -->
    <Import Project="$(MSBuildThisFileDirectory)props\Common.props" />
    <Import Project="$(MSBuildThisFileDirectory)props\ILRepack.targets" />

    <!-- Revit -->
    <Import Condition="'$(UseRevit)' == 'true'" Project="$(MSBuildThisFileDirectory)props\Revit.props" />
    <Import Condition="'$(UseRevit)' == 'true'" Project="$(MSBuildThisFileDirectory)props\Revit.targets" />

    <!-- AutoCad -->
    <Import Condition="'$(UseAutoCad)' == 'true'" Project="$(MSBuildThisFileDirectory)props\AutoCad.props" />
    <Import Condition="'$(UseAutoCad)' == 'true'" Project="$(MSBuildThisFileDirectory)props\AutoCad.targets" />

</Project>
