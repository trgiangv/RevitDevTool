* text=auto eol=lf

*.cs text eol=lf
*.csproj text eol=lf
*.props text eol=lf
*.targets text eol=lf
*.md text eol=lf
*.json text eol=lf
*.ps1 text eol=lf
*.xml text eol=lf
*.xaml text eol=lf

*.zip filter=lfs diff=lfs merge=lfs -text
*.exe filter=lfs diff=lfs merge=lfs -text
*.dll filter=lfs diff=lfs merge=lfs -text
*.png -text
*.jpg -text
*.jpeg -text
*.gif -text
*.ico -text
*.webp -text
*.woff -text
*.woff2 -text
*.ttf -text
*.eot -text
*.pdf -text
*.nupkg -text
*.snk -text
*.pfx -text

# Documentation media is binary content managed by Git LFS.
# Keep Markdown/configuration files in docs/static diffable as text.
docs/static/**/*.png filter=lfs diff=lfs merge=lfs -text
docs/static/**/*.jpg filter=lfs diff=lfs merge=lfs -text
docs/static/**/*.jpeg filter=lfs diff=lfs merge=lfs -text
docs/static/**/*.gif filter=lfs diff=lfs merge=lfs -text
docs/static/**/*.webp filter=lfs diff=lfs merge=lfs -text
docs/static/**/*.ico filter=lfs diff=lfs merge=lfs -text
docs/static/**/*.svg filter=lfs diff=lfs merge=lfs -text
*.pdb -text
