<?xml version="1.0" encoding="utf-8"?>
<Project ToolsVersion="15.0" xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
    <PropertyGroup>
        <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
    </PropertyGroup>
    <ItemGroup>
        <!--Ioc-->
        <PackageVersion Include="Microsoft.Extensions.Hosting" Version="10.0.9"/>
        <!--Python-->
        <PackageVersion Include="pythonnet" Version="3.1.0"/>
        <PackageVersion Include="IronPython" Version="3.4.2"/>
        <!--MCP-->
        <PackageVersion Include="ModelContextProtocol" Version="1.4.1"/>
        <!--FSharp-->
        <PackageVersion Include="FSharp.Core" Version="10.1.204"/>
        <PackageVersion Include="FSharp.Compiler.Service" Version="43.12.204"/>
        <!--CSharp-->
        <PackageVersion Include="Microsoft.CodeAnalysis.CSharp" Version="5.3.0"/>
        <!--Telemetry-->
        <PackageVersion Include="Sentry" Version="6.6.0"/>
        <!--Logging-->
        <PackageVersion Include="Microsoft.Extensions.Logging.Abstractions" Version="10.0.9"/>
        <PackageVersion Include="ZLogger" Version="2.5.10"/>
        <PackageVersion Include="ZLogger.Scintilla" Version="0.0.8"/>
        <PackageVersion Include="Scintilla5.NET" Version="6.1.2"/>
        <!--Utilities-->
        <PackageVersion Include="System.Diagnostics.DiagnosticSource" Version="10.0.9"/>
        <PackageVersion Include="System.Reflection.MetadataLoadContext" Version="10.0.9"/>
        <PackageVersion Include="JetBrains.Annotations" Version="2026.2.0"/>
        <GlobalPackageReference Include="Polyfill" Version="10.11.2"/>
        <PackageVersion Include="Microsoft-WindowsAPICodePack-Shell" Version="1.1.5"/>
        <PackageVersion Include="System.Drawing.Common" Version="8.0.25"/>
        <PackageVersion Include="System.Net.Http" Version="4.3.4"/>
        <PackageVersion Include="System.Text.Json" Version="9.0.5"/>
        <!--Auth-->
        <PackageVersion Include="Duende.IdentityModel.OidcClient" Version="7.1.0"/>
        <PackageVersion Include="System.Security.Cryptography.ProtectedData" Version="10.0.9"/>
        <!--Console-->
        <PackageVersion Include="CliWrap" Version="3.10.2"/>
        <!--UI-->
        <PackageVersion Include="CommunityToolkit.Mvvm" Version="8.4.2"/>
        <PackageVersion Include="H.NotifyIcon.Wpf" Version="2.4.1"/>
        <PackageVersion Include="Microsoft.Web.WebView2" Version="1.0.4022.49"/>
        <!--Build Tools-->
        <PackageVersion Include="ILRepack" Version="2.0.45"/>
        <PackageVersion Include="Sourcy.DotNet" Version="1.1.1"/>
        <PackageVersion Include="Shouldly" Version="4.3.0"/>
        <PackageVersion Include="ModularPipelines" Version="3.2.8"/>
        <PackageVersion Include="ModularPipelines.Git" Version="3.2.8"/>
        <PackageVersion Include="ModularPipelines.DotNet" Version="3.2.8"/>
        <PackageVersion Include="ModularPipelines.GitHub" Version="3.2.8"/>
        <PackageVersion Include="Microsoft.VisualStudio.SolutionPersistence" Version="1.0.52"/>
        <!--File IO-->
        <PackageVersion Include="OpenMcdf" Version="3.1.4"/>
        <!--AutoCad-->
        <PackageVersion Include="ACadSharp" Version="3.6.29"/>
        <PackageVersion Include="ricaun.AutoCAD.UI" Version="0.5.0"/>
        <!--Tests-->
        <PackageVersion Include="coverlet.collector" Version="10.0.1"/>
        <PackageVersion Include="Microsoft.NET.Test.Sdk" Version="18.6.0"/>
        <PackageVersion Include="xunit.v3" Version="3.2.2"/>
        <PackageVersion Include="xunit.runner.visualstudio" Version="3.1.5"/>
    </ItemGroup>
</Project>
