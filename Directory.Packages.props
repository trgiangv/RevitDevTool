<?xml version="1.0" encoding="utf-8"?>
<Project ToolsVersion="15.0" xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
    <PropertyGroup>
        <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
        <MsVersion>10.0.11</MsVersion>
    </PropertyGroup>
    <ItemGroup>
        <!--Mirosoft-->
        <PackageVersion Include="Microsoft.Extensions.Hosting" Version="$(MsVersion)" />
        <PackageVersion Include="Microsoft.Extensions.DependencyInjection.Abstractions"
            Version="$(MsVersion)" />
        <PackageVersion Include="Microsoft.Extensions.DependencyModel" Version="$(MsVersion)" />
        <PackageVersion Include="Microsoft.Extensions.DependencyInjection" Version="$(MsVersion)" />
        <PackageVersion Include="Microsoft.Extensions.Options" Version="$(MsVersion)" />
        <PackageVersion Include="Microsoft.Extensions.Options.ConfigurationExtensions"
            Version="$(MsVersion)" />
        <PackageVersion Include="Microsoft.Extensions.Logging.Abstractions" Version="$(MsVersion)" />
        <PackageVersion Include="System.Diagnostics.DiagnosticSource" Version="$(MsVersion)" />
        <PackageVersion Include="System.Reflection.Metadata" Version="$(MsVersion)" />
        <PackageVersion Include="System.Reflection.MetadataLoadContext" Version="$(MsVersion)" />
        <PackageVersion Include="System.Security.Cryptography.ProtectedData" Version="$(MsVersion)" />
        <PackageVersion Include="System.Text.Json" Version="$(MsVersion)" />
        <PackageVersion Include="Microsoft.Bcl.AsyncInterfaces" Version="$(MsVersion)" />
        <!--Python-->
        <PackageVersion Include="pythonnet" Version="3.1.0" />
        <PackageVersion Include="IronPython" Version="3.4.2" />
        <!--MCP-->
        <PackageVersion Include="ModelContextProtocol" Version="2.2.0" />
        <PackageVersion Include="ModelContextProtocol.Extensions.Tasks" Version="2.2.0" />
        <!--FSharp-->
        <PackageVersion Include="FSharp.Core" Version="11.0.101-preview7.26381.103" />
        <PackageVersion Include="FSharp.Compiler.Service" Version="43.13.101-preview7.26381.103" />
        <!--CSharp-->
        <PackageVersion Include="Microsoft.CodeAnalysis.CSharp" Version="5.9.0" />
        <!--Telemetry-->
        <PackageVersion Include="Sentry" Version="6.9.0" />
        <!--Logging-->
        <PackageVersion Include="ZLogger" Version="2.5.10" />
        <PackageVersion Include="ZLogger.Scintilla" Version="0.0.9" />
        <PackageVersion Include="Scintilla5.NET" Version="7.0.0" />
        <!--Utilities-->
        <PackageVersion Include="JetBrains.Annotations" Version="2026.2.0" />
        <GlobalPackageReference Include="Polyfill" Version="11.2.0" />
        <PackageVersion Include="Microsoft-WindowsAPICodePack-Shell" Version="1.1.5" />
        <PackageVersion Include="System.Drawing.Common" Version="8.0.25" />
        <PackageVersion Include="System.Net.Http" Version="4.3.4" />
        <PackageVersion Include="System.Runtime.CompilerServices.Unsafe" Version="6.1.2" />
        <!--Auth-->
        <PackageVersion Include="Duende.IdentityModel.OidcClient" Version="7.1.0" />
        <!--Console-->
        <PackageVersion Include="CliWrap" Version="3.10.5" />
        <PackageVersion Include="ConsoleAppFramework" Version="5.7.13" />
        <!--UI-->
        <PackageVersion Include="CommunityToolkit.Mvvm" Version="8.4.2" />
        <PackageVersion Include="Aprillz.MewUI.Windows" Version="0.20.2" />
        <PackageVersion Include="H.NotifyIcon" Version="2.4.1" />
        <PackageVersion Include="Microsoft.Web.WebView2" Version="1.0.4191.47" />
        <!--BuildTools-->
        <PackageVersion Include="ILRepack" Version="2.0.48" />
        <PackageVersion Include="Sourcy.DotNet" Version="1.1.1" />
        <PackageVersion Include="Shouldly" Version="4.3.0" />
        <PackageVersion Include="ModularPipelines" Version="3.2.8" />
        <PackageVersion Include="ModularPipelines.Git" Version="3.2.8" />
        <PackageVersion Include="ModularPipelines.DotNet" Version="3.2.8" />
        <PackageVersion Include="ModularPipelines.GitHub" Version="3.2.8" />
        <PackageVersion Include="Microsoft.VisualStudio.SolutionPersistence" Version="1.0.52" />
        <PackageVersion Include="Microsoft.VisualStudio.Interop" Version="17.14.40260" />
        <!--FileIO-->
        <PackageVersion Include="OpenMcdf" Version="3.2.0" />
        <!--AutoCad-->
        <PackageVersion Include="ACadSharp" Version="3.7.1" />
        <PackageVersion Include="ricaun.AutoCAD.UI" Version="0.5.0" />
        <!--Tests-->
        <PackageVersion Include="xunit.v3" Version="4.0.0" />
        <PackageVersion Include="coverlet.MTP" Version="10.0.1" />
        <PackageVersion Include="NUnit" Version="4.6.1" />
        <PackageVersion Include="TUnit" Version="1.66.27" />
        <PackageVersion Include="TUnit.Core" Version="1.66.27" />
        <PackageVersion Include="TUnit.Engine" Version="1.66.27" />
        <PackageVersion Include="Microsoft.Testing.Platform" Version="2.4.0" />
        <PackageVersion Include="Microsoft.Testing.Platform.MSBuild" Version="2.4.0" />
        <PackageVersion Include="Moq" Version="4.20.72" />
        <PackageVersion Include="Bogus" Version="35.6.5" />
    </ItemGroup>
</Project>