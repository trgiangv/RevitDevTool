<UserControl x:Class="DevTools.Views.View.McpRegistryView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:behav="clr-namespace:DevTools.UI.Behaviors;assembly=DevTools.UI"
             xmlns:converters="clr-namespace:DevTools.Views.Converters"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:design="clr-namespace:DevTools.UI.Theme.Design;assembly=DevTools.UI"
             xmlns:mah="http://metro.devtools.ui/winfx/xaml/controls"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:DevTools.Views.ViewModel"
             d:Background="{DynamicResource DevTools.MahApps.Brushes.ThemeBackground}"
             d:DataContext="{d:DesignInstance vm:McpRegistryViewModel}"
             d:DesignHeight="500"
             d:DesignWidth="500"
             mc:Ignorable="d">

    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/DevTools.UI;component/Theme/Theme.xaml" />
                <design:IntellisenseResources Source="/DevTools.UI;component/Theme/Design/DesignTimeResources.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <Style x:Key="InfoBlock"
                   TargetType="TextBlock">
                <Setter Property="Foreground" Value="{DynamicResource DevTools.MahApps.Brushes.ThemeForeground}" />
            </Style>

            <converters:ExecutionModeImageConverter x:Key="ExecutionModeToIcon" />

        </ResourceDictionary>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0"
              Margin="0,0,0,6">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <TextBox Grid.Column="0"
                     mah:TextBoxHelper.ClearTextButton="True"
                     mah:TextBoxHelper.Watermark="Search tools..."
                     Text="{Binding SearchText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />

            <Button Grid.Column="1"
                    Width="28"
                    Height="28"
                    Margin="2,0,0,0"
                    Command="{Binding ReloadCommand}"
                    ToolTip="Reload tool registry">
                <Path Width="12"
                      Height="12"
                      Data="{StaticResource Refresh}"
                      Fill="{DynamicResource DevTools.MahApps.Brushes.ThemeForeground}"
                      Stretch="Uniform" />
            </Button>
        </Grid>

        <UniformGrid Grid.Row="1"
                     Margin="0,0,0,8"
                     Columns="5"
                     Rows="1">
            <Border Margin="0,0,5,0"
                    Padding="6"
                    BorderBrush="{DynamicResource DevTools.MahApps.Brushes.Gray8}"
                    BorderThickness="1"
                    CornerRadius="4">
                <StackPanel Orientation="Vertical">
                    <Ellipse Width="8"
                             Height="8"
                             HorizontalAlignment="Left">
                        <Ellipse.Style>
                            <Style TargetType="Ellipse">
                                <Setter Property="Fill" Value="#FF6B6B" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsConnected}"
                                                 Value="True">
                                        <Setter Property="Fill" Value="#4CAF50" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Ellipse.Style>
                    </Ellipse>
                    <TextBlock Margin="0,6,0,0"
                               FontSize="10"
                               Style="{StaticResource InfoBlock}"
                               Text="{Binding PipeName}" />
                </StackPanel>
            </Border>

            <Border Margin="2,0"
                    Padding="6"
                    BorderBrush="{DynamicResource DevTools.MahApps.Brushes.Gray8}"
                    BorderThickness="1"
                    CornerRadius="4">
                <StackPanel>
                    <TextBlock FontSize="10"
                               Style="{StaticResource InfoBlock}"
                               Text="Total Tool" />
                    <TextBlock FontSize="12"
                               FontWeight="SemiBold"
                               Style="{StaticResource InfoBlock}"
                               Text="{Binding TotalToolCount}" />
                </StackPanel>
            </Border>

            <Border Margin="2,0"
                    Padding="6"
                    BorderBrush="{DynamicResource DevTools.MahApps.Brushes.Gray8}"
                    BorderThickness="1"
                    CornerRadius="4">
                <StackPanel>
                    <TextBlock FontSize="10"
                               Style="{StaticResource InfoBlock}"
                               Text=".NET Tools" />
                    <TextBlock FontSize="12"
                               FontWeight="SemiBold"
                               Style="{StaticResource InfoBlock}"
                               Text="{Binding DotNetToolCount}" />
                </StackPanel>
            </Border>

            <Border Margin="2,0"
                    Padding="6"
                    BorderBrush="{DynamicResource DevTools.MahApps.Brushes.Gray8}"
                    BorderThickness="1"
                    CornerRadius="4">
                <StackPanel>
                    <TextBlock FontSize="10"
                               Style="{StaticResource InfoBlock}"
                               Text="Python Tools" />
                    <TextBlock FontSize="12"
                               FontWeight="SemiBold"
                               Style="{StaticResource InfoBlock}"
                               Text="{Binding PythonToolCount}" />
                </StackPanel>
            </Border>

            <Border Margin="4,0,0,0"
                    Padding="6"
                    BorderBrush="{DynamicResource DevTools.MahApps.Brushes.Gray8}"
                    BorderThickness="1"
                    CornerRadius="4">
                <StackPanel>
                    <TextBlock FontSize="10"
                               Style="{StaticResource InfoBlock}"
                               Text="Total Called" />
                    <TextBlock FontSize="12"
                               FontWeight="SemiBold"
                               Style="{StaticResource InfoBlock}"
                               Text="{Binding TotalCalled}" />
                </StackPanel>
            </Border>
        </UniformGrid>

        <Grid Grid.Row="2"
              AllowDrop="True"
              DragEnter="RegistryList_DragEnter"
              DragLeave="RegistryList_DragLeave"
              DragOver="RegistryList_DragOver"
              Drop="RegistryList_Drop">

            <ListBox ItemsSource="{Binding FilteredTools}"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                     SelectedItem="{Binding SelectedTool, Mode=TwoWay}"
                     VirtualizingPanel.IsVirtualizing="True"
                     VirtualizingPanel.VirtualizationMode="Recycling">
                <ListBox.ItemContainerStyle>
                    <Style BasedOn="{StaticResource {x:Type ListBoxItem}}"
                           TargetType="ListBoxItem">
                        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                        <Setter Property="Padding" Value="4,3" />
                        <Setter Property="ToolTip" Value="{Binding ToolTipText}" />
                    </Style>
                </ListBox.ItemContainerStyle>
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <Image Grid.Column="0"
                                   Width="15"
                                   Height="15"
                                   Margin="0,0,6,0"
                                   VerticalAlignment="Center"
                                   Source="{Binding SourceKind, Converter={StaticResource ExecutionModeToIcon}}" />

                            <StackPanel Grid.Column="1"
                                        Orientation="Horizontal">
                                <TextBlock behav:HighlightTextBlockBehavior.Range="{Binding NameHighlight}"
                                           FontWeight="SemiBold"
                                           Style="{StaticResource InfoBlock}"
                                           Text="{Binding Name}"
                                           TextTrimming="CharacterEllipsis" />
                                <Border Margin="6,0,0,0"
                                        Padding="5,1"
                                        VerticalAlignment="Center"
                                        Background="{DynamicResource DevTools.MahApps.Brushes.Accent}"
                                        CornerRadius="3">
                                    <TextBlock behav:HighlightTextBlockBehavior.Range="{Binding GroupNameHighlight}"
                                               FontSize="10"
                                               Text="{Binding GroupName}"
                                               TextTrimming="CharacterEllipsis" />
                                </Border>
                            </StackPanel>

                            <Border Grid.Column="2"
                                    Margin="6,0,0,0"
                                    Padding="6,2"
                                    VerticalAlignment="Center"
                                    Background="{DynamicResource DevTools.MahApps.Brushes.Accent}"
                                    CornerRadius="6">
                                <TextBlock FontSize="10"
                                           FontWeight="SemiBold"
                                           Text="{Binding CallCount, StringFormat='Call: {0}'}" />
                            </Border>
                        </Grid>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>

            <Border x:Name="DropMask"
                    Panel.ZIndex="10"
                    Background="#AA1E1E1E"
                    IsHitTestVisible="False"
                    Visibility="Collapsed">
                <StackPanel HorizontalAlignment="Center"
                            VerticalAlignment="Center">
                    <TextBlock x:Name="DropMaskTitle"
                               HorizontalAlignment="Center"
                               FontSize="14"
                               FontWeight="SemiBold"
                               Foreground="White"
                               Text="Drop to load" />
                    <TextBlock x:Name="DropMaskHint"
                               Margin="0,6,0,0"
                               HorizontalAlignment="Center"
                               FontSize="11"
                               Foreground="#FFD0D0D0"
                               Text="Direct .dll files or Python toolset folders are supported" />
                </StackPanel>
            </Border>
        </Grid>

        <Border Grid.Row="3"
                Margin="0,6,0,0"
                Padding="10,6"
                Background="{DynamicResource DevTools.MahApps.Brushes.ThemeBackground}"
                BorderThickness="1"
                Visibility="{Binding ShowStatusPanel, Converter={StaticResource BooleanToVisibilityConverter}}">
            <StackPanel>
                <TextBlock FontSize="9"
                           Foreground="{DynamicResource DevTools.MahApps.Brushes.ThemeForeground}"
                           Text="{Binding StatusPanelText}"
                           TextAlignment="Center"
                           TextTrimming="CharacterEllipsis" />
                <mah:MetroProgressBar Height="6"
                                      Margin="0,6,0,0"
                                      IsIndeterminate="True" />
            </StackPanel>
        </Border>

        <Grid Grid.Row="4"
              Margin="0,6,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Button Height="30"
                    Margin="0,0,5,0"
                    HorizontalAlignment="Stretch"
                    Command="{Binding LoadDotnetToolsetCommand}"
                    ToolTip="Load .NET Assembly">
                <StackPanel Orientation="Horizontal">
                    <Image Width="16"
                           Height="16"
                           Margin="0,0,5,0"
                           Source="{StaticResource DotnetIcon}" />
                    <TextBlock VerticalAlignment="Center"
                               Text="Load .NET Toolset" />
                </StackPanel>
            </Button>

            <Button Grid.Column="1"
                    Height="30"
                    HorizontalAlignment="Stretch"
                    Command="{Binding LoadPythonToolsetCommand}"
                    ToolTip="Load Python Folder">
                <StackPanel Orientation="Horizontal">
                    <Image Width="16"
                           Height="16"
                           Margin="0,0,5,0"
                           Source="{StaticResource PythonIcon}" />
                    <TextBlock VerticalAlignment="Center"
                               Text="Load Python Toolset" />
                </StackPanel>
            </Button>
        </Grid>
    </Grid>
</UserControl>
