<Project Sdk="Microsoft.NET.Sdk">

    <!--
          Headless update engine. The Daemon hosts it in tray mode only.
          Velopack updates the Daemon package. This project updates the Autodesk bundle payloads.
          Decisions: docs/decisions/0046 to 0053.
    -->

    <PropertyGroup>
        <TargetFramework>net10.0-windows</TargetFramework>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="Microsoft.Extensions.Hosting"/>
        <PackageReference Include="Octokit"/>
        <PackageReference Include="Velopack"/>
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="..\DevTools.Hosting\DevTools.Hosting.csproj"/>
    </ItemGroup>

    <ItemGroup>
        <EmbeddedResource Include="..\..\props\PackageContents.xml" LogicalName="DevTools.Update.PackageContents.xml"/>
    </ItemGroup>

    <ItemGroup>
        <InternalsVisibleTo Include="DevTools.Update.Tests"/>
    </ItemGroup>

</Project>
