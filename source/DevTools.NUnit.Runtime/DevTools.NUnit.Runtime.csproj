<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFrameworks>net48;net8.0-windows;net10.0-windows</TargetFrameworks>
        <RootNamespace>DevTools.NUnit.Runtime</RootNamespace>
        <AssemblyName>DevTools.NUnit.Runtime</AssemblyName>
        <IsPackable>false</IsPackable>
        <RuntimeManifestFramework>NUnit</RuntimeManifestFramework>
        <RuntimeManifestEntry>DevTools.NUnit.Runtime.NUnitRuntimeSession</RuntimeManifestEntry>
        <RuntimeManifestAssembly>nunit.framework</RuntimeManifestAssembly>
    </PropertyGroup>

    <PropertyGroup Condition="'$(TargetFramework)' == 'net48'">
        <ILRepackable>true</ILRepackable>
        <ILRepackInternalize>true</ILRepackInternalize>
        <ILRepackKeepSymbols>true</ILRepackKeepSymbols>
        <RepackBinariesKeep>nunit.framework.dll;nunit.framework.legacy.dll;System.Runtime.CompilerServices.Unsafe.dll;System.Threading.Tasks.Extensions.dll</RepackBinariesKeep>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="NUnit"/>
        <PackageReference Include="System.Reflection.Metadata" Condition="'$(TargetFramework)' == 'net48'"/>
    </ItemGroup>

    <ItemGroup>
        <!-- Neutral cross-load-context identity remains host-shared, never payload-private. -->
        <ProjectReference Include="..\DevTools.Testing.Abstractions\DevTools.Testing.Abstractions.csproj"
                          Private="false"/>
    </ItemGroup>

    <ItemGroup>
        <InternalsVisibleTo Include="DevTools.NUnit.Runtime.Tests"/>
    </ItemGroup>

    <Import Project="..\..\props\TestingRuntime.targets"/>

</Project>
