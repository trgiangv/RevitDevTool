<Project>
  <!--
    Runtime owns NUnitRuntimePayload\ (private nunit.framework + this assembly).
    Hosts copy that folder as-is into NUnitRuntime\.

    Exclude host-owned identities: ILRepack JSON/IPC/Isolation, one loose
    Testing.Abstractions beside the add-in. Empty TargetDir would resolve
    NUnitRuntimePayload\ under the project directory — require TargetDir.
  -->
  <Target Name="PrepareNUnitRuntimePayload"
          AfterTargets="Build"
          Condition="'$(TargetPath)' != '' AND '$(TargetDir)' != ''">
    <PropertyGroup>
      <_NUnitRuntimeOutputDir>$([System.IO.Path]::GetFullPath('$(TargetDir)'))</_NUnitRuntimeOutputDir>
      <_NUnitRuntimePayloadDir>$([System.IO.Path]::Combine('$(_NUnitRuntimeOutputDir)', 'NUnitRuntimePayload'))</_NUnitRuntimePayloadDir>
    </PropertyGroup>
    <ItemGroup>
      <!-- Host ILRepack / one loose Abstractions — never into NUnitRuntimePayload. -->
      <_NUnitPayloadOmit Include="DevTools.Ipc.dll;System.Text.Json.dll;System.Text.Encodings.Web.dll;System.IO.Pipelines.dll;Microsoft.Bcl.AsyncInterfaces.dll;DevTools.AssemblyIsolation.dll;DevTools.Testing.Abstractions.dll" />
      <_NUnitRuntimePayload Include="$(_NUnitRuntimeOutputDir)*.dll"
                            Exclude="@(_NUnitPayloadOmit->'$(_NUnitRuntimeOutputDir)%(Identity)')" />
      <_NUnitRuntimePayload Include="$(_NUnitRuntimeOutputDir)$(TargetName).pdb"
                            Condition="Exists('$(_NUnitRuntimeOutputDir)$(TargetName).pdb')" />
    </ItemGroup>

    <Error Condition="!Exists('$(_NUnitRuntimeOutputDir)DevTools.NUnit.Runtime.dll')"
           Text="NUnit runtime payload requires DevTools.NUnit.Runtime.dll under '$(_NUnitRuntimeOutputDir)'." />
    <Error Condition="!Exists('$(_NUnitRuntimeOutputDir)nunit.framework.dll')"
           Text="NUnit runtime payload requires nunit.framework.dll under '$(_NUnitRuntimeOutputDir)'." />

    <RemoveDir Directories="$(_NUnitRuntimePayloadDir)" Condition="Exists('$(_NUnitRuntimePayloadDir)')" />
    <MakeDir Directories="$(_NUnitRuntimePayloadDir)" />
    <Copy SourceFiles="@(_NUnitRuntimePayload)"
          DestinationFolder="$(_NUnitRuntimePayloadDir)"
          SkipUnchangedFiles="false" />
  </Target>

  <Target Name="GetNUnitRuntimePayload"
          DependsOnTargets="Build"
          Returns="@(NUnitRuntimePayloadFile)"
          Condition="'$(TargetPath)' != '' AND '$(TargetDir)' != ''">
    <PropertyGroup>
      <_NUnitRuntimeOutputDir>$([System.IO.Path]::GetFullPath('$(TargetDir)'))</_NUnitRuntimeOutputDir>
      <_NUnitRuntimePayloadDir>$([System.IO.Path]::Combine('$(_NUnitRuntimeOutputDir)', 'NUnitRuntimePayload'))</_NUnitRuntimePayloadDir>
    </PropertyGroup>
    <Error Condition="!Exists('$(_NUnitRuntimePayloadDir)\DevTools.NUnit.Runtime.dll')"
           Text="NUnit runtime payload was not prepared at '$(_NUnitRuntimePayloadDir)'." />
    <ItemGroup>
      <NUnitRuntimePayloadFile Include="$(_NUnitRuntimePayloadDir)\*.*" />
    </ItemGroup>
  </Target>
</Project>
