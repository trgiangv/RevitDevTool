<UserControl x:Class="DevTools.ModelsContext.Views.ModelContextView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="clr-namespace:DevTools.UI.Controls;assembly=DevTools.UI"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:hc="https://handyorg.github.io/handycontrol"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:views="clr-namespace:DevTools.ModelsContext.Views"
             xmlns:vm="clr-namespace:DevTools.ModelsContext.ViewModels;assembly=DevTools.ModelsContext"
             d:DataContext="{d:DesignInstance vm:ModelContextViewModel}"
             d:DesignHeight="800"
             d:DesignWidth="320"
             mc:Ignorable="d">

    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/DevTools.ModelsContext.Views;component/ModelContextResources.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <Style x:Key="ScopeIconStyle" TargetType="Path">
                <Setter Property="Width" Value="14" />
                <Setter Property="Height" Value="14" />
                <Setter Property="Stretch" Value="Uniform" />
                <Setter Property="Fill" Value="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}" />
            </Style>

            <Style x:Key="DocumentsBoxStyle"
                   BasedOn="{StaticResource SummaryCheckComboBoxStyle}"
                   TargetType="c:SummaryCheckComboBox">
                <Style.Triggers>
                    <DataTrigger Binding="{Binding ContextBar.IsDocumentListVisible}" Value="False">
                        <Setter Property="Visibility" Value="Collapsed" />
                    </DataTrigger>
                </Style.Triggers>
            </Style>

            <Style x:Key="DocumentItemStyle"
                   BasedOn="{StaticResource CheckComboBoxItemBaseStyle}"
                   TargetType="hc:CheckComboBoxItem">
                <Setter Property="IsEnabled" Value="{Binding IsEnabled}" />
                <Setter Property="AutomationProperties.Name" Value="{Binding Label}" />
            </Style>

            <Style x:Key="TemporaryBarStyle" TargetType="Border">
                <Setter Property="Margin" Value="0,8,0,0" />
                <Setter Property="Padding" Value="8,6" />
                <Setter Property="Background" Value="{DynamicResource LightWarningBrush}" />
                <Setter Property="BorderBrush" Value="{DynamicResource WarningBrush}" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="CornerRadius" Value="4" />
                <Style.Triggers>
                    <DataTrigger Binding="{Binding IsTemporaryBarVisible}" Value="False">
                        <Setter Property="Visibility" Value="Collapsed" />
                    </DataTrigger>
                </Style.Triggers>
            </Style>

            <Style x:Key="ConfirmPanelStyle" TargetType="StackPanel">
                <Setter Property="Margin" Value="0,6,0,0" />
                <Setter Property="Visibility" Value="Collapsed" />
                <Style.Triggers>
                    <DataTrigger Binding="{Binding TemporaryBar.IsConfirmingKeep}" Value="True">
                        <Setter Property="Visibility" Value="Visible" />
                    </DataTrigger>
                </Style.Triggers>
            </Style>

            <Style x:Key="UpdatingBarStyle" TargetType="ProgressBar">
                <Setter Property="Height" Value="2" />
                <Setter Property="IsIndeterminate" Value="False" />
                <Setter Property="Visibility" Value="Collapsed" />
                <Style.Triggers>
                    <DataTrigger Binding="{Binding IsUpdating}" Value="True">
                        <Setter Property="Visibility" Value="Visible" />
                        <Setter Property="IsIndeterminate" Value="True" />
                    </DataTrigger>
                </Style.Triggers>
            </Style>
        </ResourceDictionary>
    </UserControl.Resources>

    <Grid Margin="8">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel>
            <TextBlock AutomationProperties.AutomationId="ModelContext.Title"
                       FontSize="14"
                       FontWeight="SemiBold"
                       Text="{Binding Title}"
                       TextTrimming="CharacterEllipsis" />
            <ProgressBar Margin="0,4,0,0"
                         AutomationProperties.AutomationId="ModelContext.Updating"
                         Style="{StaticResource UpdatingBarStyle}" />
        </StackPanel>

        <Grid Grid.Row="1" Margin="0,8,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <hc:ButtonGroup VerticalAlignment="Center" AutomationProperties.AutomationId="ModelContext.Scope">
                <RadioButton Height="28"
                             AutomationProperties.AutomationId="ModelContext.Scope.Selection"
                             AutomationProperties.Name="Selection"
                             IsChecked="{Binding ContextBar.IsSelectionScope}"
                             ToolTip="Selection">
                    <Path Data="{StaticResource Cursor}" Style="{StaticResource ScopeIconStyle}" />
                </RadioButton>
                <RadioButton Height="28"
                             AutomationProperties.AutomationId="ModelContext.Scope.ActiveView"
                             AutomationProperties.Name="Active view"
                             IsChecked="{Binding ContextBar.IsActiveViewScope}"
                             ToolTip="Active view">
                    <Path Data="{StaticResource Box}" Style="{StaticResource ScopeIconStyle}" />
                </RadioButton>
                <RadioButton Height="28"
                             AutomationProperties.AutomationId="ModelContext.Scope.WholeModel"
                             AutomationProperties.Name="Whole model"
                             IsChecked="{Binding ContextBar.IsWholeModelScope}"
                             ToolTip="Whole model">
                    <Path Data="{StaticResource AllModels}" Style="{StaticResource ScopeIconStyle}" />
                </RadioButton>
            </hc:ButtonGroup>
            <c:SummaryCheckComboBox x:Name="DocumentsBox"
                                    Grid.Column="1"
                                    Margin="8,0,0,0"
                                    AutomationProperties.AutomationId="ModelContext.Documents"
                                    DisplayMemberPath="Label"
                                    ItemContainerStyle="{StaticResource DocumentItemStyle}"
                                    ItemsSource="{Binding ContextBar.Documents}"
                                    SelectionChanged="OnDocumentsSelectionChanged"
                                    Style="{StaticResource DocumentsBoxStyle}" />
        </Grid>

        <Border Grid.Row="2" Style="{StaticResource TemporaryBarStyle}">
            <StackPanel>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock VerticalAlignment="Center"
                               AutomationProperties.AutomationId="Temporary.Text"
                               Foreground="{DynamicResource PrimaryTextBrush}"
                               Text="{Binding TemporaryBar.Text}" />
                    <Button Grid.Column="1"
                            AutomationProperties.AutomationId="Temporary.Keep"
                            Command="{Binding TemporaryBar.KeepCommand}"
                            Content="Keep"
                            Style="{StaticResource PanelPrimaryButton}" />
                    <Button Grid.Column="2"
                            Margin="4,0,0,0"
                            AutomationProperties.AutomationId="Temporary.Reset"
                            Command="{Binding TemporaryBar.ResetCommand}"
                            Content="Reset"
                            Style="{StaticResource PanelTextButton}" />
                </Grid>
                <StackPanel Style="{StaticResource ConfirmPanelStyle}">
                    <TextBlock AutomationProperties.AutomationId="Temporary.ConfirmText"
                               Foreground="{DynamicResource PrimaryTextBrush}"
                               Text="{Binding TemporaryBar.ConfirmText}"
                               TextWrapping="Wrap" />
                    <StackPanel Margin="0,6,0,0" Orientation="Horizontal">
                        <Button AutomationProperties.AutomationId="Temporary.ConfirmKeep"
                                Command="{Binding TemporaryBar.ConfirmKeepCommand}"
                                Content="Keep"
                                Style="{StaticResource PanelPrimaryButton}" />
                        <Button Margin="4,0,0,0"
                                AutomationProperties.AutomationId="Temporary.CancelKeep"
                                Command="{Binding TemporaryBar.CancelKeepCommand}"
                                Content="Cancel"
                                Style="{StaticResource PanelTextButton}" />
                    </StackPanel>
                </StackPanel>
            </StackPanel>
        </Border>

        <TabControl x:Name="Tabs"
                    Grid.Row="3"
                    Margin="0,8,0,0"
                    AutomationProperties.AutomationId="ModelContext.Tabs"
                    SelectionChanged="OnTabChanged">
            <TabItem AutomationProperties.AutomationId="ModelContext.Tab.Tree" Header="Tree">
                <views:TreeTabView />
            </TabItem>
            <TabItem AutomationProperties.AutomationId="ModelContext.Tab.Filter" Header="Filter">
                <views:FilterTabView />
            </TabItem>
        </TabControl>

        <TextBlock Grid.Row="4"
                   Margin="0,6,0,0"
                   AutomationProperties.AutomationId="ModelContext.Message"
                   Style="{StaticResource ErrorText}"
                   Text="{Binding Message}" />
    </Grid>
</UserControl>
