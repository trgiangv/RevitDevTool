<Project Sdk="Microsoft.NET.Sdk">
    <PropertyGroup>
        <TargetFrameworks>net48;net8.0-windows;net10.0-windows</TargetFrameworks>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="System.Text.Json" Condition="'$(TargetFramework)' == 'net48'"/>
    </ItemGroup>

    <!-- Linked into MTP / VSTest / Runner; do not ship PE discovery or the
         out-of-process Runner client in the in-host Core DLL. -->
    <ItemGroup>
        <Compile Remove="Discovery\**"/>
        <None Include="Discovery\**" />
        <Compile Remove="Client\**"/>
        <None Include="Client\**" />
    </ItemGroup>
</Project>
