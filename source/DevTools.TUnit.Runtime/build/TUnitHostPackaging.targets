<Project>
  <PropertyGroup>
    <TUnitRuntimeProject Condition="'$(TUnitRuntimeProject)' == ''">$(MSBuildThisFileDirectory)..\DevTools.TUnit.Runtime.csproj</TUnitRuntimeProject>
  </PropertyGroup>

  <Target Name="CopyTUnitRuntimeBootstrap"
          AfterTargets="Build"
          BeforeTargets="RepackAddinFiles"
          Condition="'$(TargetPath)' != '' AND '$(TargetDir)' != ''">
    <PropertyGroup>
      <_TUnitRuntimeDeployDir>$([System.IO.Path]::GetFullPath('$(TargetDir)TUnitRuntime\'))</_TUnitRuntimeDeployDir>
    </PropertyGroup>
    <MSBuild Projects="$(TUnitRuntimeProject)"
             Targets="GetTUnitRuntimePayload"
             Properties="Configuration=$(Configuration);TargetFramework=$(TargetFramework)">
      <Output TaskParameter="TargetOutputs" ItemName="_TUnitRuntimePayload" />
    </MSBuild>
    <Error Condition="'@(_TUnitRuntimePayload)' == ''"
           Text="TUnit runtime payload from '$(TUnitRuntimeProject)' was empty." />
    <RemoveDir Directories="$(_TUnitRuntimeDeployDir)" Condition="Exists('$(_TUnitRuntimeDeployDir)')" />
    <MakeDir Directories="$(_TUnitRuntimeDeployDir)" />
    <Copy SourceFiles="@(_TUnitRuntimePayload)"
          DestinationFolder="$(_TUnitRuntimeDeployDir)"
          SkipUnchangedFiles="false" />
  </Target>

  <Target Name="AssertTUnitRuntimeLayout"
          AfterTargets="RepackAddinFiles"
          Condition="'$(TargetDir)' != ''">
    <Error Condition="!Exists('$(TargetDir)TUnitRuntime\TUnit.Core.dll')"
           Text="TUnit.Core.dll must be deployed under TUnitRuntime\." />
    <Error Condition="!Exists('$(TargetDir)TUnitRuntime\TUnit.Engine.dll')"
           Text="TUnit.Engine.dll must be deployed under TUnitRuntime\." />
    <Error Condition="!Exists('$(TargetDir)TUnitRuntime\Microsoft.Testing.Platform.dll')"
           Text="Microsoft.Testing.Platform.dll must be deployed under TUnitRuntime\ when TUnit.Engine runs in-host." />
    <Error Condition="Exists('$(TargetDir)TUnit.Core.dll') OR Exists('$(TargetDir)TUnit.Engine.dll') OR Exists('$(TargetDir)Microsoft.Testing.Platform.dll')"
           Text="TUnit and MTP assemblies must not be copied at the add-in root." />
  </Target>
</Project>
