<Project>
  <Target Name="PrepareTUnitRuntimePayload"
          AfterTargets="Build"
          Condition="'$(TargetPath)' != '' AND '$(TargetDir)' != ''">
    <PropertyGroup>
      <_TUnitRuntimeOutputDir>$([System.IO.Path]::GetFullPath('$(TargetDir)'))</_TUnitRuntimeOutputDir>
      <_TUnitRuntimePayloadDir>$([System.IO.Path]::Combine('$(_TUnitRuntimeOutputDir)', 'TUnitRuntimePayload'))</_TUnitRuntimePayloadDir>
    </PropertyGroup>
    <ItemGroup>
      <_TUnitRuntimePayload Include="$(_TUnitRuntimeOutputDir)*.dll" />
      <_TUnitRuntimePayload Include="$(_TUnitRuntimeOutputDir)$(TargetName).pdb"
                            Condition="Exists('$(_TUnitRuntimeOutputDir)$(TargetName).pdb')" />
    </ItemGroup>

    <Error Condition="!Exists('$(_TUnitRuntimeOutputDir)TUnit.Core.dll')"
           Text="TUnit runtime payload requires TUnit.Core.dll under '$(_TUnitRuntimeOutputDir)'." />
    <Error Condition="!Exists('$(_TUnitRuntimeOutputDir)TUnit.Engine.dll')"
           Text="TUnit runtime payload requires TUnit.Engine.dll under '$(_TUnitRuntimeOutputDir)'." />
    <Error Condition="!Exists('$(_TUnitRuntimeOutputDir)Microsoft.Testing.Platform.dll')"
           Text="TUnit runtime payload requires Microsoft.Testing.Platform.dll under '$(_TUnitRuntimeOutputDir)'." />

    <RemoveDir Directories="$(_TUnitRuntimePayloadDir)" Condition="Exists('$(_TUnitRuntimePayloadDir)')" />
    <MakeDir Directories="$(_TUnitRuntimePayloadDir)" />
    <Copy SourceFiles="@(_TUnitRuntimePayload)"
          DestinationFolder="$(_TUnitRuntimePayloadDir)"
          SkipUnchangedFiles="false" />
  </Target>

  <Target Name="GetTUnitRuntimePayload"
          DependsOnTargets="Build"
          Returns="@(TUnitRuntimePayloadFile)"
          Condition="'$(TargetPath)' != '' AND '$(TargetDir)' != ''">
    <PropertyGroup>
      <_TUnitRuntimeOutputDir>$([System.IO.Path]::GetFullPath('$(TargetDir)'))</_TUnitRuntimeOutputDir>
      <_TUnitRuntimePayloadDir>$([System.IO.Path]::Combine('$(_TUnitRuntimeOutputDir)', 'TUnitRuntimePayload'))</_TUnitRuntimePayloadDir>
    </PropertyGroup>
    <ItemGroup>
      <TUnitRuntimePayloadFile Include="$(_TUnitRuntimePayloadDir)\*.*" />
    </ItemGroup>
  </Target>
</Project>
