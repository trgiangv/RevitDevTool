<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFrameworks>net48;net8.0-windows;net10.0-windows</TargetFrameworks>
    <RootNamespace>DevTools.TUnit.Runtime</RootNamespace>
    <AssemblyName>DevTools.TUnit.Runtime</AssemblyName>
    <IsPackable>false</IsPackable>
    <IsTestProject>false</IsTestProject>
    <IsTestingPlatformApplication>false</IsTestingPlatformApplication>
    <OutputType>Library</OutputType>
    <EnableTUnitPolyfills>false</EnableTUnitPolyfills>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="TUnit.Core" PrivateAssets="all" />
    <PackageReference Include="TUnit.Engine">
      <ExcludeAssets>build;buildTransitive;analyzers</ExcludeAssets>
    </PackageReference>
  </ItemGroup>

  <ItemGroup>
        <ProjectReference Include="..\DevTools.Testing.Abstractions\DevTools.Testing.Abstractions.csproj"
                      Private="false" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="DevTools.TUnit.Runtime.Tests" />
  </ItemGroup>

  <!-- net48 TUnit.Core/Engine n2.0 bind STJ 9. -->
  <ItemGroup Condition="'$(TargetFrameworkIdentifier)' == '.NETFramework'">
    <PackageReference Include="System.Text.Json" VersionOverride="9.0.0" />
    <PackageReference Include="Microsoft.Bcl.AsyncInterfaces" VersionOverride="9.0.0" />
  </ItemGroup>

  <Import Project="build\TUnitRuntimePayload.targets" />
</Project>
