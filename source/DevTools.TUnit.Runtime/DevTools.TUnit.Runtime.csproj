<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFrameworks>net48;net8.0-windows;net10.0-windows</TargetFrameworks>
    <RootNamespace>DevTools.TUnit.Runtime</RootNamespace>
    <AssemblyName>DevTools.TUnit.Runtime</AssemblyName>
    <IsPackable>false</IsPackable>
    <IsTestProject>false</IsTestProject>
    <IsTestingPlatformApplication>false</IsTestingPlatformApplication>
    <OutputType>Library</OutputType>
    <EnableTUnitPolyfills>false</EnableTUnitPolyfills>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="TUnit.Core" PrivateAssets="all" />
    <PackageReference Include="TUnit.Engine">
      <ExcludeAssets>build;buildTransitive;analyzers</ExcludeAssets>
    </PackageReference>
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\DevTools.Testing.Abstractions\DevTools.Testing.Abstractions.csproj"
                      Private="false" />
  </ItemGroup>

  <!-- TUnit's netstandard assemblies reference STJ 9 while current MTP tooling
       uses STJ 10. Keep both exact closures for manifest-based host loading. -->
  <ItemGroup Condition="'$(TargetFrameworkIdentifier)' == '.NETFramework'">
    <PackageDownload Include="Microsoft.Bcl.AsyncInterfaces" Version="[9.0.0]" />
    <PackageDownload Include="System.Buffers" Version="[4.5.1]" />
    <PackageDownload Include="System.IO.Pipelines" Version="[9.0.0]" />
    <PackageDownload Include="System.Memory" Version="[4.5.5]" />
    <PackageDownload Include="System.Runtime.CompilerServices.Unsafe" Version="[6.0.0]" />
    <PackageDownload Include="System.Text.Encodings.Web" Version="[9.0.0]" />
    <PackageDownload Include="System.Text.Json" Version="[9.0.0]" />
    <PackageDownload Include="System.Threading.Tasks.Extensions" Version="[4.5.4]" />
    <PackageDownload Include="System.ValueTuple" Version="[4.5.0]" />
  </ItemGroup>

  <Import Project="build\TUnitRuntimePayload.targets" />
</Project>
