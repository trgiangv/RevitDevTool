<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFrameworks>net48;net8.0-windows;net10.0-windows</TargetFrameworks>
    <RootNamespace>DevTools.TUnit.Runtime</RootNamespace>
    <AssemblyName>DevTools.TUnit.Runtime</AssemblyName>
    <IsPackable>false</IsPackable>
    <IsTestProject>false</IsTestProject>
    <IsTestingPlatformApplication>false</IsTestingPlatformApplication>
    <OutputType>Library</OutputType>
    <EnableTUnitPolyfills>false</EnableTUnitPolyfills>
    <RuntimeManifestFramework>TUnit</RuntimeManifestFramework>
    <RuntimeManifestEntry>DevTools.TUnit.Runtime.TUnitRuntimeSession</RuntimeManifestEntry>
    <RuntimeManifestAssembly>TUnit.Core</RuntimeManifestAssembly>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="TUnit.Core" PrivateAssets="all" />
    <PackageReference Include="TUnit.Engine">
      <ExcludeAssets>build;buildTransitive;analyzers</ExcludeAssets>
    </PackageReference>
  </ItemGroup>

  <ItemGroup>
        <ProjectReference Include="..\DevTools.Testing.Abstractions\DevTools.Testing.Abstractions.csproj"
                      Private="false" />
  </ItemGroup>

  <ItemGroup>
    <Compile Include="..\DevTools.MSTest.Runtime\MtpNodeResults.cs" Link="MtpNodeResults.cs" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="DevTools.TUnit.Runtime.Tests" />
  </ItemGroup>

  <Import Project="..\..\props\TestingRuntime.targets" />
</Project>
