<UserControl x:Class="DevTools.Daemon.Dashboard.Views.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:dashboard="clr-namespace:DevTools.Daemon.Dashboard"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             d:DataContext="{d:DesignInstance dashboard:DashboardViewModel}"
             d:DesignHeight="400"
             d:DesignWidth="600"
             mc:Ignorable="d">
    <StackPanel Margin="16">
        <TextBlock Margin="0,0,0,8"
                   FontSize="16"
                   FontWeight="SemiBold"
                   Text="Appearance" />
        <ComboBox Width="140"
                  Margin="0,0,0,24"
                  HorizontalAlignment="Left"
                  ItemsSource="{Binding Themes, Mode=OneTime}"
                  SelectedItem="{Binding Theme}" />

        <TextBlock Margin="0,0,0,8"
                   FontSize="16"
                   FontWeight="SemiBold"
                   Text="Startup" />
        <CheckBox Margin="0,0,0,24"
                  Content="Start DevTools Daemon at login"
                  IsChecked="{Binding AutoStartEnabled, Mode=TwoWay}" />

        <TextBlock Margin="0,0,0,8"
                   FontSize="16"
                   FontWeight="SemiBold"
                   Text="About" />
        <TextBlock Text="{Binding Version, StringFormat=Version {0}}" />
    </StackPanel>
</UserControl>
