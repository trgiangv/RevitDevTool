<UserControl x:Class="DevTools.Daemon.Dashboard.Views.HostsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:dashboard="clr-namespace:DevTools.Daemon.Dashboard"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance dashboard:DashboardViewModel}">
    <Grid Margin="16">
        <DataGrid AutoGenerateColumns="False"
                  CanUserAddRows="False"
                  CanUserDeleteRows="False"
                  HeadersVisibility="Column"
                  IsReadOnly="True"
                  ItemsSource="{Binding Hosts}">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Host"
                                    Binding="{Binding Host}"
                                    Width="*" />
                <DataGridTextColumn Header="Version"
                                    Binding="{Binding Version}"
                                    Width="*" />
                <DataGridTextColumn Header="PID"
                                    Binding="{Binding Pid}"
                                    Width="80" />
                <DataGridTextColumn Header="Status"
                                    Binding="{Binding Status}"
                                    Width="120" />
            </DataGrid.Columns>
        </DataGrid>

        <TextBlock HorizontalAlignment="Center"
                   VerticalAlignment="Center"
                   Opacity="0.6"
                   Text="No host instances discovered."
                   TextWrapping="Wrap">
            <TextBlock.Style>
                <Style TargetType="TextBlock">
                    <Setter Property="Visibility" Value="Collapsed" />
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding Hosts.Count}" Value="0">
                            <Setter Property="Visibility" Value="Visible" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </TextBlock.Style>
        </TextBlock>
    </Grid>
</UserControl>
