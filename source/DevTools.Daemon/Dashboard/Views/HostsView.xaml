<UserControl x:Class="DevTools.Daemon.Dashboard.Views.HostsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:dashboard="clr-namespace:DevTools.Daemon.Dashboard"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             d:DataContext="{d:DesignInstance dashboard:DashboardViewModel}"
             d:DesignHeight="400"
             d:DesignWidth="600"
             mc:Ignorable="d">
    <Grid Margin="16">
        <DataGrid AutoGenerateColumns="False"
                  CanUserAddRows="False"
                  CanUserDeleteRows="False"
                  HeadersVisibility="Column"
                  IsReadOnly="True"
                  ItemsSource="{Binding Hosts}">
            <DataGrid.Columns>
                <DataGridTextColumn Width="*"
                                    Binding="{Binding Host}"
                                    Header="Host" />
                <DataGridTextColumn Width="*"
                                    Binding="{Binding Version}"
                                    Header="Version" />
                <DataGridTextColumn Width="80"
                                    Binding="{Binding Pid}"
                                    Header="PID" />
                <DataGridTextColumn Width="120"
                                    Binding="{Binding Status}"
                                    Header="Status" />
            </DataGrid.Columns>
        </DataGrid>

        <TextBlock HorizontalAlignment="Center"
                   VerticalAlignment="Center"
                   Opacity="0.6"
                   Text="No host instances discovered."
                   TextWrapping="Wrap">
            <TextBlock.Style>
                <Style TargetType="TextBlock">
                    <Setter Property="Visibility" Value="Collapsed" />
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding Hosts.Count}"
                                     Value="0">
                            <Setter Property="Visibility" Value="Visible" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </TextBlock.Style>
        </TextBlock>
    </Grid>
</UserControl>
