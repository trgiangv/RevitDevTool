<UserControl x:Class="DevTools.Daemon.Dashboard.Views.OverviewView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:dashboard="clr-namespace:DevTools.Daemon.Dashboard"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             d:DataContext="{d:DesignInstance dashboard:DashboardViewModel}"
             d:DesignHeight="400"
             d:DesignWidth="600"
             mc:Ignorable="d">
    <StackPanel Margin="16">
        <TextBlock Margin="0,0,0,8"
                   FontSize="16"
                   FontWeight="SemiBold"
                   Text="Account" />

        <StackPanel Margin="0,0,0,8"
                    Orientation="Horizontal">
            <StackPanel.Style>
                <Style TargetType="StackPanel">
                    <Setter Property="Visibility" Value="Collapsed" />
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding IsAuthenticated}"
                                     Value="True">
                            <Setter Property="Visibility" Value="Visible" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </StackPanel.Style>
            <Image Width="48"
                   Height="48"
                   Margin="0,0,12,0"
                   Source="{Binding AvatarImage}"
                   Stretch="UniformToFill" />
            <StackPanel VerticalAlignment="Center">
                <TextBlock FontWeight="SemiBold"
                           Text="{Binding DisplayName}" />
                <TextBlock Opacity="0.75"
                           Text="{Binding Email}" />
            </StackPanel>
        </StackPanel>

        <StackPanel Margin="0,0,0,8">
            <StackPanel.Style>
                <Style TargetType="StackPanel">
                    <Setter Property="Visibility" Value="Collapsed" />
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding IsAuthenticated}"
                                     Value="False">
                            <Setter Property="Visibility" Value="Visible" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </StackPanel.Style>
            <TextBlock Margin="0,0,0,8"
                       Text="Not signed in" />
            <Button HorizontalAlignment="Left"
                    Command="{Binding SignInCommand}"
                    Content="Sign In" />
        </StackPanel>

        <TextBlock Margin="0,24,0,8"
                   FontSize="16"
                   FontWeight="SemiBold"
                   Text="Gateway" />
        <TextBlock Text="{Binding GatewayStatus}" />

        <TextBlock Margin="0,24,0,8"
                   FontSize="16"
                   FontWeight="SemiBold"
                   Text="Connected Hosts" />
        <TextBlock>
            <Run Text="{Binding HostCount, Mode=OneWay}" />
            <Run Text=" host(s)" />
        </TextBlock>
    </StackPanel>
</UserControl>
