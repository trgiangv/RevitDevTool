<UserControl x:Class="DevTools.Daemon.Dashboard.Views.OverviewView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:dashboard="clr-namespace:DevTools.Daemon.Dashboard"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance dashboard:DashboardViewModel}">
    <StackPanel Margin="16">
        <TextBlock Text="Account"
                   FontSize="16"
                   FontWeight="SemiBold"
                   Margin="0,0,0,8" />

        <StackPanel Orientation="Horizontal"
                    Margin="0,0,0,8">
            <StackPanel.Style>
                <Style TargetType="StackPanel">
                    <Setter Property="Visibility" Value="Collapsed" />
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding IsAuthenticated}" Value="True">
                            <Setter Property="Visibility" Value="Visible" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </StackPanel.Style>
            <Image Source="{Binding AvatarImage}"
                   Width="48"
                   Height="48"
                   Margin="0,0,12,0"
                   Stretch="UniformToFill" />
            <StackPanel VerticalAlignment="Center">
                <TextBlock Text="{Binding DisplayName}"
                           FontWeight="SemiBold" />
                <TextBlock Text="{Binding Email}"
                           Opacity="0.75" />
            </StackPanel>
        </StackPanel>

        <StackPanel Margin="0,0,0,8">
            <StackPanel.Style>
                <Style TargetType="StackPanel">
                    <Setter Property="Visibility" Value="Collapsed" />
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding IsAuthenticated}" Value="False">
                            <Setter Property="Visibility" Value="Visible" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </StackPanel.Style>
            <TextBlock Text="Not signed in"
                       Margin="0,0,0,8" />
            <Button Content="Sign In"
                    HorizontalAlignment="Left"
                    Command="{Binding SignInCommand}" />
        </StackPanel>

        <TextBlock Text="Gateway"
                   FontSize="16"
                   FontWeight="SemiBold"
                   Margin="0,24,0,8" />
        <TextBlock Text="{Binding GatewayStatus}" />

        <TextBlock Text="Connected Hosts"
                   FontSize="16"
                   FontWeight="SemiBold"
                   Margin="0,24,0,8" />
        <TextBlock>
            <Run Text="{Binding HostCount, Mode=OneWay}" />
            <Run Text=" host(s)" />
        </TextBlock>
    </StackPanel>
</UserControl>
