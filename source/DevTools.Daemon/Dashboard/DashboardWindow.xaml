<Window x:Class="DevTools.Daemon.Dashboard.DashboardWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:DevTools.Daemon.Dashboard.Views"
        Title="DevTools Daemon"
        Icon="pack://application:,,,/DevTools.UI;component/Resources/icons/DevTools-32-Light.ico"
        Width="700"
        Height="500"
        MinWidth="500"
        MinHeight="400"
        Background="{DynamicResource DevTools.MahApps.Brushes.ThemeBackground}"
        ShowInTaskbar="True"
        WindowStartupLocation="CenterScreen">
    <TabControl Margin="8"
                SelectedIndex="{Binding SelectedTabIndex, Mode=TwoWay}">
        <TabItem Header="Overview">
            <views:OverviewView />
        </TabItem>
        <TabItem Header="Hosts">
            <views:HostsView />
        </TabItem>
        <TabItem Header="Settings">
            <views:SettingsView />
        </TabItem>
    </TabControl>
</Window>
