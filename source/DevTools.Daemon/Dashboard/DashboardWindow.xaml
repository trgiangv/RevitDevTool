<Window x:Class="DevTools.Daemon.Dashboard.DashboardWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:dashboard="clr-namespace:DevTools.Daemon.Dashboard"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:views="clr-namespace:DevTools.Daemon.Dashboard.Views"
        Title="DevTools Daemon"
        Width="700"
        Height="500"
        MinWidth="500"
        MinHeight="400"
        d:DataContext="{d:DesignInstance dashboard:DashboardViewModel}"
        Background="{DynamicResource DevTools.MahApps.Brushes.ThemeBackground}"
        Icon="pack://application:,,,/DevTools.UI;component/Resources/icons/DevTools-32-Light.ico"
        ShowInTaskbar="True"
        WindowStartupLocation="CenterScreen"
        mc:Ignorable="d">
    <TabControl Margin="8"
                SelectedIndex="{Binding SelectedTabIndex, Mode=TwoWay}">
        <TabItem Header="Overview">
            <views:OverviewView />
        </TabItem>
        <TabItem Header="Hosts">
            <views:HostsView />
        </TabItem>
        <TabItem Header="Settings">
            <views:SettingsView />
        </TabItem>
    </TabControl>
</Window>
