<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
                    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                    xmlns:tb="http://www.hardcodet.net/taskbar"
                    xmlns:views="clr-namespace:DevTools.Daemon.Views"
                    mc:Ignorable="d">

    <ContextMenu x:Key="TrayMenu"
                 d:DataContext="{d:DesignInstance views:TrayMenu}"
                 x:Shared="false">
        <MenuItem Margin="0,5,0,0"
                  Command="{Binding OpenDashboardCommand}"
                  FontWeight="Bold"
                  Header="Dashboard" />
        <Separator />
        <MenuItem Command="{Binding SignInCommand}"
                  Header="Sign In" />
        <MenuItem Command="{Binding SignOutCommand}"
                  Header="Sign Out" />
        <Separator />
        <MenuItem Margin="0,0,0,5"
                  Command="{Binding ExitApplicationCommand}"
                  Header="Quit" />
    </ContextMenu>

    <tb:TaskbarIcon x:Key="TrayIcon"
                    d:DataContext="{d:DesignInstance views:TrayMenu}"
                    ContextMenu="{StaticResource TrayMenu}"
                    LeftClickCommand="{Binding OpenDashboardCommand}"
                    NoLeftClickDelay="True"
                    ToolTipText="{Binding StatusText}" />

</ResourceDictionary>
