<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
                    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                    xmlns:views="clr-namespace:DevTools.Daemon.Views"
                    mc:Ignorable="d">

    <ContextMenu x:Key="TrayMenu"
                 x:Shared="False"
                 d:DataContext="{d:DesignInstance views:TrayMenu}">
        <MenuItem Margin="0,4,0,0"
                  Command="{Binding OpenDashboardCommand}"
                  FontWeight="SemiBold"
                  Header="Dashboard" />
        <Separator />
        <MenuItem Command="{Binding SignInCommand}"
                  Header="Sign In" />
        <MenuItem Command="{Binding SignOutCommand}"
                  Header="Sign Out" />
        <Separator />
        <MenuItem Margin="0,0,0,4"
                  Command="{Binding ExitApplicationCommand}"
                  Header="Quit" />
    </ContextMenu>

</ResourceDictionary>
