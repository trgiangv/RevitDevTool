<Window x:Class="DevTools.Daemon.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:desktop="clr-namespace:DevTools.Daemon.Desktop"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:views="clr-namespace:DevTools.Daemon.Views"
        Title="DevTools Daemon"
        Width="400"
        Height="400"
        MinWidth="300"
        MinHeight="300"
        d:DataContext="{d:DesignInstance desktop:AppState}"
        ShowInTaskbar="True"
        WindowStartupLocation="CenterScreen"
        mc:Ignorable="d">
    <TabControl Margin="5"
                SelectedIndex="{Binding SelectedTabIndex, Mode=TwoWay}">
        <TabItem Header="Overview">
            <views:OverviewView />
        </TabItem>
        <TabItem Header="Hosts">
            <views:HostsView />
        </TabItem>
        <TabItem Header="Settings">
            <views:SettingsView />
        </TabItem>
    </TabControl>
</Window>
