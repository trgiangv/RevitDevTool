<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
                    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                    xmlns:tb="http://www.hardcodet.net/taskbar"
                    xmlns:tray="clr-namespace:DevTools.Daemon.Tray"
                    mc:Ignorable="d">

    <BooleanToVisibilityConverter x:Key="BoolToVis" />

    <ContextMenu x:Key="TrayMenu" x:Shared="false"
                 d:DataContext="{d:DesignInstance tray:TrayViewModel}">
        <MenuItem Header="Dashboard" Command="{Binding OpenDashboardCommand}" FontWeight="Bold" />
        <Separator />
        <MenuItem Header="Sign In" Command="{Binding SignInCommand}" />
        <MenuItem Header="Sign Out" Command="{Binding SignOutCommand}" />
        <Separator />
        <MenuItem Header="Quit" Command="{Binding ExitApplicationCommand}" />
    </ContextMenu>

    <tb:TaskbarIcon x:Key="TrayIcon"
                    d:DataContext="{d:DesignInstance tray:TrayViewModel}"
                    IconSource="{Binding TrayIconSource}"
                    ToolTipText="{Binding StatusText}"
                    LeftClickCommand="{Binding OpenDashboardCommand}"
                    NoLeftClickDelay="True"
                    ContextMenu="{StaticResource TrayMenu}" />

</ResourceDictionary>
