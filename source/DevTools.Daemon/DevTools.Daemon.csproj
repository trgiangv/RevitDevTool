<Project Sdk="Microsoft.NET.Sdk">

    <!--
          Build (dev):   dotnet build
          Publish:       dotnet publish -c Release  → single-file exe (requires .NET 10 runtime)

          Usage:
              DevTools.Daemon.exe            desktop app (single-instance, gateway, control pipe, UI)
              DevTools.Daemon.exe - -stdio    MCP server on stdin/stdout (independent process)
    -->

    <PropertyGroup>
        <OutputType>WinExe</OutputType>
        <TargetFramework>net10.0-windows</TargetFramework>
        <RuntimeIdentifier>win-x64</RuntimeIdentifier>
        <Nullable>enable</Nullable>
        <ImplicitUsings>enable</ImplicitUsings>
        <RootNamespace>DevTools.Daemon</RootNamespace>
        <AssemblyName>DevTools.Daemon</AssemblyName>
        <StartupObject>DevTools.Daemon.Program</StartupObject>
        <ApplicationIcon>..\DevTools.UI\Resources\icons\DevTools-32-Dark.ico</ApplicationIcon>
        <SelfContained>false</SelfContained>
        <PublishSingleFile>true</PublishSingleFile>
        <MewUIBackend>Direct2D</MewUIBackend>
    </PropertyGroup>

    <PropertyGroup>
        <BundleContentsFolder>$(AppData)\Autodesk\ApplicationPlugins\RevitDevTool.bundle\Contents</BundleContentsFolder>
    </PropertyGroup>

    <PropertyGroup Condition="$(Configuration.Contains('Release'))">
        <DebugType>none</DebugType>
        <DebugSymbols>false</DebugSymbols>
    </PropertyGroup>

    <Target Name="DeployDevToolsDaemon" AfterTargets="Publish">
        <Exec Command="taskkill /F /IM DevTools.Daemon.exe 2>nul &amp; ping -n 2 127.0.0.1 >nul" IgnoreExitCode="true"/>
        <MakeDir Directories="$(BundleContentsFolder)"/>
        <Copy SourceFiles="$(PublishDir)DevTools.Daemon.exe" DestinationFolder="$(BundleContentsFolder)" OverwriteReadOnlyFiles="true" Retries="3" RetryDelayMilliseconds="1000"/>
        <Copy SourceFiles="appsettings.development.json" DestinationFolder="$(BundleContentsFolder)" Condition="Exists('appsettings.development.json')" OverwriteReadOnlyFiles="true"/>
    </Target>
    <ItemGroup>
        <PackageReference Include="H.NotifyIcon"/>
        <PackageReference Include="Aprillz.MewUI.Windows"/>
        <PackageReference Include="System.Security.Cryptography.ProtectedData"/>
        <PackageReference Include="ModelContextProtocol"/>
        <PackageReference Include="ModelContextProtocol.Extensions.Tasks"/>
        <PackageReference Include="Duende.IdentityModel.OidcClient"/>
        <PackageReference Include="ZLogger"/>
        <PackageReference Include="Microsoft.Extensions.Hosting"/>
    </ItemGroup>
    <ItemGroup>
        <EmbeddedResource Include="appsettings.json" LogicalName="appsettings.json"/>
        <EmbeddedResource Include="..\DevTools.UI\Resources\icons\DevTools-32-Dark.ico" LogicalName="DevTools.Daemon.Icons.Dark.ico"/>
        <EmbeddedResource Include="..\DevTools.UI\Resources\icons\DevTools-32-Light.ico" LogicalName="DevTools.Daemon.Icons.Light.ico"/>
    </ItemGroup>
    <ItemGroup>
        <ProjectReference Include="..\DevTools.Settings\DevTools.Settings.csproj"/>
        <ProjectReference Include="..\DevTools.Utilities\DevTools.Utilities.csproj"/>
        <ProjectReference Include="..\DevTools.Ipc\DevTools.Ipc.csproj"/>
        <ProjectReference Include="..\DevTools.Mcp.Core\DevTools.Mcp.Core.csproj" SetTargetFramework="TargetFramework=$(TargetFramework)" />
        <ProjectReference Include="..\DevTools.Mcp.Catalog\DevTools.Mcp.Catalog.csproj" SetTargetFramework="TargetFramework=$(TargetFramework)" />
        <ProjectReference Include="..\DevTools.Mcp.Client\DevTools.Mcp.Client.csproj" SetTargetFramework="TargetFramework=$(TargetFramework)" />
        <ProjectReference Include="..\DevTools.Mcp.Server\DevTools.Mcp.Server.csproj" SetTargetFramework="TargetFramework=$(TargetFramework)" />
        <ProjectReference Include="..\DevTools.FileMetadata.Core\DevTools.FileMetadata.Core.csproj" SetTargetFramework="TargetFramework=$(TargetFramework)" />
        <ProjectReference Include="..\DevTools.FileMetadata.Revit\DevTools.FileMetadata.Revit.csproj" SetTargetFramework="TargetFramework=$(TargetFramework)" />
        <ProjectReference Include="..\DevTools.FileMetadata.Acad\DevTools.FileMetadata.Acad.csproj" SetTargetFramework="TargetFramework=$(TargetFramework)" />
        <ProjectReference Include="..\DevTools.Hosting\DevTools.Hosting.csproj"/>
        <ProjectReference Include="..\DevTools.Hosting.Revit\DevTools.Hosting.Revit.csproj"/>
        <ProjectReference Include="..\DevTools.Hosting.Acad\DevTools.Hosting.Acad.csproj"/>
    </ItemGroup>
</Project>
