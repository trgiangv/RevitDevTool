<UserControl x:Class="DevTools.Daemon.Desktop.Views.UpdatesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:desktop="clr-namespace:DevTools.Daemon.Desktop.ViewModels"
             xmlns:hc="https://handyorg.github.io/handycontrol"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:updates="clr-namespace:DevTools.Daemon.Desktop.Updates"
             d:DataContext="{d:DesignInstance desktop:ShellViewModel}"
             d:DesignHeight="400"
             d:DesignWidth="400"
             mc:Ignorable="d">
    <Grid Margin="5">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock Margin="0,0,0,8"
                   Foreground="{DynamicResource PrimaryTextBrush}"
                   Text="{Binding Updater.Status}"
                   TextWrapping="Wrap"
                   Visibility="{Binding Updater.Status, Converter={StaticResource String2VisibilityConverter}}" />

        <ListBox Grid.Row="1"
                 HorizontalContentAlignment="Stretch"
                 Grid.IsSharedSizeScope="True"
                 ItemsSource="{Binding Updater.Rows}"
                 SelectionMode="Single">
            <ListBox.ItemContainerStyle>
                <Style BasedOn="{StaticResource ListBoxItemBaseStyle}" TargetType="ListBoxItem">
                    <Setter Property="IsEnabled" Value="{Binding CanSelect}" />
                </Style>
            </ListBox.ItemContainerStyle>
            <ListBox.ItemTemplate>
                <DataTemplate DataType="updates:TargetRow">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" SharedSizeGroup="Installed" />
                            <ColumnDefinition Width="Auto" SharedSizeGroup="Latest" />
                        </Grid.ColumnDefinitions>
                        <CheckBox IsChecked="{Binding IsSelected, Mode=TwoWay}" Style="{StaticResource CheckBoxBaseStyle}" />
                        <TextBlock Grid.Row="0"
                                   Grid.Column="1"
                                   Margin="8,0,0,0"
                                   VerticalAlignment="Center"
                                   Text="{Binding Description}"
                                   ToolTip="{Binding HostTip}" />
                        <hc:Badge Grid.Row="0"
                                  Grid.Column="2"
                                  Margin="0,0,10,0"
                                  HorizontalAlignment="Left"
                                  VerticalAlignment="Center"
                                  ShowBadge="{Binding IsPending}"
                                  Status="Processing"
                                  Style="{StaticResource BadgeWarning}"
                                  Visibility="{Binding Installed, Converter={StaticResource String2VisibilityConverter}}">
                            <Label Content="{Binding Installed}"
                                   Style="{StaticResource LabelSuccess.Small}"
                                   ToolTip="{Binding PendingTip, TargetNullValue=Installed}" />
                        </hc:Badge>
                        <hc:Badge Grid.Row="0"
                                  Grid.Column="3"
                                  HorizontalAlignment="Left"
                                  VerticalAlignment="Center"
                                  ShowBadge="{Binding HasUpdate}"
                                  Status="Dot"
                                  Style="{StaticResource BadgeDanger}">
                            <Label Content="{Binding Latest}"
                                   Style="{StaticResource LabelPrimary.Small}"
                                   ToolTip="Latest" />
                        </hc:Badge>
                        <ProgressBar Grid.Row="1"
                                     Grid.Column="1"
                                     Grid.ColumnSpan="3"
                                     Margin="8,4,0,0"
                                     IsIndeterminate="{Binding IsIndeterminate}"
                                     Style="{StaticResource ProgressBarFlat}"
                                     ToolTip="{Binding ProgressTip}"
                                     Visibility="{Binding IsWorking, Converter={StaticResource Boolean2VisibilityConverter}}"
                                     Value="{Binding Percent}" />
                    </Grid>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>

        <StackPanel Grid.Row="2" Margin="0,12,0,0">
            <CheckBox Content="Install updates automatically"
                      IsChecked="{Binding Updater.AutoUpdate, Mode=TwoWay}"
                      Style="{StaticResource CheckBoxBaseStyle}" />
            <CheckBox Margin="0,8,0,0"
                      Content="Include pre-releases"
                      IsChecked="{Binding Updater.IncludePrereleases, Mode=TwoWay}"
                      Style="{StaticResource CheckBoxBaseStyle}" />
        </StackPanel>

        <StackPanel Grid.Row="3"
                    Margin="0,12,0,0"
                    HorizontalAlignment="Right"
                    Orientation="Horizontal">
            <Button Margin="0,0,8,0"
                    Command="{Binding Updater.CheckForUpdatesCommand}"
                    Content="Check for updates"
                    Style="{StaticResource ButtonDefault}" />
            <hc:ProgressButton MinWidth="140"
                               hc:StatusSwitchElement.CheckedElement="{Binding Updater.ProgressText}"
                               hc:StatusSwitchElement.HideUncheckedElement="True"
                               Command="{Binding Updater.InstallCommand}"
                               Content="Update"
                               IsChecked="{Binding Updater.IsInstalling, Mode=OneWay}"
                               IsHitTestVisible="{Binding Updater.IsInstalling, Converter={StaticResource Boolean2BooleanReConverter}}"
                               Progress="{Binding Updater.Progress}"
                               Style="{StaticResource ProgressButtonPrimary}" />
        </StackPanel>
    </Grid>
</UserControl>
