<Project>
  <PropertyGroup>
    <DevToolsNUnitTestAdapterPropsImported>true</DevToolsNUnitTestAdapterPropsImported>
    <!-- Host targeting (HostName, HostVersion, …) must be declared in the test project. -->
    <HostLaunch Condition="'$(HostLaunch)' == ''">false</HostLaunch>
    <HostTimeout Condition="'$(HostTimeout)' == ''">60</HostTimeout>
    <HostLaunchTimeout Condition="'$(HostLaunchTimeout)' == ''">180</HostLaunchTimeout>
    <!-- Use $(Configuration), not $(IntermediateOutputPath): props import before SDK finalizes intermediate paths. -->
    <_DevToolsNUnitConfig Condition="'$(Configuration)' != ''">$(Configuration)</_DevToolsNUnitConfig>
    <_DevToolsNUnitConfig Condition="'$(_DevToolsNUnitConfig)' == ''">Debug</_DevToolsNUnitConfig>
    <DevToolsNUnitGeneratedRunSettingsRelPath>obj\$(_DevToolsNUnitConfig)\DevTools.NUnit.generated.runsettings</DevToolsNUnitGeneratedRunSettingsRelPath>
    <DevToolsNUnitGeneratedRunSettingsPath>$([System.IO.Path]::GetFullPath('$(MSBuildProjectDirectory)\$(DevToolsNUnitGeneratedRunSettingsRelPath)'))</DevToolsNUnitGeneratedRunSettingsPath>
    <RunSettingsFilePath>$(DevToolsNUnitGeneratedRunSettingsPath)</RunSettingsFilePath>
  </PropertyGroup>
</Project>
