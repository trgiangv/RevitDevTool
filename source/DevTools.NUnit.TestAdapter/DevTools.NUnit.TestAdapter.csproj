<Project Sdk="Microsoft.NET.Sdk">
    <PropertyGroup>
        <TargetFramework>netstandard2.0</TargetFramework>
        <RootNamespace>DevTools.NUnit.TestAdapter</RootNamespace>
        <AssemblyName>DevTools.NUnit.TestAdapter</AssemblyName>
        <PackageId>DevTools.NUnit.TestAdapter</PackageId>
        <IsPackable>true</IsPackable>
        <DevelopmentDependency>true</DevelopmentDependency>
        <Description>VSTest adapter for running NUnit tests inside Revit/AutoCAD hosts.</Description>
        <CopyLocalLockFileAssemblies>true</CopyLocalLockFileAssemblies>
        <EnableDynamicLoading>false</EnableDynamicLoading>
        <SuppressDependenciesWhenPacking>true</SuppressDependenciesWhenPacking>
        <ILRepackable>true</ILRepackable>
        <ILRepackInternalize>true</ILRepackInternalize>
        <!--
          Never merge (stay external to the repacked adapter):
          Microsoft.TestPlatform.* / ObjectModel — loaded by VSTest testhost;
          merging breaks adapter reflection.
        -->
        <RepackBinariesExcludes>
            Microsoft.TestPlatform.CoreUtilities.dll;
            Microsoft.TestPlatform.PlatformAbstractions.dll;
            Microsoft.VisualStudio.TestPlatform.ObjectModel.dll
        </RepackBinariesExcludes>
    </PropertyGroup>

    <ItemGroup>
        <Using Include="DevTools.Ipc"/>
    </ItemGroup>

    <ItemGroup>
        <None Include="build\DevTools.NUnit.TestAdapter.props" Pack="true" PackagePath="build\"/>
        <None Include="build\DevTools.NUnit.TestAdapter.targets" Pack="true" PackagePath="build\"/>
    </ItemGroup>

    <ItemGroup>
        <!-- Compile-only: testhost supplies the platform assemblies at runtime. -->
        <PackageReference Include="Microsoft.TestPlatform.ObjectModel">
            <ExcludeAssets>runtime</ExcludeAssets>
        </PackageReference>
        <!-- Merged into DevTools.NUnit.TestAdapter.dll via ILRepack (no satellite DLLs shipped). -->
        <PackageReference Include="System.Text.Json">
            <PrivateAssets>all</PrivateAssets>
        </PackageReference>
        <PackageReference Include="System.Reflection.Metadata">
            <PrivateAssets>all</PrivateAssets>
        </PackageReference>
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="..\DevTools.NUnit.Provider\DevTools.NUnit.Provider.csproj"/>
        <ProjectReference Include="..\DevTools.Testing.Abstractions\DevTools.Testing.Abstractions.csproj"/>
        <ProjectReference Include="..\DevTools.Testing.Transport\DevTools.Testing.Transport.csproj"/>
    </ItemGroup>

</Project>
