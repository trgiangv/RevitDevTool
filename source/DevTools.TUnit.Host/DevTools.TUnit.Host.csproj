<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFrameworks>net48;net8.0-windows</TargetFrameworks>
    <RootNamespace>DevTools.TUnit.Host</RootNamespace>
    <AssemblyName>DevTools.TUnit.Host</AssemblyName>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\DevTools.AssemblyIsolation\DevTools.AssemblyIsolation.csproj" />
    <ProjectReference Include="..\DevTools.Testing.Abstractions\DevTools.Testing.Abstractions.csproj" />
    <ProjectReference Include="..\DevTools.Testing.Host\DevTools.Testing.Host.csproj" />
    <ProjectReference Include="..\DevTools.TUnit.Runtime\DevTools.TUnit.Runtime.csproj"
                      ReferenceOutputAssembly="false"
                      SetTargetFramework="TargetFramework=$(TargetFramework)" />
  </ItemGroup>
</Project>
