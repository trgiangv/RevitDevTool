<Project Sdk="Microsoft.NET.Sdk">
    <PropertyGroup>
        <TargetFrameworks>net48;net8.0-windows;net10.0-windows</TargetFrameworks>
        <AppendTargetFrameworkToOutputPath>true</AppendTargetFrameworkToOutputPath>
        <RootNamespace>DevTools.NUnit.MTP</RootNamespace>
        <AssemblyName>DevTools.NUnit.MTP</AssemblyName>
        <IsPackable>false</IsPackable>
        <IsTestProject>false</IsTestProject>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="NUnit"/>
        <PackageReference Include="System.Reflection.Metadata" Condition="'$(TargetFramework)' == 'net48'"/>
        <InternalsVisibleTo Include="DevTools.NUnit.MTP.Tests"/>
    </ItemGroup>

    <ItemGroup>
        <Compile Include="..\DevTools.NUnit.Runtime\NUnitSourceLocationProvider.cs" Link="NUnitSourceLocationProvider.cs"/>
        <Compile Include="..\DevTools.NUnit.Runtime\NUnitTestNameParser.cs" Link="NUnitTestNameParser.cs"/>
        <Compile Include="..\DevTools.NUnit.Runtime\NUnitCollapsedSelection.cs" Link="NUnitCollapsedSelection.cs"/>
        <Compile Include="..\DevTools.NUnit.Runtime\NUnitTolerantAssemblyBuilder.cs" Link="NUnitTolerantAssemblyBuilder.cs"/>
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="..\DevTools.Testing.Abstractions\DevTools.Testing.Abstractions.csproj">
            <SetTargetFramework>TargetFramework=$(TargetFramework)</SetTargetFramework>
        </ProjectReference>
    </ItemGroup>
</Project>
