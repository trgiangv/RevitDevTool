<UserControl x:Class="RevitDevTool.View.AddinLoadView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:behav="clr-namespace:RevitDevTool.View.Behaviors"
             xmlns:control="clr-namespace:RevitDevTool.View.Controls"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:design="clr-namespace:RevitDevTool.Theme.Design"
             xmlns:mah="http://metro.mahapps.com/winfx/xaml/controls"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:models="clr-namespace:RevitDevTool.AddinManager.Models"
             xmlns:vm="clr-namespace:RevitDevTool.ViewModel"
             d:DataContext="{d:DesignInstance vm:AddinLoadViewModel}"
             d:DesignHeight="500"
             d:DesignWidth="400"
             Background="{DynamicResource MahApps.Brushes.ThemeBackground}"
             mc:Ignorable="d">

    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/RevitDevTool;component/Theme/Theme.xaml" />
                <design:IntellisenseResources Source="/RevitDevTool;component/Theme/Design/DesignTimeResources.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <!--  Level 1: Assembly (DLL File)  -->
            <HierarchicalDataTemplate DataType="{x:Type models:AssemblyNode}"
                                      ItemsSource="{Binding Children}">
                <StackPanel Margin="2"
                            Orientation="Horizontal">
                    <Path Width="14"
                          Height="14"
                          Margin="0,0,5,0"
                          VerticalAlignment="Center"
                          Data="{StaticResource Link}"
                          Fill="{DynamicResource MahApps.Brushes.Accent}"
                          Stretch="Uniform" />
                    <TextBlock VerticalAlignment="Center"
                               behav:HighlightTextBlockBehavior.Range="{Binding HighlightRange}"
                               Text="{Binding DisplayName}"
                               ToolTip="{Binding FilePath}" />
                </StackPanel>
            </HierarchicalDataTemplate>

            <!--  Level 2: Namespace  -->
            <HierarchicalDataTemplate DataType="{x:Type models:NamespaceNode}"
                                      ItemsSource="{Binding Children}">
                <StackPanel Margin="2"
                            Orientation="Horizontal">
                    <Path Width="12"
                          Height="12"
                          Margin="0,0,5,0"
                          VerticalAlignment="Center"
                          Data="{StaticResource BulletList}"
                          Fill="Orange"
                          Stretch="Uniform" />
                    <TextBlock VerticalAlignment="Center"
                               behav:HighlightTextBlockBehavior.Range="{Binding HighlightRange}"
                               Text="{Binding DisplayName}"
                               ToolTip="{Binding Namespace}" />
                </StackPanel>
            </HierarchicalDataTemplate>

            <!--  Level 3: Command (Leaf)  -->
            <DataTemplate DataType="{x:Type models:CommandNode}">
                <StackPanel Margin="2"
                            Orientation="Horizontal">
                    <Path Width="10"
                          Height="10"
                          Margin="0,0,5,0"
                          VerticalAlignment="Center"
                          Data="{StaticResource Play}"
                          Fill="Green"
                          Stretch="Uniform" />
                    <TextBlock VerticalAlignment="Center"
                               behav:HighlightTextBlockBehavior.Range="{Binding HighlightRange}"
                               Text="{Binding DisplayName}"
                               ToolTip="{Binding AddinItem.FullClassName}" />
                </StackPanel>
            </DataTemplate>

            <Style x:Key="ExtendedTreeViewItemStyle"
                   BasedOn="{StaticResource MahApps.Styles.TreeViewItem}"
                   TargetType="{x:Type TreeViewItem}">
                <Setter Property="IsExpanded" Value="{Binding IsExpanded, Mode=TwoWay}" />
                <Setter Property="IsSelected" Value="{Binding IsSelected, Mode=TwoWay}" />
                <Setter Property="control:MouseDoubleClick.CommandParameter" Value="{Binding}" />
                <Setter Property="control:MouseDoubleClick.Command" Value="{Binding Path=DataContext.ExecuteCommand, RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type TreeView}}}" />
            </Style>

        </ResourceDictionary>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid Margin="0,0,0,5">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <!--  Search  -->
            <TextBox Grid.Column="0"
                     mah:TextBoxHelper.Watermark="Search assemblies, namespaces, or commands..."
                     Text="{Binding SearchText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
            
            <!--  Tree Controls  -->
            <StackPanel Grid.Column="1"
                        Margin="10,0,0,0"
                        Orientation="Horizontal">
                <StackPanel.Resources>
                    <Style BasedOn="{StaticResource MahApps.Styles.Button.Circle}"
                           TargetType="{x:Type Button}">
                        <Setter Property="Height" Value="25"/>
                        <Setter Property="Width" Value="25"/>
                    </Style>
                </StackPanel.Resources>
                <Button Margin="0,0,5,0"
                        Command="{Binding ExpandAllCommand}"
                        ToolTip="Expand all">
                    <Path Width="7"
                          Height="7"
                          Data="{StaticResource Expand}"
                          Fill="{DynamicResource MahApps.Brushes.ThemeForeground}"
                          Stretch="Uniform">
                    </Path>
                </Button>
                <Button Margin="0,0,5,0"
                        Command="{Binding CollapseAllCommand}"
                        ToolTip="Collapse all">
                    <Path Width="7"
                          Height="7"
                          Data="{StaticResource Collapse}"
                          Fill="{DynamicResource MahApps.Brushes.ThemeForeground}"
                          Stretch="Uniform">
                    </Path>
                </Button>
                <Button Command="{Binding ToggleAllCommand}"
                        ToolTip="Toggle expand/collapse">
                    <Path Width="11"
                          Height="11"
                          Data="{StaticResource Toggle}"
                          Fill="{DynamicResource MahApps.Brushes.ThemeForeground}"
                          Stretch="Uniform">
                    </Path>
                </Button>
            </StackPanel>
        </Grid>
        
        <!--  Tree View  -->
        <control:ExtendedTreeView Grid.Row="1"
                                  AllowDrop="True"
                                  Drop="AddinTreeView_Drop"
                                  ItemContainerStyle="{StaticResource ExtendedTreeViewItemStyle}"
                                  ItemsSource="{Binding FilteredAssemblies}"
                                  SelectedTreeItem="{Binding SelectedItem, Mode=TwoWay}">
            <control:ExtendedTreeView.InputBindings>
                <KeyBinding Key="Delete"
                            Command="{Binding RemoveCommand}" />
            </control:ExtendedTreeView.InputBindings>
            <control:ExtendedTreeView.ContextMenu>
                <ContextMenu>
                    <MenuItem Command="{Binding ExecuteCommand}"
                              Header="Execute" />
                    <MenuItem Command="{Binding OpenLocationCommand}"
                              Header="Open Location" />
                    <Separator />
                    <MenuItem Command="{Binding RemoveCommand}"
                              Header="Remove Selected" />
                    <MenuItem Command="{Binding ClearCommand}"
                              Header="Clear All" />
                </ContextMenu>
            </control:ExtendedTreeView.ContextMenu>
        </control:ExtendedTreeView>
        
        <!--  Load Button  -->
        <Button Grid.Row="2"
                Height="30"
                Margin="0,5,0,0"
                Command="{Binding LoadAddinCommand}"
                Content="Load Add-in..."
                ToolTip="Load a .dll file to execute commands" />
    </Grid>
</UserControl>
