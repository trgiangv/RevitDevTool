<UserControl x:Class="RevitDevTool.View.PackageView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:behav="clr-namespace:RevitDevTool.View.Behaviors"
             xmlns:control="clr-namespace:RevitDevTool.View.Controls"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:design="clr-namespace:RevitDevTool.Theme.Design"
             xmlns:mah="http://metro.devtools.ui/winfx/xaml/controls"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:models="clr-namespace:RevitDevTool.Execution.Models"
             xmlns:viewModel="clr-namespace:RevitDevTool.ViewModel"
             d:DataContext="{d:DesignInstance viewModel:PackageViewModel}"
             d:DesignHeight="500"
             d:DesignWidth="400"
             mc:Ignorable="d">

    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/RevitDevTool;component/Theme/Theme.xaml" />
                <design:IntellisenseResources Source="/RevitDevTool;component/Theme/Design/DesignTimeResources.xaml" />
            </ResourceDictionary.MergedDictionaries>
            <HierarchicalDataTemplate DataType="{x:Type models:MarketplaceNode}"
                                      ItemsSource="{Binding Children}">
                <StackPanel Orientation="Horizontal">
                    <Image Width="14"
                           Height="14"
                           Margin="0,0,6,0">
                        <Image.Style>
                            <Style TargetType="Image">
                                <Setter Property="Source" Value="{StaticResource NuGetIcon}" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Marketplace}"
                                                 Value="{x:Static models:Marketplace.NuGet}">
                                        <Setter Property="Source" Value="{StaticResource NuGetIcon}" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding Marketplace}"
                                                 Value="{x:Static models:Marketplace.CondaForge}">
                                        <Setter Property="Source" Value="{StaticResource CondaForgeIcon}" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding Marketplace}"
                                                 Value="{x:Static models:Marketplace.PyPi}">
                                        <Setter Property="Source" Value="{StaticResource PypiIcon}" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Image.Style>
                    </Image>
                    <TextBlock behav:HighlightTextBlockBehavior.Range="{Binding HighlightRange}"
                               FontWeight="SemiBold"
                               Text="{Binding Name}" />
                    <TextBlock Margin="6,0,0,0"
                               Foreground="{DynamicResource DevTools.MahApps.Brushes.Gray}"
                               Text="{Binding Children.Count, StringFormat='({0})'}" />
                </StackPanel>
            </HierarchicalDataTemplate>

            <DataTemplate DataType="{x:Type models:PackageItemNode}">
                <StackPanel Orientation="Horizontal">
                    <Path Width="11"
                          Height="11"
                          Margin="0,0,6,0"
                          Data="{StaticResource Box}"
                          Fill="{DynamicResource DevTools.MahApps.Brushes.ThemeForeground}"
                          Stretch="Uniform" />
                    <TextBlock behav:HighlightTextBlockBehavior.Range="{Binding HighlightRange}"
                               Text="{Binding Name}" />
                    <Border Margin="6,0,0,0"
                            Padding="4,1"
                            Background="{DynamicResource DevTools.MahApps.Brushes.Accent}"
                            CornerRadius="3"
                            Visibility="{Binding IsLatest, Converter={StaticResource BooleanToVisibilityConverter}}">
                        <TextBlock FontSize="10"
                                   FontWeight="SemiBold"
                                   Text="Latest" />
                    </Border>
                </StackPanel>
            </DataTemplate>

            <Style x:Key="ExtendedTreeViewItemStyle"
                   d:DataContext="{d:DesignInstance models:TreeNodeBase}"
                   BasedOn="{StaticResource DevTools.MahApps.Styles.TreeViewItem}"
                   TargetType="{x:Type TreeViewItem}">
                <Setter Property="IsExpanded" Value="{Binding IsExpanded, Mode=TwoWay}" />
                <Setter Property="IsSelected" Value="{Binding IsSelected, Mode=TwoWay}" />
                <Setter Property="Visibility" Value="{Binding IsVisible, Converter={StaticResource BooleanToVisibilityConverter}}" />
            </Style>
        </ResourceDictionary>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <control:ExtendedTreeView ItemContainerStyle="{StaticResource ExtendedTreeViewItemStyle}"
                                  ItemsSource="{Binding FilteredItems}"
                                  SelectedTreeItem="{Binding SelectedNode, Mode=TwoWay}">
            <control:ExtendedTreeView.ContextMenu>
                <ContextMenu>
                    <MenuItem Command="{Binding RemoveCommand}"
                              Header="Remove" />
                    <MenuItem Command="{Binding RemoveAllCommand}"
                              Header="Remove All" />
                    <Separator />
                    <MenuItem Command="{Binding UpdateCommand}"
                              Header="Update" />
                    <MenuItem Command="{Binding RepairCommand}"
                              Header="Repair" />
                </ContextMenu>
            </control:ExtendedTreeView.ContextMenu>
        </control:ExtendedTreeView>

        <Border Grid.Row="1"
                Margin="0,6,0,0"
                Padding="8,6"
                Background="{DynamicResource DevTools.MahApps.Brushes.ThemeBackground}"
                BorderThickness="1"
                Visibility="{Binding IsBusy, Converter={StaticResource BooleanToVisibilityConverter}}">
            <StackPanel>
                <TextBlock FontSize="11"
                           Foreground="{DynamicResource DevTools.MahApps.Brushes.ThemeForeground}"
                           Text="{Binding BusyMessage}" />
                <mah:MetroProgressBar Height="6"
                                      Margin="0,6,0,0"
                                      IsIndeterminate="True" />
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
