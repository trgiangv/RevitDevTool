<UserControl x:Class="RevitDevTool.View.CommandView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:behav="clr-namespace:RevitDevTool.View.Behaviors"
             xmlns:control="clr-namespace:RevitDevTool.View.Controls"
             xmlns:converters="clr-namespace:RevitDevTool.View.Converters"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:design="clr-namespace:RevitDevTool.Theme.Design"
             xmlns:executionModels="clr-namespace:RevitDevTool.Execution.Models"
             xmlns:mah="http://metro.devtools.ui/winfx/xaml/controls"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:viewModel="clr-namespace:RevitDevTool.ViewModel"
             d:DataContext="{d:DesignInstance viewModel:CommandViewModel}"
             mc:Ignorable="d">

    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/RevitDevTool;component/Theme/Theme.xaml" />
                <design:IntellisenseResources Source="/RevitDevTool;component/Theme/Design/DesignTimeResources.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <converters:ExecutionModeImageConverter x:Key="ExecutionModeIconConverter" />
            <converters:ExecutionModeVisibilityConverter x:Key="ExecutionModeVisibilityConverter" />

            <HierarchicalDataTemplate DataType="{x:Type executionModels:ExecutionNodeRoot}"
                                      ItemsSource="{Binding Children}">
                <TextBlock Margin="2"
                           VerticalAlignment="Center"
                           behav:HighlightTextBlockBehavior.Range="{Binding HighlightRange}"
                           FontWeight="Bold"
                           Text="{Binding Name}"
                           ToolTip="{Binding RootPath}" />
            </HierarchicalDataTemplate>

            <HierarchicalDataTemplate DataType="{x:Type executionModels:ExecutionNodeIntermediate}"
                                      ItemsSource="{Binding Children}">
                <TextBlock Margin="2"
                           VerticalAlignment="Center"
                           behav:HighlightTextBlockBehavior.Range="{Binding HighlightRange}"
                           Text="{Binding Name}"
                           ToolTip="{Binding FullPath}" />
            </HierarchicalDataTemplate>

            <DataTemplate DataType="{x:Type executionModels:ExecutionNode}">
                <StackPanel Margin="2"
                            Orientation="Horizontal">
                    <Image Width="15"
                           Height="15"
                           Margin="0,0,5,0"
                           Source="{Binding ProviderType, Converter={StaticResource ExecutionModeIconConverter}}" />
                    <TextBlock VerticalAlignment="Center"
                               behav:HighlightTextBlockBehavior.Range="{Binding HighlightRange}"
                               Text="{Binding Name}"
                               ToolTip="{Binding ExecutablePath}" />
                    <Ellipse Width="8"
                             Height="8"
                             Margin="5,0,0,0"
                             Fill="Green"
                             ToolTip="Last executed"
                             Visibility="{Binding IsLastExecuted, Converter={StaticResource BooleanToVisibilityConverter}}" />
                </StackPanel>
            </DataTemplate>

            <Style x:Key="ExtendedTreeViewItemStyle"
                   d:DataContext="{d:DesignInstance executionModels:ExecutionNodeBase}"
                   BasedOn="{StaticResource DevTools.MahApps.Styles.TreeViewItem}"
                   TargetType="{x:Type TreeViewItem}">
                <Setter Property="IsExpanded" Value="{Binding IsExpanded, Mode=TwoWay}" />
                <Setter Property="IsSelected" Value="{Binding IsSelected, Mode=TwoWay}" />
                <Setter Property="Visibility" Value="{Binding IsVisible, Converter={StaticResource BooleanToVisibilityConverter}}" />
                <Setter Property="control:MouseDoubleClick.CommandParameter" Value="{Binding}" />
                <Setter Property="control:MouseDoubleClick.Command" Value="{Binding Path=DataContext.(viewModel:CommandViewModel.ExecuteCommand), RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type control:ExtendedTreeView}}}" />
            </Style>
        </ResourceDictionary>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0">
            <control:ExtendedTreeView AllowDrop="True"
                                      DragEnter="AddinTreeView_DragEnter"
                                      DragLeave="AddinTreeView_DragLeave"
                                      DragOver="AddinTreeView_DragOver"
                                      Drop="AddinTreeView_Drop"
                                      ItemContainerStyle="{StaticResource ExtendedTreeViewItemStyle}"
                                      ItemsSource="{Binding FilteredItems}"
                                      SelectedTreeItem="{Binding SelectedNode, Mode=TwoWay}">
                <control:ExtendedTreeView.InputBindings>
                    <KeyBinding Key="Delete"
                                Command="{Binding RemoveCommand}" />
                </control:ExtendedTreeView.InputBindings>
                <control:ExtendedTreeView.ContextMenu>
                    <ContextMenu>
                        <MenuItem Command="{Binding ExecuteCommand}"
                                  Header="Execute" />
                        <MenuItem Command="{Binding OpenLocationCommand}"
                                  Header="Open Location" />
                        <Separator />
                        <MenuItem Command="{Binding RemoveCommand}"
                                  Header="Remove Selected" />
                        <MenuItem Command="{Binding ClearCommand}"
                                  Header="Clear All" />
                    </ContextMenu>
                </control:ExtendedTreeView.ContextMenu>
            </control:ExtendedTreeView>

            <Border x:Name="DropMask"
                    Panel.ZIndex="10"
                    Background="#AA1E1E1E"
                    IsHitTestVisible="False"
                    Visibility="Collapsed">
                <StackPanel HorizontalAlignment="Center"
                            VerticalAlignment="Center">
                    <TextBlock x:Name="DropMaskTitle"
                               HorizontalAlignment="Center"
                               FontSize="14"
                               FontWeight="SemiBold"
                               Foreground="White"
                               Text="Drop to load" />
                    <TextBlock x:Name="DropMaskHint"
                               Margin="0,6,0,0"
                               HorizontalAlignment="Center"
                               FontSize="11"
                               Foreground="#FFD0D0D0"
                               Text=".dll files and folders are supported" />
                </StackPanel>
            </Border>
        </Grid>

        <Border Grid.Row="1"
                Margin="0,5,0,0"
                Padding="10,6"
                Background="{DynamicResource DevTools.MahApps.Brushes.ThemeBackground}"
                BorderThickness="1"
                Visibility="{Binding IsBusy, Converter={StaticResource BooleanToVisibilityConverter}}">
            <StackPanel>
                <StackPanel Margin="0,0,0,6"
                            HorizontalAlignment="Center"
                            Orientation="Horizontal">
                    <Image Width="14"
                           Height="14"
                           Margin="0,0,6,0"
                           Source="{Binding BusyProviderType, Converter={StaticResource ExecutionModeIconConverter}}"
                           Visibility="{Binding BusyProviderType, Converter={StaticResource ExecutionModeVisibilityConverter}}" />
                    <TextBlock FontSize="9"
                               Foreground="{DynamicResource DevTools.MahApps.Brushes.ThemeForeground}"
                               Text="{Binding BusyMessage}"
                               TextAlignment="Center"
                               TextTrimming="CharacterEllipsis" />
                </StackPanel>
                <mah:MetroProgressBar Height="6"
                                      IsIndeterminate="True" />
            </StackPanel>
        </Border>

        <Grid Grid.Row="2"
              Margin="0,5,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Button Height="30"
                    Margin="0,0,5,0"
                    HorizontalAlignment="Stretch"
                    Command="{Binding LoadAssemblyCommand}"
                    ToolTip="Load .NET Assembly">
                <StackPanel Orientation="Horizontal">
                    <Image Width="16"
                           Height="16"
                           Margin="0,0,5,0"
                           Source="{StaticResource DotnetIcon}" />
                    <TextBlock VerticalAlignment="Center"
                               Text="Load .NET Assembly" />
                </StackPanel>
            </Button>
            <Button Grid.Column="1"
                    Height="30"
                    HorizontalAlignment="Stretch"
                    Command="{Binding LoadScriptsCommand}"
                    ToolTip="Load Script (F# / Python)">
                <StackPanel Orientation="Horizontal">
                    <Image Width="16"
                           Height="16"
                           Source="{StaticResource FsharpIcon}" />
                    <TextBlock Margin="2,0"
                               VerticalAlignment="Center"
                               Text="/" />
                    <Image Width="16"
                           Height="16"
                           Margin="0,0,5,0"
                           Source="{StaticResource PythonIcon}" />
                    <TextBlock VerticalAlignment="Center"
                               Text="Load Scripts" />
                </StackPanel>
            </Button>
        </Grid>
    </Grid>
</UserControl>