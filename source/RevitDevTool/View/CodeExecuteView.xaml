<UserControl x:Class="RevitDevTool.View.CodeExecuteView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:behav="clr-namespace:RevitDevTool.View.Behaviors"
             xmlns:control="clr-namespace:RevitDevTool.View.Controls"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:design="clr-namespace:RevitDevTool.Theme.Design"
             xmlns:mah="http://metro.mahapps.com/winfx/xaml/controls"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:models="clr-namespace:RevitDevTool.CodeExecute.Models"
             xmlns:viewModel="clr-namespace:RevitDevTool.ViewModel"
             d:DataContext="{d:DesignInstance viewModel:CodeExecuteViewModel}"
             d:DesignHeight="500"
             d:DesignWidth="400"
             Background="{DynamicResource MahApps.Brushes.ThemeBackground}"
             mc:Ignorable="d">

    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/RevitDevTool;component/Theme/Theme.xaml" />
                <design:IntellisenseResources Source="/RevitDevTool;component/Theme/Design/DesignTimeResources.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <!--  RootNode: Assembly or Root Folder  -->
            <HierarchicalDataTemplate DataType="{x:Type models:RootNode}"
                                      ItemsSource="{Binding Children}">
                <TextBlock Margin="2"
                           VerticalAlignment="Center"
                           behav:HighlightTextBlockBehavior.Range="{Binding HighlightRange}"
                           FontWeight="Bold"
                           Text="{Binding Name}"
                           ToolTip="{Binding RootPath}" />
            </HierarchicalDataTemplate>

            <!--  IntermediateNode: Namespace or SubFolder  -->
            <HierarchicalDataTemplate DataType="{x:Type models:IntermediateNode}"
                                      ItemsSource="{Binding Children}">
                <TextBlock Margin="2"
                           VerticalAlignment="Center"
                           behav:HighlightTextBlockBehavior.Range="{Binding HighlightRange}"
                           Text="{Binding Name}"
                           ToolTip="{Binding FullPath}" />
            </HierarchicalDataTemplate>

            <!--  ExecuteNode: Command or Script  -->
            <DataTemplate DataType="{x:Type models:ExecuteNode}">
                <StackPanel Margin="2"
                            Orientation="Horizontal">
                    <Image Width="15"
                           Height="15"
                           Margin="0,0,5,0">
                        <Image.Style>
                            <Style TargetType="Image">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding ProviderType}"
                                                 Value="{x:Static models:ExecutionMode.Assembly}">
                                        <Setter Property="Source" Value="{StaticResource DotnetIcon}" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding ProviderType}"
                                                 Value="{x:Static models:ExecutionMode.Python}">
                                        <Setter Property="Source" Value="{StaticResource PythonIcon}" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding ProviderType}"
                                                 Value="{x:Static models:ExecutionMode.FSharp}">
                                        <Setter Property="Source" Value="{StaticResource FsharpIcon}" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Image.Style>
                    </Image>
                    <TextBlock VerticalAlignment="Center"
                               behav:HighlightTextBlockBehavior.Range="{Binding HighlightRange}"
                               Text="{Binding Name}"
                               ToolTip="{Binding ExecutablePath}" />
                    <Ellipse Width="8"
                             Height="8"
                             Margin="5,0,0,0"
                             Fill="Green"
                             ToolTip="Last executed"
                             Visibility="{Binding IsLastExecuted, Converter={StaticResource BooleanToVisibilityConverter}}" />
                </StackPanel>
            </DataTemplate>
            <Style x:Key="ExtendedTreeViewItemStyle"
                   d:DataContext="{d:DesignInstance models:BaseNode}"
                   BasedOn="{StaticResource MahApps.Styles.TreeViewItem}"
                   TargetType="{x:Type TreeViewItem}">
                <Setter Property="IsExpanded" Value="{Binding IsExpanded, Mode=TwoWay}" />
                <Setter Property="IsSelected" Value="{Binding IsSelected, Mode=TwoWay}" />
                <Setter Property="Visibility" Value="{Binding IsVisible, Converter={StaticResource BooleanToVisibilityConverter}}" />
                <Setter Property="control:MouseDoubleClick.CommandParameter" Value="{Binding}" />
                <Setter Property="control:MouseDoubleClick.Command" Value="{Binding Path=DataContext.(viewModel:CodeExecuteViewModel.ExecuteCommand), RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type control:ExtendedTreeView}}}" />
            </Style>

        </ResourceDictionary>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid Margin="0,0,0,5">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <!--  Search  -->
            <TextBox Grid.Column="0"
                     mah:TextBoxHelper.ClearTextButton="True"
                     mah:TextBoxHelper.Watermark="Search assemblies, namespaces, or commands..."
                     Text="{Binding SearchText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />

            <!--  Tree Controls  -->
            <StackPanel Grid.Column="1"
                        Margin="10,0,0,0"
                        Orientation="Horizontal">
                <StackPanel.Resources>
                    <Style BasedOn="{StaticResource MahApps.Styles.Button.Circle}"
                           TargetType="{x:Type Button}">
                        <Setter Property="Height" Value="25" />
                        <Setter Property="Width" Value="25" />
                    </Style>
                </StackPanel.Resources>
                <Button Margin="0,0,5,0"
                        Command="{Binding ExpandAllCommand}"
                        ToolTip="Expand all">
                    <Path Width="7"
                          Height="7"
                          Data="{StaticResource Expand}"
                          Fill="{DynamicResource MahApps.Brushes.ThemeForeground}"
                          Stretch="Uniform" />
                </Button>
                <Button Margin="0,0,5,0"
                        Command="{Binding CollapseAllCommand}"
                        ToolTip="Collapse all">
                    <Path Width="7"
                          Height="7"
                          Data="{StaticResource Collapse}"
                          Fill="{DynamicResource MahApps.Brushes.ThemeForeground}"
                          Stretch="Uniform" />
                </Button>
                <Button Command="{Binding ToggleAllCommand}"
                        ToolTip="Toggle expand/collapse">
                    <Path Width="11"
                          Height="11"
                          Data="{StaticResource Toggle}"
                          Fill="{DynamicResource MahApps.Brushes.ThemeForeground}"
                          Stretch="Uniform" />
                </Button>
            </StackPanel>
        </Grid>

        <Grid Grid.Row="1">
            <!--  Tree View  -->
            <control:ExtendedTreeView AllowDrop="True"
                                      DragEnter="AddinTreeView_DragEnter"
                                      DragLeave="AddinTreeView_DragLeave"
                                      DragOver="AddinTreeView_DragOver"
                                      Drop="AddinTreeView_Drop"
                                      ItemContainerStyle="{StaticResource ExtendedTreeViewItemStyle}"
                                      ItemsSource="{Binding FilteredItems}"
                                      SelectedTreeItem="{Binding SelectedNode, Mode=TwoWay}">
                <control:ExtendedTreeView.InputBindings>
                    <KeyBinding Key="Delete"
                                Command="{Binding RemoveCommand}" />
                </control:ExtendedTreeView.InputBindings>
                <control:ExtendedTreeView.ContextMenu>
                    <ContextMenu>
                        <MenuItem Command="{Binding ExecuteCommand}"
                                  Header="Execute" />
                        <MenuItem Command="{Binding OpenLocationCommand}"
                                  Header="Open Location" />
                        <Separator />
                        <MenuItem Command="{Binding RemoveCommand}"
                                  Header="Remove Selected" />
                        <MenuItem Command="{Binding ClearCommand}"
                                  Header="Clear All" />
                    </ContextMenu>
                </control:ExtendedTreeView.ContextMenu>
            </control:ExtendedTreeView>

            <!-- Drag-and-drop Mask -->
            <Border x:Name="DropMask"
                    Panel.ZIndex="10"
                    Background="#AA1E1E1E"
                    IsHitTestVisible="False"
                    Visibility="Collapsed">
                <StackPanel HorizontalAlignment="Center"
                            VerticalAlignment="Center">
                    <TextBlock x:Name="DropMaskTitle"
                               HorizontalAlignment="Center"
                               FontSize="14"
                               FontWeight="SemiBold"
                               Foreground="White"
                               Text="Drop to load" />
                    <TextBlock x:Name="DropMaskHint"
                               Margin="0,6,0,0"
                               HorizontalAlignment="Center"
                               FontSize="11"
                               Foreground="#FFD0D0D0"
                               Text=".dll files and folders are supported" />
                </StackPanel>
            </Border>
        </Grid>

        <!-- Progress -->
        <Border Grid.Row="2"
                Margin="0,5,0,0"
                Padding="10,6"
                Background="{DynamicResource MahApps.Brushes.ThemeBackground}"
                BorderThickness="1"
                Visibility="{Binding IsBusy, Converter={StaticResource BooleanToVisibilityConverter}}">
            <StackPanel>
                <StackPanel Orientation="Horizontal"
                            HorizontalAlignment="Center"
                            Margin="0,0,0,6">
                    <Image Width="14"
                           Height="14"
                           Margin="0,0,6,0">
                        <Image.Style>
                            <Style TargetType="Image">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding BusyProviderType}"
                                                 Value="{x:Static models:ExecutionMode.Assembly}">
                                        <Setter Property="Source" Value="{StaticResource DotnetIcon}" />
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding BusyProviderType}"
                                                 Value="{x:Static models:ExecutionMode.Python}">
                                        <Setter Property="Source" Value="{StaticResource PythonIcon}" />
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding BusyProviderType}"
                                                 Value="{x:Static models:ExecutionMode.FSharp}">
                                        <Setter Property="Source" Value="{StaticResource FsharpIcon}" />
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Image.Style>
                    </Image>
                    <TextBlock FontSize="9"
                               Foreground="{DynamicResource MahApps.Brushes.ThemeForeground}"
                               Text="{Binding BusyMessage}"
                               TextAlignment="Center"
                               TextTrimming="CharacterEllipsis" />
                </StackPanel>
                <mah:MetroProgressBar Height="6"
                                      IsIndeterminate="True" />
            </StackPanel>
        </Border>

        <!--  Load Buttons  -->
        <Grid Grid.Row="3"
              Margin="0,5,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Button Height="30"
                    Margin="0,0,5,0"
                    HorizontalAlignment="Stretch"
                    Command="{Binding LoadAssemblyCommand}"
                    ToolTip="Load .NET Assembly">
                <StackPanel Orientation="Horizontal">
                    <Image Width="16"
                           Height="16"
                           Margin="0,0,5,0"
                           Source="{StaticResource DotnetIcon}" />
                    <TextBlock VerticalAlignment="Center"
                               Text="Load .NET Assembly" />
                </StackPanel>
            </Button>
            <Button Grid.Column="1"
                    Height="30"
                    HorizontalAlignment="Stretch"
                    Command="{Binding LoadScriptsCommand}"
                    ToolTip="Load Script (F# / Python)">
                <StackPanel Orientation="Horizontal">
                    <Image Width="16"
                           Height="16"
                           Source="{StaticResource FsharpIcon}" />
                    <TextBlock Margin="2,0"
                               VerticalAlignment="Center"
                               Text="/" />
                    <Image Width="16"
                           Height="16"
                           Margin="0,0,5,0"
                           Source="{StaticResource PythonIcon}" />
                    <TextBlock VerticalAlignment="Center"
                               Text="Load Scripts" />
                </StackPanel>
            </Button>
        </Grid>
    </Grid>
</UserControl>