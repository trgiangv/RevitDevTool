<UserControl x:Class="RevitDevTool.View.CodeExecuteView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:behav="clr-namespace:RevitDevTool.View.Behaviors"
             xmlns:control="clr-namespace:RevitDevTool.View.Controls"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:design="clr-namespace:RevitDevTool.Theme.Design"
             xmlns:mah="http://metro.mahapps.com/winfx/xaml/controls"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:models="clr-namespace:RevitDevTool.CodeExecute.CSharp.Models"
             xmlns:pyModels="clr-namespace:RevitDevTool.CodeExecute.Python.Models"
             xmlns:execute="clr-namespace:RevitDevTool.ViewModel.Execute"
             xmlns:sharedModels="clr-namespace:RevitDevTool.CodeExecute.Shared.Models"
             d:DataContext="{d:DesignInstance execute:CodeExecuteViewModel}"
             d:DesignHeight="500"
             d:DesignWidth="400"
             Background="{DynamicResource MahApps.Brushes.ThemeBackground}"
             mc:Ignorable="d">

    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/RevitDevTool;component/Theme/Theme.xaml" />
                <design:IntellisenseResources Source="/RevitDevTool;component/Theme/Design/DesignTimeResources.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <!--  Level 1: Assembly  -->
            <HierarchicalDataTemplate DataType="{x:Type models:AssemblyNode}"
                                      ItemsSource="{Binding Children}">
                <TextBlock VerticalAlignment="Center"
                           Margin="2"
                           behav:HighlightTextBlockBehavior.Range="{Binding HighlightRange}"
                           Text="{Binding DisplayName}"
                           ToolTip="{Binding FilePath}" />
            </HierarchicalDataTemplate>

            <!--  Level 2: Namespace  -->
            <HierarchicalDataTemplate DataType="{x:Type models:NamespaceNode}"
                                      ItemsSource="{Binding Children}">
                <TextBlock VerticalAlignment="Center"
                           Margin="2"
                           behav:HighlightTextBlockBehavior.Range="{Binding HighlightRange}"
                           Text="{Binding DisplayName}"
                           ToolTip="{Binding Namespace}" />
            </HierarchicalDataTemplate>

            <!--  Level 3: Command -->
            <DataTemplate DataType="{x:Type models:CommandNode}">
                <StackPanel Margin="2"
                            Orientation="Horizontal">
                    <Image Width="15"
                           Height="15"
                           Margin="0,0,5,0"
                           Source="{StaticResource CsharpIcon}"/>
                    <TextBlock VerticalAlignment="Center"
                               behav:HighlightTextBlockBehavior.Range="{Binding HighlightRange}"
                               Text="{Binding DisplayName}"
                               ToolTip="{Binding AddinItem.FullClassName}" />
                </StackPanel>
            </DataTemplate>

            <!--  Python Templates  -->

            <!--  Level 1: Python Group  -->
            <HierarchicalDataTemplate DataType="{x:Type pyModels:GroupNode}"
                                      ItemsSource="{Binding Children}">
                <TextBlock VerticalAlignment="Center"
                           Margin="2"
                           behav:HighlightTextBlockBehavior.Range="{Binding HighlightRange}"
                           Text="{Binding DisplayName}"
                           ToolTip="{Binding GroupName}" />
            </HierarchicalDataTemplate>

            <!--  Level 2: Python Script -->
            <DataTemplate DataType="{x:Type pyModels:ScriptNode}">
                <StackPanel Margin="2"
                            Orientation="Horizontal">
                    <Image Width="15"
                           Height="15"
                           Margin="0,0,5,0"
                           Source="{StaticResource PythonIcon}"/>
                    <TextBlock VerticalAlignment="Center"
                               behav:HighlightTextBlockBehavior.Range="{Binding HighlightRange}"
                               Text="{Binding DisplayName}"
                               ToolTip="{Binding FilePath}" />
                </StackPanel>
            </DataTemplate>

            <Style x:Key="ExtendedTreeViewItemStyle"
                   BasedOn="{StaticResource MahApps.Styles.TreeViewItem}"
                   d:DataContext="{d:DesignInstance sharedModels:TreeNodeBase}"
                   TargetType="{x:Type TreeViewItem}">
                <Setter Property="IsExpanded" Value="{Binding IsExpanded, Mode=TwoWay}" />
                <Setter Property="IsSelected" Value="{Binding IsSelected, Mode=TwoWay}" />
                <Setter Property="control:MouseDoubleClick.CommandParameter" Value="{Binding}" />
                <Setter Property="control:MouseDoubleClick.Command"
                        Value="{Binding Path=DataContext.(execute:CodeExecuteViewModel.ActiveViewModel).ExecuteCommand,
                        RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type control:ExtendedTreeView}}}" />
            </Style>

        </ResourceDictionary>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid Margin="0,0,0,5">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <!--  Search  -->
            <TextBox Grid.Column="0"
                     mah:TextBoxHelper.ClearTextButton="True"
                     mah:TextBoxHelper.Watermark="Search assemblies, namespaces, or commands..."
                     Text="{Binding ActiveViewModel.SearchText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />

            <!--  Tree Controls  -->
            <StackPanel Grid.Column="1"
                        Margin="10,0,0,0"
                        Orientation="Horizontal">
                <StackPanel.Resources>
                    <Style BasedOn="{StaticResource MahApps.Styles.Button.Circle}"
                           TargetType="{x:Type Button}">
                        <Setter Property="Height" Value="25" />
                        <Setter Property="Width" Value="25" />
                    </Style>
                </StackPanel.Resources>
                <Button Margin="0,0,5,0"
                        Command="{Binding ActiveViewModel.ExpandAllCommand}"
                        ToolTip="Expand all">
                    <Path Width="7"
                          Height="7"
                          Data="{StaticResource Expand}"
                          Fill="{DynamicResource MahApps.Brushes.ThemeForeground}"
                          Stretch="Uniform">
                    </Path>
                </Button>
                <Button Margin="0,0,5,0"
                        Command="{Binding ActiveViewModel.CollapseAllCommand}"
                        ToolTip="Collapse all">
                    <Path Width="7"
                          Height="7"
                          Data="{StaticResource Collapse}"
                          Fill="{DynamicResource MahApps.Brushes.ThemeForeground}"
                          Stretch="Uniform">
                    </Path>
                </Button>
                <Button Margin="0,0,5,0" 
                        Command="{Binding ActiveViewModel.ToggleAllCommand}"
                        ToolTip="Toggle expand/collapse">
                    <Path Width="11"
                          Height="11"
                          Data="{StaticResource Toggle}"
                          Fill="{DynamicResource MahApps.Brushes.ThemeForeground}"
                          Stretch="Uniform">
                    </Path>
                </Button>
                <!--  Language Toggle  -->
                <Button Command="{Binding SwitchModeCommand}"
                        Width="25"
                        Height="25"
                        Padding="5"
                        ToolTip="Switch between C# and Python execution">
                    <Button.Style>
                        <Style TargetType="Button" BasedOn="{StaticResource MahApps.Styles.Button.Circle}">
                            <Setter Property="Content">
                                <Setter.Value>
                                    <Image Source="{StaticResource CsharpIcon}"/>
                                </Setter.Value>
                            </Setter>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsPythonMode}"
                                             Value="True">
                                    <Setter Property="Content">
                                        <Setter.Value>
                                            <Image Source="{StaticResource PythonIcon}"/>
                                        </Setter.Value>
                                    </Setter>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                </Button>
            </StackPanel>
        </Grid>

        <!--  Tree View  -->
        <control:ExtendedTreeView Grid.Row="1"
                                  AllowDrop="True"
                                  Drop="AddinTreeView_Drop"
                                  ItemContainerStyle="{StaticResource ExtendedTreeViewItemStyle}"
                                  ItemsSource="{Binding ActiveViewModel.FilteredItems}"
                                  SelectedTreeItem="{Binding ActiveViewModel.SelectedItem, Mode=TwoWay}">
            <control:ExtendedTreeView.InputBindings>
                <KeyBinding Key="Delete"
                            Command="{Binding ActiveViewModel.RemoveCommand}" />
            </control:ExtendedTreeView.InputBindings>
            <control:ExtendedTreeView.ContextMenu>
                <ContextMenu>
                    <!-- Execution Commands -->
                    <MenuItem Command="{Binding ActiveViewModel.ExecuteCommand}"
                              Header="Execute" />
                    <MenuItem Command="{Binding ActiveViewModel.OpenLocationCommand}"
                              Header="Open Location" />
                    <Separator />

                    <!-- Python-specific commands -->
                    <MenuItem Header="Rename Group" 
                              Command="{Binding ActiveViewModel.RenameGroupCommand}"
                              Visibility="{Binding IsPythonMode, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                    <MenuItem Header="Add New Script"
                              Command="{Binding ActiveViewModel.AddNewScriptCommand}"
                              Visibility="{Binding IsPythonMode, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                    <MenuItem Header="Select Existing Script"
                              Command="{Binding ActiveViewModel.SelectScriptCommand}"
                              Visibility="{Binding IsPythonMode, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                    <Separator Visibility="{Binding IsPythonMode, Converter={StaticResource BooleanToVisibilityConverter}}"/>

                    <!-- Remove and Clear Commands -->
                    <MenuItem Command="{Binding ActiveViewModel.RemoveCommand}"
                              Header="Remove Selected" />
                    <MenuItem Command="{Binding ActiveViewModel.ClearCommand}"
                              Header="Clear All" />
                </ContextMenu>
            </control:ExtendedTreeView.ContextMenu>
        </control:ExtendedTreeView>

        <!--  Load Button  -->
        <Button Grid.Row="2"
                Height="30"
                Margin="0,5,0,0"
                Command="{Binding ActiveViewModel.LoadCommand}"
                Content="{Binding ActiveViewModel.LoadButtonText}"
                ToolTip="Load a .dll file or create a Python group" />
    </Grid>
</UserControl>