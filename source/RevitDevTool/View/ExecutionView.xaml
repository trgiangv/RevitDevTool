<UserControl x:Class="RevitDevTool.View.ExecutionView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:converters="clr-namespace:DevTools.UI.Converters;assembly=DevTools.UI"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:design="clr-namespace:DevTools.UI.Theme.Design;assembly=DevTools.UI"
             xmlns:mah="http://metro.devtools.ui/winfx/xaml/controls"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:view="clr-namespace:RevitDevTool.View"
             xmlns:viewModel="clr-namespace:RevitDevTool.ViewModel"
             d:DataContext="{d:DesignInstance viewModel:ExecutionViewModel}"
             d:DesignHeight="500"
             d:DesignWidth="400"
             Background="{DynamicResource DevTools.MahApps.Brushes.ThemeBackground}"
             mc:Ignorable="d">

    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/DevTools.UI;component/Theme/Theme.xaml" />
                <design:IntellisenseResources Source="/DevTools.UI;component/Theme/Design/DesignTimeResources.xaml" />
            </ResourceDictionary.MergedDictionaries>
            <converters:InverseBooleanToVisibilityConverter x:Key="InverseBoolToVisibility" />
        </ResourceDictionary>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid Margin="0,0,0,5">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBox Grid.Column="0"
                     mah:TextBoxHelper.ClearTextButton="True"
                     mah:TextBoxHelper.Watermark="Search..."
                     Text="{Binding SearchText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />

            <StackPanel Grid.Column="1"
                        Margin="8,0,0,0"
                        VerticalAlignment="Center"
                        Orientation="Horizontal">
                <Path Width="12"
                      Height="12"
                      VerticalAlignment="Center"
                      Data="{StaticResource Bug}"
                      Stretch="Uniform">
                    <Path.Style>
                        <Style TargetType="Path">
                            <Setter Property="Fill" Value="#FF6B6B" />
                            <Setter Property="ToolTip" Value="Python debugger not connected" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding CommandViewModel.IsDebuggerConnected}"
                                             Value="True">
                                    <Setter Property="Fill" Value="#4CAF50" />
                                    <Setter Property="ToolTip" Value="Python debugger connected" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Path.Style>
                </Path>
                <TextBlock Margin="3,0,0,0"
                           VerticalAlignment="Center"
                           FontSize="11"
                           Foreground="{DynamicResource DevTools.MahApps.Brushes.Gray}"
                           Text="{Binding CommandViewModel.DebugPort, Mode=OneTime, StringFormat=': {0}'}"
                           ToolTip="debugpy port" />
            </StackPanel>

            <ToggleButton Grid.Column="2"
                          Margin="10,0,0,0"
                          Padding="5,0"
                          BorderThickness="0.5"
                          IsChecked="{Binding IsPackageMode, UpdateSourceTrigger=PropertyChanged}"
                          Style="{DynamicResource DevTools.MahApps.Styles.ToggleButton.Circle}"
                          ToolTip="Installed packages">
                <Path Width="16"
                      Height="16"
                      Data="{StaticResource Package}"
                      Fill="{DynamicResource DevTools.MahApps.Brushes.ThemeForeground}"
                      Stretch="Uniform" />
            </ToggleButton>

            <StackPanel Grid.Column="3"
                        Margin="5,0,0,0"
                        Orientation="Horizontal">
                <StackPanel.Resources>
                    <Style BasedOn="{StaticResource DevTools.MahApps.Styles.Button.Circle}"
                           TargetType="{x:Type Button}">
                        <Setter Property="Height" Value="25" />
                        <Setter Property="Width" Value="25" />
                    </Style>
                </StackPanel.Resources>
                <Button Margin="0,0,5,0"
                        Command="{Binding ExpandAllCommand}"
                        ToolTip="Expand all">
                    <Path Width="7"
                          Height="7"
                          Data="{StaticResource Expand}"
                          Fill="{DynamicResource DevTools.MahApps.Brushes.ThemeForeground}"
                          Stretch="Uniform" />
                </Button>
                <Button Margin="0,0,5,0"
                        Command="{Binding CollapseAllCommand}"
                        ToolTip="Collapse all">
                    <Path Width="7"
                          Height="7"
                          Data="{StaticResource Collapse}"
                          Fill="{DynamicResource DevTools.MahApps.Brushes.ThemeForeground}"
                          Stretch="Uniform" />
                </Button>
                <Button Margin="0,0,5,0"
                        Command="{Binding ToggleAllCommand}"
                        ToolTip="Toggle expand/collapse">
                    <Path Width="11"
                          Height="11"
                          Data="{StaticResource Toggle}"
                          Fill="{DynamicResource DevTools.MahApps.Brushes.ThemeForeground}"
                          Stretch="Uniform" />
                </Button>
            </StackPanel>
        </Grid>

        <view:CommandView Grid.Row="1"
                          DataContext="{Binding CommandViewModel}"
                          Visibility="{Binding DataContext.IsPackageMode, RelativeSource={RelativeSource AncestorType=UserControl}, Converter={StaticResource InverseBoolToVisibility}}" />
        <view:PackageView Grid.Row="1"
                          DataContext="{Binding PackageViewModel}"
                          Visibility="{Binding DataContext.IsPackageMode, RelativeSource={RelativeSource AncestorType=UserControl}, Converter={StaticResource BooleanToVisibilityConverter}}" />
    </Grid>
</UserControl>