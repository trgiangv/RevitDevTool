<UserControl x:Class="RevitDevTool.View.Settings.Visualization.MeshVisualizationSettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:DevTools.UI.Controls;assembly=DevTools.UI"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:design="clr-namespace:DevTools.UI.Theme.Design;assembly=DevTools.UI"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:visualization="clr-namespace:RevitDevTool.ViewModel.Settings.Visualization"
             d:Background="{DynamicResource RegionBrush}"
             d:DataContext="{d:DesignInstance visualization:MeshVisualizationViewModel}"
             d:DesignHeight="540"
             d:DesignWidth="600"
             mc:Ignorable="d">

    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/DevTools.UI;component/Theme/Theme.xaml" />
                <design:IntellisenseResources Source="/DevTools.UI;component/Theme/Design/DesignTimeResources.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>

    <ScrollViewer HorizontalScrollBarVisibility="Disabled"
                  VerticalScrollBarVisibility="Auto">
        <StackPanel>
            <!--  Surface  -->
            <GroupBox Margin="0,0,0,8"
                      Background="{StaticResource RegionBrush}"
                      Header="Surface"
                      Style="{StaticResource GroupBoxTab.Small}">
                <StackPanel Margin="8">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <CheckBox VerticalAlignment="Center"
                                  Content="Show Surface"
                                  IsChecked="{Binding ShowSurface}" />
                        <controls:ColorPicker Grid.Column="1"
                                              Width="{StaticResource Length200}"
                                              SelectedColor="{Binding SurfaceColor, Mode=TwoWay}" />
                    </Grid>
                    <StackPanel>
                        <DockPanel>
                            <TextBlock Text="Extrusion" />
                            <TextBlock HorizontalAlignment="Right"
                                       Text="{Binding Extrusion, StringFormat={}{0:F0} inch}" />
                        </DockPanel>
                        <Slider Margin="0,4,0,0"
                                IsSnapToTickEnabled="True"
                                Maximum="24"
                                Minimum="{Binding MinExtrusion, Mode=OneTime}"
                                TickFrequency="2"
                                TickPlacement="BottomRight"
                                Value="{Binding Extrusion}" />
                    </StackPanel>
                    <StackPanel>
                        <DockPanel>
                            <TextBlock Text="Transparency" />
                            <TextBlock HorizontalAlignment="Right"
                                       Text="{Binding Transparency, StringFormat={}{0} %}" />
                        </DockPanel>
                        <Slider Margin="0,4,0,0"
                                IsSnapToTickEnabled="True"
                                Maximum="100"
                                Minimum="0"
                                TickFrequency="10"
                                TickPlacement="BottomRight"
                                Value="{Binding Transparency}" />
                    </StackPanel>
                </StackPanel>
            </GroupBox>

            <!--  Mesh Grid  -->
            <GroupBox Margin="0,0,0,8"
                      Background="{StaticResource RegionBrush}"
                      Header="Mesh Grid"
                      Style="{StaticResource GroupBoxTab.Small}">
                <Grid Margin="8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <CheckBox VerticalAlignment="Center"
                              Content="Show Mesh Grid"
                              IsChecked="{Binding ShowMeshGrid}" />
                    <controls:ColorPicker Grid.Column="1"
                                          Width="{StaticResource Length200}"
                                          SelectedColor="{Binding MeshColor, Mode=TwoWay}" />
                </Grid>
            </GroupBox>

            <!--  Normal Vector  -->
            <GroupBox Margin="0,0,0,8"
                      Background="{StaticResource RegionBrush}"
                      Header="Normal Vector"
                      Style="{StaticResource GroupBoxTab.Small}">
                <Grid Margin="8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <CheckBox VerticalAlignment="Center"
                              Content="Show Normal Vector"
                              IsChecked="{Binding ShowNormalVector}" />
                    <controls:ColorPicker Grid.Column="1"
                                          Width="{StaticResource Length200}"
                                          SelectedColor="{Binding NormalVectorColor, Mode=TwoWay}" />
                </Grid>
            </GroupBox>
        </StackPanel>
    </ScrollViewer>
</UserControl>
