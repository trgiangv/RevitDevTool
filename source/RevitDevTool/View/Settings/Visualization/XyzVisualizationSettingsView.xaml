<UserControl x:Class="RevitDevTool.View.Settings.Visualization.XyzVisualizationSettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:DevTools.UI.Controls;assembly=DevTools.UI"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:design="clr-namespace:DevTools.UI.Theme.Design;assembly=DevTools.UI"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:visualization="clr-namespace:RevitDevTool.ViewModel.Settings.Visualization"
             d:Background="{DynamicResource RegionBrush}"
             d:DataContext="{d:DesignInstance visualization:XyzVisualizationViewModel}"
             d:DesignHeight="540"
             d:DesignWidth="600"
             mc:Ignorable="d">

    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/DevTools.UI;component/Theme/Theme.xaml" />
                <design:IntellisenseResources Source="/DevTools.UI;component/Theme/Design/DesignTimeResources.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>

    <ScrollViewer HorizontalScrollBarVisibility="Disabled"
                  VerticalScrollBarVisibility="Auto">
        <StackPanel>
            <!--  Planes  -->
            <GroupBox Margin="0,0,0,8"
                      Background="{StaticResource RegionBrush}"
                      Header="Planes"
                      Style="{StaticResource GroupBoxTab.Small}">
                <StackPanel Margin="8">
                    <CheckBox Content="Show Planes"
                              IsChecked="{Binding ShowPlane}" />
                    <StackPanel Margin="0,12,0,0">
                        <DockPanel>
                            <TextBlock Text="Transparency" />
                            <TextBlock HorizontalAlignment="Right"
                                       Text="{Binding Transparency, StringFormat={}{0} %}" />
                        </DockPanel>
                        <Slider Margin="0,4,0,0"
                                IsSnapToTickEnabled="True"
                                Maximum="100"
                                Minimum="0"
                                TickFrequency="10"
                                TickPlacement="BottomRight"
                                Value="{Binding Transparency}" />
                    </StackPanel>
                    <StackPanel Margin="0,12,0,0">
                        <DockPanel>
                            <TextBlock Text="Axis Length" />
                            <TextBlock HorizontalAlignment="Right"
                                       Text="{Binding AxisLength, StringFormat={}{0:F0} inch}" />
                        </DockPanel>
                        <Slider Margin="0,4,0,0"
                                IsSnapToTickEnabled="True"
                                Maximum="24"
                                Minimum="{Binding MinAxisLength, Mode=OneTime}"
                                TickFrequency="2"
                                TickPlacement="BottomRight"
                                Value="{Binding AxisLength}" />
                    </StackPanel>
                </StackPanel>
            </GroupBox>

            <!--  X Axis  -->
            <GroupBox Margin="0,0,0,8"
                      Background="{StaticResource RegionBrush}"
                      Header="X Axis"
                      Style="{StaticResource GroupBoxTab.Small}">
                <Grid Margin="8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <CheckBox VerticalAlignment="Center"
                              Content="Show X Axis"
                              IsChecked="{Binding ShowXAxis}" />
                    <controls:ColorPicker Grid.Column="1"
                                          Width="{StaticResource Length200}"
                                          SelectedColor="{Binding XColor, Mode=TwoWay}" />
                </Grid>
            </GroupBox>

            <!--  Y Axis  -->
            <GroupBox Margin="0,0,0,8"
                      Background="{StaticResource RegionBrush}"
                      Header="Y Axis"
                      Style="{StaticResource GroupBoxTab.Small}">
                <Grid Margin="8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <CheckBox VerticalAlignment="Center"
                              Content="Show Y Axis"
                              IsChecked="{Binding ShowYAxis}" />
                    <controls:ColorPicker Grid.Column="1"
                                          Width="{StaticResource Length200}"
                                          SelectedColor="{Binding YColor, Mode=TwoWay}" />
                </Grid>
            </GroupBox>

            <!--  Z Axis  -->
            <GroupBox Margin="0,0,0,8"
                      Background="{StaticResource RegionBrush}"
                      Header="Z Axis"
                      Style="{StaticResource GroupBoxTab.Small}">
                <Grid Margin="8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <CheckBox VerticalAlignment="Center"
                              Content="Show Z Axis"
                              IsChecked="{Binding ShowZAxis}" />
                    <controls:ColorPicker Grid.Column="1"
                                          Width="{StaticResource Length200}"
                                          SelectedColor="{Binding ZColor, Mode=TwoWay}" />
                </Grid>
            </GroupBox>
        </StackPanel>
    </ScrollViewer>
</UserControl>
