<UserControl x:Class="RevitDevTool.View.Settings.LogSettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:design="clr-namespace:RevitDevTool.Theme.Design"
             xmlns:mah="http://metro.devtools.ui/winfx/xaml/controls"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:settings="clr-namespace:RevitDevTool.ViewModel.Settings"
             xmlns:sys="clr-namespace:System;assembly=mscorlib"
             d:Background="{DynamicResource DevTools.MahApps.Brushes.ThemeBackground}"
             d:DataContext="{d:DesignInstance settings:LogSettingsViewModel}"
             d:DesignHeight="850"
             d:DesignWidth="600"
             mc:Ignorable="d">

    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/RevitDevTool;component/Theme/Theme.xaml" />
                <design:IntellisenseResources Source="/RevitDevTool;component/Theme/Design/DesignTimeResources.xaml" />
            </ResourceDictionary.MergedDictionaries>
            <BooleanToVisibilityConverter x:Key="BoolToVisibility" />
            <sys:Double x:Key="ContentMinWidth">100</sys:Double>
            <sys:Double x:Key="ToggleSwitchMinWidth">60</sys:Double>
        </ResourceDictionary>
    </UserControl.Resources>

    <ScrollViewer HorizontalScrollBarVisibility="Disabled"
                  VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="5">
            <!--  Log Filter  -->
            <GroupBox Margin="0,0,0,8"
                      Header="Log Filter">
                <StackPanel Margin="8,5,8,8">
                    <!--  Minimum Level  -->
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Path Width="20"
                              Height="20"
                              VerticalAlignment="Center"
                              Data="{StaticResource LogLevel}"
                              Fill="{DynamicResource DevTools.MahApps.Brushes.ThemeForeground}"
                              Stretch="Uniform" />
                        <StackPanel Grid.Column="1"
                                    Margin="12,0"
                                    VerticalAlignment="Center">
                            <TextBlock FontWeight="SemiBold"
                                       Text="Minimum Level" />
                            <TextBlock FontSize="11"
                                       Foreground="{DynamicResource DevTools.MahApps.Brushes.Gray}"
                                       Text="Minimum level for displaying logs" />
                        </StackPanel>
                        <ComboBox Grid.Column="2"
                                  Width="{StaticResource ContentMinWidth}"
                                  VerticalAlignment="Center"
                                  ItemsSource="{Binding LogLevels, Mode=OneTime}"
                                  SelectedItem="{Binding LogLevel}" />
                    </Grid>

                    <Expander Margin="0,12,0,0"
                              Header="Level Detection Keywords"
                              IsExpanded="False">
                        <StackPanel>
                            <TextBlock Margin="0,4"
                                       FontSize="11"
                                       Foreground="{DynamicResource DevTools.MahApps.Brushes.Gray}"
                                       Text="comma-separated, max 5 keywords for each level" />
                            <!--  Information Keywords  -->
                            <TextBox Margin="0,4"
                                     mah:TextBoxHelper.UseFloatingWatermark="True"
                                     mah:TextBoxHelper.Watermark="Information"
                                     mah:ValidationHelper.ShowValidationErrorOnMouseOver="True"
                                     Text="{Binding InformationKeywords, ValidatesOnDataErrors=True, UpdateSourceTrigger=PropertyChanged, NotifyOnValidationError=True}" />
                            <!--  Warning Keywords  -->
                            <TextBox Margin="0,4"
                                     mah:TextBoxHelper.UseFloatingWatermark="True"
                                     mah:TextBoxHelper.Watermark="Warning"
                                     mah:ValidationHelper.ShowValidationErrorOnMouseOver="True"
                                     Text="{Binding WarningKeywords, ValidatesOnDataErrors=True, UpdateSourceTrigger=PropertyChanged, NotifyOnValidationError=True}" />
                            <!--  Error Keywords  -->
                            <TextBox Margin="0,4"
                                     mah:TextBoxHelper.UseFloatingWatermark="True"
                                     mah:TextBoxHelper.Watermark="Error"
                                     mah:ValidationHelper.ShowValidationErrorOnMouseOver="True"
                                     Text="{Binding ErrorKeywords, ValidatesOnDataErrors=True, UpdateSourceTrigger=PropertyChanged, NotifyOnValidationError=True}" />
                            <!--  Critical Keywords  -->
                            <TextBox Margin="0,4"
                                     mah:TextBoxHelper.UseFloatingWatermark="True"
                                     mah:TextBoxHelper.Watermark="Critical"
                                     mah:ValidationHelper.ShowValidationErrorOnMouseOver="True"
                                     Text="{Binding CriticalKeywords, ValidatesOnDataErrors=True, UpdateSourceTrigger=PropertyChanged, NotifyOnValidationError=True}" />
                        </StackPanel>
                    </Expander>
                </StackPanel>
            </GroupBox>

            <!--  Stack Trace  -->
            <GroupBox Margin="0,0,0,8"
                      Header="Stack Trace">
                <StackPanel Margin="8">
                    <!--  Stack Trace  -->
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Path Width="20"
                              Height="20"
                              VerticalAlignment="Center"
                              Data="{StaticResource Stack}"
                              Fill="{DynamicResource DevTools.MahApps.Brushes.ThemeForeground}"
                              Stretch="Uniform" />
                        <StackPanel Grid.Column="1"
                                    Margin="12,0"
                                    VerticalAlignment="Center">
                            <TextBlock FontWeight="SemiBold"
                                       Text="Include Stack Trace" />
                            <TextBlock FontSize="11"
                                       Foreground="{DynamicResource DevTools.MahApps.Brushes.Gray}"
                                       Text="Include stack trace frame information" />
                        </StackPanel>
                        <StackPanel Grid.Column="2"
                                    Orientation="Vertical">
                            <mah:ToggleSwitch MinWidth="{StaticResource ToggleSwitchMinWidth}"
                                              HorizontalAlignment="Right"
                                              VerticalAlignment="Bottom"
                                              IsOn="{Binding IncludeStackTrace}" />
                            <mah:NumericUpDown Width="{StaticResource ContentMinWidth}"
                                               Margin="0,8,0,0"
                                               HorizontalAlignment="Right"
                                               VerticalAlignment="Center"
                                               Minimum="1"
                                               Value="{Binding StackTraceDepth, UpdateSourceTrigger=PropertyChanged}"
                                               Visibility="{Binding IncludeStackTrace, Converter={StaticResource BoolToVisibility}}" />
                        </StackPanel>
                    </Grid>

                    <!--  WPF Trace  -->
                    <Grid Margin="0,8,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Image Width="20"
                               Height="20"
                               VerticalAlignment="Center"
                               Source="pack://application:,,,/RevitDevTool;component/Resources/Icons/wpf.png" />
                        <StackPanel Grid.Column="1"
                                    Margin="12,0"
                                    VerticalAlignment="Center">
                            <TextBlock FontWeight="SemiBold"
                                       Text="Include WPF Trace" />
                            <TextBlock FontSize="11"
                                       Foreground="{DynamicResource DevTools.MahApps.Brushes.Gray}"
                                       Text="Include presentation trace information" />
                        </StackPanel>
                        <StackPanel Grid.Column="2"
                                    Orientation="Vertical">
                            <mah:ToggleSwitch MinWidth="{StaticResource ToggleSwitchMinWidth}"
                                              HorizontalAlignment="Right"
                                              IsOn="{Binding IncludeWpfTrace}" />
                            <ComboBox Width="{StaticResource ContentMinWidth}"
                                      Margin="0,8,0,0"
                                      HorizontalAlignment="Right"
                                      ItemsSource="{Binding SourceLevels, Mode=OneTime}"
                                      SelectedItem="{Binding WpfTraceLevel}"
                                      Visibility="{Binding IncludeWpfTrace, Converter={StaticResource BoolToVisibility}}" />
                        </StackPanel>
                    </Grid>
                </StackPanel>
            </GroupBox>

            <!--  Log Sinks  -->
            <GroupBox Margin="0,0,0,8"
                      Header="Log Sinks">
                <StackPanel Margin="8,5,8,8">
                    <!--  Target Selector  -->
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Path Width="20"
                              Height="20"
                              VerticalAlignment="Center"
                              Data="{StaticResource MonitorLog}"
                              Fill="{DynamicResource DevTools.MahApps.Brushes.ThemeForeground}"
                              Stretch="Uniform" />
                        <StackPanel Grid.Column="1"
                                    Margin="12,0"
                                    VerticalAlignment="Center">
                            <TextBlock FontWeight="SemiBold"
                                       Text="Active Sinks" />
                            <TextBlock FontSize="11"
                                       Foreground="{DynamicResource DevTools.MahApps.Brushes.Gray}"
                                       Text="Select logging output destinations" />
                        </StackPanel>
                        <mah:MultiSelectionComboBox Grid.Column="2"
                                                    Width="200"
                                                    VerticalAlignment="Center"
                                                    mah:MultiSelectorHelper.SelectedItems="{Binding SelectedLogTargets}"
                                                    ItemContainerStyle="{StaticResource DevTools.MahApps.Styles.MultiSelectionComboBoxItem.CheckBox}"
                                                    ItemsSource="{Binding AvailableLogTargets, Mode=OneTime}"
                                                    SelectionMode="Multiple" />
                    </Grid>

                    <!--  JSON Output  -->
                    <Grid Margin="0,12,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Path Width="20"
                              Height="20"
                              VerticalAlignment="Center"
                              Data="{StaticResource PrettyJson}"
                              Fill="{DynamicResource DevTools.MahApps.Brushes.ThemeForeground}"
                              Stretch="Uniform" />
                        <StackPanel Grid.Column="1"
                                    Margin="12,0"
                                    VerticalAlignment="Center">
                            <TextBlock FontWeight="SemiBold"
                                       Text="JSON" />
                            <TextBlock FontSize="11"
                                       Foreground="{DynamicResource DevTools.MahApps.Brushes.Gray}"
                                       Text="Use JSON format for all logging outputs" />
                        </StackPanel>
                        <mah:ToggleSwitch Grid.Column="2"
                                          MinWidth="{StaticResource ToggleSwitchMinWidth}"
                                          HorizontalAlignment="Right"
                                          IsOn="{Binding EnableJson}" />
                    </Grid>

                    <!--  Revit Enrichers  -->
                    <Grid Margin="0,12,0,0"
                          Visibility="{Binding IsOutputSettingsVisible, Converter={StaticResource BoolToVisibility}}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Path Width="20"
                              Height="20"
                              VerticalAlignment="Center"
                              Data="{StaticResource RevitEnricher}"
                              Fill="{DynamicResource DevTools.MahApps.Brushes.ThemeForeground}"
                              Stretch="Uniform" />
                        <StackPanel Grid.Column="1"
                                    Margin="12,0"
                                    VerticalAlignment="Center">
                            <TextBlock FontWeight="SemiBold"
                                       Text="Revit Enrichers" />
                            <TextBlock FontSize="11"
                                       Foreground="{DynamicResource DevTools.MahApps.Brushes.Gray}"
                                       Text="Add Revit context to JSON logs" />
                        </StackPanel>
                        <mah:MultiSelectionComboBox Grid.Column="2"
                                                    Width="300"
                                                    VerticalAlignment="Center"
                                                    mah:MultiSelectorHelper.SelectedItems="{Binding SelectedRevitEnrichers}"
                                                    ItemContainerStyle="{StaticResource DevTools.MahApps.Styles.MultiSelectionComboBoxItem.CheckBox}"
                                                    ItemsSource="{Binding AvailableRevitEnrichers, Mode=OneTime}"
                                                    SelectionMode="Multiple" />
                    </Grid>
                </StackPanel>
            </GroupBox>

            <!--  File Logging  -->
            <GroupBox Margin="0,0,0,8"
                      Header="File Logging"
                      Visibility="{Binding IsFileTargetSelected, Converter={StaticResource BoolToVisibility}}">
                <StackPanel Margin="8,5,8,8">
                    <!--  Rolling Interval  -->
                    <Grid Margin="0,12,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Path Width="20"
                              Height="20"
                              VerticalAlignment="Center"
                              Data="{StaticResource Clock}"
                              Fill="{DynamicResource DevTools.MahApps.Brushes.ThemeForeground}"
                              Stretch="Uniform" />
                        <StackPanel Grid.Column="1"
                                    Margin="12,0"
                                    VerticalAlignment="Center">
                            <TextBlock FontWeight="SemiBold"
                                       Text="Rolling Interval" />
                            <TextBlock FontSize="11"
                                       Foreground="{DynamicResource DevTools.MahApps.Brushes.Gray}"
                                       Text="Create new file every" />
                        </StackPanel>
                        <ComboBox Grid.Column="2"
                                  Width="{StaticResource ContentMinWidth}"
                                  VerticalAlignment="Center"
                                  ItemsSource="{Binding LogTimeIntervals, Mode=OneTime}"
                                  SelectedItem="{Binding TimeInterval}" />
                    </Grid>

                    <!--  Auto Clean  -->
                    <Grid Margin="0,12,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Path Width="20"
                              Height="20"
                              VerticalAlignment="Center"
                              Data="{StaticResource Clear}"
                              Fill="{DynamicResource DevTools.MahApps.Brushes.ThemeForeground}"
                              Stretch="Uniform" />
                        <StackPanel Grid.Column="1"
                                    Margin="12,0"
                                    VerticalAlignment="Center">
                            <TextBlock FontWeight="SemiBold"
                                       Text="Auto Clean" />
                            <TextBlock FontSize="11"
                                       Foreground="{DynamicResource DevTools.MahApps.Brushes.Gray}"
                                       Text="Delete old log files when Revit startup or shutdown" />
                        </StackPanel>
                        <mah:ToggleSwitch Grid.Column="2"
                                          MinWidth="{StaticResource ToggleSwitchMinWidth}"
                                          VerticalAlignment="Bottom"
                                          IsOn="{Binding AutoClean}" />
                    </Grid>

                    <!--  Log Folder  -->
                    <Grid Margin="0,12,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Path Width="20"
                              Height="20"
                              VerticalAlignment="Center"
                              Data="{StaticResource Folder}"
                              Fill="{DynamicResource DevTools.MahApps.Brushes.ThemeForeground}"
                              Stretch="Uniform" />
                        <StackPanel Grid.Column="1"
                                    Margin="12,0">
                            <TextBlock FontWeight="SemiBold"
                                       Text="Log Folder" />
                            <TextBlock FontSize="11"
                                       Foreground="{DynamicResource DevTools.MahApps.Brushes.Gray}"
                                       Text="{Binding LogFolder}"
                                       TextTrimming="CharacterEllipsis"
                                       ToolTip="{Binding LogFolder}" />
                        </StackPanel>
                        <Button Grid.Column="2"
                                Padding="8,4"
                                Command="{Binding BrowseFolderCommand}"
                                Content="Browse..." />
                    </Grid>
                </StackPanel>
            </GroupBox>

            <!--  HTTP Logging  -->
            <GroupBox Margin="0,0,0,8"
                      Header="HTTP Logging"
                      Visibility="{Binding IsHttpTargetSelected, Converter={StaticResource BoolToVisibility}}">
                <StackPanel Margin="8,5,8,8">
                    <!--  Endpoint  -->
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Path Width="20"
                              Height="20"
                              VerticalAlignment="Center"
                              Data="{StaticResource Link}"
                              Fill="{DynamicResource DevTools.MahApps.Brushes.ThemeForeground}"
                              Stretch="Uniform" />
                        <StackPanel Grid.Column="1"
                                    Margin="12,0"
                                    VerticalAlignment="Center">
                            <TextBlock FontWeight="SemiBold"
                                       Text="Endpoint" />
                            <TextBlock FontSize="11"
                                       Foreground="{DynamicResource DevTools.MahApps.Brushes.Gray}"
                                       Text="HTTP endpoint URL to send logs" />
                        </StackPanel>
                        <TextBox Grid.Column="2"
                                 Width="250"
                                 VerticalAlignment="Center"
                                 mah:TextBoxHelper.UseFloatingWatermark="True"
                                 mah:TextBoxHelper.Watermark="https://..."
                                 Text="{Binding HttpEndpoint, UpdateSourceTrigger=PropertyChanged}" />
                    </Grid>

                    <!--  Batch Size  -->
                    <Grid Margin="0,12,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Path Width="20"
                              Height="20"
                              VerticalAlignment="Center"
                              Data="{StaticResource BulletList}"
                              Fill="{DynamicResource DevTools.MahApps.Brushes.ThemeForeground}"
                              Stretch="Uniform" />
                        <StackPanel Grid.Column="1"
                                    Margin="12,0"
                                    VerticalAlignment="Center">
                            <TextBlock FontWeight="SemiBold"
                                       Text="Batch Size" />
                            <TextBlock FontSize="11"
                                       Foreground="{DynamicResource DevTools.MahApps.Brushes.Gray}"
                                       Text="Number of log entries per HTTP request" />
                        </StackPanel>
                        <mah:NumericUpDown Grid.Column="2"
                                           Width="{StaticResource ContentMinWidth}"
                                           VerticalAlignment="Center"
                                           Minimum="1"
                                           Value="{Binding HttpBatchSize, UpdateSourceTrigger=PropertyChanged}" />
                    </Grid>

                </StackPanel>
            </GroupBox>
        </StackPanel>
    </ScrollViewer>
</UserControl>
