<UserControl x:Class="RevitDevTool.View.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:design="clr-namespace:DevTools.UI.Theme.Design;assembly=DevTools.UI"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:settings="http://devtools.presentation"
             xmlns:visualization="clr-namespace:RevitDevTool.View.Settings"
             d:DataContext="{d:DesignInstance settings:SettingsViewModel}"
             d:DesignHeight="630"
             d:DesignWidth="600"
             Background="{DynamicResource DevTools.MahApps.Brushes.ThemeBackground}"
             mc:Ignorable="d">

    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/DevTools.UI;component/Theme/Theme.xaml" />
                <design:IntellisenseResources Source="/DevTools.UI;component/Theme/Design/DesignTimeResources.xaml" />
            </ResourceDictionary.MergedDictionaries>
            <DataTemplate DataType="{x:Type settings:GeneralSettingsViewModel}">
                <settings:GeneralSettingsView />
            </DataTemplate>
            <DataTemplate DataType="{x:Type settings:LogSettingsViewModel}">
                <settings:LogSettingsView />
            </DataTemplate>
        </ResourceDictionary>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TabControl Grid.Row="0">
            <TabItem Header="General">
                <ContentControl Content="{Binding GeneralSettings}" />
            </TabItem>
            <TabItem Header="Visualization">
                <visualization:VisualizationSettingsView />
            </TabItem>
            <TabItem Header="Log">
                <ContentControl Content="{Binding LogSettings}" />
            </TabItem>
        </TabControl>

        <!--  Reset  -->
        <Button Grid.Row="1"
                Width="100"
                Margin="5,0,5,5"
                HorizontalAlignment="Right"
                HorizontalContentAlignment="Center"
                Command="{Binding ResetSettingsCommand}"
                Content="Reset settings"
                ToolTip="Reset all settings to default" />
    </Grid>
</UserControl>
