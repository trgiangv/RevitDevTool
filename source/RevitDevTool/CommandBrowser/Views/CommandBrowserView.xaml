<UserControl x:Class="RevitDevTool.CommandBrowser.Views.CommandBrowserView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:RevitDevTool.CommandBrowser.Controls"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:design="clr-namespace:DevTools.UI.Theme.Design;assembly=DevTools.UI"
             xmlns:mah="http://metro.devtools.ui/winfx/xaml/controls"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:models="clr-namespace:RevitDevTool.CommandBrowser.Models"
             xmlns:vm="clr-namespace:RevitDevTool.CommandBrowser.ViewModels"
             x:Name="CommandBrowserBar"
             d:DataContext="{d:DesignInstance vm:CommandBrowserViewModel}"
             d:DesignHeight="32"
             d:DesignWidth="600"
             Background="{DynamicResource DevTools.MahApps.Brushes.ThemeBackground}"
             mc:Ignorable="d">

    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/DevTools.UI;component/Theme/Theme.xaml" />
                <design:IntellisenseResources Source="/DevTools.UI;component/Theme/Design/DesignTimeResources.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <!--  Favourite Toggle Style  -->
            <Style x:Key="DevTools.Styles.ToggleButton.Favorite"
                   BasedOn="{StaticResource DevTools.MahApps.Styles.ToggleButton}"
                   TargetType="{x:Type ToggleButton}">
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="BorderBrush" Value="Transparent" />
                <Setter Property="BorderThickness" Value="0" />
                <Setter Property="FocusVisualStyle" Value="{x:Null}" />
                <Setter Property="mah:ControlsHelper.FocusBorderBrush" Value="Transparent" />
                <Setter Property="mah:ControlsHelper.MouseOverBorderBrush" Value="Transparent" />
                <Setter Property="mah:ControlsHelper.FocusBorderThickness" Value="0" />
                <Setter Property="ContentTemplate">
                    <Setter.Value>
                        <DataTemplate>
                            <Path Width="16"
                                  Height="16"
                                  Data="{StaticResource Heart}"
                                  Stretch="Uniform">
                                <Path.Style>
                                    <Style TargetType="{x:Type Path}">
                                        <Setter Property="Fill" Value="{StaticResource DevTools.MahApps.Brushes.ThemeForeground}" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsChecked, RelativeSource={RelativeSource AncestorType={x:Type ToggleButton}}}"
                                                         Value="True">
                                                <Setter Property="Fill" Value="{StaticResource DevTools.MahApps.Brushes.AccentBase}" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Path.Style>
                            </Path>
                        </DataTemplate>
                    </Setter.Value>
                </Setter>
                <Style.Triggers>
                    <!--  Checked, not hovered: no background / no border  -->
                    <Trigger Property="IsChecked" Value="True">
                        <Setter Property="Background" Value="Transparent" />
                        <Setter Property="BorderBrush" Value="Transparent" />
                    </Trigger>

                    <!--  Checked + hover: same background as unchecked + hover  -->
                    <MultiTrigger>
                        <MultiTrigger.Conditions>
                            <Condition Property="IsMouseOver" Value="True" />
                            <Condition Property="IsChecked" Value="True" />
                        </MultiTrigger.Conditions>

                        <Setter Property="Background" Value="{DynamicResource DevTools.MahApps.Brushes.Gray8}" />
                        <Setter Property="BorderBrush" Value="Transparent" />
                    </MultiTrigger>
                </Style.Triggers>
            </Style>

            <!--  Command Item Template  -->
            <DataTemplate x:Key="CommandItemTemplate"
                          DataType="{x:Type models:GroupedCommandEntry}">
                <Grid ToolTip="{Binding Command.RibbonInfo.ToolTip}"
                      ToolTipService.InitialShowDelay="200">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <Grid.Style>
                        <Style TargetType="Grid">
                            <Setter Property="Opacity" Value="1" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding Command.IsAvailable}"
                                             Value="False">
                                    <Setter Property="Opacity" Value="0.35" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Grid.Style>

                    <!--  Icon  -->
                    <Border Grid.Column="0"
                            Padding="2"
                            VerticalAlignment="Center"
                            Background="{Binding DataContext.IconsBackground, ElementName=CommandBrowserBar}"
                            BorderBrush="{DynamicResource DevTools.MahApps.Brushes.Gray6}"
                            BorderThickness="1"
                            CornerRadius="3">
                        <Image Width="16"
                               Height="16"
                               RenderOptions.BitmapScalingMode="NearestNeighbor"
                               SnapsToDevicePixels="True"
                               Source="{Binding Command.RibbonInfo.Image}" />
                    </Border>

                    <!--  Name and Tab  -->
                    <StackPanel x:Name="NamePanel"
                                Grid.Column="1"
                                Margin="4,0,0,0"
                                Orientation="Horizontal">
                        <TextBlock VerticalAlignment="Center"
                                   Foreground="{DynamicResource DevTools.MahApps.Brushes.ThemeForeground}"
                                   Text="{Binding Command.RibbonInfo.Name}" />
                        <TextBlock Margin="4,0,0,0"
                                   VerticalAlignment="Center"
                                   Foreground="{DynamicResource DevTools.MahApps.Brushes.Gray5}">
                            <Run Text="(" /><Run Text="{Binding Command.RibbonInfo.TabName, Mode=OneWay}" /><Run Text=")" />
                        </TextBlock>
                    </StackPanel>

                    <!--  Favorite toggle  -->
                    <ToggleButton Grid.Column="2"
                                  Margin="2"
                                  Cursor="Hand"
                                  IsChecked="{Binding Command.IsFavorite, Mode=OneWay}"
                                  PreviewMouseLeftButtonDown="HeartButton_PreviewMouseLeftButtonDown"
                                  Style="{StaticResource DevTools.Styles.ToggleButton.Favorite}"
                                  ToolTip="Toggle favorite" />
                </Grid>
            </DataTemplate>

            <!--  Header  -->
            <DataTemplate x:Key="GroupHeaderTemplate"
                          DataType="{x:Type CollectionViewGroup}">
                <TextBlock Margin="4,4,4,2"
                           FontSize="11"
                           FontWeight="SemiBold"
                           Foreground="{DynamicResource DevTools.MahApps.Brushes.Gray4}"
                           Text="{Binding Name}" />
            </DataTemplate>
        </ResourceDictionary>
    </UserControl.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <ToggleButton Grid.Column="0"
                      Width="{Binding ElementName=SearchComboBox, Path=ActualHeight}"
                      Height="{Binding ElementName=SearchComboBox, Path=ActualHeight}"
                      Margin="2"
                      IsChecked="{Binding ShowOnlyFavorites}"
                      PreviewMouseLeftButtonDown="FavToggleButton_PreviewMouseLeftButtonDown"
                      Style="{StaticResource DevTools.Styles.ToggleButton.Favorite}"
                      ToolTip="Show only favorites" />

        <controls:AutoCompleteComboBox x:Name="SearchComboBox"
                                       Grid.Column="1"
                                       Margin="2,2,0,2"
                                       VerticalAlignment="Center"
                                       ItemTemplate="{StaticResource CommandItemTemplate}"
                                       ItemsSource="{Binding AllItemsView}"
                                       MaxDropDownHeight="400"
                                       SelectionChanged="OnSelectionChanged"
                                       Style="{DynamicResource DevTools.MahApps.Styles.ComboBox.Virtualized}"
                                       TextSearch.TextPath="Command.RibbonInfo.Name">

            <controls:AutoCompleteComboBox.Setting>
                <controls:CommandBrowserFilterSetting />
            </controls:AutoCompleteComboBox.Setting>

            <controls:AutoCompleteComboBox.GroupStyle>
                <GroupStyle HeaderTemplate="{StaticResource GroupHeaderTemplate}" />
            </controls:AutoCompleteComboBox.GroupStyle>
        </controls:AutoCompleteComboBox>
    </Grid>
</UserControl>
