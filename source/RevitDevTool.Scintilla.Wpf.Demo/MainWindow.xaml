<Window x:Class="RevitDevTool.Scintilla.Wpf.Demo.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="RevitDevTool.Scintilla WPF Demo (ZLogger)"
        Width="1450"
        Height="900">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <DockPanel Grid.Row="0" Margin="8" LastChildFill="False">
            <Button x:Name="StartFloodButton" Width="110" Height="28" Margin="0,0,8,0" Content="Start Flood"/>
            <Button x:Name="StopFloodButton" Width="110" Height="28" Margin="0,0,8,0" Content="Stop Flood" IsEnabled="False"/>
            <Button x:Name="ClearButton" Width="80" Height="28" Margin="0,0,8,0" Content="Clear"/>
            <TextBlock Margin="8,6,4,0" Text="Clear:"/>
            <ComboBox x:Name="ClearModeCombo" Width="120" Height="28" Margin="0,0,8,0"/>
            <TextBlock Margin="8,6,4,0" Text="Level:"/>
            <ComboBox x:Name="LevelFilterCombo" Width="130" Height="28" Margin="0,0,8,0"/>
            <TextBlock Margin="8,6,4,0" Text="Render:"/>
            <CheckBox x:Name="PrettyJsonCheckBox" Margin="0,6,8,0" Content="PrettyJson" IsChecked="True"/>
            <CheckBox x:Name="TokenCallbackCheckBox" Margin="0,6,8,0" Content="Token Callback" IsChecked="True"/>
            <TextBlock Margin="8,6,4,0" Text="Theme:"/>
            <ComboBox x:Name="ThemeCombo" Width="120" Height="28" Margin="0,0,8,0"/>
            <TextBlock Margin="8,6,4,0" Text="Search:"/>
            <TextBox x:Name="SearchTextBox" Width="240" Height="28" Margin="0,0,8,0"/>
            <Button x:Name="FindNextButton" Width="100" Height="28" Margin="0,0,8,0" Content="Find Next"/>
            <TextBlock x:Name="MetricsTextBlock" Margin="12,6,0,0" TextWrapping="NoWrap"/>
        </DockPanel>

        <ContentControl x:Name="ViewerContainer" Grid.Row="1"/>
    </Grid>
</Window>
