<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <UseAutoCad>true</UseAutoCad>
        <UseWpf>true</UseWpf>
        <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
        <UseWindowsForms>true</UseWindowsForms>
        <DeployAutoCadBundle>true</DeployAutoCadBundle>
        <BundleDestinationFolder>$(AppData)\Autodesk\ApplicationPlugins\RevitDevTool.bundle</BundleDestinationFolder>
    </PropertyGroup>

    <PropertyGroup>
        <ILRepackable>true</ILRepackable>
        <RepackBinariesExcludes>
            DevTools.MahApps.Metro.dll;
            DevTools.ControlzEx.dll;
            DevTools.Microsoft.Xaml.Behaviors.dll;
            FSharp.Core.dll;
            DevTools.UI.dll;
            DevTools.NUnit.Runtime.dll;
            DevTools.Testing.Abstractions.dll;
        </RepackBinariesExcludes>
    </PropertyGroup>

    <ItemGroup>
        <!--UI-->
        <PackageReference Include="Microsoft.Web.WebView2" />
        <PackageReference Include="ricaun.AutoCAD.UI"/>
    </ItemGroup>

    <ItemGroup Condition="$(TargetFramework.StartsWith('net4'))">
        <Reference Include="System.IO.Compression" />
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="..\..\libs\pythonnet-stub-generator\csharp\PythonNetStubGenerator\PythonNetStubGenerator.csproj" />
        <ProjectReference Include="..\DevTools.Presentation\DevTools.Presentation.csproj" />
        <ProjectReference Include="..\DevTools.UI\DevTools.UI.csproj" />
        <ProjectReference Include="..\DevTools.Utilities\DevTools.Utilities.csproj" />
        <ProjectReference Include="..\DevTools.AssemblyIsolation\DevTools.AssemblyIsolation.csproj" />
        <ProjectReference Include="..\DevTools.Hosting\DevTools.Hosting.csproj" />
        <ProjectReference Include="..\DevTools.Logging\DevTools.Logging.csproj" />
        <ProjectReference Include="..\DevTools.Settings\DevTools.Settings.csproj" />
        <ProjectReference Include="..\DevTools.Execution\DevTools.Execution.csproj" />
        <ProjectReference Include="..\DevTools.Telemetry\DevTools.Telemetry.csproj" />
        <ProjectReference Include="..\DevTools.Execution.Abstractions\DevTools.Execution.Abstractions.csproj" />
        <ProjectReference Include="..\DevTools.Mcp.Acad\DevTools.Mcp.Acad.csproj" />
        <ProjectReference Include="..\DevTools.NUnit.Host\DevTools.NUnit.Host.csproj" />
        <ProjectReference Include="..\DevTools.TUnit.Host\DevTools.TUnit.Host.csproj"
            SetTargetFramework="TargetFramework=$(TargetFramework)" />
    </ItemGroup>

    <ItemGroup>
        <InternalsVisibleTo Include="AcadDevTool.Tests" />
    </ItemGroup>

    <ItemGroup>
        <Using Include="CommunityToolkit.Mvvm.ComponentModel" />
        <Using Include="CommunityToolkit.Mvvm.Input" />
        <Using Include="DevTools.Execution.Abstractions" />
        <Using Include="ZLogger.Providers" />
    </ItemGroup>

    <Import Project="..\DevTools.NUnit.Runtime\build\NUnitHostPackaging.targets" />
    <Import Project="..\DevTools.TUnit.Runtime\build\TUnitHostPackaging.targets" />

    <!-- Start AutoCad -->
    <PropertyGroup>
        <StartAction>Program</StartAction>
        <StartProgram>C:\Program Files\Autodesk\AutoCAD $(AutoCadVersion)\acad.exe</StartProgram>
        <StartArguments>/language ENG</StartArguments>
    </PropertyGroup>

</Project>
