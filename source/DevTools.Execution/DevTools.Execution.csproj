<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFrameworks>net48;net8.0-windows;net10.0-windows</TargetFrameworks>
        <UseWpf>true</UseWpf>
    </PropertyGroup>

    <ItemGroup>
        <!--UI-->
        <PackageReference Include="CommunityToolkit.Mvvm"/>

        <!--Python-->
        <PackageReference Include="pythonnet"/>
        <PackageReference Include="IronPython"/>

        <!--MCP-->
        <PackageReference Include="ModelContextProtocol"/>
        <PackageReference Include="ModelContextProtocol.Extensions.Tasks"/>
        <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions"/>

        <!--FSharp-->
        <PackageReference Include="FSharp.Core"/>
        <PackageReference Include="FSharp.Compiler.Service"/>

        <!--CSharp-->
        <PackageReference Include="Microsoft.CodeAnalysis.CSharp"/>

        <!-- Utils -->
        <PackageReference Include="System.Reflection.MetadataLoadContext"/>
        <PackageReference Include="System.Net.Http" Condition="$(TargetFramework.StartsWith('net4'))"/>
        <PackageReference Include="CliWrap"/>
        <PackageReference Include="ZLogger.Scintilla"/>
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="..\DevTools.Execution.Abstractions\DevTools.Execution.Abstractions.csproj" />
        <ProjectReference Include="..\DevTools.Settings\DevTools.Settings.csproj" />
        <ProjectReference Include="..\DevTools.UI\DevTools.UI.csproj" />
        <ProjectReference Include="..\DevTools.Hosting\DevTools.Hosting.csproj" />
        <ProjectReference Include="..\DevTools.Logging\DevTools.Logging.csproj" />
        <ProjectReference Include="..\DevTools.Utilities\DevTools.Utilities.csproj" />
        <ProjectReference Include="..\DevTools.AssemblyIsolation\DevTools.AssemblyIsolation.csproj" />
        <ProjectReference Include="..\DevTools.Mcp.Catalog\DevTools.Mcp.Catalog.csproj" SetTargetFramework="TargetFramework=$(TargetFramework)" />
        <ProjectReference Include="..\DevTools.Mcp.Core\DevTools.Mcp.Core.csproj" SetTargetFramework="TargetFramework=$(TargetFramework)" />
        <ProjectReference Include="..\DevTools.Ipc\DevTools.Ipc.csproj" />
        <ProjectReference Include="..\DevTools.Telemetry\DevTools.Telemetry.csproj" />
    </ItemGroup>

    <ItemGroup>
        <Using Include="CommunityToolkit.Mvvm.ComponentModel" />
        <Using Include="CommunityToolkit.Mvvm.Input" />
        <Using Include="DevTools.Execution.Abstractions" />
        <Using Include="DevTools.Ipc" />
        <Using Include="DevTools.Mcp.Core" />
        <Using Include="DevTools.Mcp.Core.Utils" />
        <Using Include="DevTools.Mcp.Catalog" />
        <Using Include="DevTools.Mcp.Catalog.Discovery" />
        <Using Include="DevTools.Mcp.Catalog.Isolation" />
        <Using Include="DevTools.Execution.External.Testing" />
        <Using Include="JetBrains.Annotations" />
        <Using Include="System" />
    </ItemGroup>

    <ItemGroup>
        <EmbeddedResource Include="Resources\*.*" />
        <EmbeddedResource Include="Resources\scripts\*.*" />
    </ItemGroup>

</Project>
