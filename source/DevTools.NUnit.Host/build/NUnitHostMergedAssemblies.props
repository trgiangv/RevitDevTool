<Project>
  <!--
    Assemblies owned by the host add-in surface:
    - DevTools.Testing.Abstractions: one shared type identity (loose beside the add-in)
    - Transport/JSON polyfills: ILRepack into the main host DLL

    Never place these inside NUnitRuntimePayload / NUnitRuntime\.
  -->
  <ItemGroup>
    <NUnitHostOwnedAssembly Include="DevTools.Ipc" />
    <NUnitHostOwnedAssembly Include="System.Text.Json" />
    <NUnitHostOwnedAssembly Include="System.Text.Encodings.Web" />
    <NUnitHostOwnedAssembly Include="System.IO.Pipelines" />
    <NUnitHostOwnedAssembly Include="Microsoft.Bcl.AsyncInterfaces" />
    <!-- The shared loader kernel is merged into the host add-in.  It must not
         enter NUnitRuntime as a second default-context identity. -->
    <NUnitHostOwnedAssembly Include="DevTools.AssemblyIsolation" />
    <TestingSharedAssembly Include="DevTools.Testing.Abstractions" />
  </ItemGroup>
</Project>
