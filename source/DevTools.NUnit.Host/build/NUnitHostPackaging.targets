<Project>
  <Import Project="$(MSBuildThisFileDirectory)NUnitHostMergedAssemblies.props" />

  <PropertyGroup>
    <NUnitRuntimeProject Condition="'$(NUnitRuntimeProject)' == ''">$(MSBuildThisFileDirectory)..\..\DevTools.NUnit.Runtime\DevTools.NUnit.Runtime.csproj</NUnitRuntimeProject>
  </PropertyGroup>

  <!--
    Copy Runtime-owned payload into $(TargetDir)NUnitRuntime\.
    Never use bare $(OutputPath) — when empty, MSBuild resolves relative to the
    project directory and creates a stray source/NUnitRuntime folder.
    Host JSON/IPC deps stay merged into the main add-in; NUnit Transport stays loose beside the add-in.
  -->
  <Target Name="CopyNUnitRuntimeBootstrap"
          AfterTargets="Build"
          BeforeTargets="RepackAddinFiles"
          Condition="'$(TargetPath)' != '' AND '$(TargetDir)' != ''">
    <PropertyGroup>
      <_NUnitRuntimeDeployDir>$([System.IO.Path]::GetFullPath('$(TargetDir)NUnitRuntime\'))</_NUnitRuntimeDeployDir>
      <_NUnitHostOutputDir>$([System.IO.Path]::GetFullPath('$(TargetDir)'))</_NUnitHostOutputDir>
    </PropertyGroup>

    <MSBuild Projects="$(NUnitRuntimeProject)"
             Targets="GetNUnitRuntimePayload"
             Properties="Configuration=$(Configuration);TargetFramework=$(TargetFramework)">
      <Output TaskParameter="TargetOutputs" ItemName="_NUnitRuntimePayload" />
    </MSBuild>

    <ItemGroup>
      <_NUnitRuntimePayloadAbsolute Include="@(_NUnitRuntimePayload->'%(FullPath)')"
                                    Condition="Exists('%(FullPath)')" />
      <_NUnitRuntimePayloadAbsolute Include="@(_NUnitRuntimePayload)"
                                    Condition="!Exists('%(FullPath)') AND Exists('%(Identity)')" />
      <_StaleFlatRuntime Include="$(_NUnitHostOutputDir)DevTools.NUnit.Runtime.dll"
                         Condition="Exists('$(_NUnitHostOutputDir)DevTools.NUnit.Runtime.dll')" />
      <_StaleFlatRuntime Include="$(_NUnitHostOutputDir)DevTools.NUnit.Runtime.pdb"
                         Condition="Exists('$(_NUnitHostOutputDir)DevTools.NUnit.Runtime.pdb')" />
    </ItemGroup>

    <Error Condition="'@(_NUnitRuntimePayloadAbsolute)' == ''"
           Text="NUnit runtime payload from '$(NUnitRuntimeProject)' was empty (TargetFramework=$(TargetFramework))." />

    <RemoveDir Directories="$(_NUnitRuntimeDeployDir)" Condition="Exists('$(_NUnitRuntimeDeployDir)')" />
    <MakeDir Directories="$(_NUnitRuntimeDeployDir)" />
    <Copy SourceFiles="@(_NUnitRuntimePayloadAbsolute)"
          DestinationFolder="$(_NUnitRuntimeDeployDir)"
          SkipUnchangedFiles="false" />
    <Delete Files="@(_StaleFlatRuntime)" />
  </Target>

  <Target Name="AssertNUnitHostDependencyOwnership"
          AfterTargets="RepackAddinFiles"
          Condition="'$(ILRepackable)' == 'true' AND '$(TargetPath)' != '' AND '$(TargetDir)' != ''">
    <PropertyGroup>
      <_NUnitHostOutputDir>$([System.IO.Path]::GetFullPath('$(TargetDir)'))</_NUnitHostOutputDir>
    </PropertyGroup>
    <ItemGroup>
      <_ForbiddenLooseHostDependency Include="$(_NUnitHostOutputDir)%(NUnitHostOwnedAssembly.Identity).dll"
                                     Condition="'%(NUnitHostOwnedAssembly.Identity)' != 'DevTools.NUnit.Transport'
                                                AND Exists('$(_NUnitHostOutputDir)%(NUnitHostOwnedAssembly.Identity).dll')" />
      <_ForbiddenLooseHostDependency Include="$(_NUnitHostOutputDir)NUnitRuntime\%(NUnitHostOwnedAssembly.Identity).dll"
                                     Condition="Exists('$(_NUnitHostOutputDir)NUnitRuntime\%(NUnitHostOwnedAssembly.Identity).dll')" />
      <_ForbiddenLooseHostDependency Include="$(_NUnitHostOutputDir)DevTools.NUnit.Runtime.dll"
                                     Condition="Exists('$(_NUnitHostOutputDir)DevTools.NUnit.Runtime.dll')" />
      <_RequiredLooseNUnitAssembly Include="$(_NUnitHostOutputDir)DevTools.NUnit.Transport.dll"
                                   Condition="!Exists('$(_NUnitHostOutputDir)DevTools.NUnit.Transport.dll')" />
      <_RequiredLooseNUnitAssembly Include="$(_NUnitHostOutputDir)NUnitRuntime\DevTools.NUnit.Runtime.dll"
                                   Condition="!Exists('$(_NUnitHostOutputDir)NUnitRuntime\DevTools.NUnit.Runtime.dll')" />
      <_RequiredLooseNUnitAssembly Include="$(_NUnitHostOutputDir)NUnitRuntime\nunit.framework.dll"
                                   Condition="!Exists('$(_NUnitHostOutputDir)NUnitRuntime\nunit.framework.dll')" />
      <_RequiredLooseTestingAssembly Include="$(_NUnitHostOutputDir)%(TestingSharedAssembly.Identity).dll"
                                     Condition="!Exists('$(_NUnitHostOutputDir)%(TestingSharedAssembly.Identity).dll')" />
      <_ForbiddenTestingCopy Include="$(_NUnitHostOutputDir)NUnitRuntime\%(TestingSharedAssembly.Identity).dll"
                             Condition="Exists('$(_NUnitHostOutputDir)NUnitRuntime\%(TestingSharedAssembly.Identity).dll')" />
      <_DuplicateTestingAbstractions Include="$(_NUnitHostOutputDir)DevTools.Testing.Abstractions.dll"
                                     Condition="Exists('$(_NUnitHostOutputDir)DevTools.Testing.Abstractions.dll')" />
      <_DuplicateTestingAbstractions Include="$(_NUnitHostOutputDir)NUnitRuntime\DevTools.Testing.Abstractions.dll"
                                     Condition="Exists('$(_NUnitHostOutputDir)NUnitRuntime\DevTools.Testing.Abstractions.dll')" />
      <_ForbiddenLegacyRunner Include="$(_NUnitHostOutputDir)DevTools.NUnit.Runner.exe"
                              Condition="Exists('$(_NUnitHostOutputDir)DevTools.NUnit.Runner.exe')" />
      <_ForbiddenMergedNUnit Include="$(_NUnitHostOutputDir)nunit.framework.dll"
                             Condition="Exists('$(_NUnitHostOutputDir)nunit.framework.dll')" />
      <_ForbiddenLooseTestingStack Include="$(_NUnitHostOutputDir)DevTools.Testing.Host.dll"
                                   Condition="Exists('$(_NUnitHostOutputDir)DevTools.Testing.Host.dll')" />
      <_ForbiddenLooseTestingStack Include="$(_NUnitHostOutputDir)DevTools.Testing.Transport.dll"
                                   Condition="Exists('$(_NUnitHostOutputDir)DevTools.Testing.Transport.dll')" />
    </ItemGroup>
    <Error Condition="'@(_ForbiddenLooseHostDependency)' != ''"
           Text="Host-owned dependencies must stay merged (or NUnit Transport-only loose), never dual-copied: @(_ForbiddenLooseHostDependency)" />
    <Error Condition="'@(_RequiredLooseNUnitAssembly)' != ''"
           Text="DevTools.NUnit.Transport must stay loose beside the add-in and Runtime private closure under NUnitRuntime\: @(_RequiredLooseNUnitAssembly)" />
    <Error Condition="'@(_RequiredLooseTestingAssembly)' != ''"
           Text="DevTools.Testing.Abstractions must stay loose beside the add-in exactly once: @(_RequiredLooseTestingAssembly)" />
    <Error Condition="'@(_ForbiddenTestingCopy)' != ''"
           Text="Testing.Abstractions must not ship inside NUnitRuntime\: @(_ForbiddenTestingCopy)" />
    <Error Condition="'@(_ForbiddenLegacyRunner)' != ''"
           Text="Do not ship DevTools.NUnit.Runner.exe: @(_ForbiddenLegacyRunner)" />
    <Error Condition="'@(_DuplicateTestingAbstractions->Count())' &gt; 1"
           Text="DevTools.Testing.Abstractions.dll must appear exactly once beside the add-in: @(_DuplicateTestingAbstractions)" />
    <Error Condition="'@(_ForbiddenMergedNUnit)' != ''"
           Text="NUnit framework assemblies must stay under NUnitRuntime\, not merged or copied at the add-in root: @(_ForbiddenMergedNUnit)" />
    <Error Condition="'@(_ForbiddenLooseTestingStack)' != ''"
           Text="Testing.Host and Testing.Transport must stay merged into the host add-in: @(_ForbiddenLooseTestingStack)" />
  </Target>
</Project>
