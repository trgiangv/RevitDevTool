<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <UseRevit>true</UseRevit>
    <UseWpf>true</UseWpf>
  </PropertyGroup>
  <PropertyGroup Condition="'$(CommandBuild)' == 'true'">
    <ILRepackable>true</ILRepackable>
    <OutputPath>bin\$(Configuration).Command\</OutputPath>
    <RepackBinariesExcludes>
      FSharp.Core.dll;
      DevTools.UI.dll;
      IronPython*.dll;
      Microsoft.Dynamic.dll;
      Microsoft.Scripting*.dll;
    </RepackBinariesExcludes>
    <RepackBinariesExcludes Condition="$(TargetFramework.StartsWith('net10'))">
      $(RepackBinariesExcludes)
      Nice3point.Revit.Extensions.dll;
    </RepackBinariesExcludes>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="CommunityToolkit.Mvvm" />
    <ProjectReference Include="..\RevitDevTool.Core\RevitDevTool.Core.csproj" />
    <ProjectReference Include="..\DevTools.UI\DevTools.UI.csproj" />
    <ProjectReference Include="..\DevTools.Settings\DevTools.Settings.csproj" />
    <ProjectReference Include="..\DevTools.ModelsContext\DevTools.ModelsContext.csproj" />
    <ProjectReference Include="..\DevTools.Presentation\DevTools.Presentation.csproj" />
  </ItemGroup>
  <ItemGroup>
    <Compile Remove="ModelsContext/Scripts/**" />
    <None Include="ModelsContext/Scripts/**" />
    <Compile Remove="ModelsContext/**" Condition="'$(RevitVersion)' == '2022'" />
  </ItemGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="RevitDevTool.ModelsContext.LiveTests" />
  </ItemGroup>
  <ItemGroup>
    <Using Include="CommunityToolkit.Mvvm.ComponentModel" />
    <Using Include="CommunityToolkit.Mvvm.Input" />
  </ItemGroup>
</Project>
