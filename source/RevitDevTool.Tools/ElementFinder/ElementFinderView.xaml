<Window x:Class="RevitDevTool.Tools.ElementFinder.ElementFinderView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:design="clr-namespace:DevTools.UI.Theme.Design;assembly=DevTools.UI"
        xmlns:hc="https://handyorg.github.io/handycontrol"
        xmlns:local="clr-namespace:RevitDevTool.Tools.ElementFinder"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        Width="240"
        Height="260"
        d:DataContext="{d:DesignInstance local:ElementFinderViewModel}"
        AllowsTransparency="True"
        Background="Transparent"
        ShowInTaskbar="False"
        WindowStartupLocation="Manual"
        WindowStyle="None"
        mc:Ignorable="d">

    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/DevTools.UI;component/Theme/Theme.xaml" />
                <design:IntellisenseResources Source="/DevTools.UI;component/Theme/Design/DesignTimeResources.xaml" />
            </ResourceDictionary.MergedDictionaries>
            <BooleanToVisibilityConverter x:Key="BoolToVis" />
        </ResourceDictionary>
    </Window.Resources>

    <Border Background="{DynamicResource RegionBrush}"
            CornerRadius="5">
        <Grid Margin="5">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Border Grid.Row="0"
                    Width="{Binding ActualWidth, RelativeSource={RelativeSource AncestorType=Grid}}"
                    Height="3"
                    Margin="0,0,0,6"
                    HorizontalAlignment="Center"
                    Background="{DynamicResource SecondaryTextBrush}"
                    CornerRadius="1.5"
                    Cursor="SizeAll" />

            <ComboBox Grid.Row="1"
                      Margin="0,0,0,4"
                      ItemsSource="{Binding Documents}"
                      SelectedItem="{Binding SelectedDocument}"
                      Style="{DynamicResource ComboBoxExtend}"
                      ToolTip="Document">
                <ComboBox.ItemTemplate>
                    <DataTemplate>
                        <DockPanel LastChildFill="True">
                            <Path Width="12"
                                  Height="12"
                                  Margin="0,0,6,0"
                                  Data="{StaticResource Link}"
                                  DockPanel.Dock="Left"
                                  Fill="{DynamicResource PrimaryTextBrush}"
                                  Stretch="Uniform"
                                  ToolTip="Linked document"
                                  Visibility="{Binding IsLinked, Converter={StaticResource BoolToVis}}" />
                            <TextBlock VerticalAlignment="Center"
                                       Text="{Binding Title}"
                                       TextTrimming="CharacterEllipsis" />
                        </DockPanel>
                    </DataTemplate>
                </ComboBox.ItemTemplate>
            </ComboBox>

            <hc:TextBox Grid.Row="2"
                        Margin="0,0,0,4"
                        VerticalContentAlignment="Top"
                        hc:InfoElement.Placeholder="ElementId, UniqueId or IFC Guid&#x0a;Ex:&#x0a;- 30,9946,1658795 (comma separated)&#x0a;- 30&#x0a;  9946&#x0a;  1658795 (line separated)"
                        hc:InfoElement.ShowClearButton="True"
                        AcceptsReturn="True"
                        Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                        TextWrapping="Wrap"
                        ToolTip="ElementId / UniqueId / IFC Guid"
                        VerticalScrollBarVisibility="Auto" />

            <UniformGrid Grid.Row="3"
                         Margin="0,0,0,4"
                         Columns="4"
                         Rows="1">
                <Button Margin="0,0,4,0"
                        Padding="6,4"
                        HorizontalAlignment="Stretch"
                        hc:IconElement.Geometry="{StaticResource Cursor}"
                        hc:IconElement.Height="14"
                        hc:IconElement.Width="14"
                        Command="{Binding SelectOnlyCommand}"
                        ToolTip="Select" />
                <Button Margin="0,0,4,0"
                        Padding="6,4"
                        HorizontalAlignment="Stretch"
                        hc:IconElement.Geometry="{StaticResource Zoom}"
                        hc:IconElement.Height="14"
                        hc:IconElement.Width="14"
                        Command="{Binding SelectAndZoomCommand}"
                        ToolTip="Select + Zoom" />
                <Button Margin="0,0,4,0"
                        Padding="6,4"
                        HorizontalAlignment="Stretch"
                        hc:IconElement.Geometry="{StaticResource SectionBox}"
                        hc:IconElement.Height="14"
                        hc:IconElement.Width="14"
                        Command="{Binding SelectZoomSectionBoxCommand}"
                        ToolTip="Select + Zoom + Section Box (3D)" />
                <Button Padding="6,4"
                        HorizontalAlignment="Stretch"
                        hc:IconElement.Geometry="{StaticResource QrCode}"
                        hc:IconElement.Height="14"
                        hc:IconElement.Width="14"
                        Click="CopyIdentifiersButton_Click"
                        ToolTip="Copy selected (ElementId / UniqueId / IfcGuid)">
                    <Button.ContextMenu>
                        <ContextMenu Width="{StaticResource Length200}"
                                     DataContext="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource Self}}">
                            <MenuItem Command="{Binding CopyElementIdsCommand}"
                                      Header="ElementId" />
                            <MenuItem Command="{Binding CopyUniqueIdsCommand}"
                                      Header="UniqueId" />
                            <MenuItem Command="{Binding CopyIfcGuidsCommand}"
                                      Header="IfcGuid" />
                        </ContextMenu>
                    </Button.ContextMenu>
                </Button>
            </UniformGrid>

            <TextBlock Grid.Row="4"
                       FontSize="10"
                       Foreground="{DynamicResource SecondaryTextBrush}"
                       Text="{Binding StatusText}"
                       TextWrapping="Wrap" />
        </Grid>
    </Border>
</Window>
