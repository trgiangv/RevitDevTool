<Window x:Class="RevitDevTool.Tools.ElementFinder.ElementFinderView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:design="clr-namespace:DevTools.UI.Theme.Design;assembly=DevTools.UI"
        xmlns:local="clr-namespace:RevitDevTool.Tools.ElementFinder"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        Width="240"
        Height="260"
        d:DataContext="{d:DesignInstance local:ElementFinderViewModel}"
        AllowsTransparency="True"
        Background="Transparent"
        ShowInTaskbar="False"
        WindowStartupLocation="Manual"
        WindowStyle="None"
        mc:Ignorable="d">

    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/DevTools.UI;component/Theme/FluentTheme.xaml" />
                <design:IntellisenseResources Source="/DevTools.UI;component/Theme/Design/FluentDesignTimeResources.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Window.Resources>

    <Border Background="{DynamicResource ApplicationBackgroundBrush}"
            CornerRadius="5">
        <Grid Margin="5">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Border Grid.Row="0"
                    Width="{Binding ActualWidth, RelativeSource={RelativeSource AncestorType=Grid}}"
                    Height="3"
                    Margin="0,0,0,6"
                    HorizontalAlignment="Center"
                    Background="{DynamicResource TextFillColorTertiaryBrush}"
                    CornerRadius="1.5"
                    Cursor="SizeAll" />

            <ComboBox Grid.Row="1"
                      Margin="0,0,0,4"
                      ItemsSource="{Binding Documents}"
                      SelectedItem="{Binding SelectedDocument}"
                      ToolTip="Document">
                <ComboBox.ItemTemplate>
                    <DataTemplate>
                        <DockPanel LastChildFill="True">
                            <Path Width="12"
                                  Height="12"
                                  Margin="0,0,6,0"
                                  Data="{StaticResource Link}"
                                  DockPanel.Dock="Left"
                                  Fill="{DynamicResource TextFillColorPrimaryBrush}"
                                  Stretch="Uniform"
                                  ToolTip="Linked document"
                                  Visibility="{Binding IsLinked, Converter={StaticResource BooleanToVisibilityConverter}}" />
                            <TextBlock VerticalAlignment="Center"
                                       Text="{Binding Title}"
                                       TextTrimming="CharacterEllipsis" />
                        </DockPanel>
                    </DataTemplate>
                </ComboBox.ItemTemplate>
            </ComboBox>

            <TextBox Grid.Row="2"
                     Margin="0,0,0,4"
                     AcceptsReturn="True"
                     Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                     TextWrapping="Wrap"
                     ToolTip="ElementId, UniqueId or IFC Guid&#x0a;Ex:&#x0a;- 30,9946,1658795 (comma separated)&#x0a;- 30&#x0a;  9946&#x0a;  1658795 (line separated)"
                     VerticalScrollBarVisibility="Auto" />

            <UniformGrid Grid.Row="3"
                         Margin="0,0,0,4"
                         Columns="4"
                         Rows="1">
                <Button Margin="0,0,4,0"
                        Padding="6,4"
                        HorizontalAlignment="Stretch"
                        Command="{Binding SelectOnlyCommand}"
                        ToolTip="Select">
                    <Path Width="14"
                          Height="14"
                          Data="{StaticResource Cursor}"
                          Fill="{DynamicResource TextFillColorPrimaryBrush}"
                          Stretch="Uniform" />
                </Button>
                <Button Margin="0,0,4,0"
                        Padding="6,4"
                        HorizontalAlignment="Stretch"
                        Command="{Binding SelectAndZoomCommand}"
                        ToolTip="Select + Zoom">
                    <Path Width="14"
                          Height="14"
                          Data="{StaticResource Zoom}"
                          Fill="{DynamicResource TextFillColorPrimaryBrush}"
                          Stretch="Uniform" />
                </Button>
                <Button Margin="0,0,4,0"
                        Padding="6,4"
                        HorizontalAlignment="Stretch"
                        Command="{Binding SelectZoomSectionBoxCommand}"
                        ToolTip="Select + Zoom + Section Box (3D)">
                    <Path Width="14"
                          Height="14"
                          Data="{StaticResource SectionBox}"
                          Fill="{DynamicResource TextFillColorPrimaryBrush}"
                          Stretch="Uniform" />
                </Button>
                <Button Padding="6,4"
                        HorizontalAlignment="Stretch"
                        Click="OnCopyMenuClick"
                        ToolTip="Copy selected (ElementId / UniqueId / IfcGuid)">
                    <Button.ContextMenu>
                        <ContextMenu x:Name="CopyContextMenu">
                            <MenuItem Command="{Binding CopyElementIdsCommand}"
                                      Header="ElementId" />
                            <MenuItem Command="{Binding CopyUniqueIdsCommand}"
                                      Header="UniqueId" />
                            <MenuItem Command="{Binding CopyIfcGuidsCommand}"
                                      Header="IfcGuid" />
                        </ContextMenu>
                    </Button.ContextMenu>
                    <Path Width="14"
                          Height="14"
                          Data="{StaticResource QrCode}"
                          Fill="{DynamicResource TextFillColorPrimaryBrush}"
                          Stretch="Uniform" />
                </Button>
            </UniformGrid>

            <TextBlock Grid.Row="4"
                       FontSize="10"
                       Foreground="{StaticResource TextFillColorSecondaryBrush}"
                       Text="{Binding StatusText}"
                       TextWrapping="Wrap" />
        </Grid>
    </Border>
</Window>
