<Window x:Class="RevitDevTool.Tools.ElementFinder.ElementFinderView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:design="clr-namespace:DevTools.UI.Theme.Design;assembly=DevTools.UI"
        xmlns:local="clr-namespace:RevitDevTool.Tools.ElementFinder"
        xmlns:mah="http://metro.devtools.ui/winfx/xaml/controls"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        Width="240"
        Height="260"
        d:DataContext="{d:DesignInstance local:ElementFinderViewModel}"
        AllowsTransparency="True"
        Background="Transparent"
        ShowInTaskbar="False"
        WindowStartupLocation="Manual"
        WindowStyle="None"
        mc:Ignorable="d">

    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/DevTools.UI;component/Theme/Theme.xaml" />
                <design:IntellisenseResources Source="/DevTools.UI;component/Theme/Design/DesignTimeResources.xaml" />
            </ResourceDictionary.MergedDictionaries>
            <BooleanToVisibilityConverter x:Key="BoolToVis" />
        </ResourceDictionary>
    </Window.Resources>

    <Border Background="{DynamicResource DevTools.MahApps.Brushes.ThemeBackground}"
            CornerRadius="5">
        <Grid Margin="5">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Border Grid.Row="0"
                    Width="{Binding ActualWidth, RelativeSource={RelativeSource AncestorType=Grid}}"
                    Height="3"
                    Margin="0,0,0,6"
                    HorizontalAlignment="Center"
                    Background="{DynamicResource DevTools.MahApps.Brushes.Gray3}"
                    CornerRadius="1.5"
                    Cursor="SizeAll" />

            <ComboBox Grid.Row="1"
                      Margin="0,0,0,4"
                      ItemsSource="{Binding Documents}"
                      SelectedItem="{Binding SelectedDocument}"
                      Style="{DynamicResource DevTools.MahApps.Styles.ComboBox}"
                      ToolTip="Document">
                <ComboBox.ItemTemplate>
                    <DataTemplate>
                        <DockPanel LastChildFill="True">
                            <Path Width="12"
                                  Height="12"
                                  Margin="0,0,6,0"
                                  Data="{StaticResource Link}"
                                  DockPanel.Dock="Left"
                                  Fill="{DynamicResource DevTools.MahApps.Brushes.ThemeForeground}"
                                  Stretch="Uniform"
                                  ToolTip="Linked document"
                                  Visibility="{Binding IsLinked, Converter={StaticResource BoolToVis}}" />
                            <TextBlock VerticalAlignment="Center"
                                       Text="{Binding Title}"
                                       TextTrimming="CharacterEllipsis" />
                        </DockPanel>
                    </DataTemplate>
                </ComboBox.ItemTemplate>
            </ComboBox>

            <TextBox Grid.Row="2"
                     Margin="0,0,0,4"
                     mah:TextBoxHelper.Watermark="ElementId, UniqueId or IFC Guid&#x0a;Ex:&#x0a;- 30,9946,1658795 (comma separated)&#x0a;- 30&#x0a;  9946&#x0a;  1658795 (line separated)"
                     AcceptsReturn="True"
                     Style="{DynamicResource DevTools.MahApps.Styles.TextBox}"
                     Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                     TextWrapping="Wrap"
                     ToolTip="ElementId / UniqueId / IFC Guid"
                     VerticalScrollBarVisibility="Auto" />

            <UniformGrid Grid.Row="3"
                         Margin="0,0,0,4"
                         Columns="4"
                         Rows="1">
                <Button Margin="0,0,4,0"
                        Padding="6,4"
                        Command="{Binding SelectOnlyCommand}"
                        ToolTip="Select">
                    <Path Width="14"
                          Height="14"
                          Data="{StaticResource Cursor}"
                          Fill="{DynamicResource DevTools.MahApps.Brushes.ThemeForeground}"
                          Stretch="Uniform" />
                </Button>
                <Button Margin="0,0,4,0"
                        Padding="6,4"
                        Command="{Binding SelectAndZoomCommand}"
                        ToolTip="Select + Zoom">
                    <Path Width="14"
                          Height="14"
                          Data="{StaticResource Zoom}"
                          Fill="{DynamicResource DevTools.MahApps.Brushes.ThemeForeground}"
                          Stretch="Uniform" />
                </Button>
                <Button Margin="0,0,4,0"
                        Padding="6,4"
                        Command="{Binding SelectZoomSectionBoxCommand}"
                        ToolTip="Select + Zoom + Section Box (3D)">
                    <Path Width="14"
                          Height="14"
                          Data="{StaticResource SectionBox}"
                          Fill="{DynamicResource DevTools.MahApps.Brushes.ThemeForeground}"
                          Stretch="Uniform" />
                </Button>
                <mah:DropDownButton mah:ControlsHelper.CornerRadius="3"
                                    ArrowVisibility="Collapsed"
                                    BorderBrush="{StaticResource DevTools.MahApps.Brushes.Button.Border}"
                                    ToolTip="Copy selected (ElementId / UniqueId / IfcGuid)">
                    <mah:DropDownButton.Icon>
                        <Path Width="14"
                              Height="14"
                              Data="{StaticResource QrCode}"
                              Fill="{DynamicResource DevTools.MahApps.Brushes.ThemeForeground}"
                              Stretch="Uniform" />
                    </mah:DropDownButton.Icon>
                    <mah:DropDownButton.Items>
                        <MenuItem Command="{Binding CopyElementIdsCommand}"
                                  Header="ElementId" />
                        <MenuItem Command="{Binding CopyUniqueIdsCommand}"
                                  Header="UniqueId" />
                        <MenuItem Command="{Binding CopyIfcGuidsCommand}"
                                  Header="IfcGuid" />
                    </mah:DropDownButton.Items>
                </mah:DropDownButton>
            </UniformGrid>

            <TextBlock Grid.Row="4"
                       FontSize="10"
                       Foreground="{DynamicResource DevTools.MahApps.Brushes.Gray3}"
                       Text="{Binding StatusText}"
                       TextWrapping="Wrap" />
        </Grid>
    </Border>
</Window>
