<UserControl x:Class="RevitDevTool.Tools.CommandBrowser.Views.CommandBrowserView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:design="clr-namespace:DevTools.UI.Theme.Design;assembly=DevTools.UI"
             xmlns:dui="clr-namespace:DevTools.UI.Controls;assembly=DevTools.UI"
             xmlns:hc="https://handyorg.github.io/handycontrol"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:models="clr-namespace:RevitDevTool.Tools.CommandBrowser.Models"
             xmlns:vm="clr-namespace:RevitDevTool.Tools.CommandBrowser.ViewModels"
             x:Name="CommandBrowserBar"
             d:DataContext="{d:DesignInstance vm:CommandBrowserViewModel}"
             d:DesignHeight="32"
             d:DesignWidth="600"
             Background="{DynamicResource RegionBrush}"
             mc:Ignorable="d">

    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/DevTools.UI;component/Theme/Theme.xaml" />
                <design:IntellisenseResources Source="/DevTools.UI;component/Theme/Design/DesignTimeResources.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <!--  Hover-reveal bookmark. Click must not select the combo row.  -->
            <Style x:Key="CommandItemFavoriteButton"
                   d:DataContext="{d:DesignInstance models:GroupedCommandEntry}"
                   TargetType="Button">
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="BorderBrush" Value="Transparent" />
                <Setter Property="BorderThickness" Value="0" />
                <Setter Property="FocusVisualStyle" Value="{x:Null}" />
                <Setter Property="Cursor" Value="Hand" />
                <Setter Property="Padding" Value="6,0" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Border Padding="{TemplateBinding Padding}"
                                    Background="Transparent">
                                <Path x:Name="Icon"
                                      Width="12"
                                      Height="12"
                                      HorizontalAlignment="Center"
                                      VerticalAlignment="Center"
                                      Data="{StaticResource BookmarkOn}"
                                      Fill="{DynamicResource PrimaryBrush}"
                                      Opacity="0"
                                      Stretch="Uniform" />
                            </Border>
                            <ControlTemplate.Triggers>
                                <DataTrigger Binding="{Binding IsMouseOver, RelativeSource={RelativeSource AncestorType=Grid}}"
                                             Value="True">
                                    <Setter TargetName="Icon" Property="Opacity" Value="0.4" />
                                </DataTrigger>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Icon" Property="Opacity" Value="1" />
                                </Trigger>
                                <DataTrigger Binding="{Binding Command.IsFavorite}"
                                             Value="True">
                                    <Setter TargetName="Icon" Property="Opacity" Value="1" />
                                    <Setter TargetName="Icon" Property="Fill" Value="{DynamicResource DarkPrimaryBrush}" />
                                </DataTrigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <DataTemplate x:Key="CommandItemTemplate"
                          DataType="{x:Type models:GroupedCommandEntry}">
                <Grid ToolTip="{Binding Command.RibbonInfo.ToolTip}"
                      ToolTipService.InitialShowDelay="200">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="28" />
                    </Grid.ColumnDefinitions>

                    <Grid.Style>
                        <Style TargetType="Grid">
                            <Setter Property="Opacity" Value="1" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding Command.RibbonInfo.IsEnabled}"
                                             Value="False">
                                    <Setter Property="Opacity" Value="0.35" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Grid.Style>

                    <Border Grid.Column="0"
                            Padding="2"
                            VerticalAlignment="Center"
                            Background="{Binding DataContext.IconsBackground, ElementName=CommandBrowserBar}"
                            BorderBrush="{DynamicResource BorderBrush}"
                            BorderThickness="1"
                            CornerRadius="{StaticResource DefaultCornerRadius}">
                        <Image Width="{StaticResource Length16}"
                               Height="{StaticResource Length16}"
                               RenderOptions.BitmapScalingMode="NearestNeighbor"
                               SnapsToDevicePixels="True"
                               Source="{Binding Command.RibbonInfo.Image}" />
                    </Border>

                    <TextBlock Grid.Column="1"
                               Margin="4,0,0,0"
                               VerticalAlignment="Center"
                               TextTrimming="CharacterEllipsis">
                        <Run Foreground="{DynamicResource PrimaryTextBrush}"
                             Text="{Binding Command.RibbonInfo.Name, Mode=OneWay}" /><Run Foreground="{DynamicResource ThirdlyTextBrush}"
                             Text=" (" /><Run Foreground="{DynamicResource ThirdlyTextBrush}"
                             Text="{Binding Command.RibbonInfo.TabName, Mode=OneWay}" /><Run Foreground="{DynamicResource ThirdlyTextBrush}"
                             Text=")" />
                    </TextBlock>

                    <Button Grid.Column="2"
                            PreviewMouseLeftButtonDown="OnFavoriteClick"
                            Style="{StaticResource CommandItemFavoriteButton}"
                            ToolTip="Toggle favorite" />
                </Grid>
            </DataTemplate>

            <DataTemplate x:Key="GroupHeaderTemplate"
                          DataType="{x:Type CollectionViewGroup}">
                <TextBlock Margin="4,6,4,2"
                           FontWeight="SemiBold"
                           Foreground="{DynamicResource ThirdlyTextBrush}"
                           Text="{Binding Name}" />
            </DataTemplate>
        </ResourceDictionary>
    </UserControl.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>

        <ToggleButton Grid.Column="0"
                      Width="{Binding ActualHeight, ElementName=SearchComboBox}"
                      Height="{Binding ActualHeight, ElementName=SearchComboBox}"
                      Margin="2"
                      Padding="0"
                      VerticalAlignment="Center"
                      IsChecked="{Binding ShowOnlyFavorites}"
                      PreviewMouseLeftButtonDown="OnFavoritesFilterClick"
                      Style="{StaticResource ToggleButtonDefault}"
                      ToolTip="Show only favorites">
            <Path Width="14"
                  Height="14"
                  Fill="{DynamicResource PrimaryBrush}"
                  Stretch="Uniform">
                <Path.Style>
                    <Style TargetType="Path">
                        <Setter Property="Data" Value="{StaticResource BookmarkOff}" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding ShowOnlyFavorites}"
                                         Value="True">
                                <Setter Property="Data" Value="{StaticResource BookmarkOn}" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Path.Style>
            </Path>
        </ToggleButton>

        <dui:AutoCompleteComboBox x:Name="SearchComboBox"
                                  Grid.Column="1"
                                  Margin="2,2,0,2"
                                  VerticalAlignment="Center"
                                  ItemTemplate="{StaticResource CommandItemTemplate}"
                                  ItemsSource="{Binding AllItemsView}"
                                  MaxDropDownHeight="400"
                                  SelectionChanged="OnSelectionChanged"
                                  Style="{DynamicResource ComboBoxExtend}"
                                  TextSearch.TextPath="Command.RibbonInfo.Name">
            <ComboBox.ItemContainerStyle>
                <Style BasedOn="{StaticResource ComboBoxItemBaseStyle}"
                       TargetType="ComboBoxItem">
                    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                </Style>
            </ComboBox.ItemContainerStyle>
            <dui:AutoCompleteComboBox.Setting>
                <models:CommandBrowserFilterSetting />
            </dui:AutoCompleteComboBox.Setting>
            <dui:AutoCompleteComboBox.GroupStyle>
                <GroupStyle HeaderTemplate="{StaticResource GroupHeaderTemplate}" />
            </dui:AutoCompleteComboBox.GroupStyle>
        </dui:AutoCompleteComboBox>

        <ToggleButton Grid.Column="2"
                      Margin="2"
                      VerticalAlignment="Center"
                      IsChecked="{Binding ElementFinder.IsOpen}"
                      Style="{StaticResource ToggleButtonFlip}"
                      ToolTip="Element Finder">
            <hc:StatusSwitchElement.CheckedElement>
                <Border Background="{StaticResource PrimaryBrush}">
                    <Path Width="{StaticResource Length16}"
                          Height="{StaticResource Length16}"
                          HorizontalAlignment="Center"
                          VerticalAlignment="Center"
                          Data="{StaticResource Search}"
                          Fill="{DynamicResource TextIconBrush}"
                          Stretch="Uniform" />
                </Border>
            </hc:StatusSwitchElement.CheckedElement>
            <Path Width="{StaticResource Length16}"
                  Height="{StaticResource Length16}"
                  HorizontalAlignment="Center"
                  VerticalAlignment="Center"
                  Data="{StaticResource Search}"
                  Fill="{DynamicResource PrimaryTextBrush}"
                  Stretch="Uniform" />
        </ToggleButton>
    </Grid>
</UserControl>
