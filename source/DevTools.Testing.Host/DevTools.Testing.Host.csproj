<Project Sdk="Microsoft.NET.Sdk">
    <PropertyGroup>
        <TargetFrameworks>net48;net8.0-windows;net10.0-windows</TargetFrameworks>
        <RootNamespace>DevTools.Testing.Host</RootNamespace>
        <AssemblyName>DevTools.Testing.Host</AssemblyName>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions"/>
        <InternalsVisibleTo Include="DevTools.Testing.Host.Tests"/>
        <InternalsVisibleTo Include="DevTools.NUnit.Host.Tests"/>
        <InternalsVisibleTo Include="DevTools.NUnit.Host.NetFramework.Tests"/>
        <InternalsVisibleTo Include="DevTools.TUnit.Host.Tests"/>
        <InternalsVisibleTo Include="NetFrameworkGenerationProbe"/>
        <ProjectReference Include="..\DevTools.Testing.Abstractions\DevTools.Testing.Abstractions.csproj"/>
        <ProjectReference Include="..\DevTools.Testing.Transport\DevTools.Testing.Transport.csproj"/>
        <ProjectReference Include="..\DevTools.Ipc\DevTools.Ipc.csproj"/>
        <ProjectReference Include="..\DevTools.Hosting\DevTools.Hosting.csproj"/>
        <ProjectReference Include="..\DevTools.Execution.Abstractions\DevTools.Execution.Abstractions.csproj"/>
        <ProjectReference Include="..\DevTools.AssemblyIsolation\DevTools.AssemblyIsolation.csproj"/>
        <ProjectReference Include="..\DevTools.NUnit.Runtime\DevTools.NUnit.Runtime.csproj"
                          ReferenceOutputAssembly="false"
                          SetTargetFramework="TargetFramework=$(TargetFramework)"/>
        <ProjectReference Include="..\DevTools.TUnit.Runtime\DevTools.TUnit.Runtime.csproj"
                          ReferenceOutputAssembly="false"
                          SetTargetFramework="TargetFramework=$(TargetFramework)"/>
    </ItemGroup>
</Project>
