<Project>
  <!--
    net48 MTP test exe: merge copy-local managed DLLs into the exe (same flags as
    DevTools.NUnit.TestAdapter), then delete the merged satellites. Host generation
    then copies the exe + nunit.framework, not a pile of BCL polyfills.

    Never merge:
    - nunit.framework*: generation requires a loose 4.6.1 copy; attribute identity
      must match the host Runtime.
    - Autodesk / Revit / AutoCAD APIs: resolve from the host process.
    - MahApps / ControlzEx / Xaml.Behaviors: host-shared WPF (pack://).
    - WebView2 / CefSharp: mixed/native.

    Do not reuse the host add-in packing flag on the test project.
  -->
  <Target Name="DevToolsNUnitRepackNet48TestExe"
          AfterTargets="Build"
          Condition="'$(IsTestingPlatformApplication)' == 'true'
                     and $(TargetFramework.StartsWith('net4'))
                     and '$(DevToolsNUnitRepack)' != 'false'
                     and '$(TargetPath)' != ''">

    <ItemGroup>
      <_DevToolsNUnitILRepackVersion Include="@(PackageVersion)"
                                     Condition="'%(PackageVersion.Identity)' == 'ILRepack'"/>
    </ItemGroup>
    <ItemGroup Condition="'@(_DevToolsNUnitILRepackVersion->Count())' == '0'">
      <_DevToolsNUnitILRepackVersion Include="@(PackageReference)"
                                     Condition="'%(PackageReference.Identity)' == 'ILRepack'"/>
    </ItemGroup>

    <PropertyGroup>
      <_DevToolsNUnitILRepackVer>%(_DevToolsNUnitILRepackVersion.Version)</_DevToolsNUnitILRepackVer>
      <_DevToolsNUnitILRepackVer Condition="'$(_DevToolsNUnitILRepackVer)' == ''">%(_DevToolsNUnitILRepackVersion.VersionOverride)</_DevToolsNUnitILRepackVer>
      <_DevToolsNUnitILRepackVer Condition="'$(_DevToolsNUnitILRepackVer)' == ''">2.0.45</_DevToolsNUnitILRepackVer>
      <_DevToolsNUnitILRepackExe Condition="Exists('$(MSBuildThisFileDirectory)..\tools\ILRepack.exe')">$([System.IO.Path]::GetFullPath('$(MSBuildThisFileDirectory)..\tools\ILRepack.exe'))</_DevToolsNUnitILRepackExe>
      <_DevToolsNUnitILRepackExe Condition="'$(_DevToolsNUnitILRepackExe)' == '' and Exists('$(NuGetPackageRoot)ilrepack\$(_DevToolsNUnitILRepackVer)\tools\ILRepack.exe')">$(NuGetPackageRoot)ilrepack\$(_DevToolsNUnitILRepackVer)\tools\ILRepack.exe</_DevToolsNUnitILRepackExe>
      <_DevToolsNUnitILRepackExe Condition="'$(_DevToolsNUnitILRepackExe)' == '' and Exists('$(NuGetPackageRoot)ilrepack\2.0.45\tools\ILRepack.exe')">$(NuGetPackageRoot)ilrepack\2.0.45\tools\ILRepack.exe</_DevToolsNUnitILRepackExe>
      <_DevToolsNUnitILRepackExe Condition="'$(_DevToolsNUnitILRepackExe)' == '' and Exists('$(NuGetPackageRoot)ilrepack\2.0.44\tools\ILRepack.exe')">$(NuGetPackageRoot)ilrepack\2.0.44\tools\ILRepack.exe</_DevToolsNUnitILRepackExe>
    </PropertyGroup>

    <Error Condition="!Exists('$(_DevToolsNUnitILRepackExe)')"
           Text="RevitDevTool.NUnit net48 ILRepack: ILRepack.exe not found. Restore ILRepack or use the NuGet package (tools/ILRepack.exe). Set DevToolsNUnitRepack=false to skip."/>

    <ItemGroup>
      <_DevToolsNUnitRepackExclude Include="$(TargetDir)nunit.framework.dll"/>
      <_DevToolsNUnitRepackExclude Include="$(TargetDir)nunit.framework.legacy.dll"/>
      <_DevToolsNUnitRepackExclude Include="$(TargetDir)Autodesk.*.dll"/>
      <_DevToolsNUnitRepackExclude Include="$(TargetDir)RevitAPI*.dll"/>
      <_DevToolsNUnitRepackExclude Include="$(TargetDir)AdWindows.dll"/>
      <_DevToolsNUnitRepackExclude Include="$(TargetDir)UIFramework*.dll"/>
      <_DevToolsNUnitRepackExclude Include="$(TargetDir)MahApps*.dll"/>
      <_DevToolsNUnitRepackExclude Include="$(TargetDir)ControlzEx*.dll"/>
      <_DevToolsNUnitRepackExclude Include="$(TargetDir)Microsoft.Xaml.Behaviors*.dll"/>
      <_DevToolsNUnitRepackExclude Include="$(TargetDir)Microsoft.Web.WebView2*.dll"/>
      <_DevToolsNUnitRepackExclude Include="$(TargetDir)WebView2Loader.dll"/>
      <_DevToolsNUnitRepackExclude Include="$(TargetDir)CefSharp*.dll"/>
      <_DevToolsNUnitRepackExclude Include="$(TargetDir)acmgd.dll"/>
      <_DevToolsNUnitRepackExclude Include="$(TargetDir)acdbmgd.dll"/>
      <_DevToolsNUnitRepackExclude Include="$(TargetDir)accoremgd.dll"/>
      <_DevToolsNUnitRepackExclude Include="$(TargetDir)acdbmgdbrep.dll"/>
    </ItemGroup>
    <ItemGroup Condition="'$(DevToolsNUnitRepackBinariesExcludes)' != ''">
      <_DevToolsNUnitRepackExcludeNames Include="$(DevToolsNUnitRepackBinariesExcludes.Split(';'))"/>
      <_DevToolsNUnitRepackExclude Include="$(TargetDir)%(_DevToolsNUnitRepackExcludeNames.Identity)"/>
    </ItemGroup>

    <ItemGroup>
      <_DevToolsNUnitRepackInput Include="$(TargetPath)"/>
      <_DevToolsNUnitRepackInput Include="$(TargetDir)*.dll"
                                 Exclude="@(_DevToolsNUnitRepackExclude)"/>
    </ItemGroup>

    <PropertyGroup>
      <_DevToolsNUnitILRepackOutput>/out:&quot;$(TargetPath)&quot;</_DevToolsNUnitILRepackOutput>
      <_DevToolsNUnitILRepackInput>@(_DevToolsNUnitRepackInput -> '&quot;%(FullPath)&quot;', ' ')</_DevToolsNUnitILRepackInput>
      <_DevToolsNUnitILRepackLib>@(ReferencePath->'%(RelativeDir)'->Distinct()->'/lib:&quot;%(identity) &quot;', ' ')</_DevToolsNUnitILRepackLib>
      <_DevToolsNUnitILRepackCmd>&quot;$(_DevToolsNUnitILRepackExe)&quot; /internalize /union /illink /parallel $(_DevToolsNUnitILRepackOutput) $(_DevToolsNUnitILRepackLib) $(_DevToolsNUnitILRepackInput)</_DevToolsNUnitILRepackCmd>
    </PropertyGroup>

    <Message Text="RevitDevTool.NUnit: ILRepack net48 $(TargetPath)" Importance="high"/>

    <Exec Command="$(_DevToolsNUnitILRepackCmd)"
          Condition="!$(Configuration.Contains('Release'))"/>
    <Exec Command="$(_DevToolsNUnitILRepackCmd) /noRepackRes /ndebug"
          StandardOutputImportance="Low"
          Condition="$(Configuration.Contains('Release'))"/>

    <ItemGroup>
      <_DevToolsNUnitRepackedFiles
          Include="@(_DevToolsNUnitRepackInput -> '%(RootDir)%(Directory)%(Filename).dll')"
          Condition="%(Filename) != $(AssemblyName)"/>
      <_DevToolsNUnitRepackedFiles
          Include="@(_DevToolsNUnitRepackInput -> '%(RootDir)%(Directory)%(Filename).pdb')"
          Condition="%(Filename) != $(AssemblyName)"/>
    </ItemGroup>
    <Delete Files="@(_DevToolsNUnitRepackedFiles)"/>

    <ItemGroup>
      <_DevToolsNUnitSatelliteDirs Include="$(TargetDir)cs;$(TargetDir)de;$(TargetDir)es;$(TargetDir)fr;$(TargetDir)it;$(TargetDir)ja;$(TargetDir)ko;$(TargetDir)pl;$(TargetDir)pt-BR;$(TargetDir)ru;$(TargetDir)tr;$(TargetDir)zh-Hans;$(TargetDir)zh-Hant"/>
    </ItemGroup>
    <RemoveDir Directories="@(_DevToolsNUnitSatelliteDirs)" Condition="Exists('%(Identity)')"/>
  </Target>
</Project>
