<Project Sdk="Microsoft.NET.Sdk">
    <PropertyGroup>
        <TargetFrameworks>net48;net8.0-windows;net10.0-windows</TargetFrameworks>
        <!-- Independent package: do not inherit Autodesk flatten. Parallel TFMs
             must not share obj/bin or VS races CSC (CS2012 / MSB3713). -->
        <AppendTargetFrameworkToOutputPath>true</AppendTargetFrameworkToOutputPath>
        <RootNamespace>DevTools.NUnit.Mtp</RootNamespace>
        <AssemblyName>DevTools.NUnit.Mtp</AssemblyName>
        <PackageId>RevitDevTool.NUnit</PackageId>
        <!-- Bump this before running .github/workflows/PublishNUnit.yml.
             Independent of the RevitDevTool installer GitVersion. -->
        <Version>0.0.4</Version>
        <IsPackable>true</IsPackable>
        <DevelopmentDependency>true</DevelopmentDependency>
        <PackageLicenseExpression>MIT</PackageLicenseExpression>
        <PackageProjectUrl>https://github.com/trgiangv/RevitDevTool</PackageProjectUrl>
        <Description>Microsoft.Testing.Platform framework that runs NUnit tests inside Revit/AutoCAD hosts. Requires RevitDevTool (https://github.com/trgiangv/RevitDevTool).</Description>
        <PackageTags>nunit;revit;autocad;testing;mtp</PackageTags>
        <PackageReadmeFile>README.md</PackageReadmeFile>
        <EnableDynamicLoading>false</EnableDynamicLoading>
        <CopyLocalLockFileAssemblies>true</CopyLocalLockFileAssemblies>
        <IsTestProject>false</IsTestProject>
        <ILRepackable Condition="'$(TargetFramework)' == 'net48'">true</ILRepackable>
        <ILRepackInternalize Condition="'$(TargetFramework)' == 'net48'">true</ILRepackInternalize>
    </PropertyGroup>

    <ItemGroup>
        <None Include="build\RevitDevTool.NUnit.props" Pack="true" PackagePath="build\"/>
        <None Include="build\RevitDevTool.NUnit.targets" Pack="true" PackagePath="build\"/>
        <None Include="README.md" Pack="true" PackagePath="\"/>
    </ItemGroup>

    <ItemGroup>
        <!-- Compile against the platform; consumers supply it at runtime via Microsoft.Testing.Platform.MSBuild. -->
        <PackageReference Include="Microsoft.Testing.Platform">
            <PrivateAssets>all</PrivateAssets>
            <ExcludeAssets>runtime</ExcludeAssets>
        </PackageReference>
        <!-- net48: merged into DevTools.NUnit.Mtp.dll via props/ILRepack.targets. -->
        <PackageReference Include="System.Text.Json" Condition="'$(TargetFramework)' == 'net48'">
            <PrivateAssets>all</PrivateAssets>
        </PackageReference>
        <PackageReference Include="System.Reflection.Metadata" Condition="'$(TargetFramework)' == 'net48'">
            <PrivateAssets>all</PrivateAssets>
        </PackageReference>
        <PackageReference Include="System.Runtime.CompilerServices.Unsafe" Condition="'$(TargetFramework)' == 'net48'">
            <PrivateAssets>all</PrivateAssets>
        </PackageReference>
        <InternalsVisibleTo Include="DevTools.NUnit.Mtp.Tests"/>
    </ItemGroup>

    <ItemGroup>
        <Compile Include="..\DevTools.NUnit.Core\Contracts\NUnitMessages.cs" Link="Core\NUnitMessages.cs"/>
        <Compile Include="..\DevTools.NUnit.Core\Contracts\NUnitRunnerCli.cs" Link="Core\NUnitRunnerCli.cs"/>
        <Compile Include="..\DevTools.NUnit.Core\NUnitHostTiming.cs" Link="Core\NUnitHostTiming.cs"/>
        <Compile Include="..\DevTools.NUnit.Core\Discovery\NUnitMetadataDiscoverer.cs" Link="Core\Discovery\NUnitMetadataDiscoverer.cs"/>
        <Compile Include="..\DevTools.NUnit.Core\Client\HostRunOptions.cs" Link="Core\Client\HostRunOptions.cs"/>
        <Compile Include="..\DevTools.NUnit.Core\Client\RunnerTestFilter.cs" Link="Core\Client\RunnerTestFilter.cs"/>
        <Compile Include="..\DevTools.NUnit.Core\Client\IRunnerTransport.cs" Link="Core\Client\IRunnerTransport.cs"/>
        <Compile Include="..\DevTools.NUnit.Core\Client\NUnitRunnerPaths.cs" Link="Core\Client\NUnitRunnerPaths.cs"/>
        <Compile Include="..\DevTools.NUnit.Core\Client\ProcessRunnerClient.cs" Link="Core\Client\ProcessRunnerClient.cs"/>
        <Compile Include="..\DevTools.NUnit.Core\Client\NUnitTestingMapping.cs" Link="Core\Client\NUnitTestingMapping.cs"/>
        <Compile Include="..\DevTools.NUnit.Core\Client\NUnitProcessTransportAdapter.cs" Link="Core\Client\NUnitProcessTransportAdapter.cs"/>
        <ProjectReference Include="..\DevTools.Testing.Abstractions\DevTools.Testing.Abstractions.csproj"/>
        <ProjectReference Include="..\DevTools.Testing.Transport\DevTools.Testing.Transport.csproj"/>
        <ProjectReference Include="..\DevTools.Testing.Mtp\DevTools.Testing.Mtp.csproj"/>
    </ItemGroup>
</Project>
