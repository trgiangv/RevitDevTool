<UserControl x:Class="DevTools.Presentation.Views.ExecutionView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:design="clr-namespace:DevTools.UI.Theme.Design;assembly=DevTools.UI"
             xmlns:mah="http://metro.devtools.ui/winfx/xaml/controls"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:viewModels="clr-namespace:DevTools.Presentation.ViewModels"
             xmlns:views="clr-namespace:DevTools.Presentation.Views"
             d:DataContext="{d:DesignInstance viewModels:ExecutionViewModel}"
             d:DesignHeight="500"
             d:DesignWidth="400"
             Background="{DynamicResource DevTools.MahApps.Brushes.ThemeBackground}"
             mc:Ignorable="d">

    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/DevTools.UI;component/Theme/Theme.xaml" />
                <design:IntellisenseResources Source="/DevTools.UI;component/Theme/Design/DesignTimeResources.xaml" />
            </ResourceDictionary.MergedDictionaries>
            <DataTemplate x:Key="ExecutionCommandTemplate">
                <views:CommandView DataContext="{Binding CommandViewModel}" />
            </DataTemplate>
            <DataTemplate x:Key="ExecutionPackageTemplate">
                <views:PackageView DataContext="{Binding PackageViewModel}" />
            </DataTemplate>
            <Style x:Key="DebuggerPortChip"
                   TargetType="Border">
                <Setter Property="Padding" Value="5,2" />
                <Setter Property="Margin" Value="0,0,4,0" />
                <Setter Property="CornerRadius" Value="4" />
                <Setter Property="Background" Value="{DynamicResource DevTools.MahApps.Brushes.Gray10}" />
                <Setter Property="BorderBrush" Value="{DynamicResource DevTools.MahApps.Brushes.Gray8}" />
                <Setter Property="BorderThickness" Value="1.5" />
                <Setter Property="SnapsToDevicePixels" Value="True" />
            </Style>
        </ResourceDictionary>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0"
              Margin="0,0,0,5">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBox Grid.Column="0"
                     mah:TextBoxHelper.ClearTextButton="True"
                     mah:TextBoxHelper.Watermark="Search..."
                     Text="{Binding SearchText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />

            <ToggleButton Grid.Column="1"
                          Margin="5,0,0,0"
                          Padding="5,0"
                          BorderThickness="0.5"
                          IsChecked="{Binding IsPackageMode, UpdateSourceTrigger=PropertyChanged}"
                          Style="{DynamicResource DevTools.MahApps.Styles.ToggleButton.Circle}"
                          ToolTip="Installed packages">
                <Path Width="16"
                      Height="16"
                      Data="{StaticResource Package}"
                      Fill="{DynamicResource DevTools.MahApps.Brushes.ThemeForeground}"
                      Stretch="Uniform" />
            </ToggleButton>

            <StackPanel Grid.Column="2"
                        Margin="5,0,0,0"
                        Orientation="Horizontal">
                <StackPanel.Resources>
                    <Style BasedOn="{StaticResource DevTools.MahApps.Styles.Button.Circle}"
                           TargetType="{x:Type Button}">
                        <Setter Property="Height" Value="25" />
                        <Setter Property="Width" Value="25" />
                    </Style>
                </StackPanel.Resources>
                <Button Margin="0,0,5,0"
                        Command="{Binding ExpandAllCommand}"
                        ToolTip="Expand all">
                    <Path Width="7"
                          Height="7"
                          Data="{StaticResource Expand}"
                          Fill="{DynamicResource DevTools.MahApps.Brushes.ThemeForeground}"
                          Stretch="Uniform" />
                </Button>
                <Button Margin="0,0,5,0"
                        Command="{Binding CollapseAllCommand}"
                        ToolTip="Collapse all">
                    <Path Width="7"
                          Height="7"
                          Data="{StaticResource Collapse}"
                          Fill="{DynamicResource DevTools.MahApps.Brushes.ThemeForeground}"
                          Stretch="Uniform" />
                </Button>
                <Button Margin="0,0,5,0"
                        Command="{Binding ToggleAllCommand}"
                        ToolTip="Toggle expand/collapse">
                    <Path Width="11"
                          Height="11"
                          Data="{StaticResource Toggle}"
                          Fill="{DynamicResource DevTools.MahApps.Brushes.ThemeForeground}"
                          Stretch="Uniform" />
                </Button>
            </StackPanel>
        </Grid>

        <StackPanel Grid.Row="1"
                    Margin="0,0,0,4"
                    Orientation="Horizontal"
                    Visibility="{Binding CommandViewModel.HasDebugger, Converter={StaticResource BooleanToVisibilityConverter}}">
            <Path Width="12"
                  Height="12"
                  Margin="0,0,6,0"
                  VerticalAlignment="Center"
                  Data="{StaticResource Bug}"
                  Stretch="Uniform">
                <Path.Style>
                    <Style TargetType="Path">
                        <Setter Property="Fill" Value="{DynamicResource DevTools.MahApps.Brushes.ThemeForeground}" />
                        <Setter Property="ToolTip" Value="Debugger not connected" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding CommandViewModel.IsDebuggerConnected}"
                                         Value="True">
                                <Setter Property="Fill" Value="#FF6B6B" />
                                <Setter Property="ToolTip" Value="Debugger connected" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Path.Style>
            </Path>
            <Border ToolTip="CPython debugpy port">
                <Border.Style>
                    <Style BasedOn="{StaticResource DebuggerPortChip}"
                           TargetType="Border">
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding CommandViewModel.IsPythonDebuggerConnected}"
                                         Value="True">
                                <Setter Property="BorderBrush" Value="#FF6B6B" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <StackPanel Orientation="Horizontal">
                    <Image Width="12"
                           Height="12"
                           VerticalAlignment="Center"
                           Source="{StaticResource PythonIcon}"
                           ToolTip="CPython" />
                    <TextBlock Margin="3,0,0,0"
                               VerticalAlignment="Center"
                               FontSize="11"
                               Foreground="{DynamicResource DevTools.MahApps.Brushes.ThemeForeground}"
                               Text="{Binding CommandViewModel.PythonDebugPort}" />
                </StackPanel>
            </Border>
            <Border ToolTip="IronPython debugpy port">
                <Border.Style>
                    <Style BasedOn="{StaticResource DebuggerPortChip}"
                           TargetType="Border">
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding CommandViewModel.IsIronPythonDebuggerConnected}"
                                         Value="True">
                                <Setter Property="BorderBrush" Value="#FF6B6B" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <StackPanel Orientation="Horizontal">
                    <Image Width="12"
                           Height="12"
                           VerticalAlignment="Center"
                           Source="{StaticResource IronPythonIcon}"
                           ToolTip="IronPython" />
                    <TextBlock Margin="3,0,0,0"
                               VerticalAlignment="Center"
                               FontSize="11"
                               Foreground="{DynamicResource DevTools.MahApps.Brushes.ThemeForeground}"
                               Text="{Binding CommandViewModel.IronPythonDebugPort}" />
                </StackPanel>
            </Border>
        </StackPanel>

        <ContentControl Grid.Row="2"
                        Content="{Binding}"
                        Focusable="False">
            <ContentControl.Style>
                <Style TargetType="ContentControl">
                    <Setter Property="ContentTemplate" Value="{StaticResource ExecutionCommandTemplate}" />
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding IsPackageMode}"
                                     Value="True">
                            <Setter Property="ContentTemplate" Value="{StaticResource ExecutionPackageTemplate}" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </ContentControl.Style>
        </ContentControl>
    </Grid>
</UserControl>
