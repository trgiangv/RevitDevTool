<UserControl x:Class="DevTools.Presentation.Views.ExecutionView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:design="clr-namespace:DevTools.UI.Theme.Design;assembly=DevTools.UI"
             xmlns:hc="https://handyorg.github.io/handycontrol"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:viewModels="clr-namespace:DevTools.Presentation.ViewModels"
             xmlns:views="clr-namespace:DevTools.Presentation.Views"
             d:DataContext="{d:DesignInstance viewModels:ExecutionViewModel}"
             d:DesignHeight="500"
             d:DesignWidth="400"
             Background="{DynamicResource RegionBrush}"
             mc:Ignorable="d">

    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/DevTools.UI;component/Theme/Theme.xaml" />
                <design:IntellisenseResources Source="/DevTools.UI;component/Theme/Design/DesignTimeResources.xaml" />
            </ResourceDictionary.MergedDictionaries>
            <DataTemplate x:Key="ExecutionCommandTemplate">
                <views:CommandView DataContext="{Binding CommandViewModel}" />
            </DataTemplate>
            <DataTemplate x:Key="ExecutionPackageTemplate">
                <views:PackageView DataContext="{Binding PackageViewModel}" />
            </DataTemplate>
            <Style x:Key="DebuggerPortChip"
                   TargetType="Border">
                <Setter Property="Padding" Value="5,2" />
                <Setter Property="CornerRadius" Value="4" />
                <Setter Property="Background" Value="{DynamicResource SecondaryRegionBrush}" />
                <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="SnapsToDevicePixels" Value="True" />
            </Style>
        </ResourceDictionary>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0"
              Margin="0,0,0,5">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <hc:TextBox Grid.Column="0"
                        hc:InfoElement.Placeholder="Search..."
                        hc:InfoElement.ShowClearButton="True"
                        Text="{Binding SearchText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
            <ToggleButton Grid.Column="1"
                          Margin="5,0,0,0"
                          IsChecked="{Binding IsPackageMode}"
                          Style="{StaticResource ToggleButtonFlip}"
                          ToolTip="MCP">
                <hc:StatusSwitchElement.CheckedElement>
                    <Border Background="{StaticResource PrimaryBrush}">
                        <Path Width="{StaticResource Length16}"
                              Height="{StaticResource Length16}"
                              Data="{StaticResource Package}"
                              Fill="{DynamicResource TextIconBrush}"
                              Stretch="Uniform" />
                    </Border>
                </hc:StatusSwitchElement.CheckedElement>
                <Border>
                    <Path Width="{StaticResource Length16}"
                          Height="{StaticResource Length16}"
                          Data="{StaticResource Package}"
                          Fill="{DynamicResource PrimaryTextBrush}"
                          Stretch="Uniform" />
                </Border>
            </ToggleButton>

            <!--  Tree Expand/Collapse  -->
            <hc:UniformSpacingPanel Grid.Column="2"
                                    Margin="5,0,0,0"
                                    Orientation="Horizontal"
                                    Spacing="5">
                <Button hc:IconElement.Geometry="{StaticResource Expand}"
                        Command="{Binding ExpandAllCommand}"
                        Style="{StaticResource ButtonIconCircular}"
                        ToolTip="Expand all" />
                <Button hc:IconElement.Geometry="{StaticResource Collapse}"
                        Command="{Binding CollapseAllCommand}"
                        Style="{StaticResource ButtonIconCircular}"
                        ToolTip="Collapse all" />
                <Button hc:IconElement.Geometry="{StaticResource Toggle}"
                        Command="{Binding ToggleAllCommand}"
                        Style="{StaticResource ButtonIconCircular}"
                        ToolTip="Toggle expand/collapse" />
            </hc:UniformSpacingPanel>
        </Grid>

        <hc:UniformSpacingPanel Grid.Row="1"
                                Margin="0,0,0,4"
                                Spacing="4"
                                Visibility="{Binding CommandViewModel.HasDebugger, Converter={StaticResource Boolean2VisibilityConverter}}">
            <Path Width="12"
                  Height="12"
                  VerticalAlignment="Center"
                  Data="{StaticResource Bug}"
                  Stretch="Uniform">
                <Path.Style>
                    <Style TargetType="Path">
                        <Setter Property="Fill" Value="{DynamicResource PrimaryTextBrush}" />
                        <Setter Property="ToolTip" Value="Debugger not connected" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding CommandViewModel.IsDebuggerConnected}"
                                         Value="True">
                                <Setter Property="Fill" Value="{DynamicResource DangerBrush}" />
                                <Setter Property="ToolTip" Value="Debugger connected" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Path.Style>
            </Path>
            <Border ToolTip="CPython debugpy port">
                <Border.Style>
                    <Style BasedOn="{StaticResource DebuggerPortChip}"
                           TargetType="Border">
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding CommandViewModel.IsPythonDebuggerConnected}"
                                         Value="True">
                                <Setter Property="BorderBrush" Value="{DynamicResource DangerBrush}" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <StackPanel Orientation="Horizontal">
                    <Image Width="12"
                           Height="12"
                           VerticalAlignment="Center"
                           Source="{StaticResource PythonIcon}"
                           ToolTip="CPython" />
                    <TextBlock Margin="3,0,0,0"
                               VerticalAlignment="Center"
                               FontSize="11"
                               Foreground="{DynamicResource PrimaryTextBrush}"
                               Text="{Binding CommandViewModel.PythonDebugPort}" />
                </StackPanel>
            </Border>
            <Border ToolTip="IronPython debugpy port">
                <Border.Style>
                    <Style BasedOn="{StaticResource DebuggerPortChip}"
                           TargetType="Border">
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding CommandViewModel.IsIronPythonDebuggerConnected}"
                                         Value="True">
                                <Setter Property="BorderBrush" Value="{DynamicResource DangerBrush}" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <StackPanel Orientation="Horizontal">
                    <Image Width="12"
                           Height="12"
                           VerticalAlignment="Center"
                           Source="{StaticResource IronPythonIcon}"
                           ToolTip="IronPython" />
                    <TextBlock Margin="3,0,0,0"
                               VerticalAlignment="Center"
                               FontSize="11"
                               Foreground="{DynamicResource PrimaryTextBrush}"
                               Text="{Binding CommandViewModel.IronPythonDebugPort}" />
                </StackPanel>
            </Border>
        </hc:UniformSpacingPanel>

        <ContentControl Grid.Row="2"
                        Content="{Binding}"
                        Focusable="False">
            <ContentControl.Style>
                <Style TargetType="ContentControl">
                    <Setter Property="ContentTemplate" Value="{StaticResource ExecutionCommandTemplate}" />
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding IsPackageMode}"
                                     Value="True">
                            <Setter Property="ContentTemplate" Value="{StaticResource ExecutionPackageTemplate}" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </ContentControl.Style>
        </ContentControl>
    </Grid>
</UserControl>
