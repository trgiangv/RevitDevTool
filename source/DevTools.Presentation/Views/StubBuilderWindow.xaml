<Window x:Class="DevTools.Presentation.Views.StubBuilderWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:design="clr-namespace:DevTools.UI.Theme.Design;assembly=DevTools.UI"
        xmlns:hc="https://handyorg.github.io/handycontrol"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:models="clr-namespace:DevTools.Presentation.Models"
        xmlns:viewModels="clr-namespace:DevTools.Presentation.ViewModels"
        Title="Stubs Builder"
        Width="700"
        Height="650"
        MinWidth="650"
        MinHeight="500"
        d:DataContext="{d:DesignInstance Type=viewModels:StubBuilderViewModel}"
        d:DesignHeight="650"
        d:DesignWidth="700"
        Background="{DynamicResource SecondaryRegionBrush}"
        ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner"
        mc:Ignorable="d">

    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/DevTools.UI;component/Theme/Theme.xaml" />
                <design:IntellisenseResources Source="/DevTools.UI;component/Theme/Design/DesignTimeResources.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Window.Resources>

    <Grid Margin="5">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!--  Toolbar: Hide unchecked + Select All / Clear  -->
        <StackPanel Margin="0,0,0,8"
                    HorizontalAlignment="Left"
                    Orientation="Horizontal">

            <CheckBox Margin="0,0,12,0"
                      Content="Hide unchecked"
                      IsChecked="{Binding HideUnchecked}" />

            <Button Margin="0,0,8,0"
                    Command="{Binding SelectAllCommand}"
                    Content="Check All" />

            <Button Command="{Binding ClearSelectionCommand}"
                    Content="Check None" />
        </StackPanel>

        <!--  Search  -->
        <hc:TextBox Grid.Row="1"
                    Margin="0,0,0,8"
                    VerticalContentAlignment="Center"
                    hc:InfoElement.Placeholder="Search assemblies..."
                    hc:InfoElement.ShowClearButton="True"
                    Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" />

        <!--  Assembly CheckListBox  -->
        <ListBox Grid.Row="2"
                 Margin="0,0,0,8"
                 ItemsSource="{Binding FilteredAssemblies}"
                 ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                 TextSearch.TextPath="Name"
                 VirtualizingStackPanel.IsVirtualizing="True"
                 VirtualizingStackPanel.VirtualizationMode="Recycling">
            <ListBox.ItemContainerStyle>
                <Style BasedOn="{StaticResource ListBoxItemBaseStyle}"
                       TargetType="ListBoxItem">
                    <EventSetter Event="MouseDoubleClick"
                                 Handler="OnAssemblyItemDoubleClick" />
                </Style>
            </ListBox.ItemContainerStyle>
            <ListBox.ItemTemplate>
                <DataTemplate DataType="models:AssemblyItem">
                    <StackPanel Orientation="Horizontal">
                        <CheckBox Margin="0,0,6,0"
                                  Focusable="True"
                                  IsChecked="{Binding IsSelected}" />
                        <TextBlock VerticalAlignment="Center"
                                   FontWeight="SemiBold"
                                   Text="{Binding Name}" />
                        <TextBlock MaxWidth="350"
                                   Margin="8,0,0,0"
                                   VerticalAlignment="Center"
                                   Foreground="{DynamicResource ThirdlyTextBrush}"
                                   Text="{Binding Location}"
                                   TextTrimming="CharacterEllipsis" />
                    </StackPanel>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>

        <!--  Output Path  -->
        <Grid Grid.Row="3"
              Margin="0,0,0,8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <TextBlock Grid.Column="0"
                       Margin="0,0,8,0"
                       VerticalAlignment="Center"
                       FontWeight="SemiBold"
                       Foreground="{DynamicResource PrimaryTextBrush}"
                       Text="Output Path:" />

            <TextBox Grid.Column="1"
                     Margin="0,0,5,0"
                     VerticalContentAlignment="Center"
                     Text="{Binding OutputPath, UpdateSourceTrigger=PropertyChanged}" />

            <Button Grid.Column="2"
                    Width="30"
                    Command="{Binding BrowseOutputPathCommand}"
                    Content="..." />
        </Grid>

        <!--  Status Message  -->
        <TextBlock Grid.Row="4"
                   Margin="0,0,0,8"
                   FontSize="11"
                   Foreground="{DynamicResource PrimaryBrush}"
                   Text="{Binding StatusMessage}"
                   TextWrapping="Wrap" />

        <!--  Bottom buttons  -->
        <Grid Grid.Row="5">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <ProgressBar Grid.Column="0"
                         Margin="0,0,15,0"
                         VerticalAlignment="Center"
                         IsIndeterminate="{Binding IsGenerating}"
                         Visibility="{Binding IsGenerating, Converter={StaticResource Boolean2VisibilityConverter}}" />

            <Button Grid.Column="1"
                    Width="100"
                    Padding="16,6"
                    Command="{Binding GenerateStubsCommand}"
                    Content="Generate"
                    Style="{StaticResource ButtonPrimary}" />
        </Grid>
    </Grid>
</Window>
