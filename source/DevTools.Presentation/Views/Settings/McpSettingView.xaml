<UserControl x:Class="DevTools.Presentation.Views.Settings.McpSettingView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:design="clr-namespace:DevTools.UI.Theme.Design;assembly=DevTools.UI"
             xmlns:mah="http://metro.devtools.ui/winfx/xaml/controls"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:settings="clr-namespace:DevTools.Presentation.ViewModels.Settings"
             d:Background="{DynamicResource DevTools.MahApps.Brushes.ThemeBackground}"
             d:DataContext="{d:DesignInstance settings:McpSettingViewModel}"
             d:DesignHeight="600"
             d:DesignWidth="600"
             mc:Ignorable="d">

    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/DevTools.UI;component/Theme/Theme.xaml" />
                <design:IntellisenseResources Source="/DevTools.UI;component/Theme/Design/DesignTimeResources.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>

    <ScrollViewer HorizontalScrollBarVisibility="Disabled"
                  VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="5">

            <!--  DevTools Daemon (Remote AI Clients)  -->
            <GroupBox Margin="0,0,0,8"
                      Header="DevTools Daemon">
                <Grid>
                    <StackPanel Margin="5">
                        <TextBlock Margin="0,0,0,4"
                                   FontSize="11"
                                   Foreground="{DynamicResource DevTools.MahApps.Brushes.Gray}"
                                   Text="Remote AI clients connect through the DevTools Daemon — ChatGPT, Claude, Perplexity, Gemini, and other Streamable HTTP MCP clients."
                                   TextWrapping="Wrap" />

                        <TextBlock Margin="0,10,0,0"
                                   FontWeight="SemiBold"
                                   Text="{Binding DaemonStatus}" />

                        <StackPanel Margin="0,10,0,0"
                                    Orientation="Horizontal">
                            <Button MinWidth="120"
                                    Command="{Binding TriggerDaemonSignInCommand}"
                                    Content="Sign In via Daemon" />
                            <Button MinWidth="120"
                                    Margin="8,0,0,0"
                                    Command="{Binding OpenDaemonDashboardCommand}"
                                    Content="Open Dashboard" />
                        </StackPanel>
                    </StackPanel>

                    <!--  Sign-in overlay  -->
                    <Border Background="{DynamicResource DevTools.MahApps.Brushes.ThemeBackground}"
                            Opacity="0.85"
                            Visibility="{Binding IsSigningIn, Converter={StaticResource BooleanToVisibilityConverter}}">
                        <StackPanel HorizontalAlignment="Stretch"
                                    VerticalAlignment="Center">
                            <mah:ProgressRing Width="40"
                                              Height="40"
                                              IsActive="{Binding IsSigningIn}" />
                            <TextBlock Margin="0,8,0,0"
                                       HorizontalAlignment="Center"
                                       FontSize="12"
                                       Text="Waiting for sign in..." />
                            <Button Margin="0,12,0,0"
                                    HorizontalAlignment="Right"
                                    Command="{Binding CancelSignInCommand}"
                                    Content="Cancel" />
                        </StackPanel>
                    </Border>
                </Grid>
            </GroupBox>

            <!--  Stdio (Local Desktop Apps)  -->
            <GroupBox Margin="0,0,0,8"
                      Header="Stdio">
                <StackPanel Margin="5">
                    <TextBlock Margin="0,0,0,4"
                               FontSize="11"
                               Foreground="{DynamicResource DevTools.MahApps.Brushes.Gray}"
                               Text="For local desktop AI clients that support stdio transport — Cursor, VS Code, OpenCode, Claude Desktop, Codex, Windsurf, and any MCP-compatible client. Point your AI client to DevTools.Daemon.exe (the daemon tray app must be running)."
                               TextWrapping="Wrap" />
                    <TextBox Margin="0,8,0,0"
                             FontFamily="Consolas"
                             FontSize="11"
                             Foreground="{DynamicResource DevTools.MahApps.Brushes.ThemeForeground}"
                             IsReadOnly="True"
                             Text="{Binding StdioConfigSnippet, Mode=OneTime}"
                             TextWrapping="NoWrap" />
                </StackPanel>
            </GroupBox>

            <!--  Custom Loaded Sources  -->
            <GroupBox Margin="0,0,0,8"
                      Header="Custom Loaded Sources">
                <ListBox MinHeight="200"
                         Margin="5"
                         ItemsSource="{Binding ToolsetSources}"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                         VirtualizingPanel.IsVirtualizing="True"
                         VirtualizingPanel.VirtualizationMode="Recycling">
                    <ListBox.ItemContainerStyle>
                        <Style BasedOn="{StaticResource {x:Type ListBoxItem}}"
                               TargetType="ListBoxItem">
                            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                            <Setter Property="Padding" Value="4,2" />
                            <Setter Property="mah:ControlsHelper.CornerRadius" Value="4" />
                        </Style>
                    </ListBox.ItemContainerStyle>
                    <ListBox.ItemTemplate>
                        <DataTemplate xmlns:sys="clr-namespace:System;assembly=mscorlib"
                                      DataType="sys:String">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <TextBlock Grid.Column="0"
                                           VerticalAlignment="Center"
                                           FontSize="11"
                                           Foreground="{DynamicResource DevTools.MahApps.Brushes.ThemeForeground}"
                                           Text="{Binding}"
                                           TextTrimming="CharacterEllipsis"
                                           ToolTip="{Binding}" />

                                <Button Grid.Column="1"
                                        Width="20"
                                        Height="20"
                                        Margin="6,0,0,0"
                                        BorderBrush="Transparent"
                                        BorderThickness="0"
                                        Command="{Binding DataContext.RemoveSourceCommand, RelativeSource={RelativeSource AncestorType=ListBox}}"
                                        CommandParameter="{Binding}"
                                        ToolTip="Remove">
                                    <Path Width="8"
                                          Height="8"
                                          Data="{StaticResource Clear}"
                                          Fill="{DynamicResource DevTools.MahApps.Brushes.ThemeForeground}"
                                          Stretch="Uniform" />
                                </Button>
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </GroupBox>
        </StackPanel>
    </ScrollViewer>
</UserControl>
