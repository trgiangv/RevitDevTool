<UserControl x:Class="DevTools.Presentation.Views.Settings.McpSettingView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:design="clr-namespace:DevTools.UI.Theme.Design;assembly=DevTools.UI"
             xmlns:hc="https://handyorg.github.io/handycontrol"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:settings="clr-namespace:DevTools.Presentation.ViewModels.Settings"
             d:Background="{DynamicResource RegionBrush}"
             d:DataContext="{d:DesignInstance settings:McpSettingViewModel}"
             d:DesignHeight="600"
             d:DesignWidth="600"
             mc:Ignorable="d">

    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/DevTools.UI;component/Theme/Theme.xaml" />
                <design:IntellisenseResources Source="/DevTools.UI;component/Theme/Design/DesignTimeResources.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>

    <ScrollViewer HorizontalScrollBarVisibility="Disabled"
                  VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="5">

            <!--  DevTools Daemon (Remote AI Clients)  -->
            <GroupBox Margin="0,0,0,8"
                      Background="{StaticResource RegionBrush}"
                      Header="Streamable Http"
                      Style="{StaticResource GroupBoxTab.Small}">
                <Grid>
                    <StackPanel Margin="5">
                        <TextBlock Margin="0,0,0,4"
                                   FontSize="11"
                                   Foreground="{DynamicResource SecondaryTextBrush}"
                                   Text="Remote AI clients connect through the DevTools Daemon — ChatGPT, Claude, Perplexity, and other Streamable HTTP MCP clients."
                                   TextWrapping="Wrap" />

                        <TextBlock Margin="0,10,0,0"
                                   FontWeight="SemiBold"
                                   Text="{Binding DaemonStatus}" />

                        <StackPanel Margin="0,10,0,0"
                                    Orientation="Horizontal">
                            <Button MinWidth="120"
                                    Command="{Binding TriggerDaemonSignInCommand}"
                                    Content="Sign In" />
                            <Button MinWidth="120"
                                    Margin="8,0,0,0"
                                    Command="{Binding OpenDaemonDashboardCommand}"
                                    Content="Open Dashboard" />
                        </StackPanel>
                    </StackPanel>

                    <!--  Sign-in overlay  -->
                    <Border Background="{DynamicResource RegionBrush}"
                            Opacity="0.85"
                            Visibility="{Binding IsSigningIn, Converter={StaticResource Boolean2VisibilityConverter}}">
                        <StackPanel HorizontalAlignment="Stretch"
                                    VerticalAlignment="Center">
                            <hc:LoadingCircle Width="40"
                                              Height="40"
                                              HorizontalAlignment="Center"
                                              IsRunning="{Binding IsSigningIn}" />
                            <TextBlock Margin="0,8,0,0"
                                       HorizontalAlignment="Center"
                                       FontSize="12"
                                       Text="Waiting for sign in..." />
                            <Button Margin="0,12,0,0"
                                    HorizontalAlignment="Right"
                                    Command="{Binding CancelSignInCommand}"
                                    Content="Cancel" />
                        </StackPanel>
                    </Border>
                </Grid>
            </GroupBox>

            <!--  Stdio (Local Desktop Apps)  -->
            <GroupBox Margin="0,0,0,8"
                      Background="{StaticResource RegionBrush}"
                      Header="Stdio"
                      Style="{StaticResource GroupBoxTab.Small}">
                <StackPanel Margin="5">
                    <TextBlock Margin="0,0,0,4"
                               FontSize="11"
                               Foreground="{DynamicResource SecondaryTextBrush}"
                               Text="For local desktop AI clients that support stdio transport — Cursor, VS Code, OpenCode, Claude Desktop, Codex, Windsurf, and any MCP-compatible client. Point your AI client to DevTools.Daemon.exe."
                               TextWrapping="Wrap" />
                    <TextBox Margin="0,8,0,0"
                             Padding="5"
                             FontFamily="Consolas"
                             FontSize="11"
                             Foreground="{DynamicResource PrimaryTextBrush}"
                             IsReadOnly="True"
                             Text="{Binding StdioConfigSnippet, Mode=OneTime}"
                             TextWrapping="NoWrap" />
                </StackPanel>
            </GroupBox>

            <!--  Custom Loaded Sources  -->
            <GroupBox Margin="0,0,0,8"
                      Background="{StaticResource RegionBrush}"
                      Header="Custom Loaded Sources"
                      Style="{StaticResource GroupBoxTab.Small}">
                <ListBox MinHeight="200"
                         ItemsSource="{Binding ToolsetSources}"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                         VirtualizingPanel.IsVirtualizing="True"
                         VirtualizingPanel.VirtualizationMode="Recycling">
                    <ListBox.ItemContainerStyle>
                        <Style BasedOn="{StaticResource {x:Type ListBoxItem}}"
                               TargetType="ListBoxItem">
                            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                            <Setter Property="Padding" Value="4,2" />
                            <Setter Property="hc:BorderElement.CornerRadius" Value="4" />
                        </Style>
                    </ListBox.ItemContainerStyle>
                    <ListBox.ItemTemplate>
                        <DataTemplate xmlns:sys="clr-namespace:System;assembly=mscorlib"
                                      DataType="sys:String">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <TextBlock Grid.Column="0"
                                           VerticalAlignment="Center"
                                           FontSize="11"
                                           Foreground="{DynamicResource PrimaryTextBrush}"
                                           Text="{Binding}"
                                           TextTrimming="CharacterEllipsis"
                                           ToolTip="{Binding}" />

                                <Button Grid.Column="1"
                                        Margin="6,0,0,0"
                                        hc:IconElement.Geometry="{StaticResource Clear}"
                                        Command="{Binding DataContext.RemoveSourceCommand, RelativeSource={RelativeSource AncestorType=ListBox}}"
                                        CommandParameter="{Binding}"
                                        Style="{StaticResource ButtonIcon.Small}"
                                        ToolTip="Remove" />
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </GroupBox>
        </StackPanel>
    </ScrollViewer>
</UserControl>
