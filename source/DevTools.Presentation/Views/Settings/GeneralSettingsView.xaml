<UserControl x:Class="DevTools.Presentation.Views.Settings.GeneralSettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:design="clr-namespace:DevTools.UI.Theme.Design;assembly=DevTools.UI"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:settings="clr-namespace:DevTools.Presentation.ViewModels.Settings"
             d:Background="{DynamicResource RegionBrush}"
             d:DataContext="{d:DesignInstance settings:GeneralSettingsViewModel}"
             d:DesignHeight="600"
             d:DesignWidth="600"
             mc:Ignorable="d">

    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/DevTools.UI;component/Theme/Theme.xaml" />
                <design:IntellisenseResources Source="/DevTools.UI;component/Theme/Design/DesignTimeResources.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>

    <ScrollViewer HorizontalScrollBarVisibility="Disabled"
                  VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="5">
            <!--  Theme  -->
            <GroupBox Margin="0,0,0,8"
                      Background="{StaticResource RegionBrush}"
                      Header="Theme"
                      Style="{StaticResource GroupBoxTab.Small}">
                <Grid Margin="8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock FontWeight="SemiBold"
                                   Text="Application Theme" />
                        <TextBlock FontSize="11"
                                   Foreground="{DynamicResource SecondaryTextBrush}"
                                   Text="Customise the application theme" />
                    </StackPanel>
                    <ComboBox Grid.Column="1"
                              Width="{StaticResource Length120}"
                              VerticalAlignment="Center"
                              ItemsSource="{Binding Themes, Mode=OneTime}"
                              SelectedItem="{Binding Theme}" />
                </Grid>
            </GroupBox>

            <!--  Performance  -->
            <GroupBox Margin="0,0,0,8"
                      Background="{StaticResource RegionBrush}"
                      Header="Performance"
                      Style="{StaticResource GroupBoxTab.Small}">
                <StackPanel>
                    <Grid Margin="8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock FontWeight="SemiBold"
                                       Text="Hardware graphics acceleration" />
                            <TextBlock FontSize="11"
                                       Foreground="{DynamicResource SecondaryTextBrush}"
                                       Text="Offloads graphic rendering from the CPU to the GPU" />
                        </StackPanel>
                        <ToggleButton Grid.Column="1"
                                      IsChecked="{Binding UseHardwareRendering}"
                                      Style="{StaticResource ToggleButtonSwitch}" />
                    </Grid>
                    <Grid Margin="8,0,8,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock FontWeight="SemiBold"
                                       Text="Memory monitor" />
                            <TextBlock FontSize="11"
                                       Foreground="{DynamicResource SecondaryTextBrush}"
                                       Text="Shows realtime process memory and operation tracking" />
                        </StackPanel>
                        <ToggleButton Grid.Column="1"
                                      IsChecked="{Binding IsMemoryEnabled}"
                                      Style="{StaticResource ToggleButtonSwitch}" />
                    </Grid>
                </StackPanel>
            </GroupBox>

            <!--  Privacy  -->
            <GroupBox Margin="0,0,0,8"
                      Background="{StaticResource RegionBrush}"
                      Header="Privacy"
                      Style="{StaticResource GroupBoxTab.Small}">
                <Grid Margin="8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock FontWeight="SemiBold"
                                   Text="Anonymous diagnostics" />
                        <TextBlock FontSize="11"
                                   Foreground="{DynamicResource SecondaryTextBrush}"
                                   Text="Optional. Helps maintainers spot crashes and usage patterns. No model content or script source."
                                   TextWrapping="Wrap" />
                    </StackPanel>
                    <ToggleButton Grid.Column="1"
                                  IsChecked="{Binding EnableTelemetry}"
                                  Style="{StaticResource ToggleButtonSwitch}" />
                </Grid>
            </GroupBox>
        </StackPanel>
    </ScrollViewer>
</UserControl>
