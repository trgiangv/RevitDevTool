<UserControl x:Class="DevTools.Presentation.Views.Settings.LogSettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:design="clr-namespace:DevTools.UI.Theme.Design;assembly=DevTools.UI"
             xmlns:hc="https://handyorg.github.io/handycontrol"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:settings="clr-namespace:DevTools.Presentation.ViewModels.Settings"
             d:Background="{DynamicResource RegionBrush}"
             d:DataContext="{d:DesignInstance settings:LogSettingsViewModel}"
             d:DesignHeight="850"
             d:DesignWidth="600"
             mc:Ignorable="d">

    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/DevTools.UI;component/Theme/Theme.xaml" />
                <design:IntellisenseResources Source="/DevTools.UI;component/Theme/Design/DesignTimeResources.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>

    <ScrollViewer HorizontalScrollBarVisibility="Disabled"
                  VerticalScrollBarVisibility="Auto">
        <hc:SimpleStackPanel Margin="5">
            <!--  Log Filter  -->
            <GroupBox Margin="0,0,0,8"
                      Background="{StaticResource RegionBrush}"
                      Header="Log Filter"
                      Style="{StaticResource GroupBoxTab.Small}">
                <StackPanel Margin="8,5,8,8">
                    <!--  Minimum Level  -->
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Path Width="20"
                              Height="20"
                              VerticalAlignment="Center"
                              Data="{StaticResource LogLevel}"
                              Fill="{DynamicResource PrimaryTextBrush}"
                              Stretch="Uniform" />
                        <StackPanel Grid.Column="1"
                                    Margin="12,0"
                                    VerticalAlignment="Center">
                            <TextBlock FontWeight="SemiBold"
                                       Text="Minimum Level" />
                            <TextBlock FontSize="11"
                                       Foreground="{DynamicResource SecondaryTextBrush}"
                                       Text="Minimum level for displaying logs" />
                        </StackPanel>
                        <ComboBox Grid.Column="2"
                                  Width="{StaticResource Length100}"
                                  VerticalAlignment="Center"
                                  ItemsSource="{Binding LogLevels, Mode=OneTime}"
                                  SelectedItem="{Binding LogLevel}" />
                    </Grid>

                    <Expander Margin="0,12,0,0"
                              Header="Level Detection Keywords"
                              IsExpanded="False">
                        <StackPanel>
                            <TextBlock Margin="0,0,0,5"
                                       Foreground="{DynamicResource SecondaryTextBrush}"
                                       Text="comma-separated, max 5 keywords for each level" />

                            <!--  Information  -->
                            <DockPanel Margin="0,0,0,5"
                                       LastChildFill="True"
                                       ToolTip="Information">

                                <Path Width="{StaticResource Length14}"
                                      Height="{StaticResource Length14}"
                                      Margin="5,0"
                                      VerticalAlignment="Center"
                                      Data="{StaticResource InfoGeometry}"
                                      DockPanel.Dock="Left"
                                      Fill="{StaticResource InfoBrush}"
                                      Stretch="Uniform" />

                                <hc:TextBox hc:InfoElement.Placeholder="Information"
                                            Style="{StaticResource TextBoxExtend}"
                                            Text="{Binding InformationKeywords, ValidatesOnDataErrors=True, UpdateSourceTrigger=PropertyChanged, NotifyOnValidationError=True}" />
                            </DockPanel>

                            <!--  Warning  -->
                            <DockPanel Margin="0,0,0,5"
                                       LastChildFill="True"
                                       ToolTip="Warning">

                                <Path Width="{StaticResource Length14}"
                                      Height="{StaticResource Length14}"
                                      Margin="5,0"
                                      VerticalAlignment="Center"
                                      Data="{StaticResource WarningGeometry}"
                                      DockPanel.Dock="Left"
                                      Fill="{StaticResource WarningBrush}"
                                      Stretch="Uniform" />

                                <hc:TextBox hc:InfoElement.Placeholder="Warning"
                                            Style="{StaticResource TextBoxExtend}"
                                            Text="{Binding WarningKeywords, ValidatesOnDataErrors=True, UpdateSourceTrigger=PropertyChanged, NotifyOnValidationError=True}" />
                            </DockPanel>

                            <!--  Error  -->
                            <DockPanel Margin="0,0,0,5"
                                       LastChildFill="True"
                                       ToolTip="Error">

                                <Path Width="{StaticResource Length14}"
                                      Height="{StaticResource Length14}"
                                      Margin="5,0"
                                      VerticalAlignment="Center"
                                      Data="{StaticResource ErrorGeometry}"
                                      DockPanel.Dock="Left"
                                      Fill="{StaticResource DangerBrush}"
                                      Stretch="Uniform" />

                                <hc:TextBox hc:InfoElement.Placeholder="Error"
                                            Style="{StaticResource TextBoxExtend}"
                                            Text="{Binding ErrorKeywords, ValidatesOnDataErrors=True, UpdateSourceTrigger=PropertyChanged, NotifyOnValidationError=True}" />
                            </DockPanel>

                            <!--  Critical  -->
                            <DockPanel LastChildFill="True"
                                       ToolTip="Critical">

                                <Path Width="{StaticResource Length14}"
                                      Height="{StaticResource Length14}"
                                      Margin="5,0"
                                      VerticalAlignment="Center"
                                      Data="{StaticResource FatalGeometry}"
                                      DockPanel.Dock="Left"
                                      Fill="{StaticResource AccentBrush}"
                                      Stretch="Uniform" />

                                <hc:TextBox hc:InfoElement.Placeholder="Critical"
                                            Style="{StaticResource TextBoxExtend}"
                                            Text="{Binding CriticalKeywords, ValidatesOnDataErrors=True, UpdateSourceTrigger=PropertyChanged, NotifyOnValidationError=True}" />
                            </DockPanel>
                        </StackPanel>
                    </Expander>
                </StackPanel>
            </GroupBox>

            <!--  Stack Trace  -->
            <GroupBox Margin="0,0,0,8"
                      Background="{StaticResource RegionBrush}"
                      Header="Stack Trace"
                      Style="{StaticResource GroupBoxTab.Small}">
                <hc:UniformSpacingPanel Margin="8"
                                        Orientation="Vertical"
                                        Spacing="8">
                    <!--  Stack Trace  -->
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Path Width="20"
                              Height="20"
                              VerticalAlignment="Center"
                              Data="{StaticResource Stack}"
                              Fill="{DynamicResource PrimaryTextBrush}"
                              Stretch="Uniform" />
                        <StackPanel Grid.Column="1"
                                    Margin="12,0"
                                    VerticalAlignment="Center">
                            <TextBlock FontWeight="SemiBold"
                                       Text="Include Stack Trace" />
                            <TextBlock FontSize="11"
                                       Foreground="{DynamicResource SecondaryTextBrush}"
                                       Text="Include stack trace frame information" />
                        </StackPanel>
                        <StackPanel Grid.Column="2"
                                    Orientation="Vertical">
                            <ToggleButton HorizontalAlignment="Right"
                                          VerticalAlignment="Bottom"
                                          IsChecked="{Binding IncludeStackTrace}"
                                          Style="{StaticResource ToggleButtonSwitch}" />
                            <hc:NumericUpDown Width="{StaticResource Length100}"
                                              Margin="0,8,0,0"
                                              HorizontalAlignment="Left"
                                              VerticalAlignment="Center"
                                              Increment="1"
                                              Minimum="1"
                                              Visibility="{Binding IncludeStackTrace, Converter={StaticResource Boolean2VisibilityConverter}}"
                                              Value="{Binding StackTraceDepth, UpdateSourceTrigger=PropertyChanged}" />
                        </StackPanel>
                    </Grid>

                    <!--  WPF Trace  -->
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Image Width="20"
                               Height="20"
                               VerticalAlignment="Center"
                               Source="pack://application:,,,/DevTools.UI;component/Resources/Icons/wpf.png" />
                        <StackPanel Grid.Column="1"
                                    Margin="12,0"
                                    VerticalAlignment="Center">
                            <TextBlock FontWeight="SemiBold"
                                       Text="Include WPF Trace" />
                            <TextBlock FontSize="11"
                                       Foreground="{DynamicResource SecondaryTextBrush}"
                                       Text="Include presentation trace information" />
                        </StackPanel>
                        <StackPanel Grid.Column="2"
                                    Orientation="Vertical">
                            <ToggleButton HorizontalAlignment="Right"
                                          VerticalAlignment="Bottom"
                                          IsChecked="{Binding IncludeWpfTrace}"
                                          Style="{StaticResource ToggleButtonSwitch}" />
                            <ComboBox Width="{StaticResource Length100}"
                                      Margin="0,8,0,0"
                                      HorizontalAlignment="Right"
                                      ItemsSource="{Binding SourceLevels, Mode=OneTime}"
                                      SelectedItem="{Binding WpfTraceLevel}"
                                      Visibility="{Binding IncludeWpfTrace, Converter={StaticResource Boolean2VisibilityConverter}}" />
                        </StackPanel>
                    </Grid>
                </hc:UniformSpacingPanel>
            </GroupBox>

            <!--  Log Sinks  -->
            <GroupBox Margin="0,0,0,8"
                      Background="{StaticResource RegionBrush}"
                      Header="Log Sinks"
                      Style="{StaticResource GroupBoxTab.Small}">
                <hc:UniformSpacingPanel Margin="8,5,8,8"
                                        Orientation="Vertical"
                                        Spacing="12">
                    <!--  Target Selector  -->
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Path Width="20"
                              Height="20"
                              VerticalAlignment="Center"
                              Data="{StaticResource MonitorLog}"
                              Fill="{DynamicResource PrimaryTextBrush}"
                              Stretch="Uniform" />
                        <hc:SimpleStackPanel Grid.Column="1"
                                             Margin="12,0"
                                             VerticalAlignment="Center">
                            <TextBlock FontWeight="SemiBold"
                                       Text="Active Sinks" />
                            <TextBlock FontSize="11"
                                       Foreground="{DynamicResource SecondaryTextBrush}"
                                       Text="Select logging output destinations" />
                        </hc:SimpleStackPanel>
                        <hc:CheckComboBox Grid.Column="2"
                                          Width="{StaticResource Length200}"
                                          VerticalAlignment="Center"
                                          hc:ListBoxAttach.SelectedItems="{Binding SelectedLogTargets, Mode=OneWay}"
                                          ItemsSource="{Binding AvailableLogTargets, Mode=OneTime}" />
                    </Grid>

                    <!--  JSON Output  -->
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Path Width="20"
                              Height="20"
                              VerticalAlignment="Center"
                              Data="{StaticResource PrettyJson}"
                              Fill="{DynamicResource PrimaryTextBrush}"
                              Stretch="Uniform" />
                        <hc:SimpleStackPanel Grid.Column="1"
                                             Margin="12,0"
                                             VerticalAlignment="Center">
                            <TextBlock FontWeight="SemiBold"
                                       Text="JSON" />
                            <TextBlock FontSize="11"
                                       Foreground="{DynamicResource SecondaryTextBrush}"
                                       Text="Use JSON format for all logging outputs" />
                        </hc:SimpleStackPanel>
                        <ToggleButton Grid.Column="2"
                                      HorizontalAlignment="Right"
                                      IsChecked="{Binding EnableJson}"
                                      Style="{StaticResource ToggleButtonSwitch}" />
                    </Grid>

                    <!--  Optional enrichers (host-provided)  -->
                    <Grid Visibility="{Binding HasEnrichers, Converter={StaticResource Boolean2VisibilityConverter}}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Path Width="20"
                              Height="20"
                              VerticalAlignment="Center"
                              Data="{StaticResource RevitEnricher}"
                              Fill="{DynamicResource PrimaryTextBrush}"
                              Stretch="Uniform" />
                        <hc:SimpleStackPanel Grid.Column="1"
                                             Margin="12,0"
                                             VerticalAlignment="Center">
                            <TextBlock FontWeight="SemiBold"
                                       Text="Log enrichers" />
                            <TextBlock FontSize="11"
                                       Foreground="{DynamicResource SecondaryTextBrush}"
                                       Text="Add optional context fields to JSON logs" />
                        </hc:SimpleStackPanel>
                        <hc:CheckComboBox Grid.Column="2"
                                          Width="{StaticResource Length200}"
                                          VerticalAlignment="Center"
                                          hc:ListBoxAttach.SelectedItems="{Binding SelectedEnrichers, Mode=OneWay}"
                                          ItemsSource="{Binding AvailableEnrichers, Mode=OneTime}" />
                    </Grid>
                </hc:UniformSpacingPanel>
            </GroupBox>

            <!--  File Logging  -->
            <GroupBox Margin="0,0,0,8"
                      Background="{StaticResource RegionBrush}"
                      Header="File Logging"
                      Style="{StaticResource GroupBoxTab.Small}"
                      Visibility="{Binding IsFileTargetSelected, Converter={StaticResource Boolean2VisibilityConverter}}">
                <hc:UniformSpacingPanel Margin="8,5,8,8"
                                        Orientation="Vertical"
                                        Spacing="12">
                    <!--  Rolling Interval  -->
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Path Width="20"
                              Height="20"
                              VerticalAlignment="Center"
                              Data="{StaticResource Clock}"
                              Fill="{DynamicResource PrimaryTextBrush}"
                              Stretch="Uniform" />
                        <hc:SimpleStackPanel Grid.Column="1"
                                             Margin="12,0"
                                             VerticalAlignment="Center">
                            <TextBlock FontWeight="SemiBold"
                                       Text="Rolling Interval" />
                            <TextBlock FontSize="11"
                                       Foreground="{DynamicResource SecondaryTextBrush}"
                                       Text="Create new file every" />
                        </hc:SimpleStackPanel>
                        <ComboBox Grid.Column="2"
                                  Width="{StaticResource Length100}"
                                  VerticalAlignment="Center"
                                  ItemsSource="{Binding LogTimeIntervals, Mode=OneTime}"
                                  SelectedItem="{Binding TimeInterval}" />
                    </Grid>

                    <!--  Auto Clean  -->
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Path Width="20"
                              Height="20"
                              VerticalAlignment="Center"
                              Data="{StaticResource Clear}"
                              Fill="{DynamicResource PrimaryTextBrush}"
                              Stretch="Uniform" />
                        <hc:SimpleStackPanel Grid.Column="1"
                                             Margin="12,0"
                                             VerticalAlignment="Center">
                            <TextBlock FontWeight="SemiBold"
                                       Text="Auto Clean" />
                            <TextBlock FontSize="11"
                                       Foreground="{DynamicResource SecondaryTextBrush}"
                                       Text="Delete old log files when Revit startup or shutdown" />
                        </hc:SimpleStackPanel>
                        <ToggleButton Grid.Column="2"
                                      VerticalAlignment="Bottom"
                                      IsChecked="{Binding AutoClean}"
                                      Style="{StaticResource ToggleButtonSwitch}" />
                    </Grid>

                    <!--  Log Folder  -->
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Path Width="20"
                              Height="20"
                              VerticalAlignment="Center"
                              Data="{StaticResource Folder}"
                              Fill="{DynamicResource PrimaryTextBrush}"
                              Stretch="Uniform" />
                        <hc:SimpleStackPanel Grid.Column="1"
                                             Margin="12,0">
                            <TextBlock FontWeight="SemiBold"
                                       Text="Log Folder" />
                            <TextBlock FontSize="11"
                                       Foreground="{DynamicResource SecondaryTextBrush}"
                                       Text="{Binding LogFolder}"
                                       TextTrimming="CharacterEllipsis"
                                       ToolTip="{Binding LogFolder}" />
                        </hc:SimpleStackPanel>
                        <Button Grid.Column="2"
                                Padding="8,4"
                                Command="{Binding BrowseFolderCommand}"
                                Content="Browse..." />
                    </Grid>
                </hc:UniformSpacingPanel>
            </GroupBox>

            <!--  HTTP Logging  -->
            <GroupBox Margin="0,0,0,8"
                      Background="{StaticResource RegionBrush}"
                      Header="HTTP Logging"
                      Style="{StaticResource GroupBoxTab.Small}"
                      Visibility="{Binding IsHttpTargetSelected, Converter={StaticResource Boolean2VisibilityConverter}}">
                <hc:UniformSpacingPanel Margin="8,5,8,8"
                                        Orientation="Vertical"
                                        Spacing="12">
                    <!--  Endpoint  -->
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Path Width="20"
                              Height="20"
                              VerticalAlignment="Center"
                              Data="{StaticResource Link}"
                              Fill="{DynamicResource PrimaryTextBrush}"
                              Stretch="Uniform" />
                        <hc:SimpleStackPanel Grid.Column="1"
                                             Margin="12,0"
                                             VerticalAlignment="Center">
                            <TextBlock FontWeight="SemiBold"
                                       Text="Endpoint" />
                            <TextBlock FontSize="11"
                                       Foreground="{DynamicResource SecondaryTextBrush}"
                                       Text="HTTP endpoint URL to send logs" />
                        </hc:SimpleStackPanel>
                        <TextBox Grid.Column="2"
                                 Width="{StaticResource Length200}"
                                 VerticalAlignment="Center"
                                 hc:InfoElement.Placeholder="https://..."
                                 Text="{Binding HttpEndpoint, UpdateSourceTrigger=PropertyChanged}" />
                    </Grid>

                    <!--  Batch Size  -->
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Path Width="20"
                              Height="20"
                              VerticalAlignment="Center"
                              Data="{StaticResource BulletList}"
                              Fill="{DynamicResource PrimaryTextBrush}"
                              Stretch="Uniform" />
                        <hc:SimpleStackPanel Grid.Column="1"
                                             Margin="12,0"
                                             VerticalAlignment="Center">
                            <TextBlock FontWeight="SemiBold"
                                       Text="Batch Size" />
                            <TextBlock FontSize="11"
                                       Foreground="{DynamicResource SecondaryTextBrush}"
                                       Text="Number of log entries per HTTP request" />
                        </hc:SimpleStackPanel>
                        <hc:NumericUpDown Grid.Column="2"
                                          Width="{StaticResource Length100}"
                                          VerticalAlignment="Center"
                                          Increment="1"
                                          Minimum="1"
                                          Value="{Binding HttpBatchSize, UpdateSourceTrigger=PropertyChanged}" />
                    </Grid>
                </hc:UniformSpacingPanel>
            </GroupBox>
        </hc:SimpleStackPanel>
    </ScrollViewer>
</UserControl>
