<UserControl x:Class="DevTools.Presentation.Views.ModelsContext.TreeTabView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="clr-namespace:DevTools.UI.Controls;assembly=DevTools.UI"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:design="clr-namespace:DevTools.UI.Theme.Design;assembly=DevTools.UI"
             xmlns:hc="https://handyorg.github.io/handycontrol"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:model="clr-namespace:DevTools.ModelsContext.Model;assembly=DevTools.ModelsContext"
             xmlns:views="clr-namespace:DevTools.Presentation.Views.ModelsContext"
             xmlns:vm="clr-namespace:DevTools.ModelsContext.ViewModels;assembly=DevTools.ModelsContext"
             d:DataContext="{d:DesignInstance vm:ModelContextViewModel}"
             d:DesignHeight="600"
             d:DesignWidth="320"
             mc:Ignorable="d">

    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/DevTools.UI;component/Theme/Theme.xaml" />
                <design:IntellisenseResources Source="/DevTools.UI;component/Theme/Design/DesignTimeResources.xaml" />
                <views:ModelContextResources />
            </ResourceDictionary.MergedDictionaries>

            <Style x:Key="TreeRowContainerStyle"
                   d:DataContext="{d:DesignInstance model:TreeRow}"
                   BasedOn="{StaticResource FlatTreeListItemStyle}"
                   TargetType="ListBoxItem">
                <Setter Property="AutomationProperties.Name" Value="{Binding Text, Mode=OneTime}" />
            </Style>

            <Style x:Key="RowBadgeStyle"
                   d:DataContext="{d:DesignInstance model:TreeRow}"
                   BasedOn="{StaticResource TagBaseStyle}"
                   TargetType="hc:Tag">
                <Setter Property="ShowCloseButton" Value="False" />
            </Style>

            <Style x:Key="RowButtonStyle"
                   d:DataContext="{d:DesignInstance model:TreeRow}"
                   BasedOn="{StaticResource ButtonIcon.Small}"
                   TargetType="Button">
                <Setter Property="Foreground" Value="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" />
            </Style>

            <DataTemplate x:Key="TreeRowTemplate" DataType="{x:Type model:TreeRow}">
                <Grid x:Name="RowGrid" Height="28">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="20" />
                        <ColumnDefinition Width="18" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="24" />
                    </Grid.ColumnDefinitions>

                    <Border Width="{Binding Indent, Mode=OneTime}" />

                    <Button x:Name="Chevron"
                            Grid.Column="1"
                            Width="20"
                            hc:IconElement.Geometry="{StaticResource Chevron}"
                            AutomationProperties.AutomationId="Tree.Row.Expand"
                            Command="{Binding DataContext.Tree.ToggleExpandCommand, RelativeSource={RelativeSource AncestorType={x:Type c:FlatTreeList}}}"
                            CommandParameter="{Binding}"
                            RenderTransformOrigin="0.5,0.5"
                            Style="{StaticResource RowButtonStyle}" />

                    <Path x:Name="LevelIcon"
                          Grid.Column="2"
                          Width="12"
                          Height="12"
                          Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ListBoxItem}}"
                          Stretch="Uniform" />

                    <TextBlock x:Name="RowText"
                               Grid.Column="3"
                               VerticalAlignment="Center"
                               Text="{Binding Text, Mode=OneTime}"
                               TextTrimming="CharacterEllipsis"
                               ToolTip="{Binding Text, Mode=OneTime}" />

                    <Button x:Name="More"
                            Grid.Column="3"
                            Grid.ColumnSpan="6"
                            AutomationProperties.AutomationId="Tree.Row.More"
                            Command="{Binding DataContext.Tree.LoadMoreCommand, RelativeSource={RelativeSource AncestorType={x:Type c:FlatTreeList}}}"
                            CommandParameter="{Binding}"
                            Content="{Binding Text, Mode=OneTime}"
                            Style="{StaticResource PanelLinkButton}"
                            Visibility="Collapsed" />

                    <hc:Tag x:Name="BadgeBox"
                            Grid.Column="4"
                            Height="16"
                            Margin="4,0,0,0"
                            Padding="5,0"
                            AutomationProperties.AutomationId="Tree.Row.Badge"
                            Background="{DynamicResource PrimaryBrush}"
                            Content="{Binding Badge, Mode=OneTime, StringFormat=N0}"
                            FontSize="10"
                            Foreground="{DynamicResource TextIconBrush}"
                            IsHitTestVisible="False"
                            Style="{StaticResource RowBadgeStyle}" />

                    <TextBlock x:Name="CountText"
                               Grid.Column="5"
                               MinWidth="50"
                               Margin="6,0,0,0"
                               VerticalAlignment="Center"
                               AutomationProperties.AutomationId="Tree.Row.Count"
                               Opacity="0.6"
                               Text="{Binding CountText, Mode=OneTime}"
                               TextAlignment="Right" />

                    <Ellipse x:Name="LinkDot"
                             Grid.Column="6"
                             Width="6"
                             Height="6"
                             Margin="4,0,0,0"
                             VerticalAlignment="Center"
                             Fill="{DynamicResource WarningBrush}"
                             ToolTip="Goes through link commands"
                             Visibility="Collapsed" />

                    <StackPanel x:Name="Actions"
                                Grid.Column="7"
                                Orientation="Horizontal"
                                Visibility="Collapsed">
                        <Button x:Name="Isolate"
                                hc:IconElement.Geometry="{StaticResource Isolate}"
                                AutomationProperties.AutomationId="Tree.Row.Isolate"
                                Click="OnToolClick"
                                IsVisibleChanged="OnToolShown"
                                MouseEnter="OnToolHover"
                                Style="{StaticResource RowButtonStyle}"
                                Tag="{x:Static vm:MenuAction.Isolate}"
                                ToolTip="Isolate"
                                ToolTipService.ShowOnDisabled="True" />
                        <Button x:Name="Halftone"
                                hc:IconElement.Geometry="{StaticResource Halftone}"
                                AutomationProperties.AutomationId="Tree.Row.Halftone"
                                Click="OnToolClick"
                                IsVisibleChanged="OnToolShown"
                                MouseEnter="OnToolHover"
                                Style="{StaticResource RowButtonStyle}"
                                Tag="{x:Static vm:MenuAction.Halftone}"
                                ToolTip="Halftone"
                                ToolTipService.ShowOnDisabled="True" />
                        <Button x:Name="Color"
                                hc:IconElement.Geometry="{StaticResource ColorDrop}"
                                AutomationProperties.AutomationId="Tree.Row.Color"
                                Click="OnToolClick"
                                IsVisibleChanged="OnToolShown"
                                MouseEnter="OnToolHover"
                                Style="{StaticResource RowButtonStyle}"
                                Tag="{x:Static vm:MenuAction.Color}"
                                ToolTip="Color…"
                                ToolTipService.ShowOnDisabled="True" />
                    </StackPanel>

                    <Button x:Name="Eye"
                            Grid.Column="8"
                            hc:IconElement.Geometry="{StaticResource EyeOpenGeometry}"
                            AutomationProperties.AutomationId="Tree.Row.Eye"
                            AutomationProperties.ItemStatus="{Binding Eye, Mode=OneTime}"
                            Command="{Binding DataContext.Tree.ToggleEyeCommand, RelativeSource={RelativeSource AncestorType={x:Type c:FlatTreeList}}}"
                            CommandParameter="{Binding}"
                            MouseEnter="OnEyeMouseEnter"
                            MouseLeave="OnEyeMouseLeave"
                            Style="{StaticResource RowButtonStyle}"
                            ToolTip="Hide" />
                </Grid>
                <DataTemplate.Triggers>

                    <DataTrigger Binding="{Binding HasChildren}" Value="False">
                        <Setter TargetName="Chevron" Property="Visibility" Value="Hidden" />
                    </DataTrigger>
                    <DataTrigger Binding="{Binding IsExpanded}" Value="True">
                        <Setter TargetName="Chevron" Property="RenderTransform">
                            <Setter.Value>
                                <RotateTransform Angle="90" />
                            </Setter.Value>
                        </Setter>
                    </DataTrigger>

                    <DataTrigger Binding="{Binding Kind}" Value="{x:Static model:TreeRowKind.AllModelsHeader}">
                        <Setter TargetName="LevelIcon" Property="Data" Value="{StaticResource AllModels}" />
                        <Setter TargetName="RowText" Property="FontWeight" Value="SemiBold" />
                    </DataTrigger>
                    <DataTrigger Binding="{Binding Kind}" Value="{x:Static model:TreeRowKind.AllModelsGroup}">
                        <Setter TargetName="LevelIcon" Property="Data" Value="{StaticResource Category}" />
                    </DataTrigger>
                    <DataTrigger Binding="{Binding Kind}" Value="{x:Static model:TreeRowKind.CurrentModelHeader}">
                        <Setter TargetName="LevelIcon" Property="Data" Value="{StaticResource Document}" />
                        <Setter TargetName="RowText" Property="FontWeight" Value="SemiBold" />
                    </DataTrigger>
                    <DataTrigger Binding="{Binding Kind}" Value="{x:Static model:TreeRowKind.LinkModel}">
                        <Setter TargetName="LevelIcon" Property="Data" Value="{StaticResource Link}" />
                        <Setter TargetName="RowText" Property="FontWeight" Value="SemiBold" />
                    </DataTrigger>
                    <DataTrigger Binding="{Binding Kind}" Value="{x:Static model:TreeRowKind.Group}">
                        <Setter TargetName="LevelIcon" Property="Data" Value="{StaticResource Category}" />
                    </DataTrigger>
                    <DataTrigger Binding="{Binding Kind}" Value="{x:Static model:TreeRowKind.Family}">
                        <Setter TargetName="LevelIcon" Property="Data" Value="{StaticResource Family}" />
                    </DataTrigger>
                    <DataTrigger Binding="{Binding Kind}" Value="{x:Static model:TreeRowKind.Type}">
                        <Setter TargetName="LevelIcon" Property="Data" Value="{StaticResource ElementType}" />
                    </DataTrigger>
                    <DataTrigger Binding="{Binding Kind}" Value="{x:Static model:TreeRowKind.Instance}">
                        <Setter TargetName="LevelIcon" Property="Data" Value="{StaticResource Box}" />
                    </DataTrigger>

                    <DataTrigger Binding="{Binding Badge}" Value="0">
                        <Setter TargetName="BadgeBox" Property="Visibility" Value="Collapsed" />
                    </DataTrigger>
                    <DataTrigger Binding="{Binding HasCount}" Value="False">
                        <Setter TargetName="CountText" Property="Visibility" Value="Collapsed" />
                    </DataTrigger>
                    <DataTrigger Binding="{Binding IsInsideLink}" Value="True">
                        <Setter TargetName="LinkDot" Property="Visibility" Value="Visible" />
                        <Setter TargetName="Halftone" Property="Visibility" Value="Collapsed" />
                        <Setter TargetName="Color" Property="Visibility" Value="Collapsed" />
                    </DataTrigger>

                    <DataTrigger Binding="{Binding Eye}" Value="{x:Static model:RowEye.None}">
                        <Setter TargetName="Eye" Property="Visibility" Value="Hidden" />
                    </DataTrigger>
                    <DataTrigger Binding="{Binding Eye}" Value="{x:Static model:RowEye.Hidden}">
                        <Setter TargetName="Eye" Property="hc:IconElement.Geometry" Value="{StaticResource EyeCloseGeometry}" />
                        <Setter TargetName="Eye" Property="ToolTip" Value="Show" />
                        <Setter TargetName="RowGrid" Property="Opacity" Value="0.55" />
                    </DataTrigger>
                    <DataTrigger Binding="{Binding Eye}" Value="{x:Static model:RowEye.Partly}">
                        <Setter TargetName="Eye" Property="Opacity" Value="0.55" />
                        <Setter TargetName="Eye" Property="ToolTip" Value="Partly hidden · click to hide" />
                    </DataTrigger>
                    <DataTrigger Binding="{Binding Eye}" Value="{x:Static model:RowEye.Unknown}">
                        <Setter TargetName="Eye" Property="Opacity" Value="0.35" />
                        <Setter TargetName="Eye" Property="ToolTip" Value="State unknown" />
                    </DataTrigger>
                    <DataTrigger Binding="{Binding Eye}" Value="{x:Static model:RowEye.HiddenByAllModels}">
                        <Setter TargetName="Eye" Property="hc:IconElement.Geometry" Value="{StaticResource EyeCloseGeometry}" />
                        <Setter TargetName="Eye" Property="IsEnabled" Value="False" />
                        <Setter TargetName="Eye" Property="ToolTip" Value="Hidden by All models" />
                        <Setter TargetName="RowGrid" Property="Opacity" Value="0.55" />
                    </DataTrigger>

                    <DataTrigger Binding="{Binding IsHighlighted}" Value="True">
                        <Setter TargetName="RowGrid" Property="Background" Value="{DynamicResource SecondaryRegionBrush}" />
                    </DataTrigger>

                    <DataTrigger Binding="{Binding RelativeSource={RelativeSource AncestorType=ListBoxItem}, Path=IsMouseOver}" Value="True">
                        <Setter TargetName="Actions" Property="Visibility" Value="Visible" />
                    </DataTrigger>
                    <DataTrigger Binding="{Binding RelativeSource={RelativeSource AncestorType=ListBoxItem}, Path=IsSelected}" Value="True">
                        <Setter TargetName="Actions" Property="Visibility" Value="Visible" />
                        <Setter TargetName="BadgeBox" Property="Visibility" Value="Collapsed" />
                        <Setter TargetName="RowGrid" Property="Background" Value="{x:Null}" />
                    </DataTrigger>

                    <DataTrigger Binding="{Binding IsHeader}" Value="True">
                        <Setter TargetName="Actions" Property="Visibility" Value="Collapsed" />
                    </DataTrigger>
                    <DataTrigger Binding="{Binding Kind}" Value="{x:Static model:TreeRowKind.MorePage}">
                        <Setter TargetName="Actions" Property="Visibility" Value="Collapsed" />
                        <Setter TargetName="Eye" Property="Visibility" Value="Collapsed" />
                        <Setter TargetName="CountText" Property="Visibility" Value="Collapsed" />
                        <Setter TargetName="RowText" Property="Visibility" Value="Collapsed" />
                        <Setter TargetName="LevelIcon" Property="Visibility" Value="Collapsed" />
                        <Setter TargetName="More" Property="Visibility" Value="Visible" />
                    </DataTrigger>
                </DataTemplate.Triggers>
            </DataTemplate>

            <Style x:Key="HintButtonStyle"
                   d:DataContext="{d:DesignInstance vm:ModelContextViewModel}"
                   BasedOn="{StaticResource PanelLinkButton}"
                   TargetType="Button">
                <Style.Triggers>
                    <DataTrigger Binding="{Binding Tree.SyncHint}" Value="{x:Null}">
                        <Setter Property="Visibility" Value="Collapsed" />
                    </DataTrigger>
                </Style.Triggers>
            </Style>

            <Style x:Key="SyncPanelStyle"
                   d:DataContext="{d:DesignInstance vm:ModelContextViewModel}"
                   TargetType="StackPanel">
                <Setter Property="Orientation" Value="Horizontal" />
                <Setter Property="Margin" Value="8,0,0,0" />
                <Style.Triggers>
                    <DataTrigger Binding="{Binding Tree.IsSyncVisible}" Value="False">
                        <Setter Property="Visibility" Value="Collapsed" />
                    </DataTrigger>
                </Style.Triggers>
            </Style>

            <Style x:Key="ShowInTreeStyle"
                   d:DataContext="{d:DesignInstance vm:ModelContextViewModel}"
                   BasedOn="{StaticResource PanelLinkButton}"
                   TargetType="Button">
                <Style.Triggers>
                    <DataTrigger Binding="{Binding Tree.CanShowInTree}" Value="False">
                        <Setter Property="Visibility" Value="Collapsed" />
                    </DataTrigger>
                </Style.Triggers>
            </Style>

            <Style x:Key="ClearStyle"
                   d:DataContext="{d:DesignInstance vm:ModelContextViewModel}"
                   BasedOn="{StaticResource PanelLinkButton}"
                   TargetType="Button">
                <Style.Triggers>
                    <DataTrigger Binding="{Binding Tree.HasSelection}" Value="False">
                        <Setter Property="Visibility" Value="Collapsed" />
                    </DataTrigger>
                </Style.Triggers>
            </Style>
        </ResourceDictionary>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid Margin="0,8,0,4">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBox hc:InfoElement.Placeholder="Search"
                     hc:InfoElement.ShowClearButton="True"
                     AutomationProperties.AutomationId="Tree.Search"
                     Style="{StaticResource TextBoxExtend}"
                     Text="{Binding Tree.SearchText, UpdateSourceTrigger=PropertyChanged}" />
            <StackPanel Grid.Column="1" Style="{StaticResource SyncPanelStyle}">
                <TextBlock VerticalAlignment="Center" Text="Sync" />
                <ToggleButton Margin="6,0,0,0"
                              AutomationProperties.AutomationId="Tree.Sync"
                              AutomationProperties.Name="Sync"
                              IsChecked="{Binding Tree.IsSyncOn}"
                              Style="{StaticResource ToggleButtonSwitch.Small}" />
            </StackPanel>
        </Grid>

        <Button Grid.Row="1"
                Margin="0,0,0,4"
                AutomationProperties.AutomationId="Tree.Hint"
                Command="{Binding Tree.ExpandAllCommand}"
                Content="{Binding Tree.SyncHint}"
                Style="{StaticResource HintButtonStyle}" />

        <c:FlatTreeList x:Name="RowList"
                        Grid.Row="2"
                        AutomationProperties.AutomationId="Tree.Rows"
                        ContextMenuOpening="OnContextMenuOpening"
                        ItemContainerStyle="{StaticResource TreeRowContainerStyle}"
                        ItemTemplate="{StaticResource TreeRowTemplate}"
                        PreviewKeyDown="OnRowsKeyDown"
                        SelectionChanged="OnSelectionChanged">
            <c:FlatTreeList.ContextMenu>
                <views:ModelContextMenu d:DataContext="{d:DesignInstance vm:ModelContextViewModel}" />
            </c:FlatTreeList.ContextMenu>
        </c:FlatTreeList>

        <Grid Grid.Row="3" Margin="0,4,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <TextBlock VerticalAlignment="Center"
                       AutomationProperties.AutomationId="Tree.Status"
                       Style="{StaticResource SecondaryText}"
                       Text="{Binding Tree.StatusText}" />
            <Button Grid.Column="1"
                    Margin="8,0,0,0"
                    AutomationProperties.AutomationId="Tree.Clear"
                    Command="{Binding Tree.ClearSelectionCommand}"
                    Content="Clear"
                    Style="{StaticResource ClearStyle}" />
            <Button Grid.Column="2"
                    Margin="8,0,0,0"
                    AutomationProperties.AutomationId="Tree.ShowInTree"
                    Command="{Binding Tree.ShowInTreeCommand}"
                    Content="Show in tree"
                    Style="{StaticResource ShowInTreeStyle}" />
            <TextBlock Grid.Column="3"
                       Margin="8,0,0,0"
                       AutomationProperties.AutomationId="Tree.Message"
                       Style="{StaticResource ErrorText}"
                       Text="{Binding Tree.Message}" />
        </Grid>
    </Grid>
</UserControl>
