<UserControl x:Class="DevTools.Presentation.Views.ModelsContext.ModelContextView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:design="clr-namespace:DevTools.UI.Theme.Design;assembly=DevTools.UI"
             xmlns:hc="https://handyorg.github.io/handycontrol"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:views="clr-namespace:DevTools.Presentation.Views.ModelsContext"
             xmlns:vm="clr-namespace:DevTools.ModelsContext.ViewModels;assembly=DevTools.ModelsContext"
             d:DataContext="{d:DesignInstance vm:ModelContextViewModel}"
             d:DesignHeight="800"
             d:DesignWidth="320"
             mc:Ignorable="d">

    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/DevTools.UI;component/Theme/Theme.xaml" />
                <design:IntellisenseResources Source="/DevTools.UI;component/Theme/Design/DesignTimeResources.xaml" />
                <views:ModelContextResources />
            </ResourceDictionary.MergedDictionaries>

            <Style x:Key="DocumentsBoxStyle"
                   d:DataContext="{d:DesignInstance vm:ModelContextViewModel}"
                   BasedOn="{StaticResource CheckComboBoxBaseStyle}"
                   TargetType="hc:CheckComboBox">
                <Setter Property="ShowSelectAllButton" Value="True" />
                <Style.Triggers>
                    <DataTrigger Binding="{Binding ContextBar.IsDocumentListVisible}" Value="False">
                        <Setter Property="Visibility" Value="Collapsed" />
                    </DataTrigger>
                </Style.Triggers>
            </Style>

            <Style x:Key="DocumentItemStyle"
                   d:DataContext="{d:DesignInstance vm:DocumentItemViewModel}"
                   BasedOn="{StaticResource CheckComboBoxItemBaseStyle}"
                   TargetType="hc:CheckComboBoxItem">
                <Setter Property="IsEnabled" Value="{Binding IsEnabled}" />
                <Setter Property="AutomationProperties.Name" Value="{Binding Label}" />
            </Style>

            <Style x:Key="TemporaryBarStyle"
                   d:DataContext="{d:DesignInstance vm:ModelContextViewModel}"
                   BasedOn="{StaticResource BorderTipWarning}"
                   TargetType="Border">
                <Setter Property="Margin" Value="0,8,0,0" />
                <Setter Property="Padding" Value="8,6" />
                <Style.Triggers>
                    <DataTrigger Binding="{Binding IsTemporaryBarVisible}" Value="False">
                        <Setter Property="Visibility" Value="Collapsed" />
                    </DataTrigger>
                </Style.Triggers>
            </Style>

            <Style x:Key="ConfirmPanelStyle"
                   d:DataContext="{d:DesignInstance vm:ModelContextViewModel}"
                   TargetType="StackPanel">
                <Setter Property="Margin" Value="0,6,0,0" />
                <Setter Property="Visibility" Value="Collapsed" />
                <Style.Triggers>
                    <DataTrigger Binding="{Binding TemporaryBar.IsConfirmingKeep}" Value="True">
                        <Setter Property="Visibility" Value="Visible" />
                    </DataTrigger>
                </Style.Triggers>
            </Style>

            <Style x:Key="UpdatingBarStyle"
                   d:DataContext="{d:DesignInstance vm:ModelContextViewModel}"
                   BasedOn="{StaticResource ProgressBarFlat}"
                   TargetType="ProgressBar">
                <Setter Property="IsIndeterminate" Value="False" />
                <Setter Property="Visibility" Value="Collapsed" />
                <Style.Triggers>
                    <DataTrigger Binding="{Binding IsUpdating}" Value="True">
                        <Setter Property="Visibility" Value="Visible" />
                        <Setter Property="IsIndeterminate" Value="True" />
                    </DataTrigger>
                </Style.Triggers>
            </Style>
        </ResourceDictionary>
    </UserControl.Resources>

    <Grid Margin="8">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />

            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock AutomationProperties.AutomationId="ModelContext.Busy"
                   Foreground="{DynamicResource WarningBrush}"
                   Style="{StaticResource ErrorText}"
                   Text="{Binding BusyText}" />

        <ProgressBar x:Name="UpdatingBar"
                     Grid.Row="2"
                     Margin="0,2,0,0"
                     VerticalAlignment="Top"
                     AutomationProperties.AutomationId="ModelContext.Updating"
                     Style="{StaticResource UpdatingBarStyle}" />
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <hc:ButtonGroup VerticalAlignment="Center"
                            AutomationProperties.AutomationId="ModelContext.Scope"
                            Style="{StaticResource ButtonGroupSolid}">
                <RadioButton Height="28"
                             hc:IconElement.Geometry="{StaticResource Cursor}"
                             hc:IconElement.Height="14"
                             hc:IconElement.Width="14"
                             AutomationProperties.AutomationId="ModelContext.Scope.Selection"
                             AutomationProperties.Name="Selection"
                             IsChecked="{Binding ContextBar.IsSelectionScope}"
                             ToolTip="Selection" />
                <RadioButton Height="28"
                             hc:IconElement.Geometry="{StaticResource Box}"
                             hc:IconElement.Height="14"
                             hc:IconElement.Width="14"
                             AutomationProperties.AutomationId="ModelContext.Scope.ActiveView"
                             AutomationProperties.Name="Active view"
                             IsChecked="{Binding ContextBar.IsActiveViewScope}"
                             ToolTip="Active view" />
                <RadioButton Height="28"
                             hc:IconElement.Geometry="{StaticResource AllModels}"
                             hc:IconElement.Height="14"
                             hc:IconElement.Width="14"
                             AutomationProperties.AutomationId="ModelContext.Scope.WholeModel"
                             AutomationProperties.Name="Whole model"
                             IsChecked="{Binding ContextBar.IsWholeModelScope}"
                             ToolTip="Whole model" />
            </hc:ButtonGroup>
            <hc:CheckComboBox x:Name="DocumentsBox"
                              Grid.Column="1"
                              Margin="8,0,0,0"
                              AutomationProperties.AutomationId="ModelContext.Documents"
                              DisplayMemberPath="Label"
                              ItemContainerStyle="{StaticResource DocumentItemStyle}"
                              ItemsSource="{Binding ContextBar.Documents}"
                              SelectionChanged="OnDocumentsSelectionChanged"
                              Style="{StaticResource DocumentsBoxStyle}" />
        </Grid>

        <Border Grid.Row="3" Style="{StaticResource TemporaryBarStyle}">
            <StackPanel>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock VerticalAlignment="Center"
                               AutomationProperties.AutomationId="Temporary.Text"
                               Foreground="{DynamicResource PrimaryTextBrush}"
                               Text="{Binding TemporaryBar.Text}" />
                    <Button Grid.Column="1"
                            AutomationProperties.AutomationId="Temporary.Keep"
                            Command="{Binding TemporaryBar.KeepCommand}"
                            Content="Keep"
                            Style="{StaticResource ButtonPrimary.Small}" />
                    <Button Grid.Column="2"
                            Margin="4,0,0,0"
                            AutomationProperties.AutomationId="Temporary.Reset"
                            Command="{Binding TemporaryBar.ResetCommand}"
                            Content="Reset"
                            Style="{StaticResource ButtonDefault.Small}" />
                </Grid>
                <StackPanel Style="{StaticResource ConfirmPanelStyle}">
                    <TextBlock AutomationProperties.AutomationId="Temporary.ConfirmText"
                               Foreground="{DynamicResource PrimaryTextBrush}"
                               Text="{Binding TemporaryBar.ConfirmText}"
                               TextWrapping="Wrap" />
                    <StackPanel Margin="0,6,0,0" Orientation="Horizontal">
                        <Button AutomationProperties.AutomationId="Temporary.ConfirmKeep"
                                Command="{Binding TemporaryBar.ConfirmKeepCommand}"
                                Content="Keep"
                                Style="{StaticResource ButtonPrimary.Small}" />
                        <Button Margin="4,0,0,0"
                                AutomationProperties.AutomationId="Temporary.CancelKeep"
                                Command="{Binding TemporaryBar.CancelKeepCommand}"
                                Content="Cancel"
                                Style="{StaticResource ButtonDefault.Small}" />
                    </StackPanel>
                </StackPanel>
            </StackPanel>
        </Border>

        <TabControl x:Name="Tabs"
                    Grid.Row="2"
                    Margin="0,8,0,0"
                    AutomationProperties.AutomationId="ModelContext.Tabs"
                    BorderThickness="0"
                    SelectionChanged="OnTabChanged"
                    Style="{StaticResource TabControlSliding}">
            <TabItem AutomationProperties.AutomationId="ModelContext.Tab.Explorer" Header="Explorer">
                <views:ExplorerTabView />
            </TabItem>
            <TabItem AutomationProperties.AutomationId="ModelContext.Tab.Filter" Header="Filter">
                <views:FilterTabView />
            </TabItem>
        </TabControl>

        <TextBlock Grid.Row="4"
                   Margin="0,6,0,0"
                   AutomationProperties.AutomationId="ModelContext.Message"
                   Style="{StaticResource ErrorText}"
                   Text="{Binding Message}" />

        <Popup x:Name="ColorPopup"
               Grid.Row="0"
               d:DataContext="{d:DesignInstance vm:ModelContextViewModel}"
               Placement="Bottom"
               StaysOpen="False">
            <hc:ColorPicker x:Name="ColorPicker"
                            AutomationProperties.AutomationId="ModelContext.ColorPicker"
                            Canceled="OnColorCanceled"
                            Confirmed="OnColorConfirmed" />
        </Popup>
    </Grid>
</UserControl>