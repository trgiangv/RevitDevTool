<ContextMenu x:Class="DevTools.Presentation.Views.ModelsContext.ModelContextMenu"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:views="clr-namespace:DevTools.Presentation.Views.ModelsContext"
             xmlns:vm="clr-namespace:DevTools.ModelsContext.ViewModels;assembly=DevTools.ModelsContext"
             d:DataContext="{d:DesignInstance vm:ModelContextViewModel}"
             AutomationProperties.AutomationId="Menu"
             DataContext="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource Self}}"
             ItemsSource="{Binding ContextMenu.Items}"
             mc:Ignorable="d">

    <ContextMenu.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <views:ModelContextResources />
            </ResourceDictionary.MergedDictionaries>

            <ControlTemplate x:Key="MenuSeparatorTemplate" TargetType="MenuItem">
                <Border Height="1"
                        Margin="0,2"
                        Background="{DynamicResource BorderBrush}" />
            </ControlTemplate>

            <DataTemplate x:Key="MenuHeaderTemplate" DataType="{x:Type vm:MenuItemViewModel}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="22" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Path x:Name="Icon"
                          Width="14"
                          Height="14"
                          HorizontalAlignment="Left"
                          VerticalAlignment="Center"
                          Fill="{DynamicResource PrimaryTextBrush}"
                          Stretch="Uniform" />
                    <TextBlock Grid.Column="1"
                               VerticalAlignment="Center"
                               Text="{Binding Text}" />
                    <Ellipse x:Name="ReferenceDot"
                             Grid.Column="2"
                             Width="6"
                             Height="6"
                             Margin="8,0,0,0"
                             VerticalAlignment="Center"
                             Fill="{DynamicResource WarningBrush}"
                             ToolTip="Goes through link commands"
                             Visibility="Collapsed" />
                </Grid>
                <DataTemplate.Triggers>
                    <DataTrigger Binding="{Binding UsesReferenceCommands}" Value="True">
                        <Setter TargetName="ReferenceDot" Property="Visibility" Value="Visible" />
                    </DataTrigger>
                    <DataTrigger Binding="{Binding IconKey}" Value="Select">
                        <Setter TargetName="Icon" Property="Data" Value="{StaticResource Cursor}" />
                    </DataTrigger>
                    <DataTrigger Binding="{Binding IconKey}" Value="Zoom">
                        <Setter TargetName="Icon" Property="Data" Value="{StaticResource Zoom}" />
                    </DataTrigger>
                    <DataTrigger Binding="{Binding IconKey}" Value="SectionBox">
                        <Setter TargetName="Icon" Property="Data" Value="{StaticResource SectionBox}" />
                    </DataTrigger>
                    <DataTrigger Binding="{Binding IconKey}" Value="Isolate">
                        <Setter TargetName="Icon" Property="Data" Value="{StaticResource Isolate}" />
                    </DataTrigger>
                    <DataTrigger Binding="{Binding IconKey}" Value="Hide">
                        <Setter TargetName="Icon" Property="Data" Value="{StaticResource EyeCloseGeometry}" />
                    </DataTrigger>
                    <DataTrigger Binding="{Binding IconKey}" Value="Show">
                        <Setter TargetName="Icon" Property="Data" Value="{StaticResource EyeOpenGeometry}" />
                    </DataTrigger>
                    <DataTrigger Binding="{Binding IconKey}" Value="Halftone">
                        <Setter TargetName="Icon" Property="Data" Value="{StaticResource Halftone}" />
                    </DataTrigger>
                    <DataTrigger Binding="{Binding IconKey}" Value="Color">
                        <Setter TargetName="Icon" Property="Data" Value="{StaticResource ColorDrop}" />
                    </DataTrigger>
                    <DataTrigger Binding="{Binding IconKey}" Value="Reset">
                        <Setter TargetName="Icon" Property="Data" Value="{StaticResource Refresh}" />
                    </DataTrigger>
                </DataTemplate.Triggers>
            </DataTemplate>

            <Style x:Key="MenuEntryStyle"
                   BasedOn="{StaticResource {x:Type MenuItem}}"
                   TargetType="MenuItem">
                <Setter Property="AutomationProperties.AutomationId" Value="{Binding Action, StringFormat='Menu.{0}'}" />
                <Setter Property="Command" Value="{Binding Command}" />
                <Setter Property="HeaderTemplate" Value="{StaticResource MenuHeaderTemplate}" />
                <Setter Property="InputGestureText" Value="{Binding Shortcut}" />
                <Setter Property="ToolTip" Value="{Binding DisabledReason}" />
                <Setter Property="ToolTipService.ShowOnDisabled" Value="True" />
                <Style.Triggers>
                    <DataTrigger Binding="{Binding IsVisible}" Value="False">
                        <Setter Property="Visibility" Value="Collapsed" />
                    </DataTrigger>
                    <DataTrigger Binding="{Binding IsSeparator}" Value="True">
                        <Setter Property="Template" Value="{StaticResource MenuSeparatorTemplate}" />
                        <Setter Property="IsEnabled" Value="False" />
                        <Setter Property="Focusable" Value="False" />
                    </DataTrigger>
                </Style.Triggers>
            </Style>
        </ResourceDictionary>
    </ContextMenu.Resources>

    <ContextMenu.ItemContainerStyle>
        <StaticResource ResourceKey="MenuEntryStyle" />
    </ContextMenu.ItemContainerStyle>
</ContextMenu>
