<ResourceDictionary x:Class="DevTools.Presentation.Views.ModelsContext.Filters.FilterRuleTemplates"
                    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:behaviors="clr-namespace:DevTools.UI.Behaviors;assembly=DevTools.UI"
                    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
                    xmlns:dd="clr-namespace:DevTools.UI.Behaviors.DragDrop;assembly=DevTools.UI"
                    xmlns:filters="clr-namespace:DevTools.ModelsContext.Filters;assembly=DevTools.ModelsContext"
                    xmlns:hc="https://handyorg.github.io/handycontrol"
                    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                    xmlns:parameters="clr-namespace:DevTools.ModelsContext.Parameters;assembly=DevTools.ModelsContext"
                    xmlns:scope="clr-namespace:DevTools.ModelsContext.Scope;assembly=DevTools.ModelsContext"
                    xmlns:ui="clr-namespace:DevTools.UI.Controls;assembly=DevTools.UI"
                    xmlns:uiConverters="clr-namespace:DevTools.UI.Converters;assembly=DevTools.UI"
                    xmlns:views="clr-namespace:DevTools.Presentation.Views.ModelsContext.Filters"
                    mc:Ignorable="d">

    <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="/DevTools.UI;component/Controls/TagCheckComboBox/TagCheckComboBox.xaml" />
    </ResourceDictionary.MergedDictionaries>

    <uiConverters:EnumDescriptionConverter x:Key="EnumDescription" />
    <views:ParameterTipConverter x:Key="ParameterTip" />
    <views:FilterDropHandler x:Key="FilterDrop" />

    <Style x:Key="SmallSecondaryText"
           BasedOn="{StaticResource TextBlockDefaultSecLight}"
           TargetType="TextBlock">
        <Setter Property="FontSize" Value="11" />
        <Setter Property="HorizontalAlignment" Value="Left" />
        <Setter Property="TextTrimming" Value="CharacterEllipsis" />
    </Style>

    <Style x:Key="ParameterItemStyle"
           d:DataContext="{d:DesignInstance parameters:ParameterInfo}"
           BasedOn="{StaticResource SmallComboBoxItem}"
           TargetType="ComboBoxItem">
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <!--  Room for the overlay scroll bar (8 px).  -->
        <Setter Property="Margin" Value="0,0,10,0" />
        <Setter Property="AutomationProperties.Name" Value="{Binding SpokenName}" />
    </Style>

    <Style x:Key="SourceIconStyle"
           d:DataContext="{d:DesignInstance parameters:ParameterInfo}"
           TargetType="Path">
        <Setter Property="Width" Value="13" />
        <Setter Property="Height" Value="13" />
        <Setter Property="Margin" Value="4,0,0,0" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="Stretch" Value="Uniform" />
        <Setter Property="StrokeThickness" Value="1.2" />
        <Setter Property="Visibility" Value="Collapsed" />
        <Setter Property="AutomationProperties.AutomationId" Value="Filter.Rule.Parameter.Source" />
        <Style.Triggers>
            <DataTrigger Binding="{Binding Source}" Value="Project">
                <Setter Property="Data" Value="{DynamicResource ProjectParameter}" />
                <Setter Property="Stroke" Value="{DynamicResource SuccessBrush}" />
                <Setter Property="Visibility" Value="Visible" />
            </DataTrigger>
            <DataTrigger Binding="{Binding Source}" Value="Shared">
                <Setter Property="Data" Value="{DynamicResource SharedParameter}" />
                <Setter Property="Stroke" Value="{DynamicResource PrimaryBrush}" />
                <Setter Property="Visibility" Value="Visible" />
            </DataTrigger>
            <DataTrigger Binding="{Binding Source}" Value="Family">
                <Setter Property="Data" Value="{DynamicResource FamilyParameter}" />
                <Setter Property="Stroke" Value="{DynamicResource WarningBrush}" />
                <Setter Property="Visibility" Value="Visible" />
            </DataTrigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="RowSourceIconStyle"
           BasedOn="{StaticResource SourceIconStyle}"
           TargetType="Path">
        <Style.Triggers>
            <DataTrigger Binding="{Binding IsSelected, RelativeSource={RelativeSource AncestorType=ComboBoxItem}}" Value="True">
                <Setter Property="Stroke" Value="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ComboBoxItem}}" />
            </DataTrigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="TipText"
           BasedOn="{StaticResource TextBlockDefault}"
           TargetType="TextBlock">
        <Setter Property="FontSize" Value="11" />
        <Setter Property="HorizontalAlignment" Value="Left" />
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>

    <Style x:Key="TipLabel"
           BasedOn="{StaticResource TextBlockDefaultSecLight}"
           TargetType="TextBlock">
        <Setter Property="FontSize" Value="11" />
        <Setter Property="HorizontalAlignment" Value="Left" />
    </Style>

    <DataTemplate x:Key="TipListTemplate" DataType="{x:Type parameters:TipList}">
        <StackPanel x:Name="List" Margin="0,5,0,0">
            <TextBlock Style="{StaticResource TipLabel}" Text="{Binding Title}" />
            <ItemsControl Focusable="False" ItemsSource="{Binding Items}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <TextBlock Margin="6,0,0,0"
                                   Style="{StaticResource TipText}"
                                   Text="{Binding StringFormat='• {0}'}" />
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
            <TextBlock x:Name="More"
                       Margin="6,0,0,0"
                       Style="{StaticResource TipLabel}"
                       Text="{Binding More}" />
        </StackPanel>
        <DataTemplate.Triggers>
            <DataTrigger Binding="{Binding More}" Value="{x:Null}">
                <Setter TargetName="More" Property="Visibility" Value="Collapsed" />
            </DataTrigger>
            <DataTrigger Binding="{Binding IsEmpty}" Value="True">
                <Setter TargetName="List" Property="Visibility" Value="Collapsed" />
            </DataTrigger>
        </DataTemplate.Triggers>
    </DataTemplate>

    <DataTemplate x:Key="ParameterTipTemplate" DataType="{x:Type parameters:ParameterTip}">
        <StackPanel MaxWidth="320" Grid.IsSharedSizeScope="True">
            <TextBlock Margin="0,0,0,4"
                       FontSize="12"
                       FontWeight="SemiBold"
                       Style="{StaticResource TipText}"
                       Text="{Binding Title}" />
            <ItemsControl Focusable="False" ItemsSource="{Binding Rows}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate DataType="{x:Type parameters:TipRow}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" SharedSizeGroup="TipLabel" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Margin="0,0,10,0"
                                       Style="{StaticResource TipLabel}"
                                       Text="{Binding Label}" />
                            <TextBlock x:Name="Value"
                                       Grid.Column="1"
                                       Style="{StaticResource TipText}"
                                       Text="{Binding Value}" />
                        </Grid>
                        <DataTemplate.Triggers>
                            <DataTrigger Binding="{Binding Label}" Value="{x:Static parameters:ParameterTip.BuiltInLabel}">
                                <Setter TargetName="Value" Property="FontFamily" Value="Consolas" />
                                <Setter TargetName="Value" Property="FontSize" Value="10.5" />
                                <Setter TargetName="Value" Property="TextWrapping" Value="NoWrap" />
                            </DataTrigger>
                            <DataTrigger Binding="{Binding Label}" Value="{x:Static parameters:ParameterTip.GuidLabel}">
                                <Setter TargetName="Value" Property="FontFamily" Value="Consolas" />
                                <Setter TargetName="Value" Property="FontSize" Value="10.5" />
                            </DataTrigger>
                        </DataTemplate.Triggers>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
            <ContentPresenter Content="{Binding Models}" ContentTemplate="{StaticResource TipListTemplate}" />
            <ContentPresenter Content="{Binding Places}" ContentTemplate="{StaticResource TipListTemplate}" />
        </StackPanel>
    </DataTemplate>

    <Style x:Key="ParameterTipStyle"
           BasedOn="{StaticResource ToolTipBaseStyle}"
           TargetType="ToolTip">
        <Setter Property="ContentTemplate" Value="{StaticResource ParameterTipTemplate}" />
    </Style>

    <GroupStyle x:Key="ParameterSections" HidesIfEmpty="True">
        <GroupStyle.Panel>
            <ItemsPanelTemplate>
                <VirtualizingStackPanel IsVirtualizing="True" VirtualizationMode="Recycling" />
            </ItemsPanelTemplate>
        </GroupStyle.Panel>
        <GroupStyle.ContainerStyle>
            <Style TargetType="GroupItem">
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="GroupItem">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="*" />
                                </Grid.RowDefinitions>
                                <ItemsPresenter x:Name="Items" Grid.Row="1" />
                                <ui:StickyGroupHeader x:Name="Header"
                                                      Panel.ZIndex="1"
                                                      AutomationProperties.AutomationId="Filter.Rule.Parameter.Section"
                                                      Content="{TemplateBinding Content}"
                                                      ContentTemplate="{TemplateBinding ContentTemplate}"
                                                      ToolTip="Click to collapse or expand" />
                            </Grid>
                            <ControlTemplate.Triggers>
                                <Trigger SourceName="Header" Property="IsExpanded" Value="False">
                                    <Setter TargetName="Items" Property="Visibility" Value="Collapsed" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
        </GroupStyle.ContainerStyle>
        <GroupStyle.HeaderTemplate>
            <DataTemplate DataType="{x:Type CollectionViewGroup}">
                <Border Padding="4,4,12,2" Background="{DynamicResource RegionBrush}">
                    <Border x:Name="Box"
                            Height="24"
                            Padding="8,0"
                            Background="{DynamicResource RegionBrush}"
                            BorderBrush="{DynamicResource BorderBrush}"
                            BorderThickness="1"
                            CornerRadius="4">
                        <StackPanel Orientation="Horizontal">
                            <Path x:Name="Chevron"
                                  Width="7"
                                  Height="9"
                                  VerticalAlignment="Center"
                                  Data="{DynamicResource Chevron}"
                                  Fill="{DynamicResource SecondaryTextBrush}"
                                  RenderTransformOrigin="0.5,0.5"
                                  Stretch="Uniform" />
                            <TextBlock Margin="6,0,0,0"
                                       VerticalAlignment="Center"
                                       FontWeight="SemiBold"
                                       Style="{StaticResource TextBlockDefault}"
                                       Text="{Binding Name, Converter={StaticResource EnumDescription}}" />
                            <TextBlock Margin="6,0,0,0"
                                       VerticalAlignment="Center"
                                       Style="{StaticResource SmallSecondaryText}"
                                       Text="{Binding ItemCount, StringFormat=N0}" />
                        </StackPanel>
                    </Border>
                </Border>
                <DataTemplate.Triggers>
                    <Trigger SourceName="Box" Property="IsMouseOver" Value="True">
                        <Setter TargetName="Box" Property="Background" Value="{DynamicResource SecondaryRegionBrush}" />
                    </Trigger>
                    <DataTrigger Binding="{Binding IsExpanded, RelativeSource={RelativeSource AncestorType=ui:StickyGroupHeader}}" Value="True">
                        <Setter TargetName="Chevron" Property="RenderTransform">
                            <Setter.Value>
                                <RotateTransform Angle="90" />
                            </Setter.Value>
                        </Setter>
                    </DataTrigger>
                </DataTemplate.Triggers>
            </DataTemplate>
        </GroupStyle.HeaderTemplate>
    </GroupStyle>

    <Style x:Key="EditableValueStyle"
           d:DataContext="{d:DesignInstance filters:RuleViewModel}"
           BasedOn="{StaticResource SmallComboBoxExtend}"
           TargetType="ComboBox">
        <Style.Triggers>
            <DataTrigger Binding="{Binding Kind}" Value="YesNo">
                <Setter Property="Visibility" Value="Collapsed" />
            </DataTrigger>
            <DataTrigger Binding="{Binding Kind}" Value="Reference">
                <Setter Property="Visibility" Value="Collapsed" />
            </DataTrigger>
            <DataTrigger Binding="{Binding Kind}" Value="Enumerated">
                <Setter Property="Visibility" Value="Collapsed" />
            </DataTrigger>
            <DataTrigger Binding="{Binding NeedsValue}" Value="False">
                <Setter Property="Visibility" Value="Collapsed" />
            </DataTrigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="PickValueStyle"
           d:DataContext="{d:DesignInstance filters:RuleViewModel}"
           BasedOn="{StaticResource SmallComboBox}"
           TargetType="ComboBox">
        <Setter Property="Visibility" Value="Collapsed" />
        <Style.Triggers>
            <DataTrigger Binding="{Binding Kind}" Value="Reference">
                <Setter Property="Visibility" Value="Visible" />
            </DataTrigger>
            <DataTrigger Binding="{Binding Kind}" Value="Enumerated">
                <Setter Property="Visibility" Value="Visible" />
            </DataTrigger>
            <DataTrigger Binding="{Binding NeedsValue}" Value="False">
                <Setter Property="Visibility" Value="Collapsed" />
            </DataTrigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="YesNoValueStyle"
           d:DataContext="{d:DesignInstance filters:RuleViewModel}"
           BasedOn="{StaticResource SmallComboBox}"
           TargetType="ComboBox">
        <Setter Property="Visibility" Value="Collapsed" />
        <Style.Triggers>
            <DataTrigger Binding="{Binding Kind}" Value="YesNo">
                <Setter Property="Visibility" Value="Visible" />
            </DataTrigger>
            <DataTrigger Binding="{Binding NeedsValue}" Value="False">
                <Setter Property="Visibility" Value="Collapsed" />
            </DataTrigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="RuleGridStyle"
           d:DataContext="{d:DesignInstance filters:FilterNodeViewModel}"
           TargetType="Grid">
        <Style.Triggers>
            <DataTrigger Binding="{Binding IsReadOnly}" Value="True">
                <Setter Property="IsEnabled" Value="False" />
            </DataTrigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="AddButtonStyle"
           BasedOn="{StaticResource ButtonDefault.Small}"
           TargetType="Button">
        <Setter Property="Margin" Value="0,0,5,0" />
    </Style>

    <Style x:Key="GripStyle"
           d:DataContext="{d:DesignInstance filters:FilterNodeViewModel}"
           TargetType="Thumb">
        <Setter Property="Width" Value="8" />
        <Setter Property="Height" Value="14" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="Focusable" Value="True" />
        <Setter Property="Cursor" Value="SizeAll" />
        <Setter Property="ToolTip" Value="Drag to move · Alt+Up / Alt+Down" />
        <Setter Property="AutomationProperties.AutomationId" Value="Filter.Item.Grip" />
        <Setter Property="AutomationProperties.Name" Value="Move" />
        <Setter Property="dd:DragReorder.IsDragSource" Value="True" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Thumb">
                    <Border x:Name="Area" Background="Transparent">
                        <Path Width="8"
                              Height="12"
                              Data="{DynamicResource ReorderDots}"
                              Fill="{DynamicResource SecondaryTextBrush}"
                              Stretch="Uniform" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="Area" Property="Background" Value="{DynamicResource BorderBrush}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <DataTrigger Binding="{Binding IsReadOnly}" Value="True">
                <Setter Property="Visibility" Value="Hidden" />
            </DataTrigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="ScopeItemStyle"
           d:DataContext="{d:DesignInstance scope:ScopeOptionViewModel}"
           BasedOn="{StaticResource TagCheckComboBoxItem.Small}"
           TargetType="ui:TagCheckComboBoxItem">
        <Setter Property="AutomationProperties.Name" Value="{Binding Name}" />
        <Style.Triggers>
            <DataTrigger Binding="{Binding IsOutsideParent}" Value="True">
                <Setter Property="Foreground" Value="{DynamicResource WarningBrush}" />
            </DataTrigger>
            <DataTrigger Binding="{Binding IsUnresolved}" Value="True">
                <Setter Property="Foreground" Value="{DynamicResource WarningBrush}" />
            </DataTrigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="ScopeBoxStyle"
           BasedOn="{StaticResource TagCheckComboBox.Small}"
           TargetType="ui:TagCheckComboBox">
        <Setter Property="Margin" Value="4,0,0,0" />
        <Setter Property="DisplayMemberPath" Value="Name" />
        <Setter Property="ItemContainerStyle" Value="{StaticResource ScopeItemStyle}" />
        <Setter Property="MaxDropDownHeight" Value="240" />
        <Setter Property="Placeholder" Value="{x:Static filters:RuleSetViewModel.SameAsParent}" />
        <Setter Property="behaviors:CheckedItems.Path" Value="IsChecked" />
    </Style>

    <DataTemplate x:Key="ParameterTemplate" DataType="{x:Type parameters:ParameterInfo}">
        <Grid Background="Transparent">
            <Grid.ToolTip>
                <ToolTip Content="{Binding Converter={StaticResource ParameterTip}}" Style="{StaticResource ParameterTipStyle}" />
            </Grid.ToolTip>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <TextBlock MaxWidth="250"
                       VerticalAlignment="Center"
                       Text="{Binding DisplayName}"
                       TextTrimming="CharacterEllipsis" />
            <Path Grid.Column="1"
                  HorizontalAlignment="Left"
                  Style="{StaticResource RowSourceIconStyle}" />
        </Grid>
    </DataTemplate>

    <Style x:Key="OperatorItemStyle"
           BasedOn="{StaticResource SmallComboBoxItem}"
           TargetType="ComboBoxItem">
        <Setter Property="AutomationProperties.Name" Value="{Binding Converter={StaticResource EnumDescription}}" />
    </Style>

    <DataTemplate x:Key="OperatorTemplate" DataType="{x:Type filters:FilterOperator}">
        <TextBlock Text="{Binding Converter={StaticResource EnumDescription}}" TextTrimming="CharacterEllipsis" />
    </DataTemplate>

    <DataTemplate x:Key="ValueCountTemplate" DataType="{x:Type parameters:ValueCount}">
        <Grid Margin="0,0,10,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock Text="{Binding Value}" TextTrimming="CharacterEllipsis" />
            <TextBlock Grid.Column="1"
                       Margin="8,0,0,0"
                       FontSize="11"
                       Opacity="0.6"
                       Text="{Binding Count, StringFormat=N0}" />
        </Grid>
    </DataTemplate>

    <ItemsPanelTemplate x:Key="ValuesPanel">
        <VirtualizingStackPanel IsVirtualizing="True" VirtualizationMode="Recycling" />
    </ItemsPanelTemplate>

    <DataTemplate x:Key="ChildTemplate" DataType="{x:Type filters:FilterNodeViewModel}">
        <StackPanel>
            <Button x:Name="Connector"
                    MinWidth="38"
                    Margin="0,6,0,0"
                    HorizontalAlignment="Left"
                    AutomationProperties.AutomationId="Filter.Set.Connector"
                    Command="{Binding ToggleConnectorCommand}"
                    Content="{Binding ConnectorText}"
                    Style="{StaticResource ButtonDefault.Small}"
                    ToolTip="Switch AND / OR for this group"
                    Visibility="Collapsed" />
            <ContentPresenter x:Name="Node" Content="{Binding}" />
        </StackPanel>
        <DataTemplate.Triggers>
            <DataTrigger Binding="{Binding ShowsConnector}" Value="True">
                <Setter TargetName="Connector" Property="Visibility" Value="Visible" />
                <Setter TargetName="Node" Property="Margin" Value="0,6,0,0" />
            </DataTrigger>
        </DataTemplate.Triggers>
    </DataTemplate>

    <DataTemplate DataType="{x:Type filters:RuleSetViewModel}">
        <Border x:Name="Frame"
                Padding="5"
                Background="{DynamicResource RegionBrush}"
                BorderBrush="{DynamicResource PrimaryBrush}"
                BorderThickness="1"
                CornerRadius="4">
            <Border.InputBindings>
                <KeyBinding Command="{Binding MoveUpCommand}" Gesture="Alt+Up" />
                <KeyBinding Command="{Binding MoveDownCommand}" Gesture="Alt+Down" />
            </Border.InputBindings>
            <StackPanel>
                <Grid x:Name="Header" Style="{StaticResource RuleGridStyle}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="8" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Thumb Style="{StaticResource GripStyle}" />
                    <TextBlock Grid.Column="1"
                               Margin="5,0,0,0"
                               Style="{StaticResource TextBlockDefaultBold}"
                               Text="Group" />
                    <ToggleButton Grid.Column="3"
                                  Width="20"
                                  Padding="4"
                                  hc:IconElement.Height="10"
                                  hc:IconSwitchElement.Geometry="{StaticResource DownGeometry}"
                                  hc:IconSwitchElement.GeometrySelected="{StaticResource UpGeometry}"
                                  AutomationProperties.AutomationId="Filter.Set.Collapse"
                                  AutomationProperties.Name="Collapse"
                                  IsChecked="{Binding IsExpanded}"
                                  Style="{StaticResource ToggleButtonIconTransparent.Small}"
                                  ToolTip="Collapse or expand the group" />
                    <Button Grid.Column="4"
                            hc:IconElement.Geometry="{StaticResource CloseGeometry}"
                            hc:IconElement.Height="9"
                            AutomationProperties.AutomationId="Filter.Set.Remove"
                            Command="{Binding RemoveCommand}"
                            Style="{StaticResource ButtonIcon.Small}"
                            ToolTip="Remove group" />
                </Grid>
                <Grid x:Name="Scope"
                      Margin="0,5,0,0"
                      Style="{StaticResource RuleGridStyle}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <TextBlock HorizontalAlignment="Left"
                               Style="{StaticResource TextBlockDefaultSecLight}"
                               Text="Search" />
                    <ui:TagCheckComboBox Grid.Column="1"
                                         AutomationProperties.AutomationId="Filter.Set.Scope.Documents"
                                         ItemsSource="{Binding DocumentOptions}"
                                         SearchPlaceholder="Search documents"
                                         Style="{StaticResource ScopeBoxStyle}"
                                         ToolTip="Documents this group searches" />
                    <ui:TagCheckComboBox Grid.Column="2"
                                         AutomationProperties.AutomationId="Filter.Set.Scope.Categories"
                                         ItemsSource="{Binding CategoryOptions}"
                                         SearchPlaceholder="Search categories"
                                         Style="{StaticResource ScopeBoxStyle}"
                                         ToolTip="Categories this group searches" />
                </Grid>
                <Border x:Name="Warning"
                        Margin="0,5,0,0"
                        Padding="6,3"
                        Style="{StaticResource BorderTipWarning}"
                        Visibility="Collapsed">
                    <TextBlock HorizontalAlignment="Left"
                               AutomationProperties.AutomationId="Filter.Set.Warning"
                               FontSize="11"
                               Style="{StaticResource TextBlockDefault}"
                               Text="{Binding Warning}"
                               TextWrapping="Wrap" />
                </Border>
                <StackPanel x:Name="Body" Margin="0,6,0,0">
                    <Grid x:Name="NoRules"
                          Height="30"
                          Margin="0,0,0,6"
                          Background="Transparent"
                          Visibility="Collapsed">
                        <Rectangle RadiusX="4"
                                   RadiusY="4"
                                   Stroke="{DynamicResource BorderBrush}"
                                   StrokeDashArray="4 3"
                                   StrokeThickness="1" />
                        <TextBlock Margin="16,0"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"
                                   AutomationProperties.AutomationId="Filter.NoRules"
                                   Style="{StaticResource SmallSecondaryText}"
                                   Text="No conditions · every element of the checked categories" />
                    </Grid>
                    <views:FilterItemsControl x:Name="Rules"
                                              dd:DragReorder.DropTarget="{StaticResource FilterDrop}"
                                              AutomationProperties.AutomationId="Filter.Rules"
                                              Background="Transparent"
                                              Focusable="False"
                                              ItemTemplate="{StaticResource ChildTemplate}"
                                              ItemsSource="{Binding Children}" />
                    <StackPanel x:Name="AddButtons"
                                Margin="0,6,0,0"
                                Orientation="Horizontal">
                        <Button hc:IconElement.Geometry="{StaticResource AddGeometry}"
                                AutomationProperties.AutomationId="Filter.Rule.Add"
                                Command="{Binding AddConditionCommand}"
                                Content="Condition"
                                Style="{StaticResource AddButtonStyle}"
                                ToolTip="Add a condition" />
                        <Button hc:IconElement.Geometry="{DynamicResource Stack}"
                                AutomationProperties.AutomationId="Filter.Set.Add"
                                Command="{Binding AddGroupCommand}"
                                Content="Group"
                                Style="{StaticResource AddButtonStyle}"
                                ToolTip="Add a group with its own AND / OR and search scope" />
                    </StackPanel>
                </StackPanel>
            </StackPanel>
        </Border>
        <DataTemplate.Triggers>
            <DataTrigger Binding="{Binding HasWarning}" Value="True">
                <Setter TargetName="Warning" Property="Visibility" Value="Visible" />
            </DataTrigger>
            <DataTrigger Binding="{Binding IsExpanded}" Value="False">
                <Setter TargetName="Body" Property="Visibility" Value="Collapsed" />
            </DataTrigger>
            <DataTrigger Binding="{Binding Children.Count}" Value="0">
                <Setter TargetName="AddButtons" Property="Margin" Value="0" />
            </DataTrigger>
            <DataTrigger Binding="{Binding IsRoot}" Value="True">
                <Setter TargetName="Frame" Property="BorderThickness" Value="0" />
                <Setter TargetName="Frame" Property="Padding" Value="0" />
                <Setter TargetName="Frame" Property="Background" Value="Transparent" />
                <Setter TargetName="Header" Property="Visibility" Value="Collapsed" />
                <Setter TargetName="Scope" Property="Visibility" Value="Collapsed" />
                <Setter TargetName="Body" Property="Margin" Value="0" />
            </DataTrigger>
            <DataTrigger Binding="{Binding Children.Count}" Value="0">
                <Setter TargetName="Body" Property="dd:DragReorder.DropList" Value="{Binding ElementName=Rules}" />
            </DataTrigger>
            <MultiDataTrigger>
                <MultiDataTrigger.Conditions>
                    <Condition Binding="{Binding IsRoot}" Value="True" />
                    <Condition Binding="{Binding Children.Count}" Value="0" />
                </MultiDataTrigger.Conditions>
                <Setter TargetName="NoRules" Property="Visibility" Value="Visible" />
            </MultiDataTrigger>
            <DataTrigger Binding="{Binding IsReadOnly}" Value="True">
                <Setter TargetName="AddButtons" Property="Visibility" Value="Collapsed" />
            </DataTrigger>
        </DataTemplate.Triggers>
    </DataTemplate>

    <DataTemplate DataType="{x:Type filters:RuleViewModel}">
        <Border Padding="5"
                Background="{DynamicResource SecondaryRegionBrush}"
                CornerRadius="4">
            <Border.InputBindings>
                <KeyBinding Command="{Binding MoveUpCommand}" Gesture="Alt+Up" />
                <KeyBinding Command="{Binding MoveDownCommand}" Gesture="Alt+Down" />
            </Border.InputBindings>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="8" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Thumb Style="{StaticResource GripStyle}" />
                <Grid Grid.Column="1"
                      Margin="5,0,0,0"
                      Style="{StaticResource RuleGridStyle}">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <ui:AutoCompleteComboBox x:Name="Picker"
                                                 HorizontalContentAlignment="Left"
                                                 AutomationProperties.AutomationId="Filter.Rule.Parameter"
                                                 GroupPath="Section"
                                                 IsSynchronizedWithCurrentItem="False"
                                                 ItemContainerStyle="{StaticResource ParameterItemStyle}"
                                                 ItemTemplate="{StaticResource ParameterTemplate}"
                                                 ItemsPanel="{StaticResource ValuesPanel}"
                                                 ItemsSource="{Binding Parameters}"
                                                 MaxDropDownHeight="220"
                                                 SelectedItem="{Binding SelectedParameter}"
                                                 Style="{StaticResource SmallComboBoxExtend}"
                                                 Text="{Binding ParameterName, UpdateSourceTrigger=PropertyChanged}"
                                                 TextSearch.TextPath="DisplayName"
                                                 ToolTipService.IsEnabled="{Binding SelectedParameter, Converter={StaticResource Object2BooleanConverter}}"
                                                 VirtualizingPanel.IsVirtualizingWhenGrouping="True"
                                                 VirtualizingPanel.VirtualizationMode="Recycling">
                            <ui:AutoCompleteComboBox.GroupStyle>
                                <StaticResource ResourceKey="ParameterSections" />
                            </ui:AutoCompleteComboBox.GroupStyle>
                            <ui:AutoCompleteComboBox.ToolTip>
                                <ToolTip Content="{Binding SelectedParameter, Converter={StaticResource ParameterTip}}" Style="{StaticResource ParameterTipStyle}" />
                            </ui:AutoCompleteComboBox.ToolTip>
                        </ui:AutoCompleteComboBox>
                        <DockPanel x:Name="Chosen"
                                   Margin="8,0,26,0"
                                   VerticalAlignment="Center"
                                   DataContext="{Binding SelectedParameter}"
                                   IsHitTestVisible="False">
                            <TextBlock x:Name="ChosenType"
                                       AutomationProperties.AutomationId="Filter.Rule.Parameter.Type"
                                       DockPanel.Dock="Right"
                                       Text="{x:Static filters:RuleViewModel.TypeText}">
                                <TextBlock.Style>
                                    <Style BasedOn="{StaticResource SmallSecondaryText}" TargetType="TextBlock">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                        <Setter Property="VerticalAlignment" Value="Center" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsType}" Value="True">
                                                <Setter Property="Visibility" Value="Visible" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock FontSize="{Binding FontSize, ElementName=Picker}"
                                           Text="{Binding Text, ElementName=Picker}"
                                           Visibility="Hidden" />
                                <Path Style="{StaticResource SourceIconStyle}" />
                            </StackPanel>
                        </DockPanel>
                        <ToggleButton Grid.Column="1"
                                      MinWidth="24"
                                      Margin="5,0,0,0"
                                      AutomationProperties.AutomationId="Filter.Rule.CaseSensitive"
                                      Content="Aa"
                                      IsChecked="{Binding IsCaseSensitive}"
                                      Style="{StaticResource ToggleButtonDefault.Small}"
                                      ToolTip="Match case"
                                      Visibility="{Binding CanBeCaseSensitive, Converter={StaticResource Boolean2VisibilityConverter}}" />
                    </Grid>
                    <Grid Grid.Row="1" Margin="0,5,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <ComboBox AutomationProperties.AutomationId="Filter.Rule.Operator"
                                  ItemContainerStyle="{StaticResource OperatorItemStyle}"
                                  ItemTemplate="{StaticResource OperatorTemplate}"
                                  ItemsSource="{Binding Operators}"
                                  SelectedItem="{Binding Operator}"
                                  Style="{StaticResource SmallComboBox}" />
                        <ComboBox Grid.Column="1"
                                  Margin="5,0,0,0"
                                  hc:InfoElement.Placeholder="{Binding ValueHint}"
                                  AutomationProperties.AutomationId="Filter.Rule.Value"
                                  DropDownOpened="OnValuesOpened"
                                  IsEditable="True"
                                  ItemTemplate="{StaticResource ValueCountTemplate}"
                                  ItemsPanel="{StaticResource ValuesPanel}"
                                  ItemsSource="{Binding Values}"
                                  MaxDropDownHeight="200"
                                  SelectedItem="{Binding PickedValue, Mode=OneWayToSource}"
                                  Style="{StaticResource EditableValueStyle}"
                                  Text="{Binding Value, UpdateSourceTrigger=PropertyChanged}"
                                  TextSearch.TextPath="Value" />
                        <ComboBox Grid.Column="1"
                                  Margin="5,0,0,0"
                                  AutomationProperties.AutomationId="Filter.Rule.Value"
                                  DropDownOpened="OnValuesOpened"
                                  ItemTemplate="{StaticResource ValueCountTemplate}"
                                  ItemsPanel="{StaticResource ValuesPanel}"
                                  ItemsSource="{Binding Values}"
                                  Loaded="OnValuesLoaded"
                                  MaxDropDownHeight="200"
                                  SelectedValue="{Binding Value}"
                                  SelectedValuePath="Value"
                                  Style="{StaticResource PickValueStyle}" />
                        <ComboBox Grid.Column="1"
                                  Margin="5,0,0,0"
                                  AutomationProperties.AutomationId="Filter.Rule.Value"
                                  SelectedValue="{Binding Value}"
                                  SelectedValuePath="Content"
                                  Style="{StaticResource YesNoValueStyle}">
                            <ComboBoxItem Content="{x:Static parameters:ValueKinds.Yes}" />
                            <ComboBoxItem Content="{x:Static parameters:ValueKinds.No}" />
                        </ComboBox>
                        <Button Grid.Column="2"
                                Margin="3,0,0,0"
                                hc:IconElement.Geometry="{StaticResource CloseGeometry}"
                                hc:IconElement.Height="9"
                                AutomationProperties.AutomationId="Filter.Rule.Remove"
                                Command="{Binding RemoveCommand}"
                                Style="{StaticResource ButtonIcon.Small}"
                                ToolTip="Remove condition" />
                    </Grid>
                    <StackPanel Grid.Row="2" Orientation="Horizontal">
                        <TextBlock x:Name="NoParameter"
                                   Margin="0,2,0,0"
                                   FontSize="10"
                                   Style="{StaticResource TextBlockDefaultSecLight}"
                                   Text="{Binding NoParameterCount, StringFormat='[No parameter] · {0:N0}'}" />
                        <TextBlock x:Name="MoreValues"
                                   Margin="8,2,0,0"
                                   FontSize="10"
                                   Style="{StaticResource TextBlockDefaultSecLight}"
                                   Text="more…"
                                   Visibility="Collapsed" />
                    </StackPanel>
                </Grid>
            </Grid>
        </Border>
        <DataTemplate.Triggers>
            <DataTrigger Binding="{Binding NoParameterCount}" Value="0">
                <Setter TargetName="NoParameter" Property="Visibility" Value="Collapsed" />
            </DataTrigger>
            <DataTrigger Binding="{Binding HasMoreValues}" Value="True">
                <Setter TargetName="MoreValues" Property="Visibility" Value="Visible" />
            </DataTrigger>
        </DataTemplate.Triggers>
    </DataTemplate>

    <DataTemplate DataType="{x:Type filters:UnsupportedRuleViewModel}">
        <TextBlock HorizontalAlignment="Left"
                   AutomationProperties.AutomationId="Filter.Rule.Unsupported"
                   Style="{StaticResource TextBlockDefaultWarning}"
                   Text="{Binding Description, StringFormat='Unsupported rule: {0}'}"
                   TextWrapping="Wrap" />
    </DataTemplate>

</ResourceDictionary>
