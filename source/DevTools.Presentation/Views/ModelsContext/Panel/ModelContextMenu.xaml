<ContextMenu x:Class="DevTools.Presentation.Views.ModelsContext.Panel.ModelContextMenu"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:design="clr-namespace:DevTools.UI.Theme.Design;assembly=DevTools.UI"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:views="clr-namespace:DevTools.Presentation.Views.ModelsContext.Panel"
             AutomationProperties.AutomationId="Menu"
             DataContext="{Binding Path=PlacementTarget.(FrameworkElement.DataContext), RelativeSource={RelativeSource Self}}"
             Style="{DynamicResource {x:Type ContextMenu}}"
             mc:Ignorable="d">

    <ContextMenu.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/DevTools.UI;component/Theme/Theme.xaml" />
                <design:IntellisenseResources Source="/DevTools.UI;component/Theme/Design/DesignTimeResources.xaml" />
                <views:ModelContextResources />
            </ResourceDictionary.MergedDictionaries>

            <Style x:Key="MenuIconStyle" TargetType="Path">
                <Setter Property="Width" Value="14" />
                <Setter Property="Height" Value="14" />
                <Setter Property="Stretch" Value="Uniform" />
                <Setter Property="Fill" Value="{Binding (TextElement.Foreground), RelativeSource={RelativeSource Self}}" />
            </Style>

            <Style x:Key="HideShowIconStyle"
                   BasedOn="{StaticResource MenuIconStyle}"
                   TargetType="Path">
                <Setter Property="Data" Value="{StaticResource EyeCloseGeometry}" />
                <Style.Triggers>
                    <DataTrigger Binding="{Binding IconKey}" Value="Show">
                        <Setter Property="Data" Value="{StaticResource EyeOpenGeometry}" />
                    </DataTrigger>
                </Style.Triggers>
            </Style>

            <Style x:Key="MenuEntryStyle"
                   BasedOn="{StaticResource {x:Type MenuItem}}"
                   TargetType="MenuItem">
                <Setter Property="AutomationProperties.AutomationId" Value="{Binding Action, StringFormat='Menu.{0}'}" />
                <Setter Property="Command" Value="{Binding Command}" />
                <Setter Property="Header" Value="{Binding Text}" />
                <Setter Property="InputGestureText" Value="{Binding Shortcut}" />
                <Setter Property="ToolTip" Value="{Binding ToolTipText}" />
                <Setter Property="ToolTipService.ShowOnDisabled" Value="True" />
                <Style.Triggers>
                    <DataTrigger Binding="{Binding IsVisible}" Value="False">
                        <Setter Property="Visibility" Value="Collapsed" />
                    </DataTrigger>
                </Style.Triggers>
            </Style>
        </ResourceDictionary>
    </ContextMenu.Resources>

    <MenuItem DataContext="{Binding ContextMenu[SelectInHost]}" Style="{StaticResource MenuEntryStyle}">
        <MenuItem.Icon>
            <Path Data="{StaticResource Cursor}" Style="{StaticResource MenuIconStyle}" />
        </MenuItem.Icon>
    </MenuItem>
    <MenuItem DataContext="{Binding ContextMenu[Zoom]}" Style="{StaticResource MenuEntryStyle}">
        <MenuItem.Icon>
            <Path Data="{StaticResource Zoom}" Style="{StaticResource MenuIconStyle}" />
        </MenuItem.Icon>
    </MenuItem>
    <MenuItem DataContext="{Binding ContextMenu[SectionBox]}" Style="{StaticResource MenuEntryStyle}">
        <MenuItem.Icon>
            <Path Data="{StaticResource SectionBox}" Style="{StaticResource MenuIconStyle}" />
        </MenuItem.Icon>
    </MenuItem>
    <Separator />
    <MenuItem DataContext="{Binding ContextMenu[Isolate]}" Style="{StaticResource MenuEntryStyle}">
        <MenuItem.Icon>
            <Path Data="{StaticResource Isolate}" Style="{StaticResource MenuIconStyle}" />
        </MenuItem.Icon>
    </MenuItem>
    <MenuItem DataContext="{Binding ContextMenu[HideShow]}" Style="{StaticResource MenuEntryStyle}">
        <MenuItem.Icon>
            <Path Style="{StaticResource HideShowIconStyle}" />
        </MenuItem.Icon>
    </MenuItem>
    <MenuItem DataContext="{Binding ContextMenu[Halftone]}" Style="{StaticResource MenuEntryStyle}">
        <MenuItem.Icon>
            <Path Data="{StaticResource Halftone}" Style="{StaticResource MenuIconStyle}" />
        </MenuItem.Icon>
    </MenuItem>
    <MenuItem DataContext="{Binding ContextMenu[Color]}" Style="{StaticResource MenuEntryStyle}">
        <MenuItem.Icon>
            <Path Data="{StaticResource ColorDrop}" Style="{StaticResource MenuIconStyle}" />
        </MenuItem.Icon>
    </MenuItem>
    <Separator />
    <MenuItem DataContext="{Binding ContextMenu[WhyHidden]}" Style="{StaticResource MenuEntryStyle}">
        <MenuItem.Icon>
            <Path Data="{StaticResource AskGeometry}" Style="{StaticResource MenuIconStyle}" />
        </MenuItem.Icon>
    </MenuItem>
</ContextMenu>
