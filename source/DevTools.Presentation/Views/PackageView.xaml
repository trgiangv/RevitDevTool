<UserControl x:Class="DevTools.Presentation.Views.PackageView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:behav="clr-namespace:DevTools.UI.Behaviors;assembly=DevTools.UI"
             xmlns:control="clr-namespace:DevTools.UI.Controls;assembly=DevTools.UI"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:design="clr-namespace:DevTools.UI.Theme.Design;assembly=DevTools.UI"
             xmlns:hc="https://handyorg.github.io/handycontrol"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:models="http://devtools.execution/models"
             xmlns:viewModels="clr-namespace:DevTools.Presentation.ViewModels"
             d:DataContext="{d:DesignInstance viewModels:PackageViewModel}"
             d:DesignHeight="500"
             d:DesignWidth="400"
             mc:Ignorable="d">

    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/DevTools.UI;component/Theme/Theme.xaml" />
                <design:IntellisenseResources Source="/DevTools.UI;component/Theme/Design/DesignTimeResources.xaml" />
            </ResourceDictionary.MergedDictionaries>
            <HierarchicalDataTemplate DataType="{x:Type models:MarketplaceNode}"
                                      ItemsSource="{Binding Children}">
                <StackPanel Orientation="Horizontal">
                    <Image Width="14"
                           Height="14"
                           Margin="0,0,6,0">
                        <Image.Style>
                            <Style TargetType="Image">
                                <Setter Property="Source" Value="{StaticResource NuGetIcon}" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Marketplace}"
                                                 Value="{x:Static models:Marketplace.NuGet}">
                                        <Setter Property="Source" Value="{StaticResource NuGetIcon}" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding Marketplace}"
                                                 Value="{x:Static models:Marketplace.CondaForge}">
                                        <Setter Property="Source" Value="{StaticResource CondaForgeIcon}" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding Marketplace}"
                                                 Value="{x:Static models:Marketplace.PyPi}">
                                        <Setter Property="Source" Value="{StaticResource PypiIcon}" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Image.Style>
                    </Image>
                    <TextBlock behav:HighlightTextBlockBehavior.Range="{Binding HighlightRange}"
                               FontWeight="SemiBold"
                               Text="{Binding Name}" />
                    <TextBlock Margin="6,0,0,0"
                               Text="{Binding Children.Count, StringFormat='({0})'}" />
                </StackPanel>
            </HierarchicalDataTemplate>

            <DataTemplate DataType="{x:Type models:PackageItemNode}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock x:Name="PackageNameTb"
                               Grid.Column="1"
                               behav:HighlightTextBlockBehavior.Range="{Binding HighlightRange}"
                               Text="{Binding Name}" />
                    <Path Grid.Column="0"
                          Width="11"
                          Height="11"
                          Margin="0,0,6,0"
                          VerticalAlignment="Center"
                          Data="{StaticResource Box}"
                          Fill="{Binding Path=Foreground, ElementName=PackageNameTb}"
                          Stretch="Uniform" />
                    <Border Grid.Column="2"
                            Margin="6,0,0,0"
                            Padding="4,1"
                            Background="{DynamicResource PrimaryBrush}"
                            CornerRadius="3"
                            Visibility="{Binding IsLatest, Converter={StaticResource Boolean2VisibilityConverter}}">
                        <TextBlock FontSize="10"
                                   FontWeight="SemiBold"
                                   Foreground="{StaticResource TextIconBrush}"
                                   Text="Latest" />
                    </Border>
                </Grid>
            </DataTemplate>

            <Style x:Key="ExtendedTreeViewItemStyle"
                   d:DataContext="{d:DesignInstance models:TreeNodeBase}"
                   BasedOn="{StaticResource TreeViewItemBaseStyle}"
                   TargetType="{x:Type TreeViewItem}">
                <Setter Property="IsExpanded" Value="{Binding IsExpanded, Mode=TwoWay}" />
                <Setter Property="IsSelected" Value="{Binding IsSelected, Mode=TwoWay}" />
                <Setter Property="Visibility" Value="{Binding IsVisible, Converter={StaticResource Boolean2VisibilityConverter}}" />
            </Style>
        </ResourceDictionary>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <control:ExtendedTreeView ItemContainerStyle="{StaticResource ExtendedTreeViewItemStyle}"
                                  ItemsSource="{Binding FilteredItems}"
                                  SelectedTreeItem="{Binding SelectedNode, Mode=TwoWay}">
            <control:ExtendedTreeView.ContextMenu>
                <ContextMenu Width="{StaticResource Length200}">
                    <MenuItem Command="{Binding RemoveCommand}"
                              Header="Remove" />
                    <MenuItem Command="{Binding RemoveAllCommand}"
                              Header="Remove All" />
                    <Separator />
                    <MenuItem Command="{Binding UpdateCommand}"
                              Header="Update" />
                    <MenuItem Command="{Binding RepairCommand}"
                              Header="Repair" />
                </ContextMenu>
            </control:ExtendedTreeView.ContextMenu>
        </control:ExtendedTreeView>

        <Border Grid.Row="1"
                Margin="0,6,0,0"
                Padding="8,6"
                Background="{DynamicResource RegionBrush}"
                BorderThickness="1"
                Visibility="{Binding IsBusy, Converter={StaticResource Boolean2VisibilityConverter}}">
            <StackPanel>
                <TextBlock FontSize="11"
                           Foreground="{DynamicResource PrimaryTextBrush}"
                           Text="{Binding BusyMessage}" />
                <hc:LoadingLine Margin="0,6,0,0"
                                IsRunning="{Binding IsBusy}" />
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
