<UserControl x:Class="DevTools.Presentation.Views.MemoryView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:converters="clr-namespace:DevTools.Presentation.Converters"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:design="clr-namespace:DevTools.UI.Theme.Design;assembly=DevTools.UI"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:viewModels="clr-namespace:DevTools.Presentation.ViewModels"
             d:Background="{DynamicResource DevTools.MahApps.Brushes.ThemeBackground}"
             d:DataContext="{d:DesignInstance viewModels:MemoryViewModel}"
             d:DesignHeight="100"
             d:DesignWidth="450"
             mc:Ignorable="d">

    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/DevTools.UI;component/Theme/Theme.xaml" />
                <design:IntellisenseResources Source="/DevTools.UI;component/Theme/Design/DesignTimeResources.xaml" />
            </ResourceDictionary.MergedDictionaries>
            <converters:ExecutionModeImageConverter x:Key="ModeToImageConverter" />
            <converters:ExecutionModeVisibilityConverter x:Key="ModeToVisibilityConverter" />
        </ResourceDictionary>
    </UserControl.Resources>

    <Border Padding="10,8"
            BorderBrush="{DynamicResource DevTools.MahApps.Brushes.Gray8}"
            BorderThickness="1"
            CornerRadius="6">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Grid Grid.Row="0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal">
                    <TextBlock FontSize="11"
                               Foreground="{DynamicResource DevTools.MahApps.Brushes.Gray}"
                               Text="Working Set:" />
                    <TextBlock Margin="5,0,0,0"
                               FontSize="11"
                               FontWeight="SemiBold"
                               Foreground="{DynamicResource DevTools.MahApps.Brushes.ThemeForeground}"
                               Text="{Binding WorkingSetMb, Mode=OneWay, StringFormat='{}{0:F1} MB'}" />
                </StackPanel>
                <StackPanel Grid.Column="1"
                            HorizontalAlignment="Center"
                            Orientation="Horizontal">
                    <TextBlock FontSize="11"
                               Foreground="{DynamicResource DevTools.MahApps.Brushes.Gray}"
                               Text="Private:" />
                    <TextBlock Margin="5,0,0,0"
                               FontSize="11"
                               FontWeight="SemiBold"
                               Foreground="{DynamicResource DevTools.MahApps.Brushes.ThemeForeground}"
                               Text="{Binding PrivateMb, Mode=OneWay, StringFormat='{}{0:F1} MB'}" />
                </StackPanel>
                <StackPanel Grid.Column="2"
                            HorizontalAlignment="Center"
                            Orientation="Horizontal">
                    <TextBlock FontSize="11"
                               Foreground="{DynamicResource DevTools.MahApps.Brushes.Gray}"
                               Text="Managed:" />
                    <TextBlock Margin="5,0,0,0"
                               FontSize="11"
                               FontWeight="SemiBold"
                               Foreground="{DynamicResource DevTools.MahApps.Brushes.ThemeForeground}"
                               Text="{Binding ManagedMb, Mode=OneWay, StringFormat='{}{0:F1} MB'}" />
                </StackPanel>
                <TextBlock Grid.Column="3"
                           Margin="8,0,0,0"
                           HorizontalAlignment="Right"
                           FontSize="11">
                    <Run Foreground="{DynamicResource DevTools.MahApps.Brushes.Gray}"
                         Text="H/T: " />
                    <Run FontWeight="SemiBold"
                         Foreground="{DynamicResource DevTools.MahApps.Brushes.ThemeForeground}"
                         Text="{Binding HandleCount, Mode=OneWay}" />
                    <Run Foreground="{DynamicResource DevTools.MahApps.Brushes.Gray}"
                         Text=" / " />
                    <Run FontWeight="SemiBold"
                         Foreground="{DynamicResource DevTools.MahApps.Brushes.ThemeForeground}"
                         Text="{Binding ThreadCount, Mode=OneWay}" />
                </TextBlock>
            </Grid>

            <Grid Grid.Row="1"
                  Margin="0,7,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0"
                            VerticalAlignment="Center"
                            Orientation="Horizontal">
                    <Image Width="14"
                           Height="14"
                           Margin="0,0,6,0"
                           VerticalAlignment="Center"
                           Source="{Binding LastExecutionMode, Converter={StaticResource ModeToImageConverter}, Mode=OneWay}"
                           Visibility="{Binding LastExecutionMode, Converter={StaticResource ModeToVisibilityConverter}, Mode=OneWay}" />
                    <TextBlock FontSize="11"
                               FontWeight="SemiBold"
                               Foreground="{DynamicResource DevTools.MahApps.Brushes.ThemeForeground}"
                               Text="{Binding LastOperationName, Mode=OneWay}"
                               TextTrimming="CharacterEllipsis" />
                </StackPanel>
                <Border Grid.Column="1"
                        Margin="8,0,0,0"
                        Padding="8,3"
                        VerticalAlignment="Center"
                        Background="{Binding LastOutcomeBrush, Mode=OneWay}"
                        CornerRadius="4">
                    <TextBlock FontSize="10"
                               FontWeight="SemiBold"
                               Foreground="White"
                               Text="{Binding LastOutcomeText, Mode=OneWay}" />
                </Border>
            </Grid>

            <DockPanel Grid.Row="2"
                       Margin="0,6,0,0"
                       LastChildFill="True">
                <TextBlock Margin="8,0,0,0"
                           VerticalAlignment="Center"
                           DockPanel.Dock="Right"
                           FontSize="10"
                           Foreground="{DynamicResource DevTools.MahApps.Brushes.Gray}"
                           Text="{Binding LastOperationDurationMs, Mode=OneWay, StringFormat='{}{0} ms'}" />
                <TextBlock VerticalAlignment="Center"
                           FontSize="10">
                    <Run Foreground="{DynamicResource DevTools.MahApps.Brushes.Gray}"
                         Text="ΔPrivate: " />
                    <Run FontWeight="SemiBold"
                         Foreground="{Binding LastDeltaPrivateBrush, Mode=OneWay}"
                         Text="{Binding LastDeltaPrivateMb, Mode=OneWay, StringFormat='{}{0:+0.0;-0.0;0.0} MB'}" />
                    <Run Foreground="{DynamicResource DevTools.MahApps.Brushes.Gray}"
                         Text="   ΔManaged: " />
                    <Run FontWeight="SemiBold"
                         Foreground="{Binding LastDeltaManagedBrush, Mode=OneWay}"
                         Text="{Binding LastDeltaManagedMb, Mode=OneWay, StringFormat='{}{0:+0.0;-0.0;0.0} MB'}" />
                    <Run Foreground="{DynamicResource DevTools.MahApps.Brushes.Gray}"
                         Text="   ΔHandles: " />
                    <Run FontWeight="SemiBold"
                         Foreground="{Binding LastDeltaHandlesBrush, Mode=OneWay}"
                         Text="{Binding LastDeltaHandles, Mode=OneWay, StringFormat='{}{0:+#;-#;0}'}" />
                    <Run Foreground="{DynamicResource DevTools.MahApps.Brushes.Gray}"
                         Text="   Peak: " />
                    <Run FontWeight="SemiBold"
                         Foreground="{DynamicResource DevTools.MahApps.Brushes.Gray2}"
                         Text="{Binding LastPeakPrivateDeltaMb, Mode=OneWay, StringFormat='{}{0:+0.0;-0.0;0.0} MB'}" />
                </TextBlock>
            </DockPanel>
        </Grid>
    </Border>
</UserControl>
