<Project Sdk="Microsoft.NET.Sdk">
    <PropertyGroup>
        <TargetFrameworks>net48;net8.0-windows;net10.0-windows</TargetFrameworks>
        <RootNamespace>DevTools.Testing.Transport</RootNamespace>
        <AssemblyName>DevTools.Testing.Transport</AssemblyName>
    </PropertyGroup>

    <ItemGroup Condition="'$(TargetFramework)' == 'net48'">
        <PackageReference Include="System.Text.Json"/>
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="..\DevTools.Ipc\DevTools.Ipc.csproj"/>
        <ProjectReference Include="..\DevTools.Testing.Abstractions\DevTools.Testing.Abstractions.csproj"/>
        <ProjectReference Include="..\DevTools.Utilities\DevTools.Utilities.csproj"/>
    </ItemGroup>

    <Import Project="..\..\props\TestingRuntime.props"/>

    <Target Name="GenerateTestingRuntimeContract" BeforeTargets="BeforeCompile">
        <PropertyGroup>
            <_TestingRuntimeContractPath>$(IntermediateOutputPath)TestingRuntimeContract.g.cs</_TestingRuntimeContractPath>
        </PropertyGroup>
        <WriteLinesToFile File="$(_TestingRuntimeContractPath)"
                          Lines="namespace DevTools.Testing.Transport%3B&#xA;&#xA;public static class TestingRuntimeContract&#xA;{&#xA;    public const int Current = $(TestingRuntimeContractCurrent)%3B&#xA;    public const int Min = $(TestingRuntimeContractMin)%3B&#xA;}"
                          Overwrite="true"
                          WriteOnlyWhenDifferent="true"/>
        <ItemGroup>
            <Compile Include="$(_TestingRuntimeContractPath)"/>
            <FileWrites Include="$(_TestingRuntimeContractPath)"/>
        </ItemGroup>
    </Target>
</Project>
