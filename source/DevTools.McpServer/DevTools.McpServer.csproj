<Project Sdk="Microsoft.NET.Sdk">

    <!--
        Build (dev):   dotnet build
        Publish:       dotnet publish -c Release

        Usage:
            MCPServer.exe                                                       stdio mode (Claude Desktop, Cursor)
            MCPServer.exe  gateway wss://gw.example.com/tunnel  token xxx       gateway tunnel mode (enterprise)
    -->

    <PropertyGroup>
        <OutputType>Exe</OutputType>
        <AssemblyName>MCPServer</AssemblyName>
        <TargetFramework>net10.0-windows</TargetFramework>
        <RuntimeIdentifier>win-x64</RuntimeIdentifier>
        <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
        <SelfContained>true</SelfContained>
        <PublishSingleFile>true</PublishSingleFile>
        <PublishTrimmed>true</PublishTrimmed>
        <TrimMode>partial</TrimMode>
        <SuppressTrimAnalysisWarnings>true</SuppressTrimAnalysisWarnings>
        <JsonSerializerIsReflectionEnabledByDefault>true</JsonSerializerIsReflectionEnabledByDefault>
        <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
        <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    </PropertyGroup>

    <PropertyGroup>
        <BundleContentsFolder>$(AppData)\Autodesk\ApplicationPlugins\RevitDevTool.bundle\Contents</BundleContentsFolder>
    </PropertyGroup>

    <PropertyGroup Condition="$(Configuration.Contains('Release'))">
        <DebugType>none</DebugType>
        <DebugSymbols>false</DebugSymbols>
    </PropertyGroup>

    <Target Name="DeployMcpServer" AfterTargets="Publish">
        <Exec Command="taskkill /F /IM MCPServer.exe 2>nul &amp; ping -n 2 127.0.0.1 >nul" IgnoreExitCode="true" />
        <MakeDir Directories="$(BundleContentsFolder)" />
        <Copy SourceFiles="$(PublishDir)MCPServer.exe" DestinationFolder="$(BundleContentsFolder)" OverwriteReadOnlyFiles="true" Retries="3" RetryDelayMilliseconds="1000" />
    </Target>

    <ItemGroup>
        <PackageReference Include="ACadSharp" />
        <PackageReference Include="Microsoft.Extensions.Hosting" />
        <PackageReference Include="ModelContextProtocol" />
        <PackageReference Include="OpenMcdf" />
        <PackageReference Include="ZLogger" />
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="..\DevTools.Logging\DevTools.Logging.csproj" />
        <ProjectReference Include="..\DevTools.McpParser\DevTools.McpParser.csproj" />
    </ItemGroup>

</Project>
