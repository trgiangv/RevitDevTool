<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFrameworks>net48;net8.0-windows;net10.0-windows</TargetFrameworks>
        <UseWpf>true</UseWpf>
    </PropertyGroup>

    <PropertyGroup Condition="$([MSBuild]::IsTargetFrameworkCompatible('$(TargetFramework)', 'net10.0'))">
        <NoWarn>$(NoWarn);WPF0001</NoWarn>
    </PropertyGroup>

    <ItemGroup>
        <ProjectReference Include="..\..\libs\MahApps.Metro\src\MahApps.Metro\MahApps.Metro.csproj" />
    </ItemGroup>

    <ItemGroup Condition="!$([MSBuild]::IsTargetFrameworkCompatible('$(TargetFramework)', 'net10.0'))">
        <ProjectReference Include="..\PresentationFramework.Fluent\PresentationFramework.Fluent.csproj" SetTargetFramework="TargetFramework=$(TargetFramework)" />
    </ItemGroup>

    <ItemGroup>
        <Resource Include="Resources\icons\*.*"/>
    </ItemGroup>

</Project>
