    <!--Combine XAML-->
    <Target Name="CombineHandyTheme" BeforeTargets="MarkupCompilePass1">
        <PropertyGroup>
            <_XamlCombineDir>$(HandySharedDir)Themes</_XamlCombineDir>
        </PropertyGroup>
        <Exec Command="&quot;$(_XamlCombineDir)\XamlCombine.exe&quot; Theme_GE45.txt Theme.xaml"
              WorkingDirectory="$(_XamlCombineDir)"/>
    </Target>

    <!--Names embedded BAML themes/*.baml-->
    <Target Name="LinkHandySharedItems" BeforeTargets="MarkupCompilePass1">
        <PropertyGroup>
            <_HandyRoot>$([System.IO.Path]::GetFullPath('$(HandySharedDir)'))</_HandyRoot>
        </PropertyGroup>
        <ItemGroup>
            <Page>
                <Link Condition="$([System.String]::Copy('%(FullPath)').StartsWith('$(_HandyRoot)', System.StringComparison.OrdinalIgnoreCase))">$([System.IO.Path]::GetRelativePath('$(_HandyRoot)', '%(FullPath)'))</Link>
            </Page>
            <EmbeddedResource>
                <Link Condition="'%(Link)' == '' and $([System.String]::Copy('%(FullPath)').StartsWith('$(_HandyRoot)', System.StringComparison.OrdinalIgnoreCase))">$([System.IO.Path]::GetRelativePath('$(_HandyRoot)', '%(FullPath)'))</Link>
            </EmbeddedResource>
        </ItemGroup>
    </Target>

    <!--IntelliSense-->
    <ItemGroup Condition="'$(DesignTimeBuild)' == 'true' AND '$(BuildingProject)' != 'true'">
        <Reference Include="HandyControl">
            <HintPath>..\..\libs\HandyControl\src\Net_GE45\HandyControl_Net_GE45\bin\$(Configuration)\$(TargetFramework)\HandyControl.dll</HintPath>
            <Private>false</Private>
        </Reference>
    </ItemGroup>

</Project>
