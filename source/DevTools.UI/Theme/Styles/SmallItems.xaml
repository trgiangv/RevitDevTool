<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:system="clr-namespace:System;assembly=System.Runtime"
                    xmlns:theme="clr-namespace:DevTools.UI.Theme">

    <ResourceDictionary.MergedDictionaries>
        <theme:ControlsResources />
    </ResourceDictionary.MergedDictionaries>

    <system:Double x:Key="SmallItemFontSize">11</system:Double>
    <system:Double x:Key="SmallItemHeight">20</system:Double>

    <Style x:Key="SmallComboBoxItem"
           BasedOn="{StaticResource ComboBoxItem.Small}"
           TargetType="ComboBoxItem">
        <Setter Property="FontSize" Value="{StaticResource SmallItemFontSize}" />
        <Setter Property="MinHeight" Value="{StaticResource SmallItemHeight}" />
    </Style>

    <Style x:Key="SmallComboBox"
           BasedOn="{StaticResource ComboBox.Small}"
           TargetType="ComboBox">
        <Setter Property="ItemContainerStyle" Value="{StaticResource SmallComboBoxItem}" />
    </Style>

    <Style x:Key="SmallComboBoxExtend"
           BasedOn="{StaticResource ComboBoxExtend.Small}"
           TargetType="ComboBox">
        <Setter Property="ItemContainerStyle" Value="{StaticResource SmallComboBoxItem}" />
    </Style>

</ResourceDictionary>
