<Application x:Class="RevitDevTool.Desktop.App"
             xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:avalonia="clr-namespace:Material.Icons.Avalonia;assembly=Material.Icons.Avalonia"
             xmlns:common="using:RevitDevTool.Desktop.Common"
             xmlns:converters="using:RevitDevTool.Desktop.Converters"
             xmlns:suki="https://github.com/kikipoulet/SukiUI"
             RequestedThemeVariant="Default">
    <Application.DataTemplates>
        <common:ViewLocator />
    </Application.DataTemplates>

    <Application.Resources>
        <converters:BoolToStatusBrushConverter x:Key="BoolToStatusBrushConverter" />
        <converters:EnumDisplayConverter x:Key="EnumDisplayConverter" />
    </Application.Resources>

    <Application.Styles>
        <suki:SukiTheme ThemeColor="Blue" />
        <avalonia:MaterialIconStyles />
    </Application.Styles>
</Application>
