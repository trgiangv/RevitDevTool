<UserControl x:Class="RevitDevTool.Desktop.Views.Processor.HeaderBarView"
             xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:automation="clr-namespace:Avalonia.Automation;assembly=Avalonia.Controls"
             xmlns:avalonia="clr-namespace:Material.Icons.Avalonia;assembly=Material.Icons.Avalonia"
             xmlns:vm="using:RevitDevTool.Desktop.ViewModels"
             x:DataType="vm:ProcessorPageViewModel">
    <Grid VerticalAlignment="Center"
          automation:AutomationProperties.AutomationId="HeaderBar"
          ColumnDefinitions="*,Auto,Auto,Auto,Auto,Auto,Auto"
          ColumnSpacing="8">

        <!--  Status  -->
        <StackPanel VerticalAlignment="Center"
                    Orientation="Horizontal"
                    Spacing="10">
            <Border Padding="10,4"
                    Background="{DynamicResource SystemAccentColorLight2}"
                    CornerRadius="6"
                    IsVisible="{Binding IsRunning}">
                <StackPanel Orientation="Horizontal"
                            Spacing="6">
                    <avalonia:MaterialIcon Width="12"
                                           Height="12"
                                           VerticalAlignment="Center"
                                           Foreground="{DynamicResource SystemAccentColor}"
                                           Kind="Loading" />
                    <TextBlock FontSize="12"
                               Text="{Binding Status}" />
                </StackPanel>
            </Border>
            <TextBlock VerticalAlignment="Center"
                       FontSize="13"
                       IsVisible="{Binding !IsRunning}"
                       Text="{Binding Status}" />
        </StackPanel>

        <!--  Run Pre-check  -->
        <Button Grid.Column="1">
            <StackPanel Orientation="Horizontal"
                        Spacing="6">
                <avalonia:MaterialIcon Width="14"
                                       Height="14"
                                       Kind="PlayArrow" />
                <TextBlock Text="Run Pre-check" />
            </StackPanel>
        </Button>

        <Separator Grid.Column="2"
                   Width="1"
                   Height="24" />

        <!--  Profile  -->
        <Button Grid.Column="3"
                ToolTip.Tip="Load Profile">
            <StackPanel Orientation="Horizontal"
                        Spacing="6">
                <avalonia:MaterialIcon Width="14"
                                       Height="14"
                                       Kind="FolderOpen" />
                <TextBlock Text="Load Profile" />
            </StackPanel>
        </Button>
        <Button Grid.Column="4"
                ToolTip.Tip="Save Profile">
            <StackPanel Orientation="Horizontal"
                        Spacing="6">
                <avalonia:MaterialIcon Width="14"
                                       Height="14"
                                       Kind="ContentSave" />
                <TextBlock Text="Save" />
            </StackPanel>
        </Button>

        <Separator Grid.Column="5"
                   Width="1"
                   Height="24" />

        <!--  Host count  -->
        <StackPanel Grid.Column="6"
                    VerticalAlignment="Center"
                    Orientation="Horizontal"
                    Spacing="6">
            <avalonia:MaterialIcon Width="14"
                                   Height="14"
                                   Kind="Server" />
            <TextBlock VerticalAlignment="Center"
                       FontWeight="Medium"
                       Text="{Binding ConnectedInstances.Count, StringFormat='{}{0} Hosts'}" />
        </StackPanel>
    </Grid>
</UserControl>
