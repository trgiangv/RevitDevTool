<UserControl x:Class="RevitDevTool.Desktop.Views.Processor.TaskQueueView"
             xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:automation="clr-namespace:Avalonia.Automation;assembly=Avalonia.Controls"
             xmlns:avalonia="clr-namespace:Material.Icons.Avalonia;assembly=Material.Icons.Avalonia"
             xmlns:converters="using:RevitDevTool.Desktop.Converters"
             xmlns:models="using:RevitDevTool.Desktop.Models"
             xmlns:suki="https://github.com/kikipoulet/SukiUI"
             xmlns:vm="using:RevitDevTool.Desktop.ViewModels"
             x:DataType="vm:ProcessorPageViewModel">
    <suki:GlassCard Padding="12">
        <Grid RowDefinitions="Auto,Auto,Auto,*"
              RowSpacing="8">
            <!--  Header  -->
            <Grid ColumnDefinitions="*,Auto,Auto"
                  ColumnSpacing="8">
                <StackPanel Orientation="Horizontal"
                            Spacing="8">
                    <avalonia:MaterialIcon Width="16"
                                           Height="16"
                                           VerticalAlignment="Center"
                                           Kind="ListBox" />
                    <TextBlock VerticalAlignment="Center"
                               FontWeight="SemiBold"
                               Text="Task Queue" />
                </StackPanel>
                <Border Grid.Column="1"
                        Padding="8,2"
                        VerticalAlignment="Center"
                        Background="{DynamicResource SystemAccentColorLight3}"
                        CornerRadius="10">
                    <TextBlock FontSize="11"
                               FontWeight="Medium"
                               Text="{Binding VisibleQueueItems.Count, StringFormat='{}{0} Active'}" />
                </Border>
                <Button Grid.Column="2">
                    <StackPanel Orientation="Horizontal"
                                Spacing="6">
                        <avalonia:MaterialIcon Width="14"
                                               Height="14"
                                               Kind="Add" />
                        <TextBlock Text="Add Files" />
                    </StackPanel>
                </Button>
            </Grid>

            <!--  Search / Filter  -->
            <Grid Grid.Row="1"
                  ColumnDefinitions="*,170"
                  ColumnSpacing="8">
                <TextBox Grid.Column="0"
                         automation:AutomationProperties.AutomationId="QueueFilterTextBox"
                         Text="{Binding QueueSearchText}"
                         Watermark="Filter files..." />
                <ComboBox Grid.Column="1"
                          ItemsSource="{Binding QueueStatusFilters}"
                          SelectedItem="{Binding QueueStatusFilter}" />
            </Grid>

            <!--  Bulk Actions  -->
            <Grid Grid.Row="2"
                  ColumnDefinitions="Auto,*,Auto,Auto,Auto"
                  ColumnSpacing="8">
                <CheckBox VerticalAlignment="Center"
                          automation:AutomationProperties.AutomationId="SelectAllQueueItemsCheckBox"
                          Content="Select all"
                          IsChecked="{Binding SelectAllQueueItems}" />
                <TextBlock Grid.Column="1"
                           VerticalAlignment="Center"
                           Text="{Binding SelectedQueueCount, StringFormat='{}{0} selected'}" />
                <Button Grid.Column="2"
                        automation:AutomationProperties.AutomationId="AssignVersionButton"
                        Command="{Binding AssignVersionCommand}"
                        Content="Change Version" />
                <Button Grid.Column="3"
                        automation:AutomationProperties.AutomationId="ChangeViewButton"
                        Command="{Binding ChangeViewCommand}"
                        Content="Assign Script" />
                <Button Grid.Column="4"
                        automation:AutomationProperties.AutomationId="RemoveSelectedButton"
                        Command="{Binding RemoveSelectedCommand}"
                        Content="Remove" />
            </Grid>

            <!--  Queue Table  -->
            <suki:GlassCard Grid.Row="3"
                            Padding="0">
                <Grid RowDefinitions="Auto,*">
                    <!--  Column Headers  -->
                    <Grid Background="{DynamicResource SystemControlBackgroundChromeMediumLowBrush}"
                          ColumnDefinitions="50,50,*,80,60,100,80"
                          ColumnSpacing="8">
                        <Border Padding="8,6">
                            <TextBlock FontSize="10"
                                       FontWeight="Bold"
                                       Text="#" />
                        </Border>
                        <Border Grid.Column="1"
                                Padding="8,6">
                            <TextBlock FontSize="10"
                                       FontWeight="Bold"
                                       Text="Source" />
                        </Border>
                        <Border Grid.Column="2"
                                Padding="8,6">
                            <TextBlock FontSize="10"
                                       FontWeight="Bold"
                                       Text="File Details" />
                        </Border>
                        <Border Grid.Column="3"
                                Padding="8,6">
                            <TextBlock FontSize="10"
                                       FontWeight="Bold"
                                       Text="Size" />
                        </Border>
                        <Border Grid.Column="4"
                                Padding="8,6">
                            <TextBlock FontSize="10"
                                       FontWeight="Bold"
                                       Text="Ver." />
                        </Border>
                        <Border Grid.Column="5"
                                Padding="8,6">
                            <TextBlock FontSize="10"
                                       FontWeight="Bold"
                                       Text="Status" />
                        </Border>
                        <Border Grid.Column="6"
                                Padding="8,6">
                            <TextBlock FontSize="10"
                                       FontWeight="Bold"
                                       Text="Instance" />
                        </Border>
                    </Grid>

                    <!--  Rows  -->
                    <ListBox Grid.Row="1"
                             ItemsSource="{Binding VisibleQueueItems}"
                             SelectionMode="Multiple">
                        <ListBox.ItemsPanel>
                            <ItemsPanelTemplate>
                                <VirtualizingStackPanel CacheLength="1.0" />
                            </ItemsPanelTemplate>
                        </ListBox.ItemsPanel>
                        <ListBox.ItemTemplate>
                            <DataTemplate x:DataType="models:QueueTaskItem">
                                <Border Padding="8,6"
                                        Background="Transparent">
                                    <Grid ColumnDefinitions="24,36,*,60,50,80,60"
                                          ColumnSpacing="8">
                                        <CheckBox VerticalAlignment="Center"
                                                  IsChecked="{Binding IsSelected}" />
                                        <Border Grid.Column="1"
                                                Width="28"
                                                Height="28"
                                                HorizontalAlignment="Center"
                                                VerticalAlignment="Center"
                                                Background="{Binding FileTypeColor}"
                                                CornerRadius="4">
                                            <avalonia:MaterialIcon Width="14"
                                                                   Height="14"
                                                                   HorizontalAlignment="Center"
                                                                   VerticalAlignment="Center"
                                                                   Kind="ZipDisk" />
                                        </Border>
                                        <StackPanel Grid.Column="2"
                                                    VerticalAlignment="Center"
                                                    Spacing="2">
                                            <StackPanel Orientation="Horizontal"
                                                        Spacing="6">
                                                <TextBlock FontWeight="Medium"
                                                           Foreground="{Binding FileTypeColor}"
                                                           Text="{Binding FileName}"
                                                           TextTrimming="CharacterEllipsis" />
                                            </StackPanel>
                                            <TextBlock FontSize="9"
                                                       Foreground="{DynamicResource SystemControlForegroundBaseMediumLowBrush}"
                                                       Text="{Binding FullPath}"
                                                       TextTrimming="CharacterEllipsis"
                                                       ToolTip.Tip="{Binding FullPath}" />
                                            <StackPanel IsVisible="{Binding ScriptPath, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
                                                        Orientation="Horizontal"
                                                        Spacing="4">
                                                <avalonia:MaterialIcon Width="10"
                                                                       Height="10"
                                                                       Foreground="{Binding ScriptTypeColor}"
                                                                       Kind="CodeBraces" />
                                                <Border Padding="4,1"
                                                        Background="{Binding ScriptTypeColor}"
                                                        CornerRadius="2">
                                                    <TextBlock FontFamily="Consolas"
                                                               FontSize="8"
                                                               Text="{Binding ScriptType}" />
                                                </Border>
                                                <TextBlock FontFamily="Consolas"
                                                           FontSize="9"
                                                           Foreground="{DynamicResource SystemControlForegroundBaseMediumLowBrush}"
                                                           Text="{Binding ScriptPath}"
                                                           TextTrimming="CharacterEllipsis"
                                                           ToolTip.Tip="{Binding ScriptPath}" />
                                            </StackPanel>
                                        </StackPanel>
                                        <TextBlock Grid.Column="3"
                                                   VerticalAlignment="Center"
                                                   FontSize="11"
                                                   Text="{Binding FileSize}" />
                                        <TextBlock Grid.Column="4"
                                                   VerticalAlignment="Center"
                                                   FontSize="11"
                                                   Text="{Binding HostVersion}" />
                                        <Border Grid.Column="5"
                                                Padding="8,2"
                                                HorizontalAlignment="Left"
                                                VerticalAlignment="Center"
                                                Background="{Binding Status, Converter={x:Static converters:StatusToColorConverter.Instance}}"
                                                CornerRadius="4">
                                            <TextBlock FontSize="10"
                                                       FontWeight="Medium"
                                                       Text="{Binding Status}" />
                                        </Border>
                                        <TextBlock Grid.Column="6"
                                                   VerticalAlignment="Center"
                                                   FontFamily="Consolas"
                                                   FontSize="10"
                                                   Text="{Binding Instance}" />
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>

                    <TextBlock Grid.Row="1"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"
                               IsVisible="{Binding IsQueueEmpty}"
                               Text="No queue items. Load a config to begin." />
                </Grid>
            </suki:GlassCard>
        </Grid>
    </suki:GlassCard>
</UserControl>
