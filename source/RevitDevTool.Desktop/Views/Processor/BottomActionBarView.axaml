<UserControl x:Class="RevitDevTool.Desktop.Views.Processor.BottomActionBarView"
             xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:avalonia="clr-namespace:Material.Icons.Avalonia;assembly=Material.Icons.Avalonia"
             xmlns:suki="https://github.com/kikipoulet/SukiUI"
             xmlns:vm="using:RevitDevTool.Desktop.ViewModels"
             x:DataType="vm:ProcessorPageViewModel">
    <suki:GlassCard Padding="12"
                    BorderThickness="1"
                    CornerRadius="4">
        <Grid VerticalAlignment="Center"
              ColumnDefinitions="*,Auto,Auto"
              ColumnSpacing="12">

            <!--  Overall Progress  -->
            <StackPanel Margin="0,0,8,0"
                        Spacing="6">
                <Grid ColumnDefinitions="*,Auto">
                    <TextBlock FontSize="12"
                               FontWeight="Medium"
                               Text="Overall Progress" />
                    <TextBlock Grid.Column="1"
                               FontSize="12"
                               FontWeight="Bold"
                               Text="{Binding OverallProgressPercent, StringFormat='{}{0:0}%'}" />
                </Grid>
                <ProgressBar Height="8"
                             Maximum="100"
                             Value="{Binding OverallProgressPercent}" />
            </StackPanel>

            <!--  Selected Count  -->
            <StackPanel Grid.Column="1"
                        VerticalAlignment="Center"
                        Orientation="Horizontal"
                        Spacing="4">
                <Border Padding="8,2"
                        Background="{DynamicResource SystemAccentColor}"
                        CornerRadius="10">
                    <TextBlock FontSize="11"
                               FontWeight="Bold"
                               Foreground="White"
                               Text="{Binding SelectedQueueCount}" />
                </Border>
                <TextBlock VerticalAlignment="Center"
                           FontSize="11"
                           Text="selected" />
            </StackPanel>

            <!--  Start Processing  -->
            <Button Grid.Column="2"
                    AutomationProperties.AutomationId="StartProcessingButton"
                    Command="{Binding RunCommand}">
                <StackPanel Orientation="Horizontal"
                            Spacing="6">
                    <avalonia:MaterialIcon Width="14"
                                           Height="14"
                                           Kind="PlayArrow" />
                    <TextBlock FontSize="12"
                               FontWeight="SemiBold"
                               Text="Start Processing" />
                </StackPanel>
            </Button>
        </Grid>
    </suki:GlassCard>
</UserControl>
