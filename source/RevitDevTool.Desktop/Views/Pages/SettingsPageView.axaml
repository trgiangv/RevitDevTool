<UserControl x:Class="RevitDevTool.Desktop.Views.Pages.SettingsPageView"
             xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:objectModel="clr-namespace:System.Collections.ObjectModel;assembly=System.ObjectModel"
             xmlns:suki="https://github.com/kikipoulet/SukiUI"
             xmlns:vm="using:RevitDevTool.Desktop.ViewModels"
             d:DesignHeight="650"
             d:DesignWidth="1110"
             x:DataType="vm:SettingsPageViewModel"
             mc:Ignorable="d">
    <suki:SettingsLayout>
        <suki:SettingsLayout.Items>
            <objectModel:ObservableCollection x:TypeArguments="suki:SettingsLayoutItem">

                <suki:SettingsLayoutItem Header="Theme">
                    <suki:SettingsLayoutItem.Content>
                        <Grid ColumnDefinitions="Auto,*"
                              ColumnSpacing="10"
                              RowDefinitions="Auto,Auto"
                              RowSpacing="10">

                            <StackPanel Grid.Row="0"
                                        Grid.Column="0"
                                        Grid.ColumnSpan="2"
                                        HorizontalAlignment="Center"
                                        Orientation="Horizontal"
                                        Spacing="20">
                                <RadioButton Width="160"
                                             Height="140"
                                             Padding="0"
                                             Classes="GigaChips"
                                             GroupName="RadioBaseTheme"
                                             IsChecked="{Binding IsSystemTheme}">
                                    <Border Margin="-50"
                                            Background="SlateGray"
                                            CornerRadius="{DynamicResource MediumCornerRadius}">
                                        <TextBlock Margin="58,42,42,42"
                                                   HorizontalAlignment="Center"
                                                   VerticalAlignment="Bottom"
                                                   FontWeight="DemiBold"
                                                   Foreground="#fafafa"
                                                   Text="System Mode" />
                                    </Border>
                                </RadioButton>

                                <RadioButton Width="160"
                                             Height="140"
                                             Padding="0"
                                             Classes="GigaChips"
                                             GroupName="RadioBaseTheme"
                                             IsChecked="{Binding IsLightTheme}">
                                    <Border Margin="-50"
                                            Background="#fafafa"
                                            CornerRadius="{DynamicResource MediumCornerRadius}">
                                        <TextBlock Margin="58,42,42,42"
                                                   HorizontalAlignment="Center"
                                                   VerticalAlignment="Bottom"
                                                   FontWeight="DemiBold"
                                                   Foreground="#555555"
                                                   Text="Light Mode" />
                                    </Border>
                                </RadioButton>

                                <RadioButton Width="160"
                                             Height="140"
                                             Classes="GigaChips"
                                             GroupName="RadioBaseTheme"
                                             IsChecked="{Binding IsDarkTheme}">
                                    <Border Margin="-50"
                                            Background="#222222"
                                            CornerRadius="{DynamicResource MediumCornerRadius}">
                                        <TextBlock Margin="58,42,42,42"
                                                   HorizontalAlignment="Center"
                                                   VerticalAlignment="Bottom"
                                                   FontWeight="DemiBold"
                                                   Foreground="#fafafa"
                                                   Text="Dark Mode" />
                                    </Border>
                                </RadioButton>
                            </StackPanel>

                            <!--  Color swatches (static, no SukiColorTheme binding)  -->
                            <StackPanel Grid.Row="1"
                                        Grid.Column="0"
                                        Grid.ColumnSpan="2"
                                        HorizontalAlignment="Center"
                                        Orientation="Horizontal"
                                        Spacing="10">
                                <RadioButton Width="50"
                                             Height="50"
                                             Classes="GigaChips"
                                             CornerRadius="50"
                                             GroupName="RadioColorTheme"
                                             IsChecked="{Binding IsColorBlue}"
                                             ToolTip.Tip="Blue">
                                    <Border Margin="-30"
                                            Background="#1E90FF"
                                            CornerRadius="50" />
                                </RadioButton>
                                <RadioButton Width="50"
                                             Height="50"
                                             Classes="GigaChips"
                                             CornerRadius="50"
                                             GroupName="RadioColorTheme"
                                             IsChecked="{Binding IsColorPurple}"
                                             ToolTip.Tip="Purple">
                                    <Border Margin="-30"
                                            Background="#8B5CF6"
                                            CornerRadius="50" />
                                </RadioButton>
                                <RadioButton Width="50"
                                             Height="50"
                                             Classes="GigaChips"
                                             CornerRadius="50"
                                             GroupName="RadioColorTheme"
                                             IsChecked="{Binding IsColorGreen}"
                                             ToolTip.Tip="Green">
                                    <Border Margin="-30"
                                            Background="#10B981"
                                            CornerRadius="50" />
                                </RadioButton>
                                <RadioButton Width="50"
                                             Height="50"
                                             Classes="GigaChips"
                                             CornerRadius="50"
                                             GroupName="RadioColorTheme"
                                             IsChecked="{Binding IsColorOrange}"
                                             ToolTip.Tip="Orange">
                                    <Border Margin="-30"
                                            Background="#F59E0B"
                                            CornerRadius="50" />
                                </RadioButton>
                                <RadioButton Width="50"
                                             Height="50"
                                             Classes="GigaChips"
                                             CornerRadius="50"
                                             GroupName="RadioColorTheme"
                                             IsChecked="{Binding IsColorRed}"
                                             ToolTip.Tip="Red">
                                    <Border Margin="-30"
                                            Background="#EF4444"
                                            CornerRadius="50" />
                                </RadioButton>
                                <RadioButton Width="50"
                                             Height="50"
                                             Classes="GigaChips"
                                             CornerRadius="50"
                                             GroupName="RadioColorTheme"
                                             IsChecked="{Binding IsColorPink}"
                                             ToolTip.Tip="Pink">
                                    <Border Margin="-30"
                                            Background="#EC4899"
                                            CornerRadius="50" />
                                </RadioButton>
                            </StackPanel>

                        </Grid>
                    </suki:SettingsLayoutItem.Content>
                </suki:SettingsLayoutItem>

                <suki:SettingsLayoutItem Header="Background">
                    <suki:SettingsLayoutItem.Content>
                        <StackPanel>
                            <suki:GlassCard Margin="0,25,0,0"
                                            Padding="25">
                                <StackPanel Spacing="40">
                                    <DockPanel>
                                        <ToggleSwitch VerticalAlignment="Top"
                                                      Classes="Switch"
                                                      DockPanel.Dock="Right"
                                                      IsChecked="{Binding BackgroundAnimations}" />
                                        <StackPanel HorizontalAlignment="Left">
                                            <TextBlock FontSize="16"
                                                       FontWeight="DemiBold"
                                                       Text="Animated Background" />
                                            <TextBlock Margin="0,12,70,0"
                                                       Foreground="{DynamicResource SukiLowText}"
                                                       Text="Enable/disable the animations for the background, which are driven by the currently active effect."
                                                       TextWrapping="Wrap" />
                                        </StackPanel>
                                    </DockPanel>
                                    <DockPanel>
                                        <ToggleSwitch VerticalAlignment="Top"
                                                      DockPanel.Dock="Right"
                                                      IsChecked="{Binding BackgroundTransitions}" />
                                        <StackPanel HorizontalAlignment="Left">
                                            <TextBlock FontSize="16"
                                                       FontWeight="DemiBold"
                                                       Text="Background Transitions" />
                                            <TextBlock Margin="0,12,70,0"
                                                       Foreground="{DynamicResource SukiLowText}"
                                                       Text="Enable/disable the transitions for the background, these will fade between the active effects when changed."
                                                       TextWrapping="Wrap" />
                                        </StackPanel>
                                    </DockPanel>
                                </StackPanel>
                            </suki:GlassCard>
                        </StackPanel>
                    </suki:SettingsLayoutItem.Content>
                </suki:SettingsLayoutItem>

                <suki:SettingsLayoutItem Header="General">
                    <suki:SettingsLayoutItem.Content>
                        <StackPanel>
                            <suki:GlassCard Margin="0,25,0,0"
                                            Padding="25">
                                <StackPanel Spacing="40">
                                    <DockPanel>
                                        <ToggleSwitch VerticalAlignment="Top"
                                                      Classes="Switch"
                                                      DockPanel.Dock="Right"
                                                      IsChecked="{Binding CheckForUpdatesOnStart}" />
                                        <StackPanel HorizontalAlignment="Left">
                                            <TextBlock FontSize="16"
                                                       FontWeight="DemiBold"
                                                       Text="Check for updates on start" />
                                            <TextBlock Margin="0,12,70,0"
                                                       Foreground="{DynamicResource SukiLowText}"
                                                       Text="Check for updates on application start. If an update is available it will notify you."
                                                       TextWrapping="Wrap" />
                                        </StackPanel>
                                    </DockPanel>
                                    <DockPanel>
                                        <ToggleSwitch VerticalAlignment="Top"
                                                      DockPanel.Dock="Right"
                                                      IsChecked="{Binding EnableNotifications}" />
                                        <StackPanel HorizontalAlignment="Left">
                                            <TextBlock FontSize="16"
                                                       FontWeight="DemiBold"
                                                       Text="Enable Notifications" />
                                            <TextBlock Margin="0,12,70,0"
                                                       Foreground="{DynamicResource SukiLowText}"
                                                       Text="Show toast notifications for batch run completion, errors, and status changes."
                                                       TextWrapping="Wrap" />
                                        </StackPanel>
                                    </DockPanel>
                                    <DockPanel>
                                        <ToggleSwitch VerticalAlignment="Top"
                                                      DockPanel.Dock="Right"
                                                      IsChecked="{Binding AutoSaveProfile}" />
                                        <StackPanel HorizontalAlignment="Left">
                                            <TextBlock FontSize="16"
                                                       FontWeight="DemiBold"
                                                       Text="Auto Save Profile" />
                                            <TextBlock Margin="0,12,70,0"
                                                       Foreground="{DynamicResource SukiLowText}"
                                                       Text="Automatically save the current profile when the application closes."
                                                       TextWrapping="Wrap" />
                                        </StackPanel>
                                    </DockPanel>
                                </StackPanel>
                            </suki:GlassCard>
                        </StackPanel>
                    </suki:SettingsLayoutItem.Content>
                </suki:SettingsLayoutItem>

            </objectModel:ObservableCollection>
        </suki:SettingsLayout.Items>
    </suki:SettingsLayout>
</UserControl>
