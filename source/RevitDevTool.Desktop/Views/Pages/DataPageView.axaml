<UserControl x:Class="RevitDevTool.Desktop.Views.Pages.DataPageView"
             xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:avalonia="clr-namespace:Material.Icons.Avalonia;assembly=Material.Icons.Avalonia"
             xmlns:objectModel="clr-namespace:System.Collections.ObjectModel;assembly=System.ObjectModel"
             xmlns:suki="https://github.com/kikipoulet/SukiUI"
             xmlns:vm="using:RevitDevTool.Desktop.ViewModels"
             x:DataType="vm:DataPageViewModel">

    <suki:SettingsLayout>
        <suki:SettingsLayout.Items>
            <objectModel:ObservableCollection x:TypeArguments="suki:SettingsLayoutItem">

                <!--  RAG Setup  -->
                <suki:SettingsLayoutItem Header="RAG Setup">
                    <suki:SettingsLayoutItem.Content>
                        <StackPanel>
                            <suki:GlassCard Margin="0,25,0,0"
                                            Padding="25">
                                <StackPanel Spacing="24">
                                    <!--  Header + Index Status  -->
                                    <DockPanel>
                                        <Border Padding="12,6"
                                                Background="{Binding HasIndex, Converter={StaticResource BoolToStatusBrushConverter}}"
                                                CornerRadius="20"
                                                DockPanel.Dock="Right">
                                            <StackPanel Orientation="Horizontal"
                                                        Spacing="6">
                                                <Ellipse Width="6"
                                                         Height="6"
                                                         Fill="White" />
                                                <TextBlock FontSize="12"
                                                           FontWeight="Medium"
                                                           Foreground="White"
                                                           Text="{Binding IndexStatus}" />
                                            </StackPanel>
                                        </Border>
                                        <StackPanel HorizontalAlignment="Left">
                                            <TextBlock FontSize="16"
                                                       FontWeight="DemiBold"
                                                       Text="Retrieval-Augmented Generation" />
                                            <TextBlock Margin="0,6,70,0"
                                                       Foreground="{DynamicResource SukiLowText}"
                                                       Text="Configure the embedding model and indexing settings for knowledge retrieval."
                                                       TextWrapping="Wrap" />
                                        </StackPanel>
                                    </DockPanel>

                                    <Separator />

                                    <!--  Embedding Model / Chunk Size / Overlap  -->
                                    <Grid ColumnDefinitions="*,*,*"
                                          ColumnSpacing="16">
                                        <StackPanel Grid.Column="0"
                                                    Spacing="6">
                                            <TextBlock Foreground="{DynamicResource SukiLowText}"
                                                       Text="Embedding Model" />
                                            <ComboBox HorizontalAlignment="Stretch"
                                                      ItemsSource="{Binding EmbeddingModels}"
                                                      SelectedItem="{Binding SelectedEmbeddingModel}" />
                                        </StackPanel>
                                        <StackPanel Grid.Column="1"
                                                    Spacing="6">
                                            <TextBlock Foreground="{DynamicResource SukiLowText}"
                                                       Text="Chunk Size (tokens)" />
                                            <NumericUpDown Maximum="4096"
                                                           Minimum="100"
                                                           Value="{Binding ChunkSize}" />
                                        </StackPanel>
                                        <StackPanel Grid.Column="2"
                                                    Spacing="6">
                                            <TextBlock Foreground="{DynamicResource SukiLowText}"
                                                       Text="Chunk Overlap" />
                                            <NumericUpDown Maximum="1024"
                                                           Minimum="0"
                                                           Value="{Binding ChunkOverlap}" />
                                        </StackPanel>
                                    </Grid>

                                    <!--  Data Directory  -->
                                    <StackPanel Spacing="6">
                                        <TextBlock Foreground="{DynamicResource SukiLowText}"
                                                   Text="Data Directory" />
                                        <Grid ColumnDefinitions="*,Auto"
                                              ColumnSpacing="8">
                                            <TextBox Text="{Binding DataDirectory}"
                                                     Watermark="Select folder containing documents to index..." />
                                            <Button Grid.Column="1"
                                                    Command="{Binding BrowseDataDirectoryCommand}">
                                                <avalonia:MaterialIcon Width="16"
                                                                       Height="16"
                                                                       Kind="FolderOpen" />
                                            </Button>
                                        </Grid>
                                    </StackPanel>

                                    <!--  Actions  -->
                                    <StackPanel Orientation="Horizontal"
                                                Spacing="12">
                                        <Button Classes="Flat"
                                                Command="{Binding BuildIndexCommand}">
                                            <StackPanel Orientation="Horizontal"
                                                        Spacing="8">
                                                <avalonia:MaterialIcon Width="16"
                                                                       Height="16"
                                                                       Kind="DatabaseSearch" />
                                                <TextBlock Text="Build Index" />
                                            </StackPanel>
                                        </Button>
                                        <Button Command="{Binding ClearIndexCommand}">
                                            <StackPanel Orientation="Horizontal"
                                                        Spacing="8">
                                                <avalonia:MaterialIcon Width="16"
                                                                       Height="16"
                                                                       Kind="DatabaseRemove" />
                                                <TextBlock Text="Clear Index" />
                                            </StackPanel>
                                        </Button>
                                    </StackPanel>

                                    <!--  Indexing progress  -->
                                    <Border Padding="12,8"
                                            Background="{DynamicResource SystemControlBackgroundChromeMediumLowBrush}"
                                            CornerRadius="6"
                                            IsVisible="{Binding IndexingProgress, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
                                        <StackPanel Orientation="Horizontal"
                                                    Spacing="8">
                                            <avalonia:MaterialIcon Width="14"
                                                                   Height="14"
                                                                   VerticalAlignment="Center"
                                                                   Foreground="{DynamicResource SystemAccentColor}"
                                                                   Kind="InformationOutline" />
                                            <TextBlock VerticalAlignment="Center"
                                                       Foreground="{DynamicResource SystemAccentColor}"
                                                       Text="{Binding IndexingProgress}" />
                                        </StackPanel>
                                    </Border>
                                </StackPanel>
                            </suki:GlassCard>
                        </StackPanel>
                    </suki:SettingsLayoutItem.Content>
                </suki:SettingsLayoutItem>

                <!--  Data Sources  -->
                <suki:SettingsLayoutItem Header="Data Sources">
                    <suki:SettingsLayoutItem.Content>
                        <StackPanel>
                            <suki:GlassCard Margin="0,25,0,0"
                                            Padding="25">
                                <StackPanel Spacing="20">
                                    <DockPanel>
                                        <Button Command="{Binding AddDataSourceCommand}"
                                                DockPanel.Dock="Right">
                                            <StackPanel Orientation="Horizontal"
                                                        Spacing="6">
                                                <avalonia:MaterialIcon Width="14"
                                                                       Height="14"
                                                                       Kind="Plus" />
                                                <TextBlock Text="Add Source" />
                                            </StackPanel>
                                        </Button>
                                        <StackPanel HorizontalAlignment="Left">
                                            <TextBlock FontSize="16"
                                                       FontWeight="DemiBold"
                                                       Text="Custom Knowledge Sources" />
                                            <TextBlock Margin="0,6,70,0"
                                                       Foreground="{DynamicResource SukiLowText}"
                                                       Text="Add external data sources (SQL, REST API, FileSystem) to augment the assistant's knowledge."
                                                       TextWrapping="Wrap" />
                                        </StackPanel>
                                    </DockPanel>

                                    <Separator />

                                    <ItemsControl ItemsSource="{Binding CustomDataSources}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Border Margin="0,0,0,10"
                                                        Padding="16"
                                                        Background="{DynamicResource SystemControlBackgroundChromeMediumLowBrush}"
                                                        CornerRadius="8">
                                                    <Grid ColumnDefinitions="Auto,*,Auto"
                                                          ColumnSpacing="12">
                                                        <CheckBox Grid.Column="0"
                                                                  VerticalAlignment="Center"
                                                                  IsChecked="{Binding IsEnabled}" />
                                                        <StackPanel Grid.Column="1"
                                                                    Spacing="8">
                                                            <TextBox FontWeight="Medium"
                                                                     Text="{Binding Name}"
                                                                     Watermark="Source name" />
                                                            <Grid ColumnDefinitions="*,*"
                                                                  ColumnSpacing="8">
                                                                <TextBox Text="{Binding Type}"
                                                                         Watermark="Type (SQL, REST, FileSystem)" />
                                                                <TextBox Grid.Column="1"
                                                                         Text="{Binding ConnectionString}"
                                                                         Watermark="Connection string / path" />
                                                            </Grid>
                                                        </StackPanel>
                                                        <Button Grid.Column="2"
                                                                Padding="8"
                                                                VerticalAlignment="Center"
                                                                Command="{Binding $parent[ItemsControl].((vm:DataPageViewModel)DataContext).RemoveDataSourceCommand}"
                                                                CommandParameter="{Binding}"
                                                                ToolTip.Tip="Remove source">
                                                            <avalonia:MaterialIcon Width="16"
                                                                                   Height="16"
                                                                                   Kind="Delete" />
                                                        </Button>
                                                    </Grid>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>

                                    <!--  Save  -->
                                    <StackPanel HorizontalAlignment="Right"
                                                Orientation="Horizontal"
                                                Spacing="12">
                                        <Button Classes="Flat"
                                                Command="{Binding SaveDataSourcesCommand}">
                                            <StackPanel Orientation="Horizontal"
                                                        Spacing="8">
                                                <avalonia:MaterialIcon Width="16"
                                                                       Height="16"
                                                                       Kind="ContentSave" />
                                                <TextBlock Text="Save Data Sources" />
                                            </StackPanel>
                                        </Button>
                                    </StackPanel>
                                </StackPanel>
                            </suki:GlassCard>
                        </StackPanel>
                    </suki:SettingsLayoutItem.Content>
                </suki:SettingsLayoutItem>

            </objectModel:ObservableCollection>
        </suki:SettingsLayout.Items>
    </suki:SettingsLayout>
</UserControl>
