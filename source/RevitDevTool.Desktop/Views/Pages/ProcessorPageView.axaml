<UserControl x:Class="RevitDevTool.Desktop.Views.Pages.ProcessorPageView"
             xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:avalonia="clr-namespace:Material.Icons.Avalonia;assembly=Material.Icons.Avalonia"
             xmlns:processor="clr-namespace:RevitDevTool.Desktop.Views.Processor"
             xmlns:suki="https://github.com/kikipoulet/SukiUI"
             xmlns:vm="using:RevitDevTool.Desktop.ViewModels"
             x:DataType="vm:ProcessorPageViewModel">
    <Grid Margin="20,16,20,16"
          RowDefinitions="Auto,*,Auto,Auto"
          RowSpacing="12">

        <!--  Row 0: Header toolbar  -->
        <processor:HeaderBarView />

        <!--  Row 1: Main content (sidebar + work area)  -->
        <Grid Grid.Row="1"
              ColumnDefinitions="220,*"
              ColumnSpacing="16">

            <!--  Left sidebar  -->
            <suki:GlassCard Padding="14"
                            VerticalAlignment="Top">
                <processor:SystemHealthPaneView />
            </suki:GlassCard>

            <!--  Right work area  -->
            <Grid Grid.Column="1"
                  RowDefinitions="Auto,*"
                  RowSpacing="12">

                <!--  Crash risk banner  -->
                <suki:GlassCard Grid.Row="0"
                                Padding="12,10"
                                IsVisible="{Binding HasCrashRisk}">
                    <StackPanel Orientation="Horizontal"
                                Spacing="8">
                        <avalonia:MaterialIcon Width="16"
                                               Height="16"
                                               VerticalAlignment="Center"
                                               Kind="AlertOutline" />
                        <TextBlock VerticalAlignment="Center"
                                   FontWeight="SemiBold"
                                   Text="{Binding CrashRiskMessage}" />
                    </StackPanel>
                </suki:GlassCard>

                <!--  Execution pane + task queue  -->
                <Grid Grid.Row="1"
                      ColumnDefinitions="300,*"
                      ColumnSpacing="12">
                    <processor:ExecutionLogicPaneView VerticalAlignment="Top" />
                    <processor:TaskQueueView Grid.Column="1" />
                </Grid>
            </Grid>
        </Grid>

        <!--  Row 2: Live console  -->
        <processor:LiveConsoleView Grid.Row="2"
                                   Height="200" />

        <!--  Row 3: Bottom action bar  -->
        <processor:BottomActionBarView Grid.Row="3" />
    </Grid>
</UserControl>
