<Project Sdk="Microsoft.NET.Sdk">

    <!--
          Build:   dotnet build
          Publish: dotnet publish -c Release  → single-file exe (requires .NET 10 runtime)
    -->

    <PropertyGroup>
        <OutputType>Exe</OutputType>
        <TargetFramework>net10.0-windows</TargetFramework>
        <RuntimeIdentifier>win-x64</RuntimeIdentifier>
        <AssemblyName>DevTools.TestRunner</AssemblyName>
        <RootNamespace>DevTools.TestRunner</RootNamespace>
        <SelfContained>false</SelfContained>
        <PublishSingleFile>true</PublishSingleFile>
        <GenerateDocumentationFile>true</GenerateDocumentationFile>
        <NoWarn>$(NoWarn);1591;1573</NoWarn>
    </PropertyGroup>

    <PropertyGroup>
        <BundleContentsFolder>$(AppData)\Autodesk\ApplicationPlugins\RevitDevTool.bundle\Contents</BundleContentsFolder>
    </PropertyGroup>

    <PropertyGroup Condition="$(Configuration.Contains('Release'))">
        <DebugType>none</DebugType>
        <DebugSymbols>false</DebugSymbols>
    </PropertyGroup>

    <Target Name="DeployDevToolsTestRunner" AfterTargets="Publish">
        <Exec Command="taskkill /F /IM DevTools.TestRunner.exe 2>nul &amp; ping -n 2 127.0.0.1 >nul" IgnoreExitCode="true"/>
        <MakeDir Directories="$(BundleContentsFolder)"/>
        <Copy SourceFiles="$(PublishDir)DevTools.TestRunner.exe"
              DestinationFolder="$(BundleContentsFolder)"
              OverwriteReadOnlyFiles="true"
              Retries="3"
              RetryDelayMilliseconds="1000"/>
    </Target>

    <ItemGroup>
        <PackageReference Include="Microsoft.VisualStudio.Interop"/>
        <PackageReference Include="Microsoft.Extensions.DependencyInjection"/>
        <PackageReference Include="ConsoleAppFramework">
            <PrivateAssets>all</PrivateAssets>
            <IncludeAssets>runtime; build; native; contentfiles; analyzers</IncludeAssets>
        </PackageReference>
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="..\DevTools.TestRunner.Core\DevTools.TestRunner.Core.csproj" SetTargetFramework="TargetFramework=net10.0-windows"/>
        <ProjectReference Include="..\DevTools.Testing.Abstractions\DevTools.Testing.Abstractions.csproj" SetTargetFramework="TargetFramework=net10.0-windows"/>
        <ProjectReference Include="..\DevTools.Testing.Transport\DevTools.Testing.Transport.csproj" SetTargetFramework="TargetFramework=net10.0-windows"/>
        <ProjectReference Include="..\DevTools.Ipc\DevTools.Ipc.csproj" SetTargetFramework="TargetFramework=net10.0-windows"/>
        <ProjectReference Include="..\DevTools.Hosting\DevTools.Hosting.csproj" SetTargetFramework="TargetFramework=net10.0-windows"/>
        <ProjectReference Include="..\DevTools.Hosting.Revit\DevTools.Hosting.Revit.csproj" SetTargetFramework="TargetFramework=net10.0-windows"/>
        <ProjectReference Include="..\DevTools.Hosting.Acad\DevTools.Hosting.Acad.csproj" SetTargetFramework="TargetFramework=net10.0-windows"/>
    </ItemGroup>

    <ItemGroup>
        <InternalsVisibleTo Include="DevTools.TestRunner.Tests"/>
    </ItemGroup>

</Project>
