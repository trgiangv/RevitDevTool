<Project Sdk="Microsoft.NET.Sdk">

    <!--
          Build:   dotnet build
          Publish: dotnet publish -c Release  → framework-dependent single-file exe.
          Shipped inside the RevitDevTool.TestAdapter package at tools/runner.
    -->

    <Import Project="..\..\props\TestingRuntime.props"/>

    <PropertyGroup>
        <OutputType>Exe</OutputType>
        <TargetFramework>$(TestRunnerTargetFramework)</TargetFramework>
        <RuntimeIdentifier>win-x64</RuntimeIdentifier>
        <AssemblyName>DevTools.TestRunner</AssemblyName>
        <RootNamespace>DevTools.TestRunner</RootNamespace>
        <SelfContained>false</SelfContained>
        <PublishSingleFile>true</PublishSingleFile>
        <RollForward>Major</RollForward>
        <GenerateDocumentationFile>true</GenerateDocumentationFile>
        <NoWarn>$(NoWarn);1591;1573</NoWarn>
    </PropertyGroup>

    <PropertyGroup Condition="$(Configuration.Contains('Release'))">
        <DebugType>none</DebugType>
        <DebugSymbols>false</DebugSymbols>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="Microsoft.Extensions.DependencyInjection"/>
        <PackageReference Include="Microsoft.VisualStudio.Interop"/>
        <PackageReference Include="ConsoleAppFramework">
            <PrivateAssets>all</PrivateAssets>
            <IncludeAssets>runtime; build; native; contentfiles; analyzers</IncludeAssets>
        </PackageReference>
    </ItemGroup>

    <ItemGroup>
        <Using Include="DevTools.Ipc" />
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="..\DevTools.Testing.Abstractions\DevTools.Testing.Abstractions.csproj" SetTargetFramework="TargetFramework=$(TestRunnerTargetFramework)"/>
        <ProjectReference Include="..\DevTools.Testing.Transport\DevTools.Testing.Transport.csproj" SetTargetFramework="TargetFramework=$(TestRunnerTargetFramework)"/>
        <ProjectReference Include="..\DevTools.Ipc\DevTools.Ipc.csproj" SetTargetFramework="TargetFramework=$(TestRunnerTargetFramework)"/>
        <ProjectReference Include="..\DevTools.Hosting\DevTools.Hosting.csproj" SetTargetFramework="TargetFramework=$(TestRunnerTargetFramework)"/>
        <ProjectReference Include="..\DevTools.Hosting.Revit\DevTools.Hosting.Revit.csproj"/>
        <ProjectReference Include="..\DevTools.Hosting.Acad\DevTools.Hosting.Acad.csproj"/>
    </ItemGroup>

    <ItemGroup>
        <InternalsVisibleTo Include="DevTools.TestRunner.Tests"/>
    </ItemGroup>

</Project>
