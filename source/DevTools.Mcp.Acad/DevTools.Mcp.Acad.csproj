<Project Sdk="Microsoft.NET.Sdk">
    <PropertyGroup>
        <UseAutoCad>true</UseAutoCad>
    </PropertyGroup>

    <ItemGroup>
        <ProjectReference Include="..\DevTools.Mcp.Catalog\DevTools.Mcp.Catalog.csproj" SetTargetFramework="TargetFramework=$(TargetFramework)" />
        <!-- acmgd 2027 (26.x) binds System.Drawing.Common 10; 8.0.x is for net48/net8 hosts. -->
        <PackageReference Include="System.Drawing.Common" ExcludeAssets="runtime"
                          Condition="'$(TargetFramework)' != 'net10.0-windows'" />
        <PackageReference Include="System.Drawing.Common" ExcludeAssets="runtime"
                          VersionOverride="$(MsVersion)"
                          Condition="'$(TargetFramework)' == 'net10.0-windows'" />
    </ItemGroup>

    <ItemGroup>
        <EmbeddedResource Include="Content\**\*" />
    </ItemGroup>
</Project>
