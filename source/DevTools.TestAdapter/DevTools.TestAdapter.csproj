<Project Sdk="Microsoft.NET.Sdk">
    <!--
      Published RevitDevTool.TestAdapter (pack entry).
      Architecture: docs/architecture/Testing/README.md

      Pack order, per TFM (net48; net8.0-windows; net10.0-windows):
        1. BuildNUnitMTPForPack / BuildTUnitMTPForPack — build the testhost siblings.
        2. ILRepack — merge copy-local (Transport, Ipc, net48 STJ BCL) into
           TestAdapter.dll; keep Testing.Abstractions.dll so testhost MTP shares
           HostTestDiscovery.
        3. PackNUnitMTP / PackTUnitMTP — MTP siblings + Abstractions to build/runtime/{tfm}.
        4. build/*.props|targets (+ build/netfx source shim) — the consumer build order
           lives in those files.

      Constraints:
        - Do not flatten obj/bin: the three TFMs would collide (CS2012 / MSB3713).
        - Microsoft.Testing.Platform.MSBuild 2.4.0 is a real dependency with all
          assets (PrivateAssets=none): an NUnit-only consumer has no other source of
          the testhost or Microsoft.Testing.Platform.dll. RepackBinariesExcludes keeps
          those DLLs out of the merged adapter. Every other graph reference stays
          PrivateAssets=all so it never reaches the nuspec.
        - Do not add PackageReference for STJ/Unsafe/Bcl: net48 takes them from
          Transport/Ipc, net8/net10 use the in-box copies, and the testhost gets its
          BCL from the MTP.MSBuild graph plus net48 binding redirects.
        - Bump Version before PublishTestAdapter.yml; it is independent of installer GitVersion.
    -->
    <PropertyGroup>
        <TargetFrameworks>net48;net8.0-windows;net10.0-windows</TargetFrameworks>
        <AppendTargetFrameworkToOutputPath>true</AppendTargetFrameworkToOutputPath>
        <RootNamespace>DevTools.TestAdapter</RootNamespace>
        <AssemblyName>DevTools.TestAdapter</AssemblyName>
        <PackageId>RevitDevTool.TestAdapter</PackageId>
        <Version>0.0.6</Version>
        <IsPackable>true</IsPackable>
        <DevelopmentDependency>true</DevelopmentDependency>
        <PackageLicenseExpression>MIT</PackageLicenseExpression>
        <PackageProjectUrl>https://github.com/trgiangv/RevitDevTool</PackageProjectUrl>
        <Description>Microsoft Testing Platform adapter that allows running NUnit or TUnit tests inside Autodesk hosts. Requires RevitDevTool (https://github.com/trgiangv/RevitDevTool).</Description>
        <PackageTags>testing;revit;autocad;adapter</PackageTags>
        <PackageReadmeFile>README.md</PackageReadmeFile>
        <PackageIcon>DevTools-32-Light.png</PackageIcon>
        <EnableDynamicLoading>false</EnableDynamicLoading>
        <CopyLocalLockFileAssemblies>true</CopyLocalLockFileAssemblies>
        <NoPackageAnalysis>true</NoPackageAnalysis>
        <TargetsForTfmSpecificContentInPackage>$(TargetsForTfmSpecificContentInPackage);PackNUnitMTP;PackTUnitMTP</TargetsForTfmSpecificContentInPackage>
        <IsTestProject>false</IsTestProject>
        <IsTestingPlatformApplication>false</IsTestingPlatformApplication>
        <DisableTestingPlatformServerCapability>true</DisableTestingPlatformServerCapability>
        <ProduceReferenceAssembly>false</ProduceReferenceAssembly>
        <ILRepackable Condition="'$(TargetFramework)' != ''">true</ILRepackable>
        <ILRepackInternalize Condition="'$(TargetFramework)' != ''">true</ILRepackInternalize>
        <RepackBinariesKeep Condition="'$(TargetFramework)' != ''">DevTools.Testing.Abstractions.dll</RepackBinariesKeep>
        <!-- Testhost assets, not adapter code: the nuspec flows them to the consumer. -->
        <RepackBinariesExcludes Condition="'$(TargetFramework)' != ''">Microsoft.Testing.Platform.dll;Microsoft.Testing.Extensions.MSBuild.dll</RepackBinariesExcludes>
    </PropertyGroup>

    <!-- 4. Consumer build files + package content. build\ is consumer source, never adapter code. -->
    <ItemGroup>
        <Compile Remove="build\**\*.cs"/>
        <None Include="build\RevitDevTool.TestAdapter.props" Pack="true" PackagePath="build\"/>
        <None Include="build\RevitDevTool.TestAdapter.targets" Pack="true" PackagePath="build\"/>
        <None Include="build\netfx\ModuleInitializerAttribute.cs" Pack="true" PackagePath="build\netfx\"/>
        <None Include="README.md" Pack="true" PackagePath="\"/>
        <None Include="..\DevTools.UI\Resources\icons\DevTools-32-Light.png" Pack="true" PackagePath="\"/>
    </ItemGroup>

    <Target Name="BuildTUnitMTPForPack">
        <PropertyGroup>
            <_TUnitMTPProject>$(MSBuildThisFileDirectory)..\DevTools.TUnit.MTP\DevTools.TUnit.MTP.csproj</_TUnitMTPProject>
            <_TUnitMTPDll>$(MSBuildThisFileDirectory)..\DevTools.TUnit.MTP\bin\$(Configuration)\$(TargetFramework)\DevTools.TUnit.MTP.dll</_TUnitMTPDll>
        </PropertyGroup>
        <MSBuild Condition="!Exists('$(_TUnitMTPDll)')"
                 Projects="$(_TUnitMTPProject)" Targets="Restore"
                 Properties="Configuration=$(Configuration)" RemoveProperties="TargetFramework"/>
        <MSBuild Condition="!Exists('$(_TUnitMTPDll)')"
                 Projects="$(_TUnitMTPProject)" Targets="Build"
                 Properties="Configuration=$(Configuration);TargetFramework=$(TargetFramework)"/>
    </Target>

    <Target Name="PackTUnitMTP"
            DependsOnTargets="BuildTUnitMTPForPack">
        <PropertyGroup>
            <_TUnitMTPDll>$(MSBuildThisFileDirectory)..\DevTools.TUnit.MTP\bin\$(Configuration)\$(TargetFramework)\DevTools.TUnit.MTP.dll</_TUnitMTPDll>
            <_TUnitMTPPackageRuntime Condition="'$(TargetFrameworkIdentifier)' == '.NETCoreApp'">build/runtime/net$(TargetFrameworkVersion.Substring(1))-windows7.0</_TUnitMTPPackageRuntime>
            <_TUnitMTPPackageRuntime Condition="'$(TargetFrameworkIdentifier)' != '.NETCoreApp'">build/runtime/net48</_TUnitMTPPackageRuntime>
        </PropertyGroup>
        <Error Condition="!Exists('$(_TUnitMTPDll)')"
               Text="Pack requires DevTools.TUnit.MTP.dll at $(_TUnitMTPDll)."/>
        <ItemGroup>
            <TfmSpecificPackageFile Include="$(_TUnitMTPDll)">
                <PackagePath>$(_TUnitMTPPackageRuntime)</PackagePath>
            </TfmSpecificPackageFile>
        </ItemGroup>
    </Target>

    <!-- 1. testhost sibling: restore/build if this TFM DLL is missing -->
    <Target Name="BuildNUnitMTPForPack">
        <PropertyGroup>
            <_NUnitMTPProject>$(MSBuildThisFileDirectory)..\DevTools.NUnit.MTP\DevTools.NUnit.MTP.csproj</_NUnitMTPProject>
            <_NUnitMTPDll>$(MSBuildThisFileDirectory)..\DevTools.NUnit.MTP\bin\$(Configuration)\$(TargetFramework)\DevTools.NUnit.MTP.dll</_NUnitMTPDll>
        </PropertyGroup>
        <MSBuild Condition="!Exists('$(_NUnitMTPDll)')"
                 Projects="$(_NUnitMTPProject)"
                 Targets="Restore"
                 Properties="Configuration=$(Configuration)"
                 RemoveProperties="TargetFramework"/>
        <MSBuild Condition="!Exists('$(_NUnitMTPDll)')"
                 Projects="$(_NUnitMTPProject)"
                 Targets="Build"
                 Properties="Configuration=$(Configuration);TargetFramework=$(TargetFramework)"/>
    </Target>

    <!-- 3. testhost sibling + kept Abstractions into build/runtime/{tfm} -->
    <Target Name="PackNUnitMTP" DependsOnTargets="BuildNUnitMTPForPack">
        <PropertyGroup>
            <_NUnitMTPDll>$(MSBuildThisFileDirectory)..\DevTools.NUnit.MTP\bin\$(Configuration)\$(TargetFramework)\DevTools.NUnit.MTP.dll</_NUnitMTPDll>
            <_NUnitMTPPackageRuntime Condition="'$(TargetFrameworkIdentifier)' == '.NETCoreApp'">build/runtime/net$(TargetFrameworkVersion.Substring(1))-windows7.0</_NUnitMTPPackageRuntime>
            <_NUnitMTPPackageRuntime Condition="'$(TargetFrameworkIdentifier)' != '.NETCoreApp'">build/runtime/net48</_NUnitMTPPackageRuntime>
        </PropertyGroup>
        <Error Condition="!Exists('$(_NUnitMTPDll)')"
               Text="Pack requires DevTools.NUnit.MTP.dll at $(_NUnitMTPDll)."/>
        <Error Condition="!Exists('$(TargetDir)DevTools.Testing.Abstractions.dll')"
               Text="Pack requires DevTools.Testing.Abstractions.dll beside the adapter so testhost MTP shares HostTestDiscovery."/>
        <ItemGroup>
            <TfmSpecificPackageFile Include="$(_NUnitMTPDll)">
                <PackagePath>$(_NUnitMTPPackageRuntime)</PackagePath>
            </TfmSpecificPackageFile>
            <TfmSpecificPackageFile Include="$(TargetDir)DevTools.Testing.Abstractions.dll">
                <PackagePath>$(_NUnitMTPPackageRuntime)</PackagePath>
            </TfmSpecificPackageFile>
        </ItemGroup>
    </Target>

    <!-- Compile: MTP (testhost hook). STJ/BCL copy-local comes from Transport/Ipc on net48. -->
    <ItemGroup>
        <PackageReference Include="Microsoft.Testing.Platform">
            <PrivateAssets>all</PrivateAssets>
            <ExcludeAssets>runtime</ExcludeAssets>
        </PackageReference>
        <PackageReference Include="Microsoft.Testing.Platform.MSBuild">
            <PrivateAssets>none</PrivateAssets>
        </PackageReference>
        <InternalsVisibleTo Include="DevTools.TestAdapter.Tests"/>
    </ItemGroup>

    <ItemGroup>
        <Compile Include="..\DevTools.Utilities\AppUtils.cs" Link="AppUtils.cs"/>
        <ProjectReference Include="..\DevTools.Testing.Abstractions\DevTools.Testing.Abstractions.csproj">
            <PrivateAssets>all</PrivateAssets>
        </ProjectReference>
        <ProjectReference Include="..\DevTools.Testing.Transport\DevTools.Testing.Transport.csproj">
            <PrivateAssets>all</PrivateAssets>
        </ProjectReference>
    </ItemGroup>
</Project>
