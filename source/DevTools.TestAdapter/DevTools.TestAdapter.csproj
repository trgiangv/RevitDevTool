<Project Sdk="Microsoft.NET.Sdk">
    <!--
      Published RevitDevTool.TestAdapter (pack entry).
      Architecture: docs/architecture/Testing/README.md

      Pack order, per TFM (net48; net8.0-windows; net10.0-windows):
        1. ILRepack — merge copy-local (Transport, Ipc, net48 STJ BCL) into
           TestAdapter.dll; keep Testing.Abstractions.dll so testhost MTP shares
           TestingDiscovery.
        2. PackRuntime — restore and build the NUnit / TUnit / MSTest testhost siblings
           and framework runtimes (TestFramework items), then siblings + Abstractions +
           runtime + manifest + pdb to build/runtime/{tfm}.
        3. build/*.props|targets (+ build/netfx source shim) — the consumer build order
           lives in those files. The selected sibling is a normal Reference, not a
           runtime plugin.
        4. PackRunner (once, outer build) — publish DevTools.TestRunner to tools/runner.

      Constraints:
        - Do not flatten obj/bin: the three TFMs would collide (CS2012 / MSB3713).
        - Microsoft.Testing.Platform.MSBuild is a real dependency with all
          assets (PrivateAssets=none): an NUnit-only consumer has no other source of
          the testhost or Microsoft.Testing.Platform.dll. RepackBinariesExcludes keeps
          those DLLs out of the merged adapter. Every other graph reference stays
          PrivateAssets=all so it never reaches the nuspec.
        - Do not add PackageReference for STJ/Unsafe/Bcl: net48 takes them from
          Transport/Ipc, net8/net10 use the in-box copies, and the testhost gets its
          BCL from the MTP.MSBuild graph plus net48 binding redirects.
        - Bump Version before PublishTestAdapter.yml; it is independent of installer GitVersion.
    -->
    <PropertyGroup>
        <TargetFrameworks>net48;net8.0-windows;net10.0-windows</TargetFrameworks>
        <AppendTargetFrameworkToOutputPath>true</AppendTargetFrameworkToOutputPath>
        <RootNamespace>DevTools.TestAdapter</RootNamespace>
        <AssemblyName>DevTools.TestAdapter</AssemblyName>
        <PackageId>RevitDevTool.TestAdapter</PackageId>
        <Version>0.2.0</Version>
        <IsPackable>true</IsPackable>
        <DevelopmentDependency>true</DevelopmentDependency>
        <PackageLicenseExpression>MIT</PackageLicenseExpression>
        <PackageProjectUrl>https://github.com/trgiangv/RevitDevTool</PackageProjectUrl>
        <Description>Microsoft Testing Platform adapter that allows running NUnit, TUnit, or MSTest tests inside Autodesk hosts. Requires RevitDevTool (https://github.com/trgiangv/RevitDevTool).</Description>
        <PackageTags>testing;revit;autocad;adapter</PackageTags>
        <PackageReadmeFile>README.md</PackageReadmeFile>
        <PackageIcon>DevTools-32-Light.png</PackageIcon>
        <EnableDynamicLoading>false</EnableDynamicLoading>
        <CopyLocalLockFileAssemblies>true</CopyLocalLockFileAssemblies>
        <NoPackageAnalysis>true</NoPackageAnalysis>
        <TargetsForTfmSpecificContentInPackage>$(TargetsForTfmSpecificContentInPackage);PackRuntime</TargetsForTfmSpecificContentInPackage>
        <BeforePack>$(BeforePack);PackRunner</BeforePack>
        <IsTestProject>false</IsTestProject>
        <IsTestingPlatformApplication>false</IsTestingPlatformApplication>
        <DisableTestingPlatformServerCapability>true</DisableTestingPlatformServerCapability>
        <ProduceReferenceAssembly>false</ProduceReferenceAssembly>
        <ILRepackable Condition="'$(TargetFramework)' != ''">true</ILRepackable>
        <ILRepackInternalize Condition="'$(TargetFramework)' != ''">true</ILRepackInternalize>
        <RepackBinariesKeep Condition="'$(TargetFramework)' != ''">DevTools.Testing.Abstractions.dll</RepackBinariesKeep>
        <!-- Testhost assets, not adapter code: the nuspec flows them to the consumer. -->
        <RepackBinariesExcludes Condition="'$(TargetFramework)' != ''">Microsoft.Testing.Platform.dll;Microsoft.Testing.Extensions.MSBuild.dll</RepackBinariesExcludes>
    </PropertyGroup>

    <!-- 4. Consumer build files + package content. build\ is consumer source, never adapter code. -->
    <ItemGroup>
        <Compile Remove="build\**\*.cs"/>
        <None Include="build\RevitDevTool.TestAdapter.props" Pack="true" PackagePath="build\"/>
        <None Include="build\RevitDevTool.TestAdapter.targets" Pack="true" PackagePath="build\"/>
        <None Include="build\netfx\ModuleInitializerAttribute.cs" Pack="true" PackagePath="build\netfx\"/>
        <None Include="build\hooks\NUnitMtpBuilderHook.cs" Pack="true" PackagePath="build\hooks\"/>
        <None Include="build\hooks\TUnitMtpBuilderHook.cs" Pack="true" PackagePath="build\hooks\"/>
        <None Include="build\hooks\MSTestMtpBuilderHook.cs" Pack="true" PackagePath="build\hooks\"/>
        <None Include="README.md" Pack="true" PackagePath="\"/>
        <None Include="..\DevTools.UI\Resources\icons\DevTools-32-Light.png" Pack="true" PackagePath="\"/>
    </ItemGroup>

    <!-- One row per framework: the testhost sibling DevTools.<F>.MTP and the framework
         runtime DevTools.<F>.Runtime (+ manifest + pdb) go to build/runtime/{tfm}. -->
    <ItemGroup>
        <TestFramework Include="NUnit;TUnit;MSTest"/>
    </ItemGroup>

    <Target Name="_ResolvePackProjects">
        <PropertyGroup>
            <_PackRuntimeDir Condition="'$(TargetFrameworkIdentifier)' == '.NETCoreApp'">build/runtime/net$(TargetFrameworkVersion.Substring(1))-windows7.0</_PackRuntimeDir>
            <_PackRuntimeDir Condition="'$(TargetFrameworkIdentifier)' != '.NETCoreApp'">build/runtime/net48</_PackRuntimeDir>
        </PropertyGroup>
        <ItemGroup>
            <_PackProject Include="$(MSBuildThisFileDirectory)..\DevTools.%(TestFramework.Identity).MTP\DevTools.%(TestFramework.Identity).MTP.csproj">
                <PackOutput>$(MSBuildThisFileDirectory)..\DevTools.%(TestFramework.Identity).MTP\bin\$(Configuration)\$(TargetFramework)\DevTools.%(TestFramework.Identity).MTP</PackOutput>
                <IsRuntime>false</IsRuntime>
            </_PackProject>
            <_PackProject Include="$(MSBuildThisFileDirectory)..\DevTools.%(TestFramework.Identity).Runtime\DevTools.%(TestFramework.Identity).Runtime.csproj">
                <PackOutput>$(MSBuildThisFileDirectory)..\DevTools.%(TestFramework.Identity).Runtime\bin\$(Configuration)\$(TargetFramework)\DevTools.%(TestFramework.Identity).Runtime</PackOutput>
                <IsRuntime>true</IsRuntime>
            </_PackProject>
        </ItemGroup>
    </Target>

    <Target Name="BuildPackProjects" DependsOnTargets="_ResolvePackProjects">
        <MSBuild Projects="@(_PackProject)"
                 Targets="Restore"
                 Properties="Configuration=$(Configuration)"
                 RemoveProperties="TargetFramework"/>
        <MSBuild Projects="@(_PackProject)"
                 Targets="Build"
                 Properties="Configuration=$(Configuration);TargetFramework=$(TargetFramework)"/>
    </Target>

    <Target Name="PackRuntime" DependsOnTargets="BuildPackProjects">
        <Error Condition="!Exists('%(_PackProject.PackOutput).dll')"
               Text="Pack requires %(_PackProject.PackOutput).dll."/>
        <Error Condition="'%(_PackProject.IsRuntime)' == 'true' And (!Exists('%(_PackProject.PackOutput).json') Or !Exists('%(_PackProject.PackOutput).pdb'))"
               Text="Pack requires the manifest and pdb beside %(_PackProject.PackOutput).dll."/>
        <Error Condition="!Exists('$(TargetDir)DevTools.Testing.Abstractions.dll')"
               Text="Pack requires DevTools.Testing.Abstractions.dll beside the adapter so testhost MTP shares TestingDiscovery."/>
        <ItemGroup>
            <TfmSpecificPackageFile Include="@(_PackProject->'%(PackOutput).dll');$(TargetDir)DevTools.Testing.Abstractions.dll">
                <PackagePath>$(_PackRuntimeDir)</PackagePath>
            </TfmSpecificPackageFile>
            <TfmSpecificPackageFile Include="%(_PackProject.PackOutput).json;%(_PackProject.PackOutput).pdb" Condition="'%(_PackProject.IsRuntime)' == 'true'">
                <PackagePath>$(_PackRuntimeDir)</PackagePath>
            </TfmSpecificPackageFile>
        </ItemGroup>
    </Target>
    <!-- Once per pack (outer build): publish the framework-dependent single-file runner
         and ship it at tools/runner. The consumer targets point devtools.runnerPath there. -->
    <Import Project="..\..\props\TestingRuntime.props"/>

    <PropertyGroup>
        <_RunnerProject>$(MSBuildThisFileDirectory)..\DevTools.TestRunner\DevTools.TestRunner.csproj</_RunnerProject>
        <_RunnerExe>$(MSBuildThisFileDirectory)..\DevTools.TestRunner\bin\$(Configuration)\$(TestRunnerTargetFramework)\win-x64\publish\DevTools.TestRunner.exe</_RunnerExe>
    </PropertyGroup>

    <Target Name="PackRunner">
        <MSBuild Projects="$(_RunnerProject)"
                 Targets="Restore"
                 Properties="Configuration=$(Configuration);MSBuildRestoreSessionId=$([System.Guid]::NewGuid())"
                 RemoveProperties="TargetFramework"/>
        <MSBuild Projects="$(_RunnerProject)"
                 Targets="Publish"
                 Properties="Configuration=$(Configuration)"
                 RemoveProperties="TargetFramework"/>
        <Error Condition="!Exists('$(_RunnerExe)')"
               Text="Pack requires the published TestRunner at $(_RunnerExe)."/>
        <ItemGroup>
            <None Include="$(_RunnerExe)" Pack="true" PackagePath="tools\runner\"/>
        </ItemGroup>
    </Target>

    <!-- Compile: MTP (testhost hook). STJ/BCL copy-local comes from Transport/Ipc on net48. -->
    <ItemGroup>
        <PackageReference Include="Microsoft.Testing.Platform">
            <PrivateAssets>all</PrivateAssets>
            <ExcludeAssets>runtime</ExcludeAssets>
        </PackageReference>
        <PackageReference Include="Microsoft.Testing.Platform.MSBuild">
            <PrivateAssets>none</PrivateAssets>
        </PackageReference>
        <InternalsVisibleTo Include="DevTools.TestAdapter.Tests"/>
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="..\DevTools.Testing.Abstractions\DevTools.Testing.Abstractions.csproj">
            <PrivateAssets>all</PrivateAssets>
        </ProjectReference>
        <ProjectReference Include="..\DevTools.Testing.Transport\DevTools.Testing.Transport.csproj">
            <PrivateAssets>all</PrivateAssets>
        </ProjectReference>
    </ItemGroup>
</Project>
