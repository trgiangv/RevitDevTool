<Project Sdk="Microsoft.NET.Sdk">
    <!--
      Published RevitDevTool.TestAdapter (pack entry).
      Architecture: docs/architecture/Testing/README.md

      1. Multi-TFM output
         - net48; net8.0-windows; net10.0-windows. Do not flatten obj/bin
           (Autodesk configs share folders → CS2012 / MSB3713).

      2. Package identity
         - Sole published testing nupkg. Bump Version before PublishTestAdapter.yml.
         - Independent of installer GitVersion. No NuGet dependency groups.

      3. net48 ILRepack
         - Merge adapter + Transport/Ipc/Json. Keep Testing.Abstractions.dll
           loose so testhost shares HostTestDiscovery with MTP.

      4. Modern runtime closure
         - Pack TargetDir DLLs (except the adapter) under
           build/runtime/net{N}-windows7.0. Not lib/ compile references.

      5. MTP sibling
         - Not a ProjectReference. pack-test-adapter.ps1 restores and builds
           DevTools.NUnit.MTP and DevTools.TUnit.MTP for all TFMs before pack.
         - Copy MTP.dll (and Abstractions on net48) to build/runtime.
    -->
    <PropertyGroup>
        <TargetFrameworks>net48;net8.0-windows;net10.0-windows</TargetFrameworks>
        <AppendTargetFrameworkToOutputPath>true</AppendTargetFrameworkToOutputPath>
        <RootNamespace>DevTools.TestAdapter</RootNamespace>
        <AssemblyName>DevTools.TestAdapter</AssemblyName>
        <PackageId>RevitDevTool.TestAdapter</PackageId>
        <Version>0.0.3</Version>
        <IsPackable>true</IsPackable>
        <DevelopmentDependency>true</DevelopmentDependency>
        <PackageLicenseExpression>MIT</PackageLicenseExpression>
        <PackageProjectUrl>https://github.com/trgiangv/RevitDevTool</PackageProjectUrl>
        <Description>Microsoft.Testing.Platform adapter that runs NUnit tests inside Autodesk hosts and native TUnit tests inside Revit. Requires RevitDevTool (https://github.com/trgiangv/RevitDevTool).</Description>
        <PackageTags>testing;revit;autocad;adapter</PackageTags>
        <PackageReadmeFile>README.md</PackageReadmeFile>
        <EnableDynamicLoading>false</EnableDynamicLoading>
        <CopyLocalLockFileAssemblies>true</CopyLocalLockFileAssemblies>
        <SuppressDependenciesWhenPacking>true</SuppressDependenciesWhenPacking>
        <NoPackageAnalysis>true</NoPackageAnalysis>
        <TargetsForTfmSpecificContentInPackage>$(TargetsForTfmSpecificContentInPackage);PackDevToolsTestAdapterRuntimeClosure;PackDevToolsNUnitMTP;PackDevToolsTUnitMTP</TargetsForTfmSpecificContentInPackage>
        <IsTestProject>false</IsTestProject>
        <ILRepackable Condition="'$(TargetFramework)' == 'net48'">true</ILRepackable>
        <ILRepackInternalize Condition="'$(TargetFramework)' == 'net48'">true</ILRepackInternalize>
        <RepackBinariesKeep Condition="'$(TargetFramework)' == 'net48'">DevTools.Testing.Abstractions.dll</RepackBinariesKeep>
    </PropertyGroup>

    <!-- 2. Package identity -->
    <ItemGroup>
        <None Include="build\RevitDevTool.TestAdapter.props" Pack="true" PackagePath="build\"/>
        <None Include="build\RevitDevTool.TestAdapter.targets" Pack="true" PackagePath="build\"/>
        <None Include="README.md" Pack="true" PackagePath="\"/>
    </ItemGroup>

    <!-- 4. Modern runtime closure -->
    <Target Name="PackDevToolsTestAdapterRuntimeClosure"
            Condition="'$(TargetFrameworkIdentifier)' == '.NETCoreApp'">
        <PropertyGroup>
            <_DevToolsTestAdapterRuntimeTfm>net$(TargetFrameworkVersion.Substring(1))-windows7.0</_DevToolsTestAdapterRuntimeTfm>
        </PropertyGroup>
        <ItemGroup>
            <TfmSpecificPackageFile Include="$(TargetDir)*.dll" Exclude="$(TargetPath)">
                <PackagePath>build/runtime/$(_DevToolsTestAdapterRuntimeTfm)</PackagePath>
            </TfmSpecificPackageFile>
        </ItemGroup>
    </Target>

    <Target Name="BuildDevToolsTUnitMTPForPack">
        <PropertyGroup>
            <_DevToolsTUnitMTPProject>$(MSBuildThisFileDirectory)..\DevTools.TUnit.MTP\DevTools.TUnit.MTP.csproj</_DevToolsTUnitMTPProject>
            <_DevToolsTUnitMTPDll>$(MSBuildThisFileDirectory)..\DevTools.TUnit.MTP\bin\$(Configuration)\$(TargetFramework)\DevTools.TUnit.MTP.dll</_DevToolsTUnitMTPDll>
        </PropertyGroup>
        <MSBuild Condition="!Exists('$(_DevToolsTUnitMTPDll)')"
                 Projects="$(_DevToolsTUnitMTPProject)" Targets="Restore"
                 Properties="Configuration=$(Configuration)" RemoveProperties="TargetFramework"/>
        <MSBuild Condition="!Exists('$(_DevToolsTUnitMTPDll)')"
                 Projects="$(_DevToolsTUnitMTPProject)" Targets="Build"
                 Properties="Configuration=$(Configuration);TargetFramework=$(TargetFramework)"/>
    </Target>

    <Target Name="PackDevToolsTUnitMTP"
            DependsOnTargets="BuildDevToolsTUnitMTPForPack">
        <PropertyGroup>
            <_DevToolsTUnitMTPDll>$(MSBuildThisFileDirectory)..\DevTools.TUnit.MTP\bin\$(Configuration)\$(TargetFramework)\DevTools.TUnit.MTP.dll</_DevToolsTUnitMTPDll>
            <_DevToolsTUnitMTPPackageRuntime Condition="'$(TargetFrameworkIdentifier)' == '.NETCoreApp'">build/runtime/net$(TargetFrameworkVersion.Substring(1))-windows7.0</_DevToolsTUnitMTPPackageRuntime>
            <_DevToolsTUnitMTPPackageRuntime Condition="'$(TargetFrameworkIdentifier)' != '.NETCoreApp'">build/runtime/net48</_DevToolsTUnitMTPPackageRuntime>
        </PropertyGroup>
        <Error Condition="!Exists('$(_DevToolsTUnitMTPDll)')"
               Text="Pack requires DevTools.TUnit.MTP.dll at $(_DevToolsTUnitMTPDll)."/>
        <ItemGroup>
            <TfmSpecificPackageFile Include="$(_DevToolsTUnitMTPDll)">
                <PackagePath>$(_DevToolsTUnitMTPPackageRuntime)</PackagePath>
            </TfmSpecificPackageFile>
        </ItemGroup>
    </Target>

    <!-- 5. MTP sibling: restore/build if this TFM DLL is missing -->
    <Target Name="BuildDevToolsNUnitMTPForPack">
        <PropertyGroup>
            <_DevToolsNUnitMTPProject>$(MSBuildThisFileDirectory)..\DevTools.NUnit.MTP\DevTools.NUnit.MTP.csproj</_DevToolsNUnitMTPProject>
            <_DevToolsNUnitMTPDll>$(MSBuildThisFileDirectory)..\DevTools.NUnit.MTP\bin\$(Configuration)\$(TargetFramework)\DevTools.NUnit.MTP.dll</_DevToolsNUnitMTPDll>
        </PropertyGroup>
        <MSBuild Condition="!Exists('$(_DevToolsNUnitMTPDll)')"
                 Projects="$(_DevToolsNUnitMTPProject)"
                 Targets="Restore"
                 Properties="Configuration=$(Configuration)"
                 RemoveProperties="TargetFramework"/>
        <MSBuild Condition="!Exists('$(_DevToolsNUnitMTPDll)')"
                 Projects="$(_DevToolsNUnitMTPProject)"
                 Targets="Build"
                 Properties="Configuration=$(Configuration);TargetFramework=$(TargetFramework)"/>
    </Target>

    <!-- 5. MTP sibling: pack into build/runtime -->
    <Target Name="PackDevToolsNUnitMTP" DependsOnTargets="BuildDevToolsNUnitMTPForPack">
        <PropertyGroup>
            <_DevToolsNUnitMTPDll>$(MSBuildThisFileDirectory)..\DevTools.NUnit.MTP\bin\$(Configuration)\$(TargetFramework)\DevTools.NUnit.MTP.dll</_DevToolsNUnitMTPDll>
            <_DevToolsNUnitMTPPackageRuntime Condition="'$(TargetFrameworkIdentifier)' == '.NETCoreApp'">build/runtime/net$(TargetFrameworkVersion.Substring(1))-windows7.0</_DevToolsNUnitMTPPackageRuntime>
            <_DevToolsNUnitMTPPackageRuntime Condition="'$(TargetFrameworkIdentifier)' != '.NETCoreApp'">build/runtime/net48</_DevToolsNUnitMTPPackageRuntime>
        </PropertyGroup>
        <Error Condition="!Exists('$(_DevToolsNUnitMTPDll)')"
               Text="Pack requires DevTools.NUnit.MTP.dll at $(_DevToolsNUnitMTPDll)."/>
        <Error Condition="'$(TargetFramework)' == 'net48' And !Exists('$(TargetDir)DevTools.Testing.Abstractions.dll')"
               Text="Pack requires DevTools.Testing.Abstractions.dll beside the net48 adapter so testhost MTP shares HostTestDiscovery."/>
        <ItemGroup>
            <TfmSpecificPackageFile Include="$(_DevToolsNUnitMTPDll)">
                <PackagePath>$(_DevToolsNUnitMTPPackageRuntime)</PackagePath>
            </TfmSpecificPackageFile>
            <TfmSpecificPackageFile Include="$(TargetDir)DevTools.Testing.Abstractions.dll"
                                    Condition="'$(TargetFramework)' == 'net48'">
                <PackagePath>$(_DevToolsNUnitMTPPackageRuntime)</PackagePath>
            </TfmSpecificPackageFile>
        </ItemGroup>
    </Target>

    <!-- 3. net48 ILRepack inputs; compile against MTP, not a runtime copy -->
    <ItemGroup>
        <GlobalPackageReference Remove="Polyfill"/>
        <PackageReference Include="Microsoft.Testing.Platform">
            <PrivateAssets>all</PrivateAssets>
            <ExcludeAssets>runtime</ExcludeAssets>
        </PackageReference>
        <PackageReference Include="System.Text.Json" Condition="'$(TargetFramework)' == 'net48'">
            <PrivateAssets>all</PrivateAssets>
        </PackageReference>
        <PackageReference Include="System.Runtime.CompilerServices.Unsafe" Condition="'$(TargetFramework)' == 'net48'">
            <PrivateAssets>all</PrivateAssets>
        </PackageReference>
        <InternalsVisibleTo Include="DevTools.TestAdapter.Tests"/>
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="..\DevTools.Testing.Abstractions\DevTools.Testing.Abstractions.csproj"/>
        <ProjectReference Include="..\DevTools.Testing.Transport\DevTools.Testing.Transport.csproj"/>
    </ItemGroup>
</Project>
