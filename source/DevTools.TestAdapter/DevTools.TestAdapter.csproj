<Project Sdk="Microsoft.NET.Sdk">
    <!--
      Published RevitDevTool.TestAdapter (pack entry).
      Architecture: docs/architecture/Testing/README.md

      Pack order, per TFM (net48; net8.0-windows; net10.0-windows):
        1. BuildMtpSiblingsForPack — build the NUnit / TUnit / MSTest testhost siblings (MtpSibling items).
        2. ILRepack — merge copy-local (Transport, Ipc, net48 STJ BCL) into
           TestAdapter.dll; keep Testing.Abstractions.dll so testhost MTP shares
           TestingDiscovery.
        3. PackMtpSiblings — MTP siblings + Abstractions to build/runtime/{tfm}.
        4. build/*.props|targets (+ build/netfx source shim) — the consumer build order
           lives in those files. The selected sibling is a normal Reference, not a
           runtime plugin.

      Constraints:
        - Do not flatten obj/bin: the three TFMs would collide (CS2012 / MSB3713).
        - Microsoft.Testing.Platform.MSBuild 2.4.1 is a real dependency with all
          assets (PrivateAssets=none): an NUnit-only consumer has no other source of
          the testhost or Microsoft.Testing.Platform.dll. RepackBinariesExcludes keeps
          those DLLs out of the merged adapter. Every other graph reference stays
          PrivateAssets=all so it never reaches the nuspec.
        - Do not add PackageReference for STJ/Unsafe/Bcl: net48 takes them from
          Transport/Ipc, net8/net10 use the in-box copies, and the testhost gets its
          BCL from the MTP.MSBuild graph plus net48 binding redirects.
        - Bump Version before PublishTestAdapter.yml; it is independent of installer GitVersion.
    -->
    <PropertyGroup>
        <TargetFrameworks>net48;net8.0-windows;net10.0-windows</TargetFrameworks>
        <AppendTargetFrameworkToOutputPath>true</AppendTargetFrameworkToOutputPath>
        <RootNamespace>DevTools.TestAdapter</RootNamespace>
        <AssemblyName>DevTools.TestAdapter</AssemblyName>
        <PackageId>RevitDevTool.TestAdapter</PackageId>
        <Version>0.1.2</Version>
        <IsPackable>true</IsPackable>
        <DevelopmentDependency>true</DevelopmentDependency>
        <PackageLicenseExpression>MIT</PackageLicenseExpression>
        <PackageProjectUrl>https://github.com/trgiangv/RevitDevTool</PackageProjectUrl>
        <Description>Microsoft Testing Platform adapter that allows running NUnit, TUnit, or MSTest tests inside Autodesk hosts. Requires RevitDevTool (https://github.com/trgiangv/RevitDevTool).</Description>
        <PackageTags>testing;revit;autocad;adapter</PackageTags>
        <PackageReadmeFile>README.md</PackageReadmeFile>
        <PackageIcon>DevTools-32-Light.png</PackageIcon>
        <EnableDynamicLoading>false</EnableDynamicLoading>
        <CopyLocalLockFileAssemblies>true</CopyLocalLockFileAssemblies>
        <NoPackageAnalysis>true</NoPackageAnalysis>
        <TargetsForTfmSpecificContentInPackage>$(TargetsForTfmSpecificContentInPackage);PackMtpSiblings</TargetsForTfmSpecificContentInPackage>
        <IsTestProject>false</IsTestProject>
        <IsTestingPlatformApplication>false</IsTestingPlatformApplication>
        <DisableTestingPlatformServerCapability>true</DisableTestingPlatformServerCapability>
        <ProduceReferenceAssembly>false</ProduceReferenceAssembly>
        <ILRepackable Condition="'$(TargetFramework)' != ''">true</ILRepackable>
        <ILRepackInternalize Condition="'$(TargetFramework)' != ''">true</ILRepackInternalize>
        <RepackBinariesKeep Condition="'$(TargetFramework)' != ''">DevTools.Testing.Abstractions.dll</RepackBinariesKeep>
        <!-- Testhost assets, not adapter code: the nuspec flows them to the consumer. -->
        <RepackBinariesExcludes Condition="'$(TargetFramework)' != ''">Microsoft.Testing.Platform.dll;Microsoft.Testing.Extensions.MSBuild.dll</RepackBinariesExcludes>
    </PropertyGroup>

    <!-- 4. Consumer build files + package content. build\ is consumer source, never adapter code. -->
    <ItemGroup>
        <Compile Remove="build\**\*.cs"/>
        <None Include="build\RevitDevTool.TestAdapter.props" Pack="true" PackagePath="build\"/>
        <None Include="build\RevitDevTool.TestAdapter.targets" Pack="true" PackagePath="build\"/>
        <None Include="build\netfx\ModuleInitializerAttribute.cs" Pack="true" PackagePath="build\netfx\"/>
        <None Include="build\hooks\NUnitMtpBuilderHook.cs" Pack="true" PackagePath="build\hooks\"/>
        <None Include="build\hooks\TUnitMtpBuilderHook.cs" Pack="true" PackagePath="build\hooks\"/>
        <None Include="build\hooks\MSTestMtpBuilderHook.cs" Pack="true" PackagePath="build\hooks\"/>
        <None Include="README.md" Pack="true" PackagePath="\"/>
        <None Include="..\DevTools.UI\Resources\icons\DevTools-32-Light.png" Pack="true" PackagePath="\"/>
    </ItemGroup>

    <!-- Testhost siblings packed beside the adapter: one row per TestingFramework. -->
    <ItemGroup>
        <MtpSibling Include="NUnit;TUnit;MSTest"/>
    </ItemGroup>

    <Target Name="_ResolveMtpSiblings">
        <PropertyGroup>
            <_MtpPackageRuntime Condition="'$(TargetFrameworkIdentifier)' == '.NETCoreApp'">build/runtime/net$(TargetFrameworkVersion.Substring(1))-windows7.0</_MtpPackageRuntime>
            <_MtpPackageRuntime Condition="'$(TargetFrameworkIdentifier)' != '.NETCoreApp'">build/runtime/net48</_MtpPackageRuntime>
        </PropertyGroup>
        <ItemGroup>
            <_MtpSibling Include="@(MtpSibling)">
                <Project>$(MSBuildThisFileDirectory)..\DevTools.%(Identity).MTP\DevTools.%(Identity).MTP.csproj</Project>
                <Dll>$(MSBuildThisFileDirectory)..\DevTools.%(Identity).MTP\bin\$(Configuration)\$(TargetFramework)\DevTools.%(Identity).MTP.dll</Dll>
            </_MtpSibling>
        </ItemGroup>
    </Target>

    <!-- 1. testhost siblings: restore/build any whose TFM DLL is missing -->
    <Target Name="BuildMtpSiblingsForPack" DependsOnTargets="_ResolveMtpSiblings">
        <MSBuild Condition="!Exists('%(_MtpSibling.Dll)')"
                 Projects="%(_MtpSibling.Project)"
                 Targets="Restore"
                 Properties="Configuration=$(Configuration)"
                 RemoveProperties="TargetFramework"/>
        <MSBuild Condition="!Exists('%(_MtpSibling.Dll)')"
                 Projects="%(_MtpSibling.Project)"
                 Targets="Build"
                 Properties="Configuration=$(Configuration);TargetFramework=$(TargetFramework)"/>
    </Target>

    <!-- 3. testhost siblings + shared Abstractions into build/runtime/{tfm} -->
    <Target Name="PackMtpSiblings" DependsOnTargets="BuildMtpSiblingsForPack">
        <Error Condition="!Exists('%(_MtpSibling.Dll)')"
               Text="Pack requires DevTools.%(_MtpSibling.Identity).MTP.dll at %(_MtpSibling.Dll)."/>
        <Error Condition="!Exists('$(TargetDir)DevTools.Testing.Abstractions.dll')"
               Text="Pack requires DevTools.Testing.Abstractions.dll beside the adapter so testhost MTP shares TestingDiscovery."/>
        <ItemGroup>
            <TfmSpecificPackageFile Include="@(_MtpSibling->'%(Dll)')">
                <PackagePath>$(_MtpPackageRuntime)</PackagePath>
            </TfmSpecificPackageFile>
            <TfmSpecificPackageFile Include="$(TargetDir)DevTools.Testing.Abstractions.dll">
                <PackagePath>$(_MtpPackageRuntime)</PackagePath>
            </TfmSpecificPackageFile>
        </ItemGroup>
    </Target>
    <!-- Compile: MTP (testhost hook). STJ/BCL copy-local comes from Transport/Ipc on net48. -->
    <ItemGroup>
        <PackageReference Include="Microsoft.Testing.Platform">
            <PrivateAssets>all</PrivateAssets>
            <ExcludeAssets>runtime</ExcludeAssets>
        </PackageReference>
        <PackageReference Include="Microsoft.Testing.Platform.MSBuild">
            <PrivateAssets>none</PrivateAssets>
        </PackageReference>
        <InternalsVisibleTo Include="DevTools.TestAdapter.Tests"/>
    </ItemGroup>

    <ItemGroup>
        <Compile Include="..\DevTools.Utilities\AppUtils.cs" Link="AppUtils.cs"/>
        <ProjectReference Include="..\DevTools.Testing.Abstractions\DevTools.Testing.Abstractions.csproj">
            <PrivateAssets>all</PrivateAssets>
        </ProjectReference>
        <ProjectReference Include="..\DevTools.Testing.Transport\DevTools.Testing.Transport.csproj">
            <PrivateAssets>all</PrivateAssets>
        </ProjectReference>
    </ItemGroup>
</Project>
