<Project>
  <!--
    Consumer test-project build (imported from RevitDevTool.TestAdapter).

    1. In-repo build order
       - MTP.dll must exist before the test exe copies it.
       - MTP/Abstractions are year-agnostic: build them as Debug or Release
         plus the consumer TFM, not as Debug.Autodesk.YYYY. RevitDevTool.slnx
         already maps those projects to Debug/Release. A per-year folder
         (bin\Debug.Autodesk.2025\net8.0-windows\) goes stale while Debug.Autodesk.2024
         is rebuilt, so Test Explorer discovery only "works" for the year last built.
       - NuGet consumers skip this; they take the DLL from build/runtime.

    2. Resolve the packaged runtime folder
       - nupkg layout: build/runtime/net48 | net8.0-windows7.0 | net10.0-windows7.0.
       - Pick exact TFM, else nearest lower. Error if the nupkg is present but nothing matches.
       - In-repo has no build/runtime folder; later copy falls back to MTP project output.

    3. Copy runtime next to the test exe
       - net8/net10: copy build/runtime/*.dll (Abstractions, Transport, Ipc, MTP).
       - net48: adapter merge hides Transport/Ipc; Testing.Abstractions stays
         loose (shared testhost discovery identity with MTP). Copy MTP.dll + Abstractions.dll.
       - MTP is not a consumer ProjectReference; testhost binds the consumer NUnit copy.

    4. Discovery refs (no Autodesk DLL copy)
       - Write $(TargetName).discovery-refs.txt from NuGet compile-only ReferencePath.
       - Testhost loads those paths; do not copy Revit/AutoCAD APIs next to the exe.

    5. Host options → testconfig.json
       - Emit HostName / HostVersion / ForceLaunch / timeouts / runnerPath from csproj.
       - Always regenerate on Build (MTP Core target is incremental and would keep a stale file).
       - Merge optional testconfig.json beside the csproj if it has no "devtools" section.
  -->
  <Import Project="$(MSBuildThisFileDirectory)RevitDevTool.TestAdapter.props"
          Condition="'$(DevToolsTestAdapterPropsImported)' != 'true'"/>

  <PropertyGroup>
    <_DevToolsMtpConfiguration Condition="$(Configuration.Contains('Release'))">Release</_DevToolsMtpConfiguration>
    <_DevToolsMtpConfiguration Condition="'$(_DevToolsMtpConfiguration)' == ''">Debug</_DevToolsMtpConfiguration>
  </PropertyGroup>

  <!-- 1. In-repo build order -->
  <ItemGroup Condition="'$(IsTestingPlatformApplication)' == 'true' And Exists('$(MSBuildThisFileDirectory)..\..\DevTools.NUnit.MTP\DevTools.NUnit.MTP.csproj')">
    <ProjectReference Include="$(MSBuildThisFileDirectory)..\..\DevTools.NUnit.MTP\DevTools.NUnit.MTP.csproj">
      <ReferenceOutputAssembly>false</ReferenceOutputAssembly>
      <Private>false</Private>
      <SetConfiguration>Configuration=$(_DevToolsMtpConfiguration)</SetConfiguration>
      <SetTargetFramework>TargetFramework=$(TargetFramework)</SetTargetFramework>
    </ProjectReference>
  </ItemGroup>

  <!-- 5. helper: merge generated + optional user testconfig.json -->
  <UsingTask TaskName="MergeDevToolsTestConfig"
             TaskFactory="RoslynCodeTaskFactory"
             AssemblyFile="$(MSBuildToolsPath)\Microsoft.Build.Tasks.Core.dll">
    <ParameterGroup>
      <UserConfigFile ParameterType="System.String"/>
      <GeneratedConfigFile ParameterType="System.String" Required="true"/>
      <OutputConfigFile ParameterType="System.String" Required="true"/>
    </ParameterGroup>
    <Task>
      <Using Namespace="System.IO"/>
      <Code Type="Fragment" Language="cs"><![CDATA[
        var generated = File.ReadAllText(GeneratedConfigFile);
        var outputDirectory = Path.GetDirectoryName(OutputConfigFile);
        if (!string.IsNullOrEmpty(outputDirectory))
            Directory.CreateDirectory(outputDirectory);

        if (string.IsNullOrWhiteSpace(UserConfigFile) || !File.Exists(UserConfigFile))
        {
            File.WriteAllText(OutputConfigFile, generated);
        }
        else
        {
            var user = File.ReadAllText(UserConfigFile).Trim().TrimStart('\uFEFF');
            if (user.IndexOf("\"devtools\"", StringComparison.OrdinalIgnoreCase) >= 0)
            {
                File.WriteAllText(OutputConfigFile, user);
            }
            else
            {
                var inner = generated.Trim().TrimStart('{').TrimEnd('}').Trim();
                var body = user.Trim().TrimStart('{').TrimEnd('}').Trim().TrimEnd(',');
                var merged = body.Length == 0
                    ? generated
                    : "{" + Environment.NewLine + body + "," + Environment.NewLine + inner + Environment.NewLine + "}";
                File.WriteAllText(OutputConfigFile, merged);
            }
        }
      ]]></Code>
    </Task>
  </UsingTask>

  <!-- 2. Resolve the packaged runtime folder -->
  <Target Name="_ResolveDevToolsTestAdapterRuntimeDir">
    <PropertyGroup>
      <_DevToolsRuntimeRoot>$(MSBuildThisFileDirectory)runtime\</_DevToolsRuntimeRoot>
      <_DevToolsConsumerTfv Condition="'$(TargetFrameworkVersion)' != ''">$(TargetFrameworkVersion.Substring(1))</_DevToolsConsumerTfv>
    </PropertyGroup>
    <PropertyGroup Condition="'$(TargetFrameworkIdentifier)' == '.NETFramework'">
      <_DevToolsTestAdapterPackageRuntimeDir>$(_DevToolsRuntimeRoot)net48\</_DevToolsTestAdapterPackageRuntimeDir>
    </PropertyGroup>
    <PropertyGroup Condition="'$(TargetFrameworkIdentifier)' == '.NETCoreApp' And '$(_DevToolsConsumerTfv)' != ''">
      <_DevToolsTestAdapterPackageRuntimeDir Condition="Exists('$(_DevToolsRuntimeRoot)net$(_DevToolsConsumerTfv)-windows7.0\')">$(_DevToolsRuntimeRoot)net$(_DevToolsConsumerTfv)-windows7.0\</_DevToolsTestAdapterPackageRuntimeDir>
      <_DevToolsTestAdapterPackageRuntimeDir Condition="'$(_DevToolsTestAdapterPackageRuntimeDir)' == '' And $([MSBuild]::VersionGreaterThanOrEquals('$(_DevToolsConsumerTfv)', '10.0')) And Exists('$(_DevToolsRuntimeRoot)net10.0-windows7.0\')">$(_DevToolsRuntimeRoot)net10.0-windows7.0\</_DevToolsTestAdapterPackageRuntimeDir>
      <_DevToolsTestAdapterPackageRuntimeDir Condition="'$(_DevToolsTestAdapterPackageRuntimeDir)' == '' And $([MSBuild]::VersionGreaterThanOrEquals('$(_DevToolsConsumerTfv)', '8.0')) And Exists('$(_DevToolsRuntimeRoot)net8.0-windows7.0\')">$(_DevToolsRuntimeRoot)net8.0-windows7.0\</_DevToolsTestAdapterPackageRuntimeDir>
    </PropertyGroup>
    <Error
        Condition="Exists('$(_DevToolsRuntimeRoot)') And ('$(_DevToolsTestAdapterPackageRuntimeDir)' == '' Or !Exists('$(_DevToolsTestAdapterPackageRuntimeDir)'))"
        Text="RevitDevTool.TestAdapter has no runtime assets for $(TargetFramework). The package ships net48, net8.0-windows, and net10.0-windows under build/runtime. A matching or nearest-lower folder is required so DevTools.NUnit.MTP.dll and the adapter closure copy next to the test exe." />
  </Target>

  <!-- 3. Copy runtime next to the test exe (net8/net10 closure) -->
  <Target Name="CopyDevToolsTestAdapterRuntimeClosure"
          AfterTargets="Build"
          DependsOnTargets="_ResolveDevToolsTestAdapterRuntimeDir"
          Condition="'$(TargetFrameworkIdentifier)' == '.NETCoreApp'">
    <ItemGroup>
      <_DevToolsTestAdapterRuntimeClosureCopy Include="$(_DevToolsTestAdapterPackageRuntimeDir)*.dll"
          Condition="'$(_DevToolsTestAdapterPackageRuntimeDir)' != ''" />
    </ItemGroup>
    <Copy SourceFiles="@(_DevToolsTestAdapterRuntimeClosureCopy)"
          DestinationFolder="$(OutDir)"
          SkipUnchangedFiles="true" />
  </Target>

  <!-- 3. Copy runtime next to the test exe (MTP sibling: net48 + in-repo fallback) -->
  <Target Name="CopyDevToolsNUnitMtp"
          AfterTargets="Build"
          DependsOnTargets="_ResolveDevToolsTestAdapterRuntimeDir">
    <PropertyGroup>
      <_DevToolsNUnitMtpFileName>DevTools.NUnit.MTP.dll</_DevToolsNUnitMtpFileName>
      <_DevToolsNUnitMtpFromPackage Condition="'$(_DevToolsTestAdapterPackageRuntimeDir)' != ''">$(_DevToolsTestAdapterPackageRuntimeDir)$(_DevToolsNUnitMtpFileName)</_DevToolsNUnitMtpFromPackage>
      <_DevToolsNUnitMtpFromRepoFlavor>$([System.IO.Path]::GetFullPath('$(MSBuildThisFileDirectory)..\..\DevTools.NUnit.MTP\bin\$(_DevToolsMtpConfiguration)\$(TargetFramework)\$(_DevToolsNUnitMtpFileName)'))</_DevToolsNUnitMtpFromRepoFlavor>
      <_DevToolsNUnitMtpFromRepoConfig>$([System.IO.Path]::GetFullPath('$(MSBuildThisFileDirectory)..\..\DevTools.NUnit.MTP\bin\$(Configuration)\$(TargetFramework)\$(_DevToolsNUnitMtpFileName)'))</_DevToolsNUnitMtpFromRepoConfig>
      <_DevToolsNUnitMtpSkipPackageCopy Condition="'$(TargetFrameworkIdentifier)' == '.NETCoreApp' And Exists('$(_DevToolsNUnitMtpFromPackage)')">true</_DevToolsNUnitMtpSkipPackageCopy>
      <_DevToolsNUnitMtpSource Condition="'$(_DevToolsNUnitMtpSkipPackageCopy)' != 'true' And Exists('$(_DevToolsNUnitMtpFromPackage)')">$(_DevToolsNUnitMtpFromPackage)</_DevToolsNUnitMtpSource>
      <_DevToolsNUnitMtpSource Condition="'$(_DevToolsNUnitMtpSource)' == '' And Exists('$(_DevToolsNUnitMtpFromRepoFlavor)')">$(_DevToolsNUnitMtpFromRepoFlavor)</_DevToolsNUnitMtpSource>
      <_DevToolsNUnitMtpSource Condition="'$(_DevToolsNUnitMtpSource)' == '' And Exists('$(_DevToolsNUnitMtpFromRepoConfig)')">$(_DevToolsNUnitMtpFromRepoConfig)</_DevToolsNUnitMtpSource>
      <_DevToolsTestingAbstractionsFileName>DevTools.Testing.Abstractions.dll</_DevToolsTestingAbstractionsFileName>
      <_DevToolsTestingAbstractionsFromPackage Condition="'$(_DevToolsTestAdapterPackageRuntimeDir)' != ''">$(_DevToolsTestAdapterPackageRuntimeDir)$(_DevToolsTestingAbstractionsFileName)</_DevToolsTestingAbstractionsFromPackage>
      <_DevToolsTestingAbstractionsFromRepoFlavor>$([System.IO.Path]::GetFullPath('$(MSBuildThisFileDirectory)..\..\DevTools.Testing.Abstractions\bin\$(_DevToolsMtpConfiguration)\$(TargetFramework)\$(_DevToolsTestingAbstractionsFileName)'))</_DevToolsTestingAbstractionsFromRepoFlavor>
      <_DevToolsTestingAbstractionsFromRepoTfm>$([System.IO.Path]::GetFullPath('$(MSBuildThisFileDirectory)..\..\DevTools.Testing.Abstractions\bin\$(Configuration)\$(TargetFramework)\$(_DevToolsTestingAbstractionsFileName)'))</_DevToolsTestingAbstractionsFromRepoTfm>
      <_DevToolsTestingAbstractionsFromRepoFlat>$([System.IO.Path]::GetFullPath('$(MSBuildThisFileDirectory)..\..\DevTools.Testing.Abstractions\bin\$(Configuration)\$(_DevToolsTestingAbstractionsFileName)'))</_DevToolsTestingAbstractionsFromRepoFlat>
      <_DevToolsTestingAbstractionsSource Condition="'$(TargetFrameworkIdentifier)' != '.NETCoreApp' And Exists('$(_DevToolsTestingAbstractionsFromPackage)')">$(_DevToolsTestingAbstractionsFromPackage)</_DevToolsTestingAbstractionsSource>
      <_DevToolsTestingAbstractionsSource Condition="'$(_DevToolsTestingAbstractionsSource)' == '' And '$(TargetFrameworkIdentifier)' != '.NETCoreApp' And Exists('$(_DevToolsTestingAbstractionsFromRepoFlavor)')">$(_DevToolsTestingAbstractionsFromRepoFlavor)</_DevToolsTestingAbstractionsSource>
      <_DevToolsTestingAbstractionsSource Condition="'$(_DevToolsTestingAbstractionsSource)' == '' And '$(TargetFrameworkIdentifier)' != '.NETCoreApp' And Exists('$(_DevToolsTestingAbstractionsFromRepoTfm)')">$(_DevToolsTestingAbstractionsFromRepoTfm)</_DevToolsTestingAbstractionsSource>
      <_DevToolsTestingAbstractionsSource Condition="'$(_DevToolsTestingAbstractionsSource)' == '' And '$(TargetFrameworkIdentifier)' != '.NETCoreApp' And Exists('$(_DevToolsTestingAbstractionsFromRepoFlat)')">$(_DevToolsTestingAbstractionsFromRepoFlat)</_DevToolsTestingAbstractionsSource>
      <_DevToolsNUnitMtpCsproj>$(MSBuildThisFileDirectory)..\..\DevTools.NUnit.MTP\DevTools.NUnit.MTP.csproj</_DevToolsNUnitMtpCsproj>
    </PropertyGroup>
    <Error
        Condition="(Exists('$(_DevToolsRuntimeRoot)') Or Exists('$(_DevToolsNUnitMtpCsproj)')) And '$(_DevToolsNUnitMtpSkipPackageCopy)' != 'true' And '$(_DevToolsNUnitMtpSource)' == ''"
        Text="RevitDevTool.TestAdapter could not copy DevTools.NUnit.MTP.dll next to the test executable for $(TargetFramework). In-repo copy looks under bin\$(_DevToolsMtpConfiguration)\$(TargetFramework)\ (then bin\$(Configuration)\$(TargetFramework)\). Rebuild DevTools.NUnit.MTP for that TFM; do not rely on a stale Debug.Autodesk.YYYY folder." />
    <Error
        Condition="(Exists('$(_DevToolsRuntimeRoot)') Or Exists('$(_DevToolsNUnitMtpCsproj)')) And '$(TargetFrameworkIdentifier)' != '.NETCoreApp' And '$(_DevToolsTestingAbstractionsSource)' == ''"
        Text="RevitDevTool.TestAdapter could not copy DevTools.Testing.Abstractions.dll next to the net48 test executable. Testhost MTP must share HostTestDiscovery with the adapter." />
    <Copy Condition="'$(_DevToolsNUnitMtpSource)' != ''"
          SourceFiles="$(_DevToolsNUnitMtpSource)"
          DestinationFolder="$(OutDir)"
          SkipUnchangedFiles="false" />
    <Copy Condition="'$(_DevToolsTestingAbstractionsSource)' != ''"
          SourceFiles="$(_DevToolsTestingAbstractionsSource)"
          DestinationFolder="$(OutDir)"
          SkipUnchangedFiles="false" />
  </Target>

  <!-- 4. Discovery refs (no Autodesk DLL copy) -->
  <Target Name="WriteDevToolsDiscoveryRefs"
          AfterTargets="Build"
          Condition="'$(IsTestingPlatformApplication)' == 'true'">
    <PropertyGroup>
      <_DevToolsDiscoveryRefsFile>$(TargetDir)$(TargetName).discovery-refs.txt</_DevToolsDiscoveryRefsFile>
    </PropertyGroup>
    <ItemGroup>
      <_DevToolsDiscoveryRef Include="@(ReferencePath)"
          Condition="'%(ReferencePath.NuGetPackageId)' != '' And '%(ReferencePath.CopyLocal)' != 'true' And Exists('%(Identity)') And !Exists('$(TargetDir)%(Filename)%(Extension)') And !$([System.String]::Copy('%(Identity)').Contains('\Reference Assemblies\')) And !$([System.String]::Copy('%(Identity)').Contains('\dotnet\packs\'))" />
    </ItemGroup>
    <WriteLinesToFile
        File="$(_DevToolsDiscoveryRefsFile)"
        Lines="@(_DevToolsDiscoveryRef->'%(Identity)')"
        Overwrite="true"
        Encoding="UTF-8"/>
    <ItemGroup>
      <FileWrites Include="$(_DevToolsDiscoveryRefsFile)"/>
    </ItemGroup>
  </Target>

  <!-- 5. Host options → testconfig.json -->
  <ItemGroup Condition="'$(IsTestingPlatformApplication)' == 'true'">
    <UpToDateCheckBuilt Include="$([System.IO.Path]::Combine($(MSBuildProjectDirectory), $(OutputPath), $(AssemblyName).testconfig.json))">
      <Original>$(MSBuildProjectFullPath)</Original>
    </UpToDateCheckBuilt>
  </ItemGroup>

  <Target Name="GenerateDevToolsTestConfig"
          BeforeTargets="BeforeBuild;GenerateTestingPlatformConfigurationFile;_CalculateGenerateTestingPlatformConfigurationFile;_GenerateTestingPlatformConfigurationFileCore"
          Condition="'$(IsTestingPlatformApplication)' == 'true'">
    <Error
        Condition="'$(HostName)' == ''"
        Text="RevitDevTool.TestAdapter test projects must declare &lt;HostName&gt; (for example Revit) in the .csproj." />
    <Error
        Condition="'$(HostVersion)' == ''"
        Text="RevitDevTool.TestAdapter test projects must declare &lt;HostVersion&gt; in the .csproj (for example &lt;HostVersion&gt;2024&lt;/HostVersion&gt; or &lt;HostVersion&gt;$(RevitVersion)&lt;/HostVersion&gt;)." />
    <PropertyGroup>
      <_DevToolsTestingRunnerPath Condition="'$(DevToolsTestingRunnerPath)' != ''">$(DevToolsTestingRunnerPath)</_DevToolsTestingRunnerPath>
      <_DevToolsTestingRunnerPath Condition="'$(_DevToolsTestingRunnerPath)' == ''">$([System.Environment]::GetFolderPath(SpecialFolder.ApplicationData))\Autodesk\ApplicationPlugins\RevitDevTool.bundle\Contents\DevTools.TestRunner.exe</_DevToolsTestingRunnerPath>
      <_DevToolsTestingRunnerPathJson>$(_DevToolsTestingRunnerPath.Replace('\', '\\'))</_DevToolsTestingRunnerPathJson>
      <_DevToolsUserTestConfigPath>$(MSBuildProjectDirectory)\testconfig.json</_DevToolsUserTestConfigPath>
      <_DevToolsGeneratedTestConfigPath>$(IntermediateOutputPath)devtools.testconfig.json</_DevToolsGeneratedTestConfigPath>
      <_DevToolsMergedTestConfigPath>$(IntermediateOutputPath)testconfig.json</_DevToolsMergedTestConfigPath>
    </PropertyGroup>

    <MakeDir Directories="$(IntermediateOutputPath);$(OutputPath)"/>
    <WriteLinesToFile
        File="$(_DevToolsGeneratedTestConfigPath)"
        Lines="{&#xA;  &quot;devtools&quot;: {&#xA;    &quot;hostName&quot;: &quot;$(HostName)&quot;,&#xA;    &quot;hostVersion&quot;: &quot;$(HostVersion)&quot;,&#xA;    &quot;forceLaunch&quot;: $(ForceLaunch),&#xA;    &quot;perTestTimeoutSeconds&quot;: $(PerTestTimeout),&#xA;    &quot;launchTimeoutSeconds&quot;: $(LaunchTimeout),&#xA;    &quot;runnerPath&quot;: &quot;$(_DevToolsTestingRunnerPathJson)&quot;,&#xA;    &quot;frameworkId&quot;: &quot;$(TestingFramework)&quot;&#xA;  }&#xA;}"
        Overwrite="true"
        Encoding="UTF-8"/>
    <MergeDevToolsTestConfig
        UserConfigFile="$(_DevToolsUserTestConfigPath)"
        GeneratedConfigFile="$(_DevToolsGeneratedTestConfigPath)"
        OutputConfigFile="$(_DevToolsMergedTestConfigPath)"/>
    <PropertyGroup>
      <_TestingPlatformConfigurationFileSourcePath>$(_DevToolsMergedTestConfigPath)</_TestingPlatformConfigurationFileSourcePath>
      <_DevToolsOutputTestConfigPath>$([System.IO.Path]::Combine($(MSBuildProjectDirectory), $(OutputPath), $(AssemblyName).testconfig.json))</_DevToolsOutputTestConfigPath>
    </PropertyGroup>
    <Copy SourceFiles="$(_DevToolsMergedTestConfigPath)"
          DestinationFiles="$(_DevToolsOutputTestConfigPath)"
          SkipUnchangedFiles="false"/>
    <ItemGroup>
      <FileWrites Include="$(_DevToolsGeneratedTestConfigPath);$(_DevToolsMergedTestConfigPath);$(_DevToolsOutputTestConfigPath)"/>
    </ItemGroup>
  </Target>
</Project>
