<Project>
  <!--
    Consumer test-project build. Order:

      0. TestingFramework -> selected sibling hook + assembly name
         (must stay in this file: NuGet imports the .props before the consumer
         sets TestingFramework)
      1. Reference the selected sibling + Abstractions from build/runtime/<tfm>
         (Private=true copy-local)
      2. CheckTestProject      TestingFramework, runtime folder, HostName, HostVersion
      3. AssemblyMetadata      csproj options -> [assembly: AssemblyMetadata("devtools.*")]
      4. WriteDiscoveryRefs    compile-only reference paths for host-free discovery
      5. CheckFrameworkVersion resolved framework package against the runtime manifest
      6. CopyFrameworkRuntime  selected framework runtime + manifest + pdb to the output, never a Reference

    Nothing here reads the consumer configuration or repo paths. In-repo
    samples restore RevitDevTool.TestAdapter from the local nupkg feed, the
    same surface an end user gets.
  -->
  <Import Project="$(MSBuildThisFileDirectory)RevitDevTool.TestAdapter.props"
          Condition="'$(TestAdapterPropsImported)' != 'true'"/>

  <!-- 0. TestingFramework -> testhost sibling (compile-time reference + MTP hook) -->
  <PropertyGroup>
    <_MtpSiblingName Condition="'$(TestingFramework)' == 'nunit'">DevTools.NUnit.MTP</_MtpSiblingName>
    <_MtpSiblingName Condition="'$(TestingFramework)' == 'tunit'">DevTools.TUnit.MTP</_MtpSiblingName>
    <_MtpSiblingName Condition="'$(TestingFramework)' == 'mstest'">DevTools.MSTest.MTP</_MtpSiblingName>
    <_MtpHookType Condition="'$(TestingFramework)' == 'nunit'">DevTools.NUnit.MTP.NUnitMtpBuilderHook</_MtpHookType>
    <_MtpHookType Condition="'$(TestingFramework)' == 'tunit'">DevTools.TUnit.MTP.TUnitMtpBuilderHook</_MtpHookType>
    <_MtpHookType Condition="'$(TestingFramework)' == 'mstest'">DevTools.MSTest.MTP.MSTestMtpBuilderHook</_MtpHookType>
    <_FrameworkRuntimeName Condition="'$(TestingFramework)' == 'nunit'">DevTools.NUnit.Runtime</_FrameworkRuntimeName>
    <_FrameworkRuntimeName Condition="'$(TestingFramework)' == 'tunit'">DevTools.TUnit.Runtime</_FrameworkRuntimeName>
    <_FrameworkRuntimeName Condition="'$(TestingFramework)' == 'mstest'">DevTools.MSTest.Runtime</_FrameworkRuntimeName>
    <_FrameworkPackageId Condition="'$(TestingFramework)' == 'nunit'">NUnit</_FrameworkPackageId>
    <_FrameworkPackageId Condition="'$(TestingFramework)' == 'tunit'">TUnit.Core</_FrameworkPackageId>
    <_FrameworkPackageId Condition="'$(TestingFramework)' == 'mstest'">MSTest.TestFramework</_FrameworkPackageId>
  </PropertyGroup>

  <ItemGroup Condition="'$(_MtpHookType)' != ''">
    <TestingPlatformBuilderHook Include="b7e4c1a9-5d2f-4e83-a16c-9f0b3d8e5a71">
      <DisplayName>RevitDevTool MTP Provider</DisplayName>
      <TypeFullName>$(_MtpHookType)</TypeFullName>
    </TestingPlatformBuilderHook>
  </ItemGroup>
  <ItemGroup Condition="'$(IsTestingPlatformApplication)' == 'true' And '$(TestingFramework)' == 'nunit'">
    <Compile Include="$(MSBuildThisFileDirectory)hooks\NUnitMtpBuilderHook.cs" />
  </ItemGroup>
  <ItemGroup Condition="'$(IsTestingPlatformApplication)' == 'true' And '$(TestingFramework)' == 'tunit'">
    <Compile Include="$(MSBuildThisFileDirectory)hooks\TUnitMtpBuilderHook.cs" />
  </ItemGroup>
  <ItemGroup Condition="'$(IsTestingPlatformApplication)' == 'true' And '$(TestingFramework)' == 'mstest'">
    <Compile Include="$(MSBuildThisFileDirectory)hooks\MSTestMtpBuilderHook.cs" />
  </ItemGroup>

  <!-- TUnit's package registers its own outer MTP framework. RevitDevTool owns
       the outer testhost so execution remains TestRunner -> testing/run IPC. -->
  <ItemGroup Condition="'$(TestingFramework)' == 'tunit'">
    <TestingPlatformBuilderHook Remove="6ADF853A-6945-4A06-9A4B-D99BC1DC1094" />
  </ItemGroup>
  <!-- MSTest.TestAdapter buildTransitive props registers this outer hook. -->
  <ItemGroup Condition="'$(TestingFramework)' == 'mstest'">
    <TestingPlatformBuilderHook Remove="031F8871-2660-4208-8F6B-FC142B40ABFF" />
  </ItemGroup>

  <!-- net4x + TUnit: the generated infrastructure applies [ModuleInitializer], which
       .NET Framework does not declare. Skipped when Polyfill or another declaration
       already provides the type. Opt out: NetFxModuleInitializer=false. -->
  <Target Name="NetFxModuleInitializer"
          BeforeTargets="CoreCompile"
          Condition="'$(TestingFramework)' == 'tunit' And $(TargetFramework.StartsWith('net4')) And '$(NetFxModuleInitializer)' != 'false'">
    <ItemGroup>
      <_DevToolsPolyfill Include="@(PackageReference)" Condition="'%(Identity)' == 'Polyfill'" />
      <_DevToolsPolyfill Include="@(GlobalPackageReference)" Condition="'%(Identity)' == 'Polyfill'" />
      <_DevToolsPolyfill Include="@(Compile)" Condition="'%(Filename)%(Extension)' == 'ModuleInitializerAttribute.cs'" />
      <Compile Include="$(MSBuildThisFileDirectory)netfx\ModuleInitializerAttribute.cs"
               Condition="'@(_DevToolsPolyfill)' == ''" />
    </ItemGroup>
  </Target>

  <!-- 1. build/runtime folder: net48, else .NET 10 or newer, else .NET 8 or newer. -->
  <PropertyGroup>
    <_RuntimeRoot>$(MSBuildThisFileDirectory)runtime\</_RuntimeRoot>
    <_ConsumerTfv Condition="'$(TargetFrameworkVersion)' != ''">$(TargetFrameworkVersion.Substring(1))</_ConsumerTfv>
    <_PackageRuntimeDir Condition="'$(TargetFrameworkIdentifier)' == '.NETFramework'">$(_RuntimeRoot)net48\</_PackageRuntimeDir>
    <_PackageRuntimeDir Condition="'$(TargetFrameworkIdentifier)' == '.NETCoreApp' And '$(_ConsumerTfv)' != '' And $([MSBuild]::VersionGreaterThanOrEquals('$(_ConsumerTfv)', '10.0'))">$(_RuntimeRoot)net10.0-windows7.0\</_PackageRuntimeDir>
    <_PackageRuntimeDir Condition="'$(_PackageRuntimeDir)' == '' And '$(TargetFrameworkIdentifier)' == '.NETCoreApp' And '$(_ConsumerTfv)' != '' And $([MSBuild]::VersionGreaterThanOrEquals('$(_ConsumerTfv)', '8.0'))">$(_RuntimeRoot)net8.0-windows7.0\</_PackageRuntimeDir>
  </PropertyGroup>

  <ItemGroup Condition="'$(_PackageRuntimeDir)' != '' And '$(_MtpSiblingName)' != ''">
    <Reference Include="$(_MtpSiblingName)">
      <HintPath>$(_PackageRuntimeDir)$(_MtpSiblingName).dll</HintPath>
      <Private>true</Private>
      <ExternallyResolved>true</ExternallyResolved>
    </Reference>
    <Reference Include="DevTools.Testing.Abstractions">
      <HintPath>$(_PackageRuntimeDir)DevTools.Testing.Abstractions.dll</HintPath>
      <Private>true</Private>
      <ExternallyResolved>true</ExternallyResolved>
    </Reference>
  </ItemGroup>

  <!-- 2. One stop per missing consumer setting. -->
  <Target Name="CheckTestProject" BeforeTargets="ResolveAssemblyReferences">
    <Error
        Condition="Exists('$(_RuntimeRoot)') And ('$(_PackageRuntimeDir)' == '' Or !Exists('$(_PackageRuntimeDir)'))"
        Text="RevitDevTool.TestAdapter has no runtime assets for $(TargetFramework). The package ships net48, net8.0-windows, and net10.0-windows under build/runtime." />
    <Error
        Condition="'$(IsTestingPlatformApplication)' == 'true' And '$(_MtpHookType)' == ''"
        Text="RevitDevTool.TestAdapter requires TestingFramework nunit, tunit, or mstest (got '$(TestingFramework)')." />
    <Error
        Condition="'$(IsTestingPlatformApplication)' == 'true' And '$(TestingFramework)' == 'mstest' And '$(EnableMSTestRunner)' != 'true'"
        Text="RevitDevTool.TestAdapter with TestingFramework=mstest needs the MSTest runner: use Sdk=&quot;MSTest.Sdk&quot; or set &lt;EnableMSTestRunner&gt;true&lt;/EnableMSTestRunner&gt;. Without it MSTest.TestAdapter turns off Microsoft.Testing.Platform (IsTestingPlatformApplication=false) and no testhost entry point is generated." />
    <Error
        Condition="'$(IsTestingPlatformApplication)' == 'true' And '$(HostName)' == ''"
        Text="RevitDevTool.TestAdapter test projects must declare &lt;HostName&gt; (for example Revit) in the .csproj." />
    <Error
        Condition="'$(IsTestingPlatformApplication)' == 'true' And '$(HostVersion)' == ''"
        Text="RevitDevTool.TestAdapter test projects must declare &lt;HostVersion&gt; (for example 2025) in the .csproj." />
  </Target>

  <!-- 3. Host options as assembly metadata; the adapter reads them from the entry assembly.
       A user-authored testconfig.json devtools key still wins. The runner is
       tools/runner inside this package. -->
  <ItemGroup Condition="'$(IsTestingPlatformApplication)' == 'true'">
    <AssemblyMetadata Include="devtools.hostName" Value="$(HostName)" />
    <AssemblyMetadata Include="devtools.hostVersion" Value="$(HostVersion)" />
    <AssemblyMetadata Include="devtools.forceLaunch" Value="$(ForceLaunch)" />
    <AssemblyMetadata Include="devtools.perTestTimeoutSeconds" Value="$(PerTestTimeout)" />
    <AssemblyMetadata Include="devtools.launchTimeoutSeconds" Value="$(LaunchTimeout)" />
    <AssemblyMetadata Include="devtools.runnerPath" Value="$([MSBuild]::NormalizePath('$(MSBuildThisFileDirectory)..\tools\runner\DevTools.TestRunner.exe'))" />
    <AssemblyMetadata Include="devtools.frameworkId" Value="$(TestingFramework)" />
  </ItemGroup>

  <!-- 4. Discovery refs: testhost resolves these paths, no Autodesk DLL copy. -->
  <Target Name="WriteDiscoveryRefs"
          AfterTargets="Build"
          Condition="'$(IsTestingPlatformApplication)' == 'true'">
    <PropertyGroup>
      <_DiscoveryRefsFile>$(TargetDir)$(TargetName).discovery-refs.txt</_DiscoveryRefsFile>
    </PropertyGroup>
    <ItemGroup>
      <_DiscoveryRef Include="@(ReferencePath)"
          Condition="'%(ReferencePath.NuGetPackageId)' != '' And '%(ReferencePath.CopyLocal)' != 'true' And Exists('%(Identity)') And !Exists('$(TargetDir)%(Filename)%(Extension)') And !$([System.String]::Copy('%(Identity)').Contains('\Reference Assemblies\')) And !$([System.String]::Copy('%(Identity)').Contains('\dotnet\packs\')) And !$([System.String]::Copy('%(ReferencePath.NuGetPackageId)').ToLowerInvariant().EndsWith('.ref'))" />
    </ItemGroup>
    <WriteLinesToFile
        File="$(_DiscoveryRefsFile)"
        Lines="@(_DiscoveryRef->'%(Identity)')"
        Overwrite="true"
        Encoding="UTF-8"/>
    <ItemGroup>
      <FileWrites Include="$(_DiscoveryRefsFile)"/>
    </ItemGroup>
  </Target>

  <!-- 5. Framework package against the runtime manifest. -->
  <Target Name="CheckFrameworkVersion"
          AfterTargets="ResolveAssemblyReferences"
          Condition="'$(IsTestingPlatformApplication)' == 'true' And '$(DesignTimeBuild)' != 'true' And '$(_FrameworkRuntimeName)' != '' And Exists('$(_PackageRuntimeDir)$(_FrameworkRuntimeName).json')">
    <ItemGroup>
      <_FrameworkPackageReference Include="@(ReferencePath)" Condition="'%(ReferencePath.NuGetPackageId)' == '$(_FrameworkPackageId)'" />
      <_AdapterPackageReference Include="@(ReferencePath)" Condition="'%(ReferencePath.NuGetPackageId)' == 'RevitDevTool.TestAdapter'" />
      <_TUnitEngineReference Include="@(ReferencePath)" Condition="'%(ReferencePath.NuGetPackageId)' == 'TUnit.Engine'" />
    </ItemGroup>
    <Error
        Condition="'$(TestingFramework)' == 'tunit' And '@(_TUnitEngineReference)' == ''"
        Text="RevitDevTool.TestAdapter with TestingFramework=tunit needs the TUnit package. Reference TUnit instead of TUnit.Core." />
    <PropertyGroup>
      <_FrameworkPackageVersion>@(_FrameworkPackageReference->'%(NuGetPackageVersion)'->Distinct())</_FrameworkPackageVersion>
      <_AdapterPackageVersion>@(_AdapterPackageReference->'%(NuGetPackageVersion)'->Distinct())</_AdapterPackageVersion>
      <_RuntimeManifestText>$([System.IO.File]::ReadAllText('$(_PackageRuntimeDir)$(_FrameworkRuntimeName).json'))</_RuntimeManifestText>
      <_RuntimeFrameworkName>$([System.Text.RegularExpressions.Regex]::Match($(_RuntimeManifestText), '"framework":\s*"([^"]+)"').Groups[1].Value)</_RuntimeFrameworkName>
      <_RuntimeFloor>$([System.Text.RegularExpressions.Regex]::Match($(_RuntimeManifestText), '"version":\s*"([^"]+)"').Groups[1].Value)</_RuntimeFloor>
      <_RuntimeFloorMajor>$(_RuntimeFloor.Split('.')[0])</_RuntimeFloorMajor>
      <_RuntimeFloorDisplay>$([System.Text.RegularExpressions.Regex]::Replace('$(_RuntimeFloor)', '^(\d+\.\d+\.\d+)\.0$', '$1'))</_RuntimeFloorDisplay>
      <_FrameworkPackageMajor Condition="'$(_FrameworkPackageVersion)' != ''">$(_FrameworkPackageVersion.Split('.')[0])</_FrameworkPackageMajor>
    </PropertyGroup>
    <Warning
        Condition="'$(_FrameworkPackageVersion)' == ''"
        Text="$(_RuntimeFrameworkName) did not resolve from the $(_FrameworkPackageId) package, so RevitDevTool.TestAdapter checks its version when tests run." />
    <Error
        Condition="'$(_FrameworkPackageVersion)' != '' And '$(_FrameworkPackageMajor)' != '$(_RuntimeFloorMajor)'"
        Text="$(_RuntimeFrameworkName) $(_FrameworkPackageVersion) is not supported by RevitDevTool.TestAdapter $(_AdapterPackageVersion) (built for $(_RuntimeFrameworkName) $(_RuntimeFloorMajor).x). Update RevitDevTool.TestAdapter to a version for $(_RuntimeFrameworkName) $(_FrameworkPackageMajor)." />
    <Error
        Condition="'$(_FrameworkPackageVersion)' != '' And '$(_FrameworkPackageMajor)' == '$(_RuntimeFloorMajor)' And $([MSBuild]::VersionLessThan('$(_FrameworkPackageVersion)', '$(_RuntimeFloor)'))"
        Text="$(_RuntimeFrameworkName) $(_FrameworkPackageVersion) is older than the $(_RuntimeFloorDisplay) that RevitDevTool.TestAdapter $(_AdapterPackageVersion) was built against. Update $(_RuntimeFrameworkName) to $(_RuntimeFloorDisplay) or later." />
  </Target>

  <!-- 6. Framework runtime + manifest + pdb to the output. -->
  <Target Name="CopyFrameworkRuntime"
          AfterTargets="CopyFilesToOutputDirectory"
          Condition="'$(IsTestingPlatformApplication)' == 'true' And '$(_FrameworkRuntimeName)' != '' And Exists('$(_PackageRuntimeDir)$(_FrameworkRuntimeName).dll')">
    <ItemGroup>
      <_FrameworkRuntimeFile Include="$(_PackageRuntimeDir)$(_FrameworkRuntimeName).dll;$(_PackageRuntimeDir)$(_FrameworkRuntimeName).json" />
      <_FrameworkRuntimeFile Include="$(_PackageRuntimeDir)$(_FrameworkRuntimeName).pdb" Condition="Exists('$(_PackageRuntimeDir)$(_FrameworkRuntimeName).pdb')" />
    </ItemGroup>
    <Copy SourceFiles="@(_FrameworkRuntimeFile)"
          DestinationFolder="$(TargetDir)"
          SkipUnchangedFiles="true" />
    <ItemGroup>
      <FileWrites Include="@(_FrameworkRuntimeFile->'$(TargetDir)%(Filename)%(Extension)')" />
    </ItemGroup>
  </Target>
</Project>
