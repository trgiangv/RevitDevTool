<Project>
  <!--
    Consumer test-project build. Order:

      0. TestingFramework -> MTPAssembly / MTPEntry  (must stay in this file: NuGet
         imports the .props before the consumer sets TestingFramework)
      1. _ResolveRuntimeDir   pick build/runtime/<tfm>: exact, else nearest lower
      2. CopyMTPSibling       copy MTPAssembly + Testing.Abstractions.dll next to the exe
      3. WriteDiscoveryRefs   write compile-only reference paths for host-free discovery
      4. GenerateTestConfig   csproj options -> [AssemblyName].testconfig.json

    Nothing here reads the consumer configuration or repo paths; the local dev loop
    lives in RevitDevTool.TestAdapter.Local.targets, which the nupkg does not ship.
  -->
  <Import Project="$(MSBuildThisFileDirectory)RevitDevTool.TestAdapter.props"
          Condition="'$(TestAdapterPropsImported)' != 'true'"/>
  <Import Project="$(MSBuildThisFileDirectory)RevitDevTool.TestAdapter.Local.targets"
          Condition="Exists('$(MSBuildThisFileDirectory)RevitDevTool.TestAdapter.Local.targets')"/>

  <!-- 0. TestingFramework -> testhost plugin -->
  <PropertyGroup>
    <MTPAssembly Condition="'$(MTPAssembly)' == '' and '$(TestingFramework)' == 'nunit'">DevTools.NUnit.MTP.dll</MTPAssembly>
    <MTPAssembly Condition="'$(MTPAssembly)' == '' and '$(TestingFramework)' == 'tunit'">DevTools.TUnit.MTP.dll</MTPAssembly>
    <MTPEntry Condition="'$(MTPEntry)' == '' and '$(TestingFramework)' == 'nunit'">DevTools.NUnit.MTP.NUnitMTP</MTPEntry>
    <MTPEntry Condition="'$(MTPEntry)' == '' and '$(TestingFramework)' == 'tunit'">DevTools.TUnit.MTP.TUnitMTP</MTPEntry>
  </PropertyGroup>

  <!-- net48 testhost binds MTP's BCL closure through binding redirects. -->
  <Target Name="DevToolsNetFxBindingRedirects"
          BeforeTargets="PrepareForBuild;GenerateBindingRedirects">
    <PropertyGroup Condition="'$(TargetFrameworkIdentifier)' == '.NETFramework'">
      <AutoGenerateBindingRedirects>true</AutoGenerateBindingRedirects>
      <GenerateBindingRedirectsOutputType>true</GenerateBindingRedirectsOutputType>
      <AutoUnifyAssemblyReferences>true</AutoUnifyAssemblyReferences>
    </PropertyGroup>
  </Target>

  <!-- TUnit's package registers its own outer MTP framework. RevitDevTool owns
       the outer testhost so execution remains TestRunner -> testing/run IPC. -->
  <ItemGroup Condition="'$(TestingFramework)' == 'tunit'">
    <TestingPlatformBuilderHook Remove="6ADF853A-6945-4A06-9A4B-D99BC1DC1094" />
  </ItemGroup>

  <!-- net4x + TUnit: the generated infrastructure applies [ModuleInitializer], which
       .NET Framework does not declare. Skipped when Polyfill or another declaration
       already provides the type. Opt out: NetFxModuleInitializer=false. -->
  <Target Name="NetFxModuleInitializer"
          BeforeTargets="CoreCompile"
          Condition="'$(TestingFramework)' == 'tunit' And $(TargetFramework.StartsWith('net4')) And '$(NetFxModuleInitializer)' != 'false'">
    <ItemGroup>
      <_DevToolsPolyfill Include="@(PackageReference)" Condition="'%(Identity)' == 'Polyfill'" />
      <_DevToolsPolyfill Include="@(GlobalPackageReference)" Condition="'%(Identity)' == 'Polyfill'" />
      <_DevToolsPolyfill Include="@(Compile)" Condition="'%(Filename)%(Extension)' == 'ModuleInitializerAttribute.cs'" />
      <Compile Include="$(MSBuildThisFileDirectory)netfx\ModuleInitializerAttribute.cs"
               Condition="'@(_DevToolsPolyfill)' == ''" />
    </ItemGroup>
  </Target>

  <!-- merge generated + optional testconfig.json -->
  <UsingTask TaskName="MergeTestConfig"
             TaskFactory="RoslynCodeTaskFactory"
             AssemblyFile="$(MSBuildToolsPath)\Microsoft.Build.Tasks.Core.dll">
    <ParameterGroup>
      <UserConfigFile ParameterType="System.String"/>
      <GeneratedConfigFile ParameterType="System.String" Required="true"/>
      <OutputConfigFile ParameterType="System.String" Required="true"/>
    </ParameterGroup>
    <Task>
      <Using Namespace="System"/>
      <Using Namespace="System.IO"/>
      <Code Type="Fragment" Language="cs"><![CDATA[
        var generated = File.ReadAllText(GeneratedConfigFile);
        var outputDirectory = Path.GetDirectoryName(OutputConfigFile);
        if (!string.IsNullOrEmpty(outputDirectory))
            Directory.CreateDirectory(outputDirectory);

        if (string.IsNullOrWhiteSpace(UserConfigFile) || !File.Exists(UserConfigFile))
        {
            File.WriteAllText(OutputConfigFile, generated);
        }
        else
        {
            var user = File.ReadAllText(UserConfigFile).Trim().TrimStart('\uFEFF');
            if (user.IndexOf("\"devtools\"", StringComparison.OrdinalIgnoreCase) >= 0)
            {
                if (user.IndexOf("\"frameworkId\"", StringComparison.OrdinalIgnoreCase) < 0
                    || user.IndexOf("\"mtpAssembly\"", StringComparison.OrdinalIgnoreCase) < 0
                    || user.IndexOf("\"mtpEntry\"", StringComparison.OrdinalIgnoreCase) < 0)
                {
                    Log.LogError("testconfig.json contains a devtools section but is missing frameworkId, mtpAssembly, or mtpEntry. Delete the devtools section or add all three plugin keys.");
                    return false;
                }

                File.WriteAllText(OutputConfigFile, user);
            }
            else
            {
                var inner = generated.Trim().TrimStart('{').TrimEnd('}').Trim();
                var body = user.Trim().TrimStart('{').TrimEnd('}').Trim().TrimEnd(',');
                var merged = body.Length == 0
                    ? generated
                    : "{" + Environment.NewLine + body + "," + Environment.NewLine + inner + Environment.NewLine + "}";
                File.WriteAllText(OutputConfigFile, merged);
            }
        }
      ]]></Code>
    </Task>
  </UsingTask>

  <!-- 1. Resolve build/runtime: exact consumer TFM, else nearest lower shipped folder. -->
  <Target Name="_ResolveRuntimeDir">
    <PropertyGroup>
      <_RuntimeRoot>$(MSBuildThisFileDirectory)runtime\</_RuntimeRoot>
      <_ConsumerTfv Condition="'$(TargetFrameworkVersion)' != ''">$(TargetFrameworkVersion.Substring(1))</_ConsumerTfv>
    </PropertyGroup>
    <PropertyGroup Condition="'$(TargetFrameworkIdentifier)' == '.NETFramework'">
      <_PackageRuntimeDir>$(_RuntimeRoot)net48\</_PackageRuntimeDir>
    </PropertyGroup>
    <PropertyGroup Condition="'$(TargetFrameworkIdentifier)' == '.NETCoreApp' And '$(_ConsumerTfv)' != ''">
      <_PackageRuntimeDir Condition="Exists('$(_RuntimeRoot)net$(_ConsumerTfv)-windows7.0\')">$(_RuntimeRoot)net$(_ConsumerTfv)-windows7.0\</_PackageRuntimeDir>
      <_PackageRuntimeDir Condition="'$(_PackageRuntimeDir)' == '' And $([MSBuild]::VersionGreaterThanOrEquals('$(_ConsumerTfv)', '10.0')) And Exists('$(_RuntimeRoot)net10.0-windows7.0\')">$(_RuntimeRoot)net10.0-windows7.0\</_PackageRuntimeDir>
      <_PackageRuntimeDir Condition="'$(_PackageRuntimeDir)' == '' And $([MSBuild]::VersionGreaterThanOrEquals('$(_ConsumerTfv)', '8.0')) And Exists('$(_RuntimeRoot)net8.0-windows7.0\')">$(_RuntimeRoot)net8.0-windows7.0\</_PackageRuntimeDir>
      <_PackageRuntimeDir Condition="'$(_PackageRuntimeDir)' == '' And $([MSBuild]::VersionGreaterThanOrEquals('$(_ConsumerTfv)', '10.0'))">$(_RuntimeRoot)net10.0-windows7.0\</_PackageRuntimeDir>
      <_PackageRuntimeDir Condition="'$(_PackageRuntimeDir)' == '' And $([MSBuild]::VersionGreaterThanOrEquals('$(_ConsumerTfv)', '8.0'))">$(_RuntimeRoot)net8.0-windows7.0\</_PackageRuntimeDir>
    </PropertyGroup>
    <Error
        Condition="Exists('$(_RuntimeRoot)') And ('$(_PackageRuntimeDir)' == '' Or !Exists('$(_PackageRuntimeDir)')) And '$(DevToolsTestAdapterLocal)' != 'true'"
        Text="RevitDevTool.TestAdapter has no runtime assets for $(TargetFramework). The package ships net48, net8.0-windows, and net10.0-windows under build/runtime. A matching or nearest-lower folder is required so DevTools.NUnit.MTP.dll and the adapter closure copy next to the test exe." />
  </Target>

  <!--
    2. Copy $(MTPAssembly) + Abstractions next to the test exe.
       MTP is not a consumer ProjectReference; testhost binds the consumer's NUnit/TUnit copy.
       SkipUnchangedFiles=false on $(MTPAssembly): a timestamp-stale sibling breaks discovery.
  -->
  <Target Name="CopyMTPSibling"
          AfterTargets="Build"
          DependsOnTargets="_ResolveRuntimeDir">
    <ItemGroup Condition="'$(_PackageRuntimeDir)' != ''">
      <_AbstractionsRuntime Include="$(_PackageRuntimeDir)DevTools.Testing.Abstractions.dll"
          Condition="Exists('$(_PackageRuntimeDir)DevTools.Testing.Abstractions.dll')" />
    </ItemGroup>
    <Error
        Condition="'$(MTPCopy)' != 'false' And !Exists('$(OutDir)$(MTPAssembly)') And Exists('$(_RuntimeRoot)') And ('$(_PackageRuntimeDir)' == '' Or !Exists('$(_PackageRuntimeDir)$(MTPAssembly)'))"
        Text="RevitDevTool.TestAdapter could not copy $(MTPAssembly) next to the test executable for $(TargetFramework). Place the DLL in $(OutDir), set MTPCopy=false if you copy it yourself, or use a first-party TestingFramework map." />
    <Error
        Condition="'$(_PackageRuntimeDir)' != '' And Exists('$(_PackageRuntimeDir)$(MTPAssembly)') And !Exists('$(_PackageRuntimeDir)DevTools.Testing.Abstractions.dll')"
        Text="RevitDevTool.TestAdapter could not copy DevTools.Testing.Abstractions.dll next to the test executable. Testhost MTP must share HostTestDiscovery with the adapter." />
    <Copy Condition="'$(_PackageRuntimeDir)' != '' And Exists('$(_PackageRuntimeDir)$(MTPAssembly)')"
          SourceFiles="$(_PackageRuntimeDir)$(MTPAssembly)"
          DestinationFolder="$(OutDir)"
          SkipUnchangedFiles="false" />
    <Copy Condition="'@(_AbstractionsRuntime)' != ''"
          SourceFiles="@(_AbstractionsRuntime)"
          DestinationFolder="$(OutDir)"
          SkipUnchangedFiles="true" />
  </Target>

  <!-- 3. Discovery refs: testhost resolves these paths, no Autodesk DLL copy. -->
  <Target Name="WriteDiscoveryRefs"
          AfterTargets="Build"
          Condition="'$(IsTestingPlatformApplication)' == 'true'">
    <PropertyGroup>
      <_DiscoveryRefsFile>$(TargetDir)$(TargetName).discovery-refs.txt</_DiscoveryRefsFile>
    </PropertyGroup>
    <ItemGroup>
      <_DiscoveryRef Include="@(ReferencePath)"
          Condition="'%(ReferencePath.NuGetPackageId)' != '' And '%(ReferencePath.CopyLocal)' != 'true' And Exists('%(Identity)') And !Exists('$(TargetDir)%(Filename)%(Extension)') And !$([System.String]::Copy('%(Identity)').Contains('\Reference Assemblies\')) And !$([System.String]::Copy('%(Identity)').Contains('\dotnet\packs\'))" />
    </ItemGroup>
    <WriteLinesToFile
        File="$(_DiscoveryRefsFile)"
        Lines="@(_DiscoveryRef->'%(Identity)')"
        Overwrite="true"
        Encoding="UTF-8"/>
    <ItemGroup>
      <FileWrites Include="$(_DiscoveryRefsFile)"/>
    </ItemGroup>
  </Target>

  <!-- 4. Options -> testconfig.json. Always regenerated: the MTP Core target is incremental. -->
  <ItemGroup Condition="'$(IsTestingPlatformApplication)' == 'true'">
    <UpToDateCheckBuilt Include="$([System.IO.Path]::Combine($(MSBuildProjectDirectory), $(OutputPath), $(AssemblyName).testconfig.json))">
      <Original>$(MSBuildProjectFullPath)</Original>
    </UpToDateCheckBuilt>
  </ItemGroup>

  <Target Name="GenerateTestConfig"
          BeforeTargets="BeforeBuild;GenerateTestingPlatformConfigurationFile;_CalculateGenerateTestingPlatformConfigurationFile;_GenerateTestingPlatformConfigurationFileCore"
          Condition="'$(IsTestingPlatformApplication)' == 'true'">
    <Error
        Condition="'$(HostName)' == ''"
        Text="RevitDevTool.TestAdapter test projects must declare &lt;HostName&gt; (for example Revit) in the .csproj." />
    <Error
        Condition="'$(HostVersion)' == ''"
        Text="RevitDevTool.TestAdapter test projects must declare &lt;HostVersion&gt; (for example 2025) in the .csproj." />
    <Error
        Condition="'$(MTPAssembly)' == ''"
        Text="RevitDevTool.TestAdapter requires MTPAssembly. Set TestingFramework to a supported value or declare &lt;MTPAssembly&gt; in the test .csproj." />
    <Error
        Condition="'$(MTPEntry)' == ''"
        Text="RevitDevTool.TestAdapter requires MTPEntry. Set TestingFramework to a supported value or declare &lt;MTPEntry&gt; in the test .csproj." />
    <PropertyGroup>
      <_RunnerPath Condition="'$(TestingRunnerPath)' != ''">$(TestingRunnerPath)</_RunnerPath>
      <_RunnerPath Condition="'$(_RunnerPath)' == ''">$([System.Environment]::GetFolderPath(SpecialFolder.ApplicationData))\Autodesk\ApplicationPlugins\RevitDevTool.bundle\Contents\DevTools.TestRunner.exe</_RunnerPath>
      <_RunnerPathJson>$(_RunnerPath.Replace('\', '\\'))</_RunnerPathJson>
      <_GeneratedTestConfigPath>$(IntermediateOutputPath)devtools.testconfig.json</_GeneratedTestConfigPath>
      <_MergedTestConfigPath>$(IntermediateOutputPath)testconfig.json</_MergedTestConfigPath>
    </PropertyGroup>
    <MakeDir Directories="$(IntermediateOutputPath);$(OutputPath)"/>
    <WriteLinesToFile
        File="$(_GeneratedTestConfigPath)"
        Lines="{&#xA;  &quot;devtools&quot;: {&#xA;    &quot;hostName&quot;: &quot;$(HostName)&quot;,&#xA;    &quot;hostVersion&quot;: &quot;$(HostVersion)&quot;,&#xA;    &quot;forceLaunch&quot;: $(ForceLaunch),&#xA;    &quot;perTestTimeoutSeconds&quot;: $(PerTestTimeout),&#xA;    &quot;launchTimeoutSeconds&quot;: $(LaunchTimeout),&#xA;    &quot;runnerPath&quot;: &quot;$(_RunnerPathJson)&quot;,&#xA;    &quot;frameworkId&quot;: &quot;$(TestingFramework)&quot;,&#xA;    &quot;mtpAssembly&quot;: &quot;$(MTPAssembly)&quot;,&#xA;    &quot;mtpEntry&quot;: &quot;$(MTPEntry)&quot;&#xA;  }&#xA;}"
        Overwrite="true"
        Encoding="UTF-8"/>
    <MergeTestConfig
        UserConfigFile="$(MSBuildProjectDirectory)\testconfig.json"
        GeneratedConfigFile="$(_GeneratedTestConfigPath)"
        OutputConfigFile="$(_MergedTestConfigPath)"/>
    <PropertyGroup>
      <_TestingPlatformConfigurationFileSourcePath>$(_MergedTestConfigPath)</_TestingPlatformConfigurationFileSourcePath>
      <_OutputTestConfigPath>$([System.IO.Path]::Combine($(MSBuildProjectDirectory), $(OutputPath), $(AssemblyName).testconfig.json))</_OutputTestConfigPath>
    </PropertyGroup>
    <Copy SourceFiles="$(_MergedTestConfigPath)"
          DestinationFiles="$(_OutputTestConfigPath)"
          SkipUnchangedFiles="false"/>
    <ItemGroup>
      <FileWrites Include="$(_GeneratedTestConfigPath);$(_MergedTestConfigPath);$(_OutputTestConfigPath)"/>
    </ItemGroup>
  </Target>
</Project>
