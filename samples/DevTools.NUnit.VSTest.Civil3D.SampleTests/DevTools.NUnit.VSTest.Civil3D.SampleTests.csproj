<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <UseAutoCad>true</UseAutoCad>
        <IsTestProject>true</IsTestProject>
        <OutputType>Library</OutputType>
        <HostName>Civil3D</HostName>
        <HostVersion>$(AutoCadVersion)</HostVersion>
        <HostLaunch>false</HostLaunch>
        <HostTimeout>60</HostTimeout>
        <HostLaunchTimeout>360</HostLaunchTimeout>
    </PropertyGroup>

    <Import Project="..\..\source\DevTools.NUnit.TestAdapter\build\DevTools.NUnit.TestAdapter.targets"/>

    <ItemGroup>
        <Compile Include="..\DevTools.NUnit.Civil3D.SampleTests\HostSmokeTests.cs" Link="HostSmokeTests.cs"/>
    </ItemGroup>

    <ItemGroup>
        <PackageReference Include="Microsoft.NET.Test.Sdk"/>
        <PackageReference Include="NUnit"/>
        <ProjectReference Include="..\..\source\DevTools.NUnit.TestAdapter\DevTools.NUnit.TestAdapter.csproj"/>
    </ItemGroup>
</Project>
