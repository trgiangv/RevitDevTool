<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <UseRevit>true</UseRevit>
        <IsTestProject>true</IsTestProject>
        <HostName>Revit</HostName>
        <HostVersion>$(RevitVersion)</HostVersion>
        <HostLaunch>false</HostLaunch>
        <HostTimeout>60</HostTimeout>
        <HostLaunchTimeout>360</HostLaunchTimeout>
    </PropertyGroup>

    <Import Project="..\..\source\DevTools.NUnit.Mtp\build\DevTools.NUnit.targets"/>

    <ItemGroup>
        <PackageReference Include="Nice3point.Revit.Toolkit" VersionOverride="$(RevitVersion).*"/>
        <PackageReference Include="Microsoft.Testing.Platform.MSBuild"/>
        <PackageReference Include="NUnit"/>
        <ProjectReference Include="..\..\source\DevTools.NUnit.Mtp\DevTools.NUnit.Mtp.csproj"/>
    </ItemGroup>
</Project>
