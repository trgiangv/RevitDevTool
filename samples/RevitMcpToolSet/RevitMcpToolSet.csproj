<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <UseRevit>true</UseRevit>
        <!-- Match host: ILRepack off for 2027 isolated context (shared MCP DLL identity). -->
        <IsRepackable Condition="$(RevitVersion) &lt; 2027">true</IsRepackable>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="Nice3point.Revit.Toolkit" VersionOverride="$(RevitVersion).*"/>
        <PackageReference Include="ModelContextProtocol">
            <ExcludeAssets>runtime</ExcludeAssets>
        </PackageReference>
        <PackageReference Include="ModelContextProtocol.Extensions.Tasks">
            <ExcludeAssets>runtime</ExcludeAssets>
        </PackageReference>
        <PackageReference Include="ILRepack"/>
    </ItemGroup>

    <ItemGroup>
        <EmbeddedResource Include="Resources\Content\*.md" />
    </ItemGroup>

</Project>
