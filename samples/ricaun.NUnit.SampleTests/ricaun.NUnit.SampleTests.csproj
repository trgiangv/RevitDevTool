<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <UseRevit>true</UseRevit>
        <IsTestProject>true</IsTestProject>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="Nice3point.Revit.Toolkit" VersionOverride="$(RevitVersion).*"/>
        <PackageReference Include="NUnit" VersionOverride="3.13.3"/>
        <PackageReference Include="ricaun.RevitTest.TestAdapter" VersionOverride="1.11.1"/>
    </ItemGroup>

    <ItemGroup>
        <Compile Include="..\DevTools.NUnit.SampleTests\HostSmokeTests.cs" Link="HostSmokeTests.cs"/>
        <Compile Include="..\DevTools.NUnit.SampleTests\BoundingBoxXyzSampleTests.cs" Link="BoundingBoxXyzSampleTests.cs"/>
        <Compile Include="..\DevTools.NUnit.SampleTests\DiscoveryGapTests.cs" Link="DiscoveryGapTests.cs"/>
        <Compile Include="..\DevTools.NUnit.SampleTests\FixtureShapeTests.cs" Link="FixtureShapeTests.cs"/>
        <Compile Include="..\DevTools.NUnit.SampleTests\LifecycleTests.cs" Link="LifecycleTests.cs"/>
        <Compile Include="..\DevTools.NUnit.SampleTests\TestCaseTests.cs" Link="TestCaseTests.cs"/>
        <Compile Include="..\DevTools.NUnit.SampleTests\ValueSourceTests.cs" Link="ValueSourceTests.cs"/>
    </ItemGroup>

    <!--Config NUnit-->
    <ItemGroup>
        <AssemblyAttribute Include="System.Reflection.AssemblyMetadataAttribute">
            <_Parameter1>NUnit.Open</_Parameter1>
            <_Parameter2>false</_Parameter2>
        </AssemblyAttribute>
        <AssemblyAttribute Include="System.Reflection.AssemblyMetadataAttribute">
            <_Parameter1>NUnit.Version</_Parameter1>
            <_Parameter2>$(RevitVersion)</_Parameter2>
        </AssemblyAttribute>
        <AssemblyAttribute Include="System.Reflection.AssemblyMetadataAttribute">
            <_Parameter1>NUnit.Close</_Parameter1>
            <_Parameter2>false</_Parameter2>
        </AssemblyAttribute>
    </ItemGroup>
</Project>