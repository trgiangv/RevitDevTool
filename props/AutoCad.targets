<?xml version="1.0" encoding="UTF-8"?>
<Project xmlns="http://schemas.microsoft.com/developer/msbuild/2003">


    <!-- ============================================== -->
    <!-- 1. Debug / Release Detection                   -->
    <!-- ============================================== -->

    <PropertyGroup Condition="'$(Configuration)' != 'Debug' AND $(Configuration.Contains('Debug'))">
        <DebugSymbols>true</DebugSymbols>
        <DefineConstants>$(DefineConstants);DEBUG</DefineConstants>
    </PropertyGroup>

    <PropertyGroup
            Condition="'$(Configuration)' != 'Release' AND $(Configuration.Contains('Release'))">
        <Optimize>true</Optimize>
        <DebugType>portable</DebugType>
        <DefineConstants>$(DefineConstants);RELEASE</DefineConstants>
    </PropertyGroup>

    <!-- ============================================== -->
    <!-- 2. Deploy Bundle                               -->
    <!-- ============================================== -->
    <!--
        AutoCAD-family apps (AutoCAD, Civil 3D, Plant 3D, ...) use the
        ApplicationPlugins bundle layout:
          %APPDATA%\Autodesk\ApplicationPlugins\<Name>.bundle\
              PackageContents.xml
              <Version>\*.dll
    -->

    <PropertyGroup>
        <BundleDestinationFolder Condition="'$(BundleDestinationFolder)' == ''">$(AppData)\Autodesk\ApplicationPlugins\$(MSBuildProjectName).bundle</BundleDestinationFolder>
        <DeployAutoCadBundle Condition="'$(DeployAutoCadBundle)' == ''">false</DeployAutoCadBundle>
        <PublishAutoCadBundle Condition="'$(DeployAutoCadBundle)' == 'true'">true</PublishAutoCadBundle>
        <PublishAutoCadBundle Condition="'$(PublishAutoCadBundle)' == ''">false</PublishAutoCadBundle>
    </PropertyGroup>

    <Target Name="PublishAutoCadBundleFiles"
            AfterTargets="Build"
            Condition="$(PublishAutoCadBundle) == 'true' AND '$(AutoCadVersion)' != '' AND '$(TargetFramework)' != ''">

        <ItemGroup>
            <PackageContentsFile Include="$(MSBuildThisFileDirectory)PackageContents.xml"/>
            <BundleItems Include="$(TargetDir)**\*" Exclude="**\$(PublishDirName)\**\*"/>
        </ItemGroup>

        <PropertyGroup>
            <BundlePublishDir>$(PublishDir)</BundlePublishDir>
            <BundleVersionDir>$(BundlePublishDir)Contents\$(AutoCadVersion)\</BundleVersionDir>
        </PropertyGroup>

        <RemoveDir Directories="$(BundleVersionDir)" Condition="Exists('$(BundleVersionDir)')"/>

        <Copy SourceFiles="@(PackageContentsFile)"
              DestinationFolder="$(BundlePublishDir)"/>
        <Copy SourceFiles="@(BundleItems)"
              DestinationFolder="$(BundleVersionDir)%(RecursiveDir)"/>

        <Message Text="$(MSBuildProjectName) -> $(BundlePublishDir)" Importance="high"/>
    </Target>

    <Target Name="DeployAutoCadBundleFiles"
            AfterTargets="PublishAutoCadBundleFiles"
            Condition="$(DeployAutoCadBundle) == 'true' AND '$(AutoCadVersion)' != '' AND '$(TargetFramework)' != ''">

        <ItemGroup>
            <BundleDeployItems Include="$(PublishDir)**\*"/>
        </ItemGroup>

        <Copy SourceFiles="@(BundleDeployItems)"
              SkipUnchangedFiles="false"
              DestinationFolder="$(BundleDestinationFolder)\%(RecursiveDir)"
              ContinueOnError="true"
              Retries="1"/>

        <Message Text="$(MSBuildProjectName) -> $(BundleDestinationFolder)\"
                 Importance="high"/>
    </Target>

    <Target Name="CleanAutoCadBundleFolder"
            AfterTargets="Clean"
            Condition="$(DeployAutoCadBundle) == 'true'">
        <RemoveDir Directories="$(BundleDestinationFolder)" ContinueOnError="true"/>
    </Target>

    <Target Name="CleanPublishFolder"
            AfterTargets="Clean"
            Condition="$(PublishAutoCadBundle) == 'true'">
        <RemoveDir Directories="$(PublishDir)"/>
    </Target>

    <!-- ============================================== -->
    <!-- 3. Define Constants                            -->
    <!-- ============================================== -->

    <Target Name="GenerateAutoCadCompatibleDefineConstants"
            BeforeTargets="CoreCompile"
            Condition="'$(AutoCadVersion)' != '' AND '$(DisableImplicitAutoCadDefines)' != 'true'">

        <PropertyGroup>
            <DefineConstants>$(DefineConstants);AUTOCAD$(AutoCadVersion)</DefineConstants>
        </PropertyGroup>

        <!-- AutoCAD version ladder -->
        <PropertyGroup Condition="$(AutoCadVersion) &gt;= 2022">
            <DefineConstants>$(DefineConstants);AUTOCAD2022_OR_GREATER</DefineConstants>
        </PropertyGroup>
        <PropertyGroup Condition="$(AutoCadVersion) &gt;= 2023">
            <DefineConstants>$(DefineConstants);AUTOCAD2023_OR_GREATER</DefineConstants>
        </PropertyGroup>
        <PropertyGroup Condition="$(AutoCadVersion) &gt;= 2024">
            <DefineConstants>$(DefineConstants);AUTOCAD2024_OR_GREATER</DefineConstants>
        </PropertyGroup>
        <PropertyGroup Condition="$(AutoCadVersion) &gt;= 2025">
            <DefineConstants>$(DefineConstants);AUTOCAD2025_OR_GREATER</DefineConstants>
        </PropertyGroup>
        <PropertyGroup Condition="$(AutoCadVersion) &gt;= 2026">
            <DefineConstants>$(DefineConstants);AUTOCAD2026_OR_GREATER</DefineConstants>
        </PropertyGroup>
        <PropertyGroup Condition="$(AutoCadVersion) &gt;= 2027">
            <DefineConstants>$(DefineConstants);AUTOCAD2027_OR_GREATER</DefineConstants>
        </PropertyGroup>

        <!-- Product-family defines (set UseXxx in csproj to opt-in) -->
        <PropertyGroup Condition="'$(UseCivil3d)' == 'true'">
            <DefineConstants>$(DefineConstants);CIVIL3D;CIVIL3D$(Civil3dVersion)</DefineConstants>
        </PropertyGroup>
        <PropertyGroup Condition="'$(UsePlant3d)' == 'true'">
            <DefineConstants>$(DefineConstants);PLANT3D;PLANT3D$(AutoCadVersion)</DefineConstants>
        </PropertyGroup>
    </Target>

</Project>
