<Project Sdk="MSTest.Sdk">

    <PropertyGroup>
        <TargetFramework>net10.0-windows</TargetFramework>
        <UseWindowsForms>true</UseWindowsForms>
        <IsPackable>false</IsPackable>
        <NoWarn>$(NoWarn);CA1707</NoWarn>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="FlaUI.UIA3" />
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="..\..\source\DevTools.ModelsContext\DevTools.ModelsContext.csproj" />
    </ItemGroup>

    <ItemGroup>
        <Compile Include="..\RevitDevTool.ModelsContext.LiveTests\Cases\CaseData.cs" Link="Shared\CaseData.cs" />
        <Compile Include="..\RevitDevTool.ModelsContext.LiveTests\Evidence\Evidence.cs" Link="Shared\Evidence.cs" />
        <None Include="..\RevitDevTool.ModelsContext.LiveTests\Data\**" Link="Data\%(RecursiveDir)%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
    </ItemGroup>

    <ItemGroup>
        <Using Include="Microsoft.VisualStudio.TestTools.UnitTesting" />
        <Using Remove="System.Windows.Forms" />
    </ItemGroup>

</Project>
