<UserControl x:Class="RevitDevTool.ExternalEvent.HotReloadUi.HotReloadPanePage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="#FFF5F5F5"
             Foreground="#FF1E1E1E">
    <!--  UserControl (not Page): Page templates/themes often fail when hosted in ContentControl + collectible ALC.  -->
    <StackPanel Margin="12">
        <TextBlock Margin="0,0,0,8"
                   Text="Satellite DLL — rebuild RevitDevTool.ExternalEvent.HotReloadUi.dll, then Reload."
                   TextWrapping="Wrap" />
        <TextBlock x:Name="InstanceLabel"
                   Background="Green"
                   FontFamily="Consolas"
                   FontSize="13"
                   TextWrapping="Wrap" />
        <Button Margin="0,12,0,0"
                Padding="8,4"
                Click="OnReloadClick"
                Content="Reload from disk" />
    </StackPanel>
</UserControl>
