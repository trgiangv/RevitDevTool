<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFrameworks>net48;net8.0-windows;net10.0-windows</TargetFrameworks>
        <RootNamespace>DevTools.NUnit.Runtime.Fixtures</RootNamespace>
        <AssemblyName>DevTools.NUnit.Runtime.Fixtures</AssemblyName>
        <IsPackable>false</IsPackable>
        <IsTestProject>false</IsTestProject>
    </PropertyGroup>

    <PropertyGroup Condition="'$(GenerationMarker)' == 'generation-two'">
        <DefineConstants>$(DefineConstants);NUNIT_GENERATION_TWO</DefineConstants>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="NUnit"/>
    </ItemGroup>

</Project>
