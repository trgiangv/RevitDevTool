        <Using Include="DevTools.Ipc"/>
        <Using Include="DevTools.Mcp.Core"/>
        <Using Include="DevTools.Mcp.Core.Catalog"/>
        <Using Include="DevTools.Mcp.Core.Models"/>
        <Using Include="DevTools.Mcp.Core.Protocol"/>
        <Using Include="DevTools.Mcp.Core.Results"/>
        <Using Include="DevTools.Daemon.Mcp.Processes"/>
        <Using Include="DevTools.Mcp"/>
