<Project>
  <PropertyGroup>
    <TargetFramework>net48</TargetFramework>
    <RootNamespace>DevTools.MSTest.Runtime.Tests.Fixtures</RootNamespace>
    <IsPackable>false</IsPackable>
    <IsTestProject>false</IsTestProject>
    <IsTestingPlatformApplication>false</IsTestingPlatformApplication>
    <EnableMSTestRunner>false</EnableMSTestRunner>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <Using Include="Microsoft.VisualStudio.TestTools.UnitTesting" />
    <PackageVersion Include="MSTest.TestFramework" Version="$(MSTestSdkVersion)" />
    <PackageReference Include="MSTest.TestFramework">
      <ExcludeAssets>analyzers;build;buildTransitive</ExcludeAssets>
    </PackageReference>
  </ItemGroup>

  <Target Name="RemoveMSTestAnalyzers" BeforeTargets="CoreCompile">
    <ItemGroup>
      <Analyzer Remove="@(Analyzer)" Condition="$([System.String]::Copy('%(Filename)').StartsWith('MSTest'))" />
    </ItemGroup>
  </Target>
</Project>
