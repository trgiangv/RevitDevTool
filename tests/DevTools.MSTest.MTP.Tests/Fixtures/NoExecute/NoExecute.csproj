<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net48</TargetFramework>
    <AssemblyName>DevTools.MSTest.NoExecuteProbe</AssemblyName>
    <RootNamespace>DevTools.TestAdapter.Tests.Fixtures</RootNamespace>
    <IsPackable>false</IsPackable>
    <IsTestProject>false</IsTestProject>
    <IsTestingPlatformApplication>false</IsTestingPlatformApplication>
    <EnableMSTestRunner>false</EnableMSTestRunner>
    <GenerateTestingPlatformEntryPoint>false</GenerateTestingPlatformEntryPoint>
    <UseMicrosoftTestingPlatformRunner>false</UseMicrosoftTestingPlatformRunner>
  </PropertyGroup>

  <ItemGroup>
    <Using Include="Microsoft.VisualStudio.TestTools.UnitTesting" />
    <PackageVersion Include="MSTest.TestFramework" Version="4.5.2" />
    <PackageReference Include="MSTest.TestFramework">
      <ExcludeAssets>analyzers;build;buildTransitive</ExcludeAssets>
    </PackageReference>
  </ItemGroup>

  <Target Name="RemoveMSTestAnalyzers" BeforeTargets="CoreCompile">
    <ItemGroup>
      <Analyzer Remove="@(Analyzer)" Condition="$([System.String]::Copy('%(Filename)').StartsWith('MSTest'))" />
    </ItemGroup>
  </Target>
</Project>
