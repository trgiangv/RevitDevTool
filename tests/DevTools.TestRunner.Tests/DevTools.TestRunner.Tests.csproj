<Project Sdk="MSTest.Sdk">

    <PropertyGroup>
        <TargetFramework>net10.0-windows</TargetFramework>
        <IsPackable>false</IsPackable>
        <!-- Match the runner exe so ProjectReference is allowed (NETSDK1151). -->
        <!-- Match DevTools.TestRunner (framework-dependent, win-x64). SelfContained=true
             against that reference is NETSDK1150. -->
        <SelfContained>false</SelfContained>
        <RuntimeIdentifier>win-x64</RuntimeIdentifier>
        <UseMicrosoftCodeCoverage>true</UseMicrosoftCodeCoverage>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="Microsoft.Extensions.DependencyInjection"/>
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="..\..\source\DevTools.Ipc\DevTools.Ipc.csproj"/>
        <ProjectReference Include="..\..\source\DevTools.Hosting\DevTools.Hosting.csproj"/>
        <ProjectReference Include="..\..\source\DevTools.Testing.Abstractions\DevTools.Testing.Abstractions.csproj"/>
        <ProjectReference Include="..\..\source\DevTools.Testing.Transport\DevTools.Testing.Transport.csproj"/>
        <ProjectReference Include="..\..\source\DevTools.TestRunner\DevTools.TestRunner.csproj"
                          AdditionalProperties="PublishSingleFile=false"/>
    </ItemGroup>

    <ItemGroup>
        <Using Include="Microsoft.VisualStudio.TestTools.UnitTesting"/>
        <Using Include="DevTools.Ipc"/>
        <Using Include="DevTools.TestRunner"/>
    </ItemGroup>

</Project>
