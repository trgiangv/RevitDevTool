<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFramework>net10.0-windows</TargetFramework>
        <IsPackable>false</IsPackable>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="xunit.v3.mtp-v2"/>
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="..\..\source\DevTools.Ipc\DevTools.Ipc.csproj"/>
        <ProjectReference Include="..\..\source\DevTools.Testing.Abstractions\DevTools.Testing.Abstractions.csproj"/>
        <ProjectReference Include="..\..\source\DevTools.Testing.Transport\DevTools.Testing.Transport.csproj"/>
        <ProjectReference Include="..\..\source\DevTools.NUnit.Provider\DevTools.NUnit.Provider.csproj"/>
        <ProjectReference Include="..\..\source\DevTools.TestRunner.Core\DevTools.TestRunner.Core.csproj"/>
        <ProjectReference Include="..\..\source\DevTools.NUnit.Runner\DevTools.NUnit.Runner.csproj"/>
    </ItemGroup>

    <!-- NETSDK1151: a non-self-contained test project cannot ProjectReference the self-contained Runner exe
         (AdditionalProperties / ReferenceOutputAssembly=false do not suppress the check). -->
    <Target Name="EnsureRunnerBuilt" BeforeTargets="Build">
        <MSBuild Projects="..\..\source\DevTools.TestRunner\DevTools.TestRunner.csproj"
                 Targets="Build"
                 Properties="Configuration=$(Configuration)"/>
    </Target>

    <ItemGroup>
        <Compile Remove="DiscoverCommandTests.cs;HostDebugAttachScopeTests.cs;NUnitRunnerFilterTests.cs;RunnerCommandLineTests.cs;TestingPipeClientTests.cs" />
    </ItemGroup>

    <ItemGroup>
        <Using Include="Xunit"/>
        <Using Include="DevTools.Ipc"/>
        <Using Include="DevTools.NUnit.Runner"/>
    </ItemGroup>

</Project>
