<Project>
    <Import Project="..\Directory.Build.props" />

    <PropertyGroup Condition="$([System.String]::Copy('$(MSBuildProjectName)').EndsWith('.Tests'))">
        <OutputType>Exe</OutputType>
        <UseMicrosoftTestingPlatformRunner>true</UseMicrosoftTestingPlatformRunner>
    </PropertyGroup>

    <!-- coverlet.MTP is net8+ only. net48 hosts (*.NetFramework.Tests) stay without it. -->
    <ItemGroup Condition="$([System.String]::Copy('$(MSBuildProjectName)').EndsWith('.Tests')) AND !$([System.String]::Copy('$(MSBuildProjectName)').Contains('NetFramework'))">
        <PackageReference Include="coverlet.MTP" />
        <None Include="$(MSBuildThisFileDirectory)testconfig.json"
              CopyToOutputDirectory="PreserveNewest"
              Link="testconfig.json" />
    </ItemGroup>
</Project>
