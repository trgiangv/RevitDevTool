<Project Sdk="MSTest.Sdk">

    <PropertyGroup>
        <TargetFramework>net48</TargetFramework>
        <IsPackable>false</IsPackable>
        <DefaultItemExcludes>$(DefaultItemExcludes);Fixtures\**\*</DefaultItemExcludes>
        <TestingExtensionsProfile>None</TestingExtensionsProfile>
        <EnableMicrosoftTestingExtensionsCodeCoverage>false</EnableMicrosoftTestingExtensionsCodeCoverage>
    </PropertyGroup>

    <ItemGroup>
        <Compile Remove="Fixtures\**\*.cs" />
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="..\..\source\DevTools.AssemblyIsolation\DevTools.AssemblyIsolation.csproj" SetTargetFramework="TargetFramework=net48" />
        <ProjectReference Include="..\..\source\DevTools.Execution\DevTools.Execution.csproj" SetTargetFramework="TargetFramework=net48" />
        <ProjectReference Include="..\..\source\DevTools.Mcp.Catalog\DevTools.Mcp.Catalog.csproj" SetTargetFramework="TargetFramework=net48" />
        <ProjectReference Include="..\DevTools.AssemblyIsolation.Tests\Fixtures\IsolationEntry\IsolationEntry.csproj" ReferenceOutputAssembly="false" SetTargetFramework="TargetFramework=net48" />
        <ProjectReference Include="..\DevTools.AssemblyIsolation.Tests\Fixtures\PrivateSystemNamedDependency\PrivateSystemNamedDependency.csproj" ReferenceOutputAssembly="false" SetTargetFramework="TargetFramework=net48" />
        <ProjectReference Include="..\DevTools.AssemblyIsolation.Tests\Fixtures\PrivateAfterDisposeDependency\PrivateAfterDisposeDependency.csproj" ReferenceOutputAssembly="false" SetTargetFramework="TargetFramework=net48" />
    </ItemGroup>

    <ItemGroup>
        <Using Include="Microsoft.VisualStudio.TestTools.UnitTesting" />
    </ItemGroup>
</Project>
