<Project Sdk="MSTest.Sdk">

    <PropertyGroup>
        <TargetFramework>net48</TargetFramework>
        <IsPackable>false</IsPackable>
        <TestingExtensionsProfile>None</TestingExtensionsProfile>
        <EnableMicrosoftTestingExtensionsCodeCoverage>false</EnableMicrosoftTestingExtensionsCodeCoverage>
        <DefaultItemExcludes>$(DefaultItemExcludes);Fixtures\**\*</DefaultItemExcludes>
    </PropertyGroup>

    <ItemGroup>
        <Compile Remove="Fixtures\**\*.cs"/>
    </ItemGroup>

    <ItemGroup>
        <PackageReference Include="NUnit"/>
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="..\..\source\DevTools.Testing.Host\DevTools.Testing.Host.csproj" SetTargetFramework="TargetFramework=net48"/>
        <ProjectReference Include="..\..\source\DevTools.Testing.Abstractions\DevTools.Testing.Abstractions.csproj" SetTargetFramework="TargetFramework=net48"/>
        <ProjectReference Include="..\..\source\DevTools.NUnit.Runtime\DevTools.NUnit.Runtime.csproj" ReferenceOutputAssembly="false" SetTargetFramework="TargetFramework=net48"/>
        <ProjectReference Include="..\DevTools.NUnit.Runtime.Fixtures\DevTools.NUnit.Runtime.Fixtures.csproj" ReferenceOutputAssembly="false"/>
        <ProjectReference Include="Fixtures\ConflictingNUnitFramework\ConflictingNUnitFramework.csproj" ReferenceOutputAssembly="false"/>
        <ProjectReference Include="Fixtures\GenerationPrivateDependency\GenerationPrivateDependency.csproj" ReferenceOutputAssembly="false"/>
        <ProjectReference Include="Fixtures\DependencyConsumer\DependencyConsumer.csproj" ReferenceOutputAssembly="false"/>
        <ProjectReference Include="Fixtures\NetFrameworkGenerationProbe\NetFrameworkGenerationProbe.csproj" ReferenceOutputAssembly="false"/>
    </ItemGroup>

    <ItemGroup>
        <Using Include="Microsoft.VisualStudio.TestTools.UnitTesting"/>
    </ItemGroup>

</Project>
